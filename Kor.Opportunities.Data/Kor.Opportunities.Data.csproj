<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 (not -windows) so the Worker (Microsoft.NET.Sdk.Worker, net8.0) can reference us. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kor.Opportunities.Data</AssemblyName>
    <!-- Don't emit Playwright's 66 MB node driver from THIS library's output —
         it was flowing via ProjectReference into every consumer's publish
         (e.g. the MCP, which never scrapes). Executables that DO scrape (the
         Worker) still get the driver from their own evaluation of
         Microsoft.Playwright.targets, which runs transitively in every
         referencing project with its own default platform. Verified against
         the Worker publish output when introduced (m-cleanup 2026-06-10). -->
    <PlaywrightPlatform>none</PlaywrightPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- BD report generators (BD-UI-Plan-2026-06-08): OpenXml not Word COM so
         reports generate on any machine incl. KOR-APP01 cron (no Word license). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Graph" Version="5.105.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.45.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kor.Opportunities.Core\Kor.Opportunities.Core.csproj" />
  </ItemGroup>
</Project>
