<Project Sdk="Microsoft.NET.Sdk">

  <!-- The NetworkOps MCP server: live, structured NetworkOps context (and, later, audited actions) for a Claude
       session over MCP, instead of a point-in-time prompt + parsing `netops` CLI text. A SEPARATE process on
       purpose: no new dependency inside the critical monitoring service, and nothing ships in its deploy. Reads the
       same DB as the service, through the same NetworkOpsStore. See docs/memory: project-networkops-mcp-server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kor.Operations.NetworkOps.Mcp</RootNamespace>
    <AssemblyName>Kor.Operations.NetworkOps.Mcp</AssemblyName>
    <!-- Don't drag the service's net48 agent build into every MCP build. -->
    <BuildAgent>false</BuildAgent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kor.Operations.NetworkOps.Service\Kor.Operations.NetworkOps.Service.csproj" />
    <ProjectReference Include="..\Kor.Operations.NetworkOps.Core\Kor.Operations.NetworkOps.Core.csproj" />
  </ItemGroup>

</Project>
