<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rule-plumbing tests reach ApplyRules directly. They pass it a settings
         dictionary that records every key looked up, which is the only way to prove the
         required-rule list covers everything the code actually reads. -->
    <InternalsVisibleTo Include="Kor.Operations.EngineeringTools.Core.Tests" />
  </ItemGroup>

</Project>