<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>netops</AssemblyName>
    <RootNamespace>Kor.Operations.NetworkOps.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- `netops watchdog` reads the service heartbeat; same version as the service. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <!-- Signing in to NetworkOps on APP01 as the app does (AppServer.cs): the app's registration and token cache. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.83.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MCP bridge's sign-in guard (McpBridge.SignIn) is driven by a test, not only read as source (board row 72). -->
    <InternalsVisibleTo Include="Kor.Operations.NetworkOps.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kor.Operations.NetworkOps.Core\Kor.Operations.NetworkOps.Core.csproj" />
    <ProjectReference Include="..\Kor.Operations.NetworkOps.Transport\Kor.Operations.NetworkOps.Transport.csproj" />
  </ItemGroup>

</Project>
