<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kor.Operations.NetworkOps.Service</RootNamespace>
    <AssemblyName>Kor.Operations.NetworkOps.Service</AssemblyName>
    <!-- Bump on every meaningful service-side change: the heartbeat row carries it, so a
         redeploy can be confirmed from the database, not assumed. -->
    <Version>0.54.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kor.Operations.NetworkOps.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.8" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Quartz" Version="3.13.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.1" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.82.1" />
    <PackageReference Include="Microsoft.Graph" Version="5.103.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <!-- The Command Center API (Api/ApiHost.cs): Entra bearer tokens. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <!-- UniFi backup pull (Jobs/UniFiBackupJob.cs): SFTP with a pinned host key. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kor.Operations.NetworkOps.Core\Kor.Operations.NetworkOps.Core.csproj" />
    <ProjectReference Include="..\Kor.Operations.NetworkOps.Transport\Kor.Operations.NetworkOps.Transport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Remote control's install script ships inside the service: generated per deployment by Mesh/MeshInstaller.cs. -->
    <EmbeddedResource Include="Mesh\install-mesh.ps1" LogicalName="Kor.Operations.NetworkOps.Service.Mesh.install-mesh.ps1" />
    <EmbeddedResource Include="Prompts\network.md" LogicalName="Kor.Operations.NetworkOps.Service.Prompts.network.md" />
    <EmbeddedResource Include="Prompts\Tools\*.md" LogicalName="Kor.Operations.NetworkOps.Service.Prompts.Tools.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The endpoint agent travels with the service, in an "agent" folder beside it: deploying the service is what
       makes a new agent version available to install (Agents/AgentInstaller.cs). It is a .NET Framework 4.8 exe, so
       it is built by its own project, not referenced. -->
  <PropertyGroup>
    <AgentProject>$(MSBuildThisFileDirectory)..\Kor.Operations.NetworkOps.Agent\Kor.Operations.NetworkOps.Agent.csproj</AgentProject>
    <AgentOutput>$(MSBuildThisFileDirectory)..\Kor.Operations.NetworkOps.Agent\bin\$(Configuration)\net48\</AgentOutput>
  </PropertyGroup>
  <Target Name="BuildAgent" BeforeTargets="Build">
    <!-- Restore and build as separate evaluations (one call would build against the pre-restore evaluation). -->
    <MSBuild Projects="$(AgentProject)" Targets="Restore" Properties="Configuration=$(Configuration);_AgentRestore=1" />
    <MSBuild Projects="$(AgentProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>
  <Target Name="CopyAgentToOutput" AfterTargets="Build">
    <ItemGroup>
      <AgentFiles Include="$(AgentOutput)Kor.Operations.NetworkOps.Agent.exe;$(AgentOutput)Kor.Operations.NetworkOps.Agent.exe.config;$(AgentOutput)Kor.Operations.NetworkOps.Agent.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentFiles)" DestinationFolder="$(OutDir)agent" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyAgentToPublish" AfterTargets="Publish">
    <ItemGroup>
      <AgentPublishFiles Include="$(AgentOutput)Kor.Operations.NetworkOps.Agent.exe;$(AgentOutput)Kor.Operations.NetworkOps.Agent.exe.config;$(AgentOutput)Kor.Operations.NetworkOps.Agent.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentPublishFiles)" DestinationFolder="$(PublishDir)agent" />
  </Target>
</Project>
