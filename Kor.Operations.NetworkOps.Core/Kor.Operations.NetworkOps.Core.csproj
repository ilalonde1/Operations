<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pure half of NetworkOps: models, parsers, rules and the run-on-target payload.
       No I/O and no Windows-only APIs, so every diagnosis can be tested against a captured
       fixture without a machine to point at (docs/KOR-NetworkOps-Design-2026-09-28.md §4.1). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kor.Operations.NetworkOps.Tests" />
  </ItemGroup>

  <!-- The PowerShell that runs ON the workstations. Embedded so the CLI and the service ship
       the exact same probe as the rules were tested against; never loose files beside an exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Probes\*.ps1" LogicalName="Probes.%(Filename).ps1" />
  </ItemGroup>

  <!-- The UPS chain's last step, run ON the ESXi host (Power/HostScript.cs): embedded for the same reason. -->
  <ItemGroup>
    <EmbeddedResource Include="Power\*.py" LogicalName="Power.%(Filename).py" />
    <EmbeddedResource Include="Rack\*.py" LogicalName="Rack.%(Filename).py" />
    <EmbeddedResource Include="Actions\*.ps1" LogicalName="Actions.%(Filename).ps1" />
  </ItemGroup>

</Project>
