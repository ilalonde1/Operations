<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kor.Opportunities.Worker</RootNamespace>
    <AssemblyName>Kor.Opportunities.Worker</AssemblyName>
    <!-- Bump on every meaningful service-side change. The ServiceHeartbeat row
         surfaces this so the operator can confirm a redeploy actually picked up
         the new binary. Mirrors Kor.Operations.FileSync.Service convention. -->
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" Version="5.5.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.26" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.8" />
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="Quartz" Version="3.13.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.1" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kor.Opportunities.Core\Kor.Opportunities.Core.csproj" />
    <ProjectReference Include="..\Kor.Opportunities.Data\Kor.Opportunities.Data.csproj" />
    <ProjectReference Include="..\Kor.Operations.Data\Kor.Operations.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ResearchPrompts\**\*.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- 2026-06-12: nightly-refresh trigger scripts ship with the Worker
         (BdResearchQueueBuilderJob runs Scripts\Nightly-Refresh.ps1).
         Linked from tools\BdQueueDrainBatchGenerate — single source, no
         repo duplication. -->
    <Content Include="..\tools\BdQueueDrainBatchGenerate\Nightly-Refresh.ps1" Link="Scripts\Nightly-Refresh.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\tools\BdQueueDrainBatchGenerate\Generate-Batch.ps1" Link="Scripts\Generate-Batch.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
