<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kor.BdIntegrityCheck</RootNamespace>
    <AssemblyName>BdIntegrityCheck</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- The duplicate-class checks run the platform's OWN normalizers
         (NormalizeForFuzzyMatch, NormalizeAggressiveKey, ExtractWebsiteDomain)
         over the live org table. A SQL re-implementation would be a third
         same-company heuristic, which Kor.Opportunities.Data/CLAUDE.md forbids. -->
    <ProjectReference Include="..\..\Kor.Opportunities.Data\Kor.Opportunities.Data.csproj" />
  </ItemGroup>
</Project>
