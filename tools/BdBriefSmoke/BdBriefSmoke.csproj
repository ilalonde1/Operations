<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BdBriefSmoke</RootNamespace>
    <AssemblyName>BdBriefSmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Kor.Opportunities.Data\Kor.Opportunities.Data.csproj" />
    <ProjectReference Include="..\..\Kor.Operations.App\Kor.Operations.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UseWPF drops System.IO from the SDK implicit usings; put it back so a new file cannot miss it. -->
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
