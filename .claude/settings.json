{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe start --module \"Operations\" --part record --hook",
            "timeout": 30,
            "statusMessage": "Reading what this module knows: five questions, resume, open issues, stale records, decisions (Knowledge IDE K6)"
          },
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe start --module \"Operations\" --part state --hook",
            "timeout": 30,
            "statusMessage": "Reading the module's STATE NOW from its handover at HEAD (Knowledge IDE K6, board row 1198)"
          },
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe start --module \"Operations\" --part memory --page 1 --pages 1 --hook",
            "timeout": 30,
            "statusMessage": "Reading this module's memory from the DB, page 1 only: the small start (row 1893); kor recall brings the rest at the moment of acting"
          },
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe start --module \"Operations\" --part board --owner Operations --hook",
            "timeout": 30,
            "statusMessage": "Reading this lead's rows off the board (the source of truth; Knowledge IDE K6)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe capture-start --hook",
            "timeout": 15,
            "statusMessage": "Recording this session's start in the module record (Knowledge IDE K4)"
          },
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe enroll-check --hook",
            "timeout": 30,
            "statusMessage": "Is every framework hook still wired here, and is session capture reaching the DB? (kor enroll-check, board row 1209)"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe fresh --file-changed --hook",
            "timeout": 15,
            "statusMessage": "Is a changed file the source of a current record? (Knowledge IDE K5/K6; matcher omitted so every watchPaths file fires it)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/claude_run_sample_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking the sample-first stop is not taken out"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"C:/VIsual Studio Projects/Framework/tools/commit_scope_guard.py\" --hook",
            "timeout": 30,
            "statusMessage": "Commit scope guard: a commit carries only paths this session named (row 1211; mistakes 4, 143)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"C:/VIsual Studio Projects/Framework/tools/board_time_guard.py\" --hook",
            "timeout": 15,
            "statusMessage": "Board time guard: no time not yet reached, no id never read (row 1967; mistakes 32-34, 54, 63, 142)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe enforce --module \"Operations\" --hook",
            "timeout": 15,
            "statusMessage": "Checking the call against the recorded lessons (Knowledge IDE K7: brain.Check)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe stall --module \"Operations\" --hook",
            "timeout": 15,
            "statusMessage": "Has this target failed twice in a row? (G1 stall guard, board row 1308)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_bash_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking against the repo's hard rules"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_asked_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking remote actions were asked for"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_sql_schema_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking the table's schema was read before writing to it"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_prior_art_guard.py\"",
            "timeout": 20,
            "statusMessage": "Recording the search"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_api_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking the command does not spend the Anthropic API"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_prior_art_guard.py\" --content-search",
            "timeout": 20,
            "statusMessage": "Checking the prior art was looked for"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_api_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking no Anthropic API call enters the BD work"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_api_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking no Anthropic API call enters the BD work"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_prior_art_guard.py\"",
            "timeout": 20,
            "statusMessage": "Recording the search"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_prior_art_guard.py\"",
            "timeout": 20,
            "statusMessage": "Recording the search"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_prior_art_guard.py\"",
            "timeout": 20,
            "statusMessage": "Recording what was read"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_look_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking every change was LOOKED at before telling a peer it is done"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_instrument_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking a reported zero came from an instrument tested on a known answer"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_bash_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking against the repo's hard rules"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_asked_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking remote actions were asked for"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_sql_schema_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking the table's schema was read before writing to it"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_prior_art_guard.py\"",
            "timeout": 20,
            "statusMessage": "Recording the search"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_api_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking the command does not spend the Anthropic API"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe context --module \"Operations\" --hook",
            "timeout": 10,
            "statusMessage": "How full is this session's context? WARN at 300k and every 100k, STOP at 850k: only the handover then (G5, board row 1474)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe recall --hook",
            "timeout": 15,
            "statusMessage": "Ranked recall: the records and board rows that match this action (row 1893)"
          },
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe repeat --hook",
            "timeout": 15,
            "statusMessage": "No duplicate work: is this measurement or analysis already recorded? (row 1998)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_absence_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking any claim that something is missing carries its proof"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_look_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking every change was LOOKED at before any claim it is done"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_instrument_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking a reported zero came from an instrument tested on a known answer"
          },
          {
            "type": "command",
            "command": "python -I \"C:/VIsual Studio Projects/Framework/tools/claude_board_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking the reply does not contradict the board (the source of truth)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe capture-check --hook",
            "timeout": 30,
            "statusMessage": "Asking once per turn what it found - a failed run, a pipeline outcome, Ian's decision, a diagnosis - and once per new commit what it taught (row 1393, Knowledge IDE K4)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe context --module \"Operations\" --hook",
            "timeout": 10,
            "statusMessage": "At STOP, is the handover written? (G5, board row 1474)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe recall --hook --push-back",
            "timeout": 15,
            "statusMessage": "Push-back: does the reply contradict a decision of Ian's (row 1893)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_prompt_recorder.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/PlanDocCheck/check_plan_doc_current.py\" owed --hook --ledger \"C:/VIsual Studio Projects/KOR.Drafter/work/*/doc-owed.jsonl\"",
            "timeout": 20,
            "statusMessage": "Is the plan doc behind the pipeline?"
          },
          {
            "type": "command",
            "command": "C:/KOR-Operations/cli/netops.exe signin-status --hook",
            "timeout": 10,
            "statusMessage": "Is the NetworkOps sign-in about to lapse?"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe context --module \"Operations\" --hook",
            "timeout": 10,
            "statusMessage": "Is this session at its context line? (G5, board row 1474)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe recall --hook",
            "timeout": 15,
            "statusMessage": "Ranked recall: the records and board rows that match this prompt (row 1893)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_bash_sample_guard.py\"",
            "timeout": 20,
            "statusMessage": "Marking truncated output as a sample"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/claude_grep_sample_guard.py\"",
            "timeout": 20,
            "statusMessage": "Marking a truncated search as a sample"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe capture-tool --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe capture-tool --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe capture-compact --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/KOR-Operations/kor/kor.exe capture-end --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
