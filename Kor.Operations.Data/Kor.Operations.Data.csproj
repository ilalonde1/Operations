<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mark this as Windows so registry APIs and ODBC are “supported on: windows” -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kor.Operations.Data</AssemblyName>
    <NoWarn>$(NoWarn);SA0001</NoWarn>
    <StyleCopEnabled>false</StyleCopEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.8" />
    <PackageReference Include="Polly" Version="8.5.2" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.3" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kor.Operations.Core\Kor.Operations.Core.csproj" />
    <ProjectReference Include="..\Kor.Opportunities.Core\Kor.Opportunities.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Kor.Operations.App\Services\AppConfigKeys.cs" Link="Services\AppConfigKeys.cs" />
  </ItemGroup>
</Project>
