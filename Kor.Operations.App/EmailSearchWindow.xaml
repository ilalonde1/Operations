<Window x:Class="Kor.Operations.EmailSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Search Filed Emails"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Loaded="Window_Loaded">

    <DockPanel LastChildFill="True" Margin="10">
        <!-- Header band -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brand.Primary.Brush}"
                CornerRadius="12"
                Padding="0"
                Margin="0,0,0,10">
            <controls:KorHeader x:Name="HeaderBar"
                                HeaderText="Filed Email Search"
                                SubtitleText="Full-text search across saved .msg/.eml"
                                AvatarDiameter="96"
                                AvatarBorderThickness="2"/>
        </Border>

        <!-- Main card -->
        <Border Style="{StaticResource Card}" Padding="12">
            <Grid>
            <DockPanel LastChildFill="True">

                <!-- Filters area -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Vertical"
                            Margin="0,0,0,8">

                    <!-- Row 1 + Row 2 in a shared grid so columns line up -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- label column -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- main input column (project / date filters) -->
                            <ColumnDefinition Width="350"/>
                            <!-- second label column -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- right input column (fts / buttons) -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1: project + full text -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Project only:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                            <TextBox x:Name="ProjectBox" Height="26"
                                     VerticalContentAlignment="Center" Padding="4,2"
                                     ToolTip="Type a project number or name to filter"
                                     TextChanged="ProjectBox_TextChanged"
                                     PreviewKeyDown="ProjectBox_PreviewKeyDown"/>
                            <Popup x:Name="ProjectPopup" PlacementTarget="{Binding ElementName=ProjectBox}"
                                   Placement="Bottom" StaysOpen="False" Width="{Binding ActualWidth, ElementName=ProjectBox}">
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                        MaxHeight="250">
                                    <ListBox x:Name="ProjectList" FontSize="12"
                                             Cursor="Hand"
                                             MouseLeftButtonUp="ProjectList_MouseUp"
                                             PreviewKeyDown="ProjectList_PreviewKeyDown"
                                             BorderThickness="0"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Full-text search:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <TextBox Grid.Row="0" Grid.Column="3"
                                 x:Name="FtsBox"
                                 MinHeight="28"
                                 Padding="6,4"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,0"
                                 ToolTip="Full-text: subject, body, addresses, filenames…"
                                 KeyDown="FtsBox_KeyDown"/>

                        <!-- Row 2: filters -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Sent Between:"
                                   VerticalAlignment="Center"
                                   Margin="0,4,6,0"/>

                        <!-- dates under the project column -->
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="0,4,0,0">
                            <DatePicker x:Name="FromDate"
                                        Width="163"
                                        Height="26"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        ToolTip="From (UTC)"/>

                            <DatePicker x:Name="ToDate"
                                        Width="163"
                                        Height="26"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        ToolTip="To (UTC)"/>
                        </StackPanel>

                        <!-- Has attachments + Clear / Search aligned under the FTS box -->
                        <Grid Grid.Row="1" Grid.Column="3"
                              Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <!-- left edge aligned with FTS textbox -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Has attachments -->
                                <ColumnDefinition Width="*"/>
                                <!-- spacer -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Clear -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Search -->
                            </Grid.ColumnDefinitions>

                            <!-- Has attachments at left edge of FTS box -->
                            <CheckBox Grid.Column="0"
                                      x:Name="HasAttachBox"
                                      Content="Has attachments"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>

                            <!-- Buttons flush right: Clear first, then Search -->
                            <Button Grid.Column="2"
                                    Content="Clear"
                                    Width="100"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource Button.Secondary}"
                                    Click="OnClear"/>

                            <Button Grid.Column="3"
                                    Content="Search"
                                    Width="100"
                                    Click="OnSearch"/>
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- PAGER (must come before the grid in a DockPanel) -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <TextBlock Text="Page:" VerticalAlignment="Center"/>
                    <TextBox x:Name="PageBox" Width="54" Text="1" Margin="6,0,8,0" Padding="4,2" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Size:" VerticalAlignment="Center"/>
                    <TextBox x:Name="PageSizeBox" Width="60" Text="50" Margin="6,0,8,0" Padding="4,2" VerticalContentAlignment="Center"/>
                    <Button x:Name="PrevBtn"
                            Content="Prev"
                            Click="OnPrev"
                            Margin="0,0,6,0"
                            Style="{StaticResource Button.Secondary}"/>
                    <Button x:Name="NextBtn"
                            Content="Next"
                            Click="OnNext"
                            Margin="0,0,8,0"/>
                    <TextBlock x:Name="TotalText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>

                <!-- Data grid (last so it fills) -->
                <DataGrid x:Name="Grid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Project"    Binding="{Binding ProjectNumber}"  Width="120"/>
                        <DataGridTextColumn Header="Sent (UTC)" Binding="{Binding SentOnUtc}"      Width="160"/>
                        <DataGridTextColumn Header="From"       Binding="{Binding FromEmail}"      Width="220"/>
                        <DataGridTextColumn Header="Subject"    Binding="{Binding Subject}"        Width="*"/>
                        <DataGridTextColumn Header="Att"        Binding="{Binding AttachmentCount}" Width="60"/>
                        <DataGridTemplateColumn Header="Open" Width="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open"
                                            Tag="{Binding FilePath}"
                                            Click="OnOpenEmail"
                                            Style="{StaticResource Button.Secondary}"
                                            Padding="8,4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
            <controls:LoadingOverlay x:Name="LoadingOverlay" Panel.ZIndex="100"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
