<Window x:Class="Kor.Operations.GeneralTools.BrochureBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kor.Operations.GeneralTools"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Sales Brochure Builder"
        Width="1320"
        Height="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">

    <Window.Resources>
        <local:FileNameFromPathConverter x:Key="FileNameFromPathConverter"/>
        <local:ImagePathConverter x:Key="ImagePathConverter"/>
        <x:Array x:Key="TemplateOptions" Type="{x:Type sys:String}">
            <sys:String>Corporate Profile</sys:String>
            <sys:String>Project Showcase</sys:String>
            <sys:String>Regional Overview</sys:String>
        </x:Array>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Height="56"
                Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E7E6E6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                        <Setter Property="Background" Value="#435363"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="Setup"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>

                <Rectangle Width="56"
                           Height="1"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Fill="#E7E6E6"/>

                <StackPanel>
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E7E6E6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                        <Setter Property="Background" Value="#435363"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="Structure"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>

                <Rectangle Width="56"
                           Height="1"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Fill="#E7E6E6"/>

                <StackPanel>
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E7E6E6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Background" Value="#435363"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="Content"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>

                <Rectangle Width="56"
                           Height="1"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Fill="#E7E6E6"/>

                <StackPanel>
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E7E6E6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Background" Value="#435363"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="Generate"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="48"
                Padding="8,0"
                BorderBrush="#E7E6E6"
                BorderThickness="0,0.5,0,0"
                Background="{StaticResource App.Background}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Back"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding PrevStepCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanGoBack}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1"
                        Content="Next →"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding NextStepCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanGoNext}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="StepContentArea">
                    <Grid Margin="0,0,16,0">
                        <Border x:Name="Step1Panel"
                                Style="{StaticResource Card}"
                                Padding="18">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Text="Brochure Setup"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Primary}"
                                           Margin="0,0,0,16"/>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Template"
                                               FontSize="12"
                                               Foreground="#888888"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{StaticResource TemplateOptions}"
                                              SelectedItem="{Binding TemplateName, Mode=TwoWay}"
                                              MinHeight="32"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Cover title"
                                               FontSize="12"
                                               Foreground="#888888"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <TextBox x:Name="CoverTitleBox"
                                                 Text="{Binding CoverTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="32"/>
                                        <TextBlock Text="e.g. KOR Structural Portfolio 2025"
                                                   Margin="10,8,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=CoverTitleBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Cover photo"
                                               FontSize="12"
                                               Foreground="#888888"
                                               Margin="0,0,0,4"/>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverPhotoPath}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CoverPhotoPath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="Browse..."
                                                Style="{StaticResource Button.Secondary}"
                                                Command="{Binding PickCoverPhotoCommand}"/>
                                        <TextBlock Text="(optional)"
                                                   Margin="10,8,0,0"
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverPhotoPath}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CoverPhotoPath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Width="80"
                                                Height="56"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                Background="#F0F0F0">
                                            <Image Source="{Binding CoverPhotoPath, Converter={StaticResource ImagePathConverter}}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding CoverPhotoPath, Converter={StaticResource FileNameFromPathConverter}}"
                                                   Margin="10,20,8,0"
                                                   MaxWidth="150"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Content="&#x2715;"
                                                Width="24"
                                                Height="24"
                                                Margin="0,16,8,0"
                                                Command="{Binding ClearCoverPhotoCommand}"/>
                                        <Button Content="Change..."
                                                Style="{StaticResource Button.Secondary}"
                                                Margin="0,12,0,0"
                                                Command="{Binding PickCoverPhotoCommand}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoverPhotoPath}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CoverPhotoPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontSize="12"
                                               Foreground="#888888"
                                               Margin="0,0,0,4">
                                        <Run Text="Opacity"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding CoverPhotoOpacity, StringFormat={}{0:P0}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Slider Minimum="0"
                                            Maximum="1"
                                            SmallChange="0.05"
                                            Value="{Binding CoverPhotoOpacity, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="Step2Panel">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>

                        <Grid x:Name="Step3Panel">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>

                        <Grid x:Name="Step4Panel">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>
                    </Grid>
                </ContentControl>
            </ScrollViewer>

            <Border Grid.Column="1"
                    x:Name="PreviewSidebar"
                    BorderBrush="#E7E6E6"
                    BorderThickness="0.5,0,0,0"/>
        </Grid>
    </DockPanel>
</Window>
