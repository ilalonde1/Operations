<Window x:Class="Kor.Operations.GeneralTools.BrochureBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:brochure="clr-namespace:Kor.Operations.Core.Models.Brochure;assembly=Kor.Operations.Core"
        xmlns:local="clr-namespace:Kor.Operations.GeneralTools"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Sales Brochure Builder"
        Width="1320"
        Height="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">

    <Window.Resources>
        <local:FileNameFromPathConverter x:Key="FileNameFromPathConverter"/>
        <local:ImagePathConverter x:Key="ImagePathConverter"/>
        <AlternationConverter x:Key="ProjectIndexConverter">
            <sys:String>#1</sys:String>
            <sys:String>#2</sys:String>
            <sys:String>#3</sys:String>
            <sys:String>#4</sys:String>
            <sys:String>#5</sys:String>
            <sys:String>#6</sys:String>
            <sys:String>#7</sys:String>
            <sys:String>#8</sys:String>
            <sys:String>#9</sys:String>
            <sys:String>#10</sys:String>
            <sys:String>#11</sys:String>
            <sys:String>#12</sys:String>
        </AlternationConverter>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="General Tools"
                            SubtitleText="Sales Brochure Builder"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.6*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Brochure Setup"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Template"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"/>
                                <ComboBox Grid.Row="0"
                                          Grid.Column="1"
                                          ItemsSource="{Binding TemplateOptions}"
                                          SelectedItem="{Binding TemplateName, Mode=TwoWay}"
                                          MinHeight="32"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Cover Title"
                                           FontWeight="Bold"
                                           VerticalAlignment="Top"
                                           Margin="0,8,16,0"/>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                    <TextBox x:Name="CoverTitleBox"
                                             Text="{Binding CoverTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"/>
                                    <TextBlock Text="e.g. KOR Structural Portfolio 2025"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="10,7,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=CoverTitleBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Cover Photo"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,8,16,0"/>
                                <Grid Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverPhotoPath}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CoverPhotoPath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Width="120"
                                                Height="80"
                                                CornerRadius="4"
                                                Background="#F0F0F0"
                                                ClipToBounds="True">
                                            <Image Source="{Binding CoverPhotoPath, Converter={StaticResource ImagePathConverter}}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <TextBlock Text="{Binding CoverPhotoPath, Converter={StaticResource FileNameFromPathConverter}}"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="9"
                                                   MaxWidth="150"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,8,0"/>

                                        <Button Content="&#x2715;"
                                                Width="24"
                                                Height="24"
                                                Command="{Binding ClearCoverPhotoCommand}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"/>

                                        <Button Content="Browse..."
                                                Style="{StaticResource Button.Secondary}"
                                                Margin="0,0,8,0"
                                                Command="{Binding PickCoverPhotoCommand}"/>

                                        <TextBlock Text="(optional)"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontStyle="Italic"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverPhotoPath}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CoverPhotoPath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Button Content="Browse..."
                                                Style="{StaticResource Button.Secondary}"
                                                Margin="0,0,8,0"
                                                Command="{Binding PickCoverPhotoCommand}"/>
                                        <TextBlock Text="(optional)"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontStyle="Italic"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Add a Project"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Fill in the project details below, then click Add Project"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontStyle="Italic"
                                       Margin="0,4,0,14"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Project Name"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Section"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <Grid>
                                        <TextBox x:Name="SectionLabelBox"
                                                 Text="{Binding SectionLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="32"/>
                                        <TextBlock Text="e.g. RESIDENTIAL"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   Margin="10,7,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SectionLabelBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Location"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ProjectLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="32"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="Description"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ProjectDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinLines="5"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="Photos"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Add Photos..."
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="0,0,8,0"
                                        Click="AddPhoto_Click"/>
                                <Button Content="Clear All"
                                        Click="RemovePhoto_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Photos.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="200"
                                          Margin="0,0,0,10">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Photos.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding Photos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type brochure:BrochurePhoto}">
                                            <Border Width="90"
                                                    Height="75"
                                                    Margin="4"
                                                    CornerRadius="4"
                                                    Background="#F0F0F0"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding FilePath, Converter={StaticResource ImagePathConverter}}"
                                                           Stretch="UniformToFill"/>

                                                    <TextBlock Text="{Binding Caption}"
                                                               VerticalAlignment="Bottom"
                                                               Background="#88000000"
                                                               Foreground="White"
                                                               FontSize="8"
                                                               Padding="2"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Caption}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Caption}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button VerticalAlignment="Top"
                                                            HorizontalAlignment="Right"
                                                            Content="&#x2715;"
                                                            FontSize="8"
                                                            Width="16"
                                                            Height="16"
                                                            Margin="2"
                                                            Background="#88000000"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ListBox x:Name="PhotosList"
                                     ItemsSource="{Binding Photos}"
                                     SelectedIndex="0"
                                     Visibility="Collapsed"/>

                            <TextBlock Text="Key Stats"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <DataGrid x:Name="StatsGrid"
                                      ItemsSource="{Binding Stats}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      Margin="0,0,0,8"
                                      MaxHeight="150">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Label"
                                                        Binding="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Value"
                                                        Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Add"
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="0,0,8,0"
                                        Click="AddStat_Click"/>
                                <Button Content="Remove"
                                        Style="{StaticResource Button.Secondary}"
                                        Click="RemoveStat_Click"/>
                            </StackPanel>

                            <TextBlock Text="Notes"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinLines="3"
                                     Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Add Project"
                                        Style="{StaticResource Button.Primary}"
                                        Padding="14,8"
                                        Command="{Binding AddProjectCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Projects in this Brochure"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Projects.Count, Mode=OneWay, StringFormat= ({0} projects)}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Bottom"
                                           Margin="6,0,0,1"/>
                            </StackPanel>

                            <TextBlock Text="No projects added yet. Fill in the details above and click Add Project."
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontStyle="Italic"
                                       FontSize="10"
                                       TextAlignment="Center"
                                       Margin="20,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Projects.Count, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Projects}" AlternationCount="12">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Projects.Count, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type brochure:BrochureProject}">
                                        <Border BorderBrush="#E7E6E6"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource ProjectIndexConverter}}"
                                                           Foreground="{StaticResource Brand.Accent.Brush}"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Top"/>

                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="{StaticResource Text.Primary}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding ProjectName}"/>
                                                        <Run Text=" &#x2014; "/>
                                                        <Run Text="{Binding SectionLabel}" Foreground="{StaticResource Text.Secondary}" FontWeight="Normal"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Foreground="{StaticResource Brand.Accent.Brush}"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Remove" TextDecorations="Underline"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ListBox ItemsSource="{Binding Projects}"
                                     SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Ready to produce"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6">
                            <Run Text="{Binding Projects.Count, Mode=OneWay}"/>
                            <Run Text=" project(s)"/>
                        </TextBlock>

                        <TextBlock Text="Add at least one project"
                                   Foreground="{StaticResource Brand.Accent.Brush}"
                                   FontStyle="Italic"
                                   FontSize="10"
                                   Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Projects.Count, Mode=OneWay}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ContentControl Grid.Row="1"
                                Content="{Binding SelectedProject}"
                                Visibility="Collapsed"/>

                <Button Grid.Row="2"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding CanProduce}"
                        Command="{Binding ProduceBrochureCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                            <Setter Property="Content" Value="Produce Brochure"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                    <Setter Property="Content" Value="Generating..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
