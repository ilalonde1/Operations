<UserControl x:Class="Kor.Operations.GeneralTools.BrochureContentStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kor.Operations.GeneralTools"
             Background="Transparent">
    <UserControl.Resources>
        <local:ProjectPageBreakAfterConverter x:Key="ProjectPageBreakAfterConverter" />
        <local:ReferenceEqualsMultiConverter x:Key="ReferenceEqualsMultiConverter" />
    </UserControl.Resources>
    <Border Style="{StaticResource Card}"
            Padding="22"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1.5"
                              Opacity="0.12"
                              BlurRadius="7"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Editing:"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Blocks, Mode=OneWay}"
                          SelectedIndex="{Binding SelectedBlockIndex, Mode=TwoWay}"
                          MinHeight="34">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="3"
                                        Padding="2,8"
                                        MinWidth="78"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrandNavy}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BlockType}" Value="Section">
                                                    <Setter Property="Background" Value="{StaticResource BrandOrange}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BlockType}" Value="Personnel">
                                                    <Setter Property="Background" Value="{StaticResource CorporateBlue}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BlockType}" Value="PageBreak">
                                                    <Setter Property="Background" Value="{StaticResource NeutralGray}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10"
                                               FontWeight="Bold"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="CONTACT"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="Section">
                                                        <Setter Property="Text" Value="SECTION"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="Personnel">
                                                        <Setter Property="Text" Value="PEOPLE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="CompanyOverview">
                                                        <Setter Property="Text" Value="OVERVIEW"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="PageBreak">
                                                        <Setter Property="Text" Value="BREAK"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Section.Heading}"
                                               FontSize="13"
                                               Foreground="{StaticResource BrandNavy}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="Section">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Personnel Page"
                                               FontSize="13"
                                               Foreground="{StaticResource BrandNavy}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="Personnel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Company Overview"
                                               FontSize="13"
                                               Foreground="{StaticResource BrandNavy}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="CompanyOverview">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Contact Page"
                                               FontSize="13"
                                               Foreground="{StaticResource BrandNavy}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="Contact">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="— Page Break —"
                                               FontSize="13"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource Text.Secondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="PageBreak">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid x:Name="Step3ContentHost">
                <TextBlock Text="Select a block above to edit its content, or go back to Structure to add blocks."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="24">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedBlock}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid x:Name="SectionEditorPanel">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedBlock.BlockType}" Value="Section">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBox Text="{Binding SelectedBlock.Section.Heading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource BrandNavy}"
                                     BorderBrush="{StaticResource NeutralGray}"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     MinHeight="34"/>
                            <Grid Margin="0,6,0,0">
                                <TextBox x:Name="SectionBlurbEditor"
                                         Text="{Binding SelectedBlock.Section.Blurb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11"
                                         Foreground="{StaticResource Text.Secondary}"
                                         BorderBrush="{StaticResource NeutralGray}"
                                         BorderThickness="1"
                                         Padding="8,6"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="58"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Add a short section blurb"
                                           Margin="12,8,0,0"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource Text.Secondary}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SectionBlurbEditor}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <Rectangle Height="1"
                                   Margin="0,12"
                                   Fill="{StaticResource NeutralGray}"/>
                        <Button Content="+ Insert Page Break"
                                Padding="10,6"
                                Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12"
                                Command="{Binding AddPageBreakCommand}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="{StaticResource NeutralGray}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="0"
                                    Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ProjectItemsControl"
                                                      ItemsSource="{Binding SelectedBlock.Section.Projects, FallbackValue={x:Null}}"
                                                      AlternationCount="1000"
                                                      AllowDrop="True"
                                                      Drop="ProjectItems_Drop">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10,8"
                                                            Background="Transparent"
                                                            BorderBrush="{StaticResource NeutralGray}"
                                                            BorderThickness="0,0,0,0.5"
                                                            DragEnter="ProjectItems_DragEnter"
                                                            DragLeave="ProjectItems_DragLeave">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                                                         Path="DataContext.SelectedProject"/>
                                                                                <Binding />
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Background" Value="#FFF8EAE5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="&#x2261;"
                                                                       FontSize="14"
                                                                       Foreground="{StaticResource LabelGray}"
                                                                       Cursor="SizeAll"
                                                                       Margin="0,0,8,0"
                                                                       VerticalAlignment="Center"
                                                                       PreviewMouseMove="ProjectDragHandle_MouseMove"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ProjectName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource BrandNavy}"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,0,8,0"/>

                                                            <Button Grid.Column="2"
                                                                    Content="↵ break"
                                                                    Padding="8,4"
                                                                    Margin="0,0,8,0"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.InsertProjectPageBreakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                <Button.CommandParameter>
                                                                    <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}"
                                                                             Path="(ItemsControl.AlternationIndex)"/>
                                                                </Button.CommandParameter>
                                                                <Button.Tag>
                                                                    <MultiBinding Converter="{StaticResource ProjectPageBreakAfterConverter}">
                                                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                                                 Path="DataContext.SelectedBlock.Section.PageBreakAfterProjectIndex"/>
                                                                        <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}"
                                                                                 Path="(ItemsControl.AlternationIndex)"/>
                                                                    </MultiBinding>
                                                                </Button.Tag>
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource BrandOrange}"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>

                                                            <Button Grid.Column="3"
                                                                    Content="Edit"
                                                                    Margin="0,0,4,0"
                                                                    Padding="4,2"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Foreground="{StaticResource Text.Primary}"
                                                                    Click="ProjectTab_Click"/>

                                                            <Button Grid.Column="4"
                                                                    Content="Remove"
                                                                    Padding="4,2"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    BorderBrush="Transparent"
                                                                    Foreground="{StaticResource Text.Primary}"
                                                                    Command="{Binding DataContext.RemoveProjectFromSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border Grid.Row="1"
                                            BorderBrush="{StaticResource NeutralGray}"
                                            BorderThickness="0,1,0,0"
                                            Padding="10">
                                        <Button Content="+ Add Project"
                                                Padding="10,6"
                                                Style="{StaticResource Button.Secondary}"
                                                HorizontalAlignment="Left"
                                                Click="NewProject_Click"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Rectangle Grid.Column="1"
                                       Fill="{StaticResource NeutralGray}"
                                       Width="1"
                                       Margin="0,0,12,0"/>
                            <Grid Grid.Column="2">
                                <Border x:Name="ProjectEditorEmptyState"
                                        BorderBrush="{StaticResource NeutralGray}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Background="#FAFBFC">
                                    <TextBlock Text="Select a project to edit or click + Add Project"
                                               FontSize="12"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource Text.Secondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Border x:Name="ProjectEditorForm"
                                        Visibility="Collapsed"
                                        BorderBrush="{StaticResource NeutralGray}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        MinWidth="300">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,12"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrandNavy}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="New Project"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingProject}" Value="True">
                                                            <Setter Property="Text" Value="Edit Project"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="0,0,6,12">
                                                <TextBlock Text="Project name"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding Project.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="32"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="6,0,0,12">
                                                <TextBlock Text="Client"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding Project.Client, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="32"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,0,0,12">
                                                <TextBlock Text="Description"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding Project.ProjectDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         MinLines="5"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2"
                                                        Grid.Column="0"
                                                        Margin="0,0,6,12">
                                                <TextBlock Text="Architect"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding Project.Architect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="32"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2"
                                                        Grid.Column="1"
                                                        Margin="6,0,0,12">
                                                <TextBlock Text="Photo"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Project.Photos.Count, Mode=OneWay}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Content="Add Photo..."
                                                            Style="{StaticResource Button.Secondary}"
                                                            Click="AddPhoto_Click"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Project.Photos.Count, Mode=OneWay}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Border Width="64"
                                                            Height="48"
                                                            CornerRadius="8"
                                                            Background="{StaticResource NeutralGray}"
                                                            ClipToBounds="True"
                                                            Margin="0,0,8,0">
                                                        <Image Source="{Binding Project.Photos[0].FilePath, Converter={StaticResource ImagePathConverter}}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Button Content="Change"
                                                            Style="{StaticResource Button.Secondary}"
                                                            Margin="0,0,8,0"
                                                            Click="AddPhoto_Click"/>
                                                    <Button Content="&#x2715;"
                                                            Width="28"
                                                            Height="28"
                                                            Style="{StaticResource Button.Secondary}"
                                                            Click="RemovePhoto_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Border BorderBrush="{StaticResource NeutralGray}"
                                                BorderThickness="0,1,0,0"
                                                Margin="0,4,0,0"
                                                Padding="0,12,0,0">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                            <Button Content="Add Project"
                                                    Command="{Binding AddProjectCommand}"
                                                    Click="ProjectFormAction_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditingProject}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Cancel"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding CancelEditCommand}"
                                                    Click="ProjectFormAction_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditingProject}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Save Changes"
                                                    Command="{Binding SaveEditCommand}"
                                                    Click="ProjectFormAction_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditingProject}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PersonnelEditorPanel">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedBlock.BlockType}" Value="Personnel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <ItemsControl x:Name="PersonItemsControl"
                                      ItemsSource="{Binding SelectedBlock.People, FallbackValue={x:Null}}"
                                      AllowDrop="True"
                                      Drop="PersonItems_Drop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource NeutralGray}"
                                            BorderThickness="0,0,0,0.5"
                                            Padding="0,8"
                                            DragEnter="PersonItems_DragEnter"
                                            DragLeave="PersonItems_DragLeave">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="&#x2261;"
                                                       FontSize="14"
                                                       Foreground="{StaticResource LabelGray}"
                                                       Cursor="SizeAll"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       PreviewMouseMove="PersonDragHandle_MouseMove"/>
                                            <Border Width="40"
                                                    Height="40"
                                                    CornerRadius="4"
                                                    Background="{StaticResource NeutralGray}"
                                                    ClipToBounds="True"
                                                    Margin="0,0,10,0"
                                                    Grid.Column="1">
                                                <Image Source="{Binding PhotoPath, Converter={StaticResource ImagePathConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrandNavy}"/>
                                                <TextBlock Text="{Binding Credentials}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                            </StackPanel>
                                            <Button Grid.Column="3"
                                                    Content="Edit"
                                                    Margin="8,0,4,0"
                                                    Click="EditPersonButton_Click"/>
                                            <Button Grid.Column="4"
                                                    Content="Remove"
                                                    Foreground="{StaticResource Text.Primary}"
                                                    BorderThickness="0"
                                                    BorderBrush="Transparent"
                                                    Command="{Binding DataContext.RemovePersonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add person"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource Button.Secondary}"
                                Click="AddPersonButton_Click"/>
                        <Border x:Name="PersonForm"
                                Margin="0,16,0,0"
                                Padding="12"
                                BorderBrush="{StaticResource NeutralGray}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Name"
                                               FontSize="12"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Person.PersonName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Credentials"
                                               FontSize="12"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Person.PersonCredentials, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Bio"
                                               FontSize="12"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Person.PersonBio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             MinLines="4"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Photo"
                                               FontSize="12"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="64"
                                                Height="48"
                                                CornerRadius="8"
                                                Background="{StaticResource NeutralGray}"
                                                ClipToBounds="True"
                                                Margin="0,0,8,0">
                                            <Image Source="{Binding Person.PersonPhotoPath, Converter={StaticResource ImagePathConverter}}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <Button Content="Browse..."
                                                Style="{StaticResource Button.Secondary}"
                                                Command="{Binding PickPersonPhotoCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Add Person"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding AddPersonToBlockCommand}"
                                        CommandParameter="{Binding SelectedBlock}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="OverviewEditorPanel">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedBlock.BlockType}" Value="CompanyOverview">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <ItemsControl x:Name="OverviewItemsControl"
                                      ItemsSource="{Binding SelectedBlock.OverviewSections, FallbackValue={x:Null}}"
                                      AlternationCount="1000"
                                      AllowDrop="True"
                                      Drop="OverviewItems_Drop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource NeutralGray}"
                                            BorderThickness="0,0,0,0.5"
                                            Padding="0,8"
                                            DragEnter="OverviewItems_DragEnter"
                                            DragLeave="OverviewItems_DragLeave">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="&#x2261;"
                                                       FontSize="14"
                                                       Foreground="{StaticResource LabelGray}"
                                                       Cursor="SizeAll"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       PreviewMouseMove="OverviewDragHandle_MouseMove"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Heading}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrandNavy}"/>
                                                <TextBlock Text="{Binding Body}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="↵ break"
                                                    Padding="8,4"
                                                    Margin="8,0,8,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.InsertOverviewPageBreakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.CommandParameter>
                                                    <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}"
                                                             Path="(ItemsControl.AlternationIndex)"/>
                                                </Button.CommandParameter>
                                                <Button.Tag>
                                                    <MultiBinding Converter="{StaticResource ProjectPageBreakAfterConverter}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                                 Path="DataContext.SelectedBlock.PageBreakAfterOverviewIndex"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}"
                                                                 Path="(ItemsControl.AlternationIndex)"/>
                                                    </MultiBinding>
                                                </Button.Tag>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrandOrange}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Content="Remove"
                                                    Foreground="{StaticResource Text.Primary}"
                                                    BorderThickness="0"
                                                    BorderBrush="Transparent"
                                                    Command="{Binding DataContext.RemoveOverviewSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,16,0,0"
                                Padding="12"
                                BorderBrush="{StaticResource NeutralGray}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Heading"
                                               FontSize="12"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Overview.OverviewHeading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Body"
                                               FontSize="12"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Overview.OverviewBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             MinLines="4"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                                <Button Content="Add Section"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding AddOverviewSectionCommand}"
                                        CommandParameter="{Binding SelectedBlock}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ContactEditorPanel">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedBlock.BlockType}" Value="Contact">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border BorderBrush="{StaticResource NeutralGray}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Contact details are auto-generated from the KOR template."
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="Vancouver" FontWeight="SemiBold" Foreground="{StaticResource BrandNavy}"/>
                            <TextBlock Text="John Markulin" Margin="0,2,0,10" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Text="Vancouver Island" FontWeight="SemiBold" Foreground="{StaticResource BrandNavy}"/>
                            <TextBlock Text="Rory Beirne" Margin="0,2,0,10" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Text="Okanagan" FontWeight="SemiBold" Foreground="{StaticResource BrandNavy}"/>
                            <TextBlock Text="Conor Murtagh" Margin="0,2,0,10" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Text="United States" FontWeight="SemiBold" Foreground="{StaticResource BrandNavy}"/>
                            <TextBlock Text="Jim DesRoches" Margin="0,2,0,0" Foreground="{StaticResource Text.Secondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid x:Name="PageBreakEditorPanel">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedBlock.BlockType}" Value="PageBreak">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border BorderBrush="{StaticResource NeutralGray}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16">
                        <TextBlock Text="This block inserts a page break. The next block will start at the top of a new page. Drag it to reorder."
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Grid>

            <Border Margin="0,16,0,0"
                    Padding="14"
                    Background="#F0F4F8"
                    BorderBrush="#D6E0EA"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="What This Step Does"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Fill in the content for each block. Select a block from the dropdown above to edit its details."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Tips"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,6"/>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="• Section  add projects, photos, and descriptions"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="• Personnel  add team member names, credentials, and bios"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="• Overview  add heading and body text for each overview section"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="• Page Break  no content needed, just positions a break"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>

                    <TextBlock Text="Checklist"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,6"/>
                    <StackPanel>
                        <TextBlock Text="☐ Each Section block has at least one project"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="☐ Each project has a name and description"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="☐ Personnel bios and photos added"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="☐ Overview headings and body text filled in"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>

