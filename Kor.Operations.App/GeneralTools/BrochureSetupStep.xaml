<UserControl x:Class="Kor.Operations.GeneralTools.BrochureSetupStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="Transparent">
    <UserControl.Resources>
        <x:Array x:Key="TemplateOptions" Type="{x:Type sys:String}">
            <sys:String>Corporate Profile</sys:String>
            <sys:String>Project Showcase</sys:String>
            <sys:String>Regional Overview</sys:String>
        </x:Array>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}"
            Padding="22"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1.5"
                              Opacity="0.12"
                              BlurRadius="7"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Brochure Setup"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}"
                       Margin="0,0,0,16"/>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Template"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{StaticResource TemplateOptions}"
                          SelectedItem="{Binding Cover.TemplateName, Mode=TwoWay}"
                          MinHeight="32"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Cover title"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>
                <Grid>
                    <TextBox x:Name="CoverTitleBox"
                             Text="{Binding Cover.CoverTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"/>
                    <TextBlock Text="e.g. KOR Structural Portfolio 2025"
                               Margin="10,8,0,0"
                               Foreground="{StaticResource Text.Secondary}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CoverTitleBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Cover photo"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Browse..."
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding PickCoverPhotoCommand}"/>
                    <TextBlock Text="(optional)"
                               Margin="10,8,0,0"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="80"
                            Height="56"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Background="#F0F0F0">
                        <Image Source="{Binding Cover.CoverPhotoPath, Converter={StaticResource ImagePathConverter}}"
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Cover.CoverPhotoPath, Converter={StaticResource FileNameFromPathConverter}}"
                               Margin="10,20,8,0"
                               MaxWidth="150"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="&#x2715;"
                            Width="24"
                            Height="24"
                            Margin="0,16,8,0"
                            Command="{Binding ClearCoverPhotoCommand}"/>
                    <Button Content="Change..."
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,12,0,0"
                            Command="{Binding PickCoverPhotoCommand}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6">
                    <Run Text="Opacity"/>
                    <Run Text="  "/>
                    <Run Text="{Binding Cover.CoverPhotoOpacity, StringFormat={}{0:P0}, Mode=OneWay}"/>
                </TextBlock>
                <Slider Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="False"
                        TickPlacement="BottomRight"
                        SmallChange="0.05"
                        Value="{Binding Cover.CoverPhotoOpacity, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Cover year"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="80"
                             Text="{Binding Cover.CoverYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="(leave blank for current year)"
                               Margin="8,8,0,0"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

