<UserControl x:Class="Kor.Operations.GeneralTools.BrochureSetupStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Style="{StaticResource Card}"
            Padding="22"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1.5"
                              Opacity="0.12"
                              BlurRadius="7"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Brochure Setup"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}"
                       Margin="0,0,0,16"/>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Visual Style"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding SkinOptions}"
                          SelectedItem="{Binding SelectedSkinDisplayName, Mode=TwoWay}"
                          MinHeight="32"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Layout"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding LayoutOptions}"
                          SelectedItem="{Binding SelectedLayoutDisplayName, Mode=TwoWay}"
                          MinHeight="32"/>
            </StackPanel>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="12"
                        Background="#F8FAFC"
                        BorderBrush="#D6E0EA"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Visual Style Preview"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}"
                                   Margin="0,0,0,8"/>
                        <Border Height="170"
                                Background="White"
                                BorderBrush="#DCE4EC"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding VisualStylePreviewImage}"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Preview unavailable"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VisualStylePreviewImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="12"
                        Background="#F8FAFC"
                        BorderBrush="#D6E0EA"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Layout Preview"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}"
                                   Margin="0,0,0,8"/>
                        <Border Height="170"
                                Background="White"
                                BorderBrush="#DCE4EC"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding LayoutPreviewImage}"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Preview unavailable"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutPreviewImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Cover title"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>
                <Grid>
                    <TextBox x:Name="CoverTitleBox"
                             Text="{Binding Cover.CoverTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"/>
                    <TextBlock Text="e.g. KOR Structural Portfolio 2025"
                               Margin="10,8,0,0"
                               Foreground="{StaticResource Text.Secondary}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CoverTitleBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Cover photo"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Browse..."
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding PickCoverPhotoCommand}"/>
                    <TextBlock Text="(optional)"
                               Margin="10,8,0,0"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="80"
                            Height="56"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Background="#F0F0F0">
                        <Image Source="{Binding Cover.CoverPhotoPath, Converter={StaticResource ImagePathConverter}}"
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Cover.CoverPhotoPath, Converter={StaticResource FileNameFromPathConverter}}"
                               Margin="10,20,8,0"
                               MaxWidth="150"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="&#x2715;"
                            Width="24"
                            Height="24"
                            Margin="0,16,8,0"
                            Command="{Binding ClearCoverPhotoCommand}"/>
                    <Button Content="Change..."
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,12,0,0"
                            Command="{Binding PickCoverPhotoCommand}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Cover.CoverPhotoPath}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6">
                    <Run Text="Opacity"/>
                    <Run Text="  "/>
                    <Run Text="{Binding Cover.CoverPhotoOpacity, StringFormat={}{0:P0}, Mode=OneWay}"/>
                </TextBlock>
                <Slider Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="False"
                        TickPlacement="BottomRight"
                        SmallChange="0.05"
                        Value="{Binding Cover.CoverPhotoOpacity, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Margin="0,16,0,16">
                <TextBlock Text="Header logo"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Browse..."
                            Padding="10,6"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding PickLogoCommand}"/>
                    <Button Content="Browse cover logo (white)..."
                            Padding="10,6"
                            Margin="8,0,0,0"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding PickCoverLogoCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding ContactConfig.LogoPath}"
                           FontSize="11"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Brand colors (optional  overrides the selected skin)"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Primary color"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource NeutralGray}">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Cover.PrimaryColorOverride, Converter={StaticResource HexToColorConverter}, ConverterParameter=#435363}"/>
                                </Border.Background>
                            </Border>
                            <TextBox Text="{Binding Cover.PrimaryColorOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Accent color"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource NeutralGray}">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Cover.AccentColorOverride, Converter={StaticResource HexToColorConverter}, ConverterParameter=#FF5C36}"/>
                                </Border.Background>
                            </Border>
                            <TextBox Text="{Binding Cover.AccentColorOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Margin="0,16,0,0"
                    Padding="14"
                    Background="#F0F4F8"
                    BorderBrush="#D6E0EA"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="What This Step Does"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Set up your brochure template and cover. The cover title and photo will appear on the first page of your document."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Tips"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,6"/>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="• Visual Style  Colors, fonts, and header treatment"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="• Layout  Page structure, project display, and personnel format"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="• Cover title  Leave blank to use the template name as the title"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="• Cover photo  Optional. Not used by Executive Summary layout. Use a high-resolution landscape image for best results"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>

                    <TextBlock Text="Checklist"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,6"/>
                    <StackPanel>
                        <TextBlock Text="☐ Visual style selected"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="☐ Layout selected"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="☐ A cover title (or leave blank for default)"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="☐ A cover photo (optional)"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>

