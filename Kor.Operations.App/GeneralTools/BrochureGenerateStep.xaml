<UserControl x:Class="Kor.Operations.GeneralTools.BrochureGenerateStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Style="{StaticResource Card}"
            Padding="22"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1.5"
                              Opacity="0.12"
                              BlurRadius="7"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock FontSize="14"
                       Foreground="{StaticResource Text.Primary}">
                <Run Text="{Binding Blocks.Count, Mode=OneWay}"/>
                <Run Text=" blocks  "/>
                <Run Text="{Binding TotalProjectCount, Mode=OneWay}"/>
                <Run Text=" projects  ~"/>
                <Run Text="{Binding EstimatedPageCount, Mode=OneWay}"/>
                <Run Text=" pages"/>
            </TextBlock>

            <TextBlock Margin="0,6,0,0"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="{StaticResource Text.Secondary}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}    {1}">
                        <Binding Path="SelectedSkinDisplayName" Mode="OneWay"/>
                        <Binding Path="SelectedLayoutDisplayName" Mode="OneWay"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Text="Add at least one section with a project before generating"
                       Margin="0,8,0,0"
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="{StaticResource BrandOrange}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalProjectCount, Mode=OneWay}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Rectangle Height="1"
                       Margin="0,16"
                       Fill="{StaticResource NeutralGray}"/>

            <Button Height="52"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ProduceBrochureCommand}"
                    Margin="0,20,0,0"
                    IsEnabled="{Binding CanProduce, Mode=OneWay}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource Brand.Primary.Brush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Content" Value="Produce Brochure"/>
                    <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                <Setter Property="Content" Value="Generating..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Style="{StaticResource Button.Secondary}"
                    Command="{Binding ExportDocxCommand}"
                    Content="Export to Word"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"/>

            <TextBlock Text="PDF will open automatically when complete"
                       Margin="0,10,0,0"
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <Border Margin="0,16,0,0"
                    Padding="14"
                    Background="#F0F4F8"
                    BorderBrush="#D6E0EA"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="What This Step Does"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Review your brochure summary and generate the PDF. The document will open automatically when complete."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Tips"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,6"/>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="• Check the block and project counts match what you expect"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="• Make sure at least one project exists before generating"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="• The PDF is saved to your documents folder"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>

                    <TextBlock Text="Checklist"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,6"/>
                    <StackPanel>
                        <TextBlock Text="☐ Block count looks correct"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="☐ At least one project added"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="☐ Cover title set in Step 1"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="☐ Ready to generate"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#667085"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>

