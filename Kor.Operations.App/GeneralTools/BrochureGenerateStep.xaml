<UserControl x:Class="Kor.Operations.GeneralTools.BrochureGenerateStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Style="{StaticResource Card}"
            Padding="20">
        <StackPanel>
            <TextBlock FontSize="14"
                       Foreground="#435363">
                <Run Text="{Binding Blocks.Count, Mode=OneWay}"/>
                <Run Text=" blocks  "/>
                <Run Text="{Binding TotalProjectCount, Mode=OneWay}"/>
                <Run Text=" projects  ~"/>
                <Run Text="{Binding EstimatedPageCount, Mode=OneWay}"/>
                <Run Text=" pages"/>
            </TextBlock>

            <TextBlock Text="{Binding TemplateName, Mode=OneWay}"
                       Margin="0,6,0,0"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="{StaticResource Text.Secondary}"/>

            <TextBlock Text="Add at least one section with a project before generating"
                       Margin="0,8,0,0"
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="#FF5C36">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalProjectCount, Mode=OneWay}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Rectangle Height="1"
                       Margin="0,16"
                       Fill="#E7E6E6"/>

            <Button Height="48"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ProduceBrochureCommand}"
                    IsEnabled="{Binding CanProduce, Mode=OneWay}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#435363"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Content" Value="Produce Brochure"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                <Setter Property="Content" Value="Generating..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Text="PDF will open automatically when complete"
                       Margin="0,10,0,0"
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
