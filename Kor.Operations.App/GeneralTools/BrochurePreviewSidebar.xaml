<UserControl x:Class="Kor.Operations.GeneralTools.BrochurePreviewSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border BorderBrush="#E7E6E6"
            BorderThickness="0.5,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12"
                    BorderBrush="#E7E6E6"
                    BorderThickness="0,0,0,0.5">
                <TextBlock FontSize="11"
                           Foreground="{StaticResource Text.Secondary}">
                    <Run Text="{Binding Blocks.Count, Mode=OneWay}"/>
                    <Run Text=" blocks"/>
                </TextBlock>
            </Border>

            <Grid Grid.Row="1">
                <TextBlock Text="Generate a brochure to&#x0a;see a preview here"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{StaticResource Text.Secondary}"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding PreviewPages, Mode=OneWay}"
                                  AlternationCount="1000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E7E6E6"
                                        BorderThickness="0.5"
                                        CornerRadius="2"
                                        Margin="8,4">
                                    <StackPanel>
                                        <Image Source="{Binding}"
                                               Margin="8"
                                               Stretch="Uniform"/>
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"
                                                   Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AddOneConverter}, StringFormat=Page {0}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Padding="12"
                    BorderBrush="#E7E6E6"
                    BorderThickness="0,0.5,0,0">
                <Button HorizontalAlignment="Stretch"
                        Command="{Binding ProduceBrochureCommand}"
                        IsEnabled="{Binding CanProduce, Mode=OneWay}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#435363"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Content" Value="Produce Brochure"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                    <Setter Property="Content" Value="Generating..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
