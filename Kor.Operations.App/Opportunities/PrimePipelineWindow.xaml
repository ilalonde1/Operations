<Window x:Class="Kor.Operations.App.Opportunities.PrimePipelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:bd="clr-namespace:Kor.Operations.App.BusinessDevelopment.Workspace"
        Title="Prime Pipeline"
        Width="1400"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <bd:BarHeightConverter x:Key="BarHeight" MaxHeight="120"/>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="{StaticResource Text.Secondary}"/>
        </Style>

        <!-- 2026-10-13: the pipeline charts and tiles moved here from the BD
             dashboard. ONE bar template serves all four charts (the dashboard
             carried four copies of it); the tooltip text is pre-formatted by
             PipelineCharts so counts and dollars share it. A bar click narrows
             the grid below. -->
        <Style x:Key="Chart.BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="HorizontalBars">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="ChartBarTemplate">
            <Grid Width="48" Margin="4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Style="{StaticResource Chart.BarButton}"
                        Tag="{Binding Label}"
                        Click="Bar_Click"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center">
                    <Border Background="{StaticResource Brand.Primary.Brush}"
                            CornerRadius="3,3,0,0"
                            Width="22">
                        <Border.ToolTip>
                            <TextBlock>
                                <Run Text="{Binding Label, Mode=OneWay}"/>
                                <Run Text=": "/>
                                <Run Text="{Binding Display, Mode=OneWay}"/>
                            </TextBlock>
                        </Border.ToolTip>
                        <Border.Height>
                            <MultiBinding Converter="{StaticResource BarHeight}">
                                <Binding Path="Value"/>
                                <Binding Path="Max"/>
                            </MultiBinding>
                        </Border.Height>
                    </Border>
                </Button>
                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="9"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource Text.Secondary}"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brand.Primary.Brush}"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="Prime Pipeline"
                            SubtitleText="Open RFPs + pipeline projects"
                            AvatarDiameter="64"
                            AvatarBorderThickness="2"/>

        <Border Grid.Row="1" Margin="12,0,12,8" Padding="10,6" Background="{StaticResource App.Background}" CornerRadius="4">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Search:" Margin="0,4,8,0" FontWeight="SemiBold"/>
                    <TextBox Width="300" Margin="0,0,12,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Searches project, buyer/owner, sector, and architect"/>

                    <TextBlock Text="Type:" Margin="0,4,4,0"/>
                    <ComboBox Width="150" Margin="0,0,12,0"
                              ItemsSource="{Binding PipelineTypeFilterOptions}"
                              SelectedItem="{Binding PipelineTypeFilter}"/>

                    <TextBlock Text="Province:" Margin="0,4,4,0"/>
                    <ComboBox Width="120" Margin="0,0,12,0"
                              ItemsSource="{Binding ProvinceFilterOptions}"
                              SelectedItem="{Binding ProvinceFilter}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding HeaderCountLabel}"
                           Margin="16,4,0,0"
                           Foreground="{StaticResource Text.Secondary}"
                           FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Overview: the whole pipeline's counts and charts. Collapsed by default so
             the list stays the point of this window; expand when you want the shape. -->
        <Expander Grid.Row="2" Margin="12,0,12,8" IsExpanded="False">
            <Expander.Header>
                <TextBlock FontWeight="SemiBold">
                    <Run Text="Overview"/>
                    <Run Text="  counts and charts for the whole pipeline · click a bar to filter the list" FontWeight="Normal" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                </TextBlock>
            </Expander.Header>
            <StackPanel Margin="0,8,0,0">
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource ChartCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Overview.TotalPipelineDisplay}" Style="{StaticResource TileNumber}"/>
                            <TextBlock Text="Total pipeline" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Overview.OpenRfpsDisplay}" Style="{StaticResource TileNumber}"/>
                            <TextBlock Text="Open RFPs" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Overview.UpcomingProjectsDisplay}" Style="{StaticResource TileNumber}"/>
                            <TextBlock Text="Upcoming projects" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding Overview.PipelineValueDisplay}" Style="{StaticResource TileNumber}"/>
                            <TextBlock Text="Pipeline value (CAD)" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="{Binding Overview.PipelineValueNote}" TextWrapping="Wrap" FontSize="11" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="4" Height="210" Margin="0,8,0,0">
                    <Border Style="{StaticResource ChartCard}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="By sector" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Overview.SectorBars}"
                                              ItemsPanel="{StaticResource HorizontalBars}"
                                              ItemTemplate="{StaticResource ChartBarTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="By market" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Overview.MarketBars}"
                                              ItemsPanel="{StaticResource HorizontalBars}"
                                              ItemTemplate="{StaticResource ChartBarTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="By stage" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Overview.StageBars}"
                                              ItemsPanel="{StaticResource HorizontalBars}"
                                              ItemTemplate="{StaticResource ChartBarTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}" Margin="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Value by market (CAD $M)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Overview.MarketValueBars}"
                                              ItemsPanel="{StaticResource HorizontalBars}"
                                              ItemTemplate="{StaticResource ChartBarTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Expander>

        <Grid Grid.Row="3" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      ItemsSource="{Binding FilteredPrimePipelineView}"
                      SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Type" Width="116" SortMemberPath="PipelineType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}"
                                        Background="{StaticResource CorporateBlue}"
                                        HorizontalAlignment="Left"
                                        Margin="0">
                                    <TextBlock Text="{Binding PipelineType}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Project" Width="*" SortMemberPath="ProjectName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasNoSourceUrl, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSourceUrl, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <Hyperlink NavigateUri="{Binding SourceUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                            <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Buyer / owner" Binding="{Binding BuyerOrOwner}" Width="190"/>
                    <DataGridTextColumn Header="Sector" Binding="{Binding Sector}" Width="120"/>
                    <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="130"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding CostDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="80"/>
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120"/>
                    <DataGridTextColumn Header="Architect" Binding="{Binding ArchitectName}" Width="170"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource Panel.Border}"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Background="White" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding Selected.ProjectName}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>

                        <WrapPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource Chip}" Background="{StaticResource CorporateBlue}">
                                <TextBlock Text="{Binding Selected.PipelineType}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{StaticResource Risk.HighConfidence.Foreground}">
                                <TextBlock Text="{Binding Selected.Province}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="11"/>
                            </Border>
                        </WrapPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source ref" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.SourceRef}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Buyer / owner" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.BuyerOrOwner}" FontWeight="SemiBold" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sector" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Sector}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Stage" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.Stage}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Estimated value" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.CostDisplay}" FontWeight="SemiBold" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Location" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Selected.LocationDisplay}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Architect" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Selected.ArchitectName}" FontWeight="SemiBold" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Source" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1"
                                       Style="{StaticResource DetailValue}"
                                       Visibility="{Binding HasSelectedSourceUrl, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <Hyperlink NavigateUri="{Binding Selected.SourceUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                    <Run Text="Open source"/>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="4" Padding="12,6" Background="{Binding StatusBrush}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12"/>
        </Border>
    </Grid>
</Window>
