<Window x:Class="Kor.Operations.App.Opportunities.CompetitionInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Competition Info"
        Width="1500" Height="850" WindowStartupLocation="CenterOwner">
    <TabControl>
        <TabItem Header="Historical RFPs">
            <Grid DataContext="{Binding Rfps}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F4F4F6" Padding="10">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Keyword" FontSize="11" Foreground="#666"/>
                                <TextBox Width="240" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Year" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="100" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Province" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="80" ItemsSource="{Binding Provinces}" SelectedItem="{Binding SelectedProvince}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Status" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="120" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Min Est. Value" FontSize="11" Foreground="#666"/>
                                <TextBox Width="120" Text="{Binding MinEstimatedValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Bottom">
                                <CheckBox Content="Has downloaded docs" IsChecked="{Binding HasDocumentsOnly}"/>
                            </StackPanel>
                            <Button Content="Apply" Width="80" Height="26" VerticalAlignment="Bottom"
                                    Command="{Binding ApplyCommand}"/>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#F4F4F6" Padding="10,6">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#444"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" RowHeight="24" HeadersVisibility="Column"
                              AlternatingRowBackground="#FAFAFA" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding OpportunityKey}" Width="180"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Buyer" Binding="{Binding BuyerName}" Width="250"/>
                            <DataGridTextColumn Header="Province" Binding="{Binding ProjectProvince}" Width="60"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding HistoricalStatus}" Width="90"/>
                            <DataGridTextColumn Header="RFP Date" Binding="{Binding RfpReleaseDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="Closes" Binding="{Binding SubmissionDeadlineUtc, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="Est. Value" Binding="{Binding EstimatedValue, StringFormat=C0}" Width="100"/>
                            <DataGridTextColumn Header="Amends" Binding="{Binding AmendmentCount}" Width="65"/>
                            <DataGridTextColumn Header="Awarded To" Binding="{Binding AwardedToOrganization}" Width="200"/>
                            <DataGridTextColumn Header="Awarded $" Binding="{Binding AwardedValue, StringFormat=C0}" Width="100"/>
                            <DataGridTextColumn Header="Docs" Binding="{Binding DocumentCount}" Width="55"/>
                            <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadedDocumentCount}" Width="85"/>
                            <DataGridTextColumn Header="Commodities" Binding="{Binding Commodities}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Awards">
            <Grid DataContext="{Binding Awards}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F4F4F6" Padding="10">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Keyword (title/buyer/winner)" FontSize="11" Foreground="#666"/>
                                <TextBox Width="240" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Winner (vendor name)" FontSize="11" Foreground="#666"/>
                                <TextBox Width="200" Text="{Binding Vendor, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Year" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="100" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Source" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="200" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Min Contract $" FontSize="11" Foreground="#666"/>
                                <TextBox Width="120" Text="{Binding MinContractValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            </StackPanel>
                            <Button Content="Apply" Width="80" Height="26" VerticalAlignment="Bottom"
                                    Command="{Binding ApplyCommand}"/>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#F4F4F6" Padding="10,6">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#444"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" RowHeight="24" HeadersVisibility="Column"
                              AlternatingRowBackground="#FAFAFA" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Awarded Date" Binding="{Binding AwardedAtUtc, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Buyer" Binding="{Binding AwardingOrganization}" Width="220"/>
                            <DataGridTextColumn Header="Winner" Binding="{Binding AwardedToOrganization}" Width="220"/>
                            <DataGridTextColumn Header="Contract $" Binding="{Binding ContractValue, StringFormat=C0}" Width="120"/>
                            <DataGridTextColumn Header="Currency" Binding="{Binding ContractCurrency}" Width="65"/>
                            <DataGridTextColumn Header="RFP Ref" Binding="{Binding ExternalReference}" Width="120"/>
                            <DataGridTextColumn Header="Contract #" Binding="{Binding ContractNumber}" Width="120"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="160"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding SolicitationType}" Width="120"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding IssuingLocation}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
