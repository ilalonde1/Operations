<Window x:Class="Kor.Operations.App.Opportunities.KorPursuitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to KOR Pursuits"
        Width="640" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Log a KOR pursuit on this opportunity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Stage" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding AllStages}" SelectedItem="{Binding Stage, Mode=TwoWay}" Margin="0,0,0,10"/>

                <TextBlock Text="Buyer name (auto-filled)" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                <TextBox Text="{Binding BuyerName, Mode=TwoWay}" Margin="0,0,0,10"/>

                <TextBlock Text="Title (auto-filled)" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                <TextBox Text="{Binding Title, Mode=TwoWay}" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="48"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Bid fee (KOR's submitted)" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding BidFee, Mode=TwoWay, StringFormat=N2, TargetNullValue=''}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Currency" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                        <ComboBox SelectedValue="{Binding BidCurrency, Mode=TwoWay}" SelectedValuePath="Content">
                            <ComboBoxItem Content="CAD"/>
                            <ComboBoxItem Content="USD"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Estimated construction value" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                <TextBox Text="{Binding EstConstructionValue, Mode=TwoWay, StringFormat=N2, TargetNullValue=''}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="KOR role" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding AllRoles}" SelectedItem="{Binding OurRole, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pursuit opened" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                        <DatePicker SelectedDate="{Binding PursuitOpenedDate, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Due date" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                        <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Submitted date" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                        <DatePicker SelectedDate="{Binding SubmittedDate, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="BD lead (KOR)" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                <TextBox Text="{Binding KorBusinessDeveloper, Mode=TwoWay}" Margin="0,0,0,10"/>

                <TextBlock Text="Proposal manager (KOR)" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                <TextBox Text="{Binding KorProposalManager, Mode=TwoWay}" Margin="0,0,0,10"/>

                <TextBlock Text="KOR strengths on this pursuit" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                <TextBox Text="{Binding Strengths, Mode=TwoWay}" Margin="0,0,0,10"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="56"/>

                <TextBlock Text="KOR weaknesses on this pursuit" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                <TextBox Text="{Binding Weaknesses, Mode=TwoWay}" Margin="0,0,0,10"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="56"/>

                <TextBlock Text="Notes" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                <TextBox Text="{Binding Notes, Mode=TwoWay}" Margin="0,0,0,10"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="56"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancel_Click"/>
            <Button Content="Save pursuit" Width="120" Click="OnSave_Click" IsDefault="True" Background="#2563EB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
