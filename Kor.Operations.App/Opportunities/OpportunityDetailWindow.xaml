<Window x:Class="Kor.Operations.App.Opportunities.OpportunityDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="RFP"
        Width="1100" Height="760" WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:KorHeader x:Name="HeaderBar" Grid.Row="0"
                                Margin="2,0,2,8"
                                HeaderText="{Binding Name}"
                                SubtitleText="{Binding BuyerName}"
                                AvatarDiameter="96" AvatarBorderThickness="2"/>

            <!-- The three things a reader wants first: the posting, the clock, the record's state. -->
            <Border Grid.Row="1" Background="{StaticResource App.Background}" Padding="14" Margin="8,0,8,8" CornerRadius="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open source posting"
                                Click="OpenPosting_Click"
                                IsEnabled="{Binding HasPrimaryUrl}"
                                Padding="14,6" Margin="0,0,8,0"
                                Style="{StaticResource Button.Primary}" FontWeight="SemiBold"/>
                        <Button Content="Edit record…" Click="Edit_Click" Padding="14,6" Margin="0,0,8,0"/>
                        <Button Content="Close" Click="Close_Click" Padding="14,6"/>
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,28,6">
                            <TextBlock Text="Closes" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding ClosesDisplay}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,6">
                            <TextBlock Text="Posted" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding PostedDisplay}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,6">
                            <TextBlock Text="Value" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding ValueDisplay}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,6">
                            <TextBlock Text="Location" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding LocationDisplay}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,6">
                            <TextBlock Text="Status" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,6">
                            <TextBlock Text="Owner" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding OwnerDisplay}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,6">
                            <TextBlock Text="Fit" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding FitDisplay}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,6">
                            <TextBlock Text="Sector" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding SectorDisplay}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Key" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding Key}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="8,0,8,8">
                <StackPanel>
                    <TextBlock Text="What the posting says" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="8,0,8,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Source postings" FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Sources}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                              AlternatingRowBackground="#FAFAFA" MaxHeight="260" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="170"/>
                            <DataGridTextColumn Header="Posted" Binding="{Binding Posted}" Width="130"/>
                            <DataGridTextColumn Header="Title as posted" Binding="{Binding Title}" Width="*"/>
                            <DataGridTemplateColumn Header="Link" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <Hyperlink Click="Link_Click" Tag="{Binding Url}">open</Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="4" Margin="22,0,8,12" FontSize="11" Foreground="#888"
                       Text="This is KOR's record of the RFP. 'Edit record…' changes our fields (owner, value, deadline, notes); it never changes the posting."/>
        </Grid>
    </ScrollViewer>
</Window>
