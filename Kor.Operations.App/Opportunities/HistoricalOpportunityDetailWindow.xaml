<Window x:Class="Kor.Operations.App.Opportunities.HistoricalOpportunityDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:local="clr-namespace:Kor.Operations.App.Opportunities"
        Title="Opportunity Detail"
        Width="1200" Height="800" WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <local:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:KorHeader x:Name="HeaderBar" Grid.Row="0"
                                Margin="2,0,2,8"
                                HeaderText="{Binding Detail.Name}"
                                SubtitleText="{Binding Detail.BuyerName}"
                                AvatarDiameter="96" AvatarBorderThickness="2"/>

            <Border Grid.Row="1" Background="{StaticResource App.Background}" Padding="14" Margin="8,0,8,8" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="ID" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding Detail.OpportunityKey}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Status" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding Detail.HistoricalStatus}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="RFP Date" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding Detail.RfpReleaseDate, StringFormat=yyyy-MM-dd}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Closes" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding Detail.SubmissionDeadlineUtc, StringFormat=yyyy-MM-dd}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Est. Value" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding Detail.EstimatedValue, StringFormat=C0}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Amendments" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding Detail.AmendmentCount}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Awarded To" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding Detail.AwardedToOrganization}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="Add to KOR Pursuits"
                            Click="AddToPursuits_Click"
                            Margin="28,0,0,0"
                            Padding="14,6"
                            Style="{StaticResource Button.Primary}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="8,0,8,8">
                <StackPanel>
                    <TextBlock Text="Description" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Detail.Commodities}" FontSize="12" Foreground="#666" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail.FullDescription}" TextWrapping="Wrap" FontSize="12.5"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="8,0,8,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Documents" FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding DocumentSummary}" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="11" Foreground="#666" Margin="0,6,0,0"/>
                    <DataGrid ItemsSource="{Binding Documents}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                              AlternatingRowBackground="#FAFAFA"
                              MinHeight="200" MaxHeight="500"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="Content-Type" Binding="{Binding ContentType}" Width="160"/>
                            <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Open"
                                                Padding="10,2"
                                                Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding LocalPath, Converter={StaticResource NullToBoolConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
