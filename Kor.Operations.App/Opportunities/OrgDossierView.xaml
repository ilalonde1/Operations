<UserControl x:Class="Kor.Operations.App.Opportunities.OrgDossierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Kor.Operations.Controls"
             xmlns:local="clr-namespace:Kor.Operations.App.Opportunities"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="OrgDossierView_Loaded"
             Unloaded="OrgDossierView_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:DossierValueKindConverter x:Key="ValueKind"/>
        <local:UrlSplitConverter x:Key="UrlSplit"/>
        <local:CommaSplitConverter x:Key="CommaSplit"/>
        <local:PriorityToBrushConverter x:Key="PriorityBrush"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Panel.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="8,0,8,10"/>
        </Style>

        <!-- Small-caps technical label, slate, less shouty than the old SemiBold. -->
        <!-- Round 56: bumped from 10→11 so the small-caps label reads at the
             same weight as the value text next to it. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,4,10,2"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <!-- Round 56: every value mode (plain / single-url / multi-url / bullet)
             renders at 13px instead of WPF's default 12. The user flagged the
             dossier values as "tiny font" in ss8 — this gets them closer to a
             normal-document feel without making the small-caps labels look weak. -->
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- Research-dossier inner section. White card with a 4px
             Brand.Primary slate accent on the left so each provider block
             reads as its own thing without pulling focus from the page. -->
        <DataTemplate DataType="{x:Type local:DossierSection}">
            <Border Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{StaticResource Brand.Primary.Brush}"
                            CornerRadius="4,0,0,4"/>
                    <Expander Grid.Column="1" Margin="14,8,14,10" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProviderName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brand.Primary.Brush}"/>
                                    <TextBlock Text="{Binding RefreshedAt, StringFormat='  refreshed {0}'}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="8,2,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="12"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Expander.Header>

                        <!-- Field rows: small-caps label + value with three visual modes
                             (plain text, single-URL hyperlink, multi-URL bullet list). -->
                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DossierField}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <!-- Plain text (most fields) -->
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource FieldValue}"
                                                   Text="{Binding Value}"
                                                   Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=Plain}"/>

                                        <!-- Single URL -> Hyperlink (Website, Source Url, etc.) -->
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource FieldValue}"
                                                   Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=SingleUrl}">
                                            <Hyperlink NavigateUri="{Binding Value}"
                                                       RequestNavigate="OnHyperlinkRequestNavigate"
                                                       Foreground="{StaticResource CorporateBlue}">
                                                <Run Text="{Binding Value, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>

                                        <!-- Multi URL -> bullet list of hyperlinks (Source Urls with two/three links) -->
                                        <ItemsControl Grid.Column="1"
                                                      Margin="0,3"
                                                      ItemsSource="{Binding Value, Converter={StaticResource UrlSplit}}"
                                                      Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=MultiUrl}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
                                                        <Run Text="•  " Foreground="{StaticResource Text.Secondary}"/>
                                                        <Hyperlink NavigateUri="{Binding}"
                                                                   RequestNavigate="OnHyperlinkRequestNavigate"
                                                                   Foreground="{StaticResource CorporateBlue}">
                                                            <Run Text="{Binding Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Sectors / comma-list -> chip row -->
                                        <ItemsControl Grid.Column="1"
                                                      Margin="0,3,0,3"
                                                      ItemsSource="{Binding Value, Converter={StaticResource CommaSplit}}"
                                                      Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=ChipList}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource App.Background}"
                                                            BorderBrush="{StaticResource Panel.Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="999"
                                                            Padding="8,2"
                                                            Margin="0,2,4,2">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Text.Primary}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Person / partner row -> bullet -->
                                        <TextBlock Grid.Column="1"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3"
                                                   Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=Bullet}">
                                            <Run Text="•  " Foreground="{StaticResource CorporateBlue}" FontWeight="Bold"/>
                                            <Run Text="{Binding Value, Mode=OneWay}"/>
                                        </TextBlock>

                                        <!-- Priority / status -> colored pill -->
                                        <Border Grid.Column="1"
                                                Background="{Binding Value, Converter={StaticResource PriorityBrush}}"
                                                CornerRadius="999"
                                                Padding="10,3"
                                                Margin="0,3"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=PriorityChip}">
                                            <TextBlock Text="{Binding Value}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Typography.Capitals="AllSmallCaps"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Border Background="{StaticResource CorporateBlue}" CornerRadius="999" Padding="8,3" Margin="14,2,0,0" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Margin="0,0,28,4" Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Website" FontSize="10" Foreground="#666"/>
                                <TextBlock>
                                    <Hyperlink NavigateUri="{Binding Website}" RequestNavigate="OnHyperlinkRequestNavigate">
                                        <Run Text="{Binding Website, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,4" Visibility="{Binding HasClendorClientId, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Clendor Client ID" FontSize="10" Foreground="#666"/>
                                <TextBlock Text="{Binding ClendorClientId}" FontSize="12.5"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Notes" FontSize="10" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasAtAGlance, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="AT A GLANCE"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brand.Primary.Brush}"
                                   Typography.Capitals="AllSmallCaps"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="HQ"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasHqCity, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding AtAGlance.HqCity}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasHqCity, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Sectors"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasSectors, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding AtAGlance.SectorsDisplay}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasSectors, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Key people"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasKeyPeople, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding AtAGlance.KeyPeopleDisplay}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasKeyPeople, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="BC Registry"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasRegistryStatus, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding AtAGlance.RegistryDisplay}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasRegistryStatus, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="Last KOR"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasLastKorEngagement, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding AtAGlance.LastKorEngagementUtc, StringFormat={}{0:yyyy-MM-dd}}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasLastKorEngagement, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0"
                                       Text="KOR projs"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasKorProjects, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{Binding AtAGlance.KorProjectsCount, StringFormat={}{0:N0}}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasKorProjects, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasDeltekSnapshot, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Deltek snapshot" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding DeltekSnapshot.ErrorMessage}"
                                   Style="{StaticResource FieldValue}"
                                   Foreground="#8A3A3A"
                                   Visibility="{Binding DeltekSnapshot.HasError, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Visibility="{Binding DeltekSnapshot.HasNoError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldValue}" Margin="0,0,0,8">
                                <Run Text="Deltek client "/>
                                <Run Text="{Binding DeltekSnapshot.ClientId, Mode=OneWay}"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding DeltekSnapshot.ClientName, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldValue}"
                                       Visibility="{Binding DeltekSnapshot.HasProjects, Converter={StaticResource BoolToVis}}">
                                <Run Text="Lifetime billed: "/>
                                <Run Text="{Binding DeltekSnapshot.LifetimeFee, StringFormat={}{0:C0}, Mode=OneWay}"/>
                                <Run Text=" across "/>
                                <Run Text="{Binding DeltekSnapshot.ProjectCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                <Run Text=" project(s)"/>
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldValue}"
                                       Visibility="{Binding DeltekSnapshot.HasLatestProject, Converter={StaticResource BoolToVis}}">
                                <Run Text="Latest: "/>
                                <Run Text="{Binding DeltekSnapshot.LatestProjectName, Mode=OneWay}"/>
                                <Run Text=" (opened "/>
                                <Run Text="{Binding DeltekSnapshot.LatestProjectStart, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding DeltekSnapshot.RecentProjects}"
                                          Margin="0,6,0,6"
                                          Visibility="{Binding DeltekSnapshot.HasRecentProjects, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DossierDeltekProject}">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                            <Run Text="•  " Foreground="{StaticResource CorporateBlue}" FontWeight="Bold"/>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding OpenDate, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Status, Mode=OneWay}"/>
                                            <Run Text="  Fee "/>
                                            <Run Text="{Binding Fee, StringFormat={}{0:C0}, Mode=OneWay}"/>
                                            <Run Text="  Billed "/>
                                            <Run Text="{Binding FeeBilled, StringFormat={}{0:C0}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource FieldValue}">
                                <Run Text="{Binding DeltekSnapshot.ContactCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                <Run Text=" Deltek contact(s)"/>
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldValue}"
                                       Visibility="{Binding DeltekSnapshot.HasArOutstanding, Converter={StaticResource BoolToVis}}">
                                <Run Text="AR outstanding: "/>
                                <Run Text="{Binding DeltekSnapshot.ArOutstanding, StringFormat={}{0:C0}, Mode=OneWay}"/>
                                <Run Text=" (90+ days: "/>
                                <Run Text="{Binding DeltekSnapshot.Ar90Plus, StringFormat={}{0:C0}, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>

                            <TextBlock Text="Some Deltek sections were unavailable for this client."
                                       Style="{StaticResource FieldValue}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontStyle="Italic"
                                       Visibility="{Binding DeltekSnapshot.DegradedSections, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Research Dossiers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <!-- DataTemplate for DossierSection is defined in
                             UserControl.Resources so the rendering is the
                             same whether the list is empty or full. -->
                        <ItemsControl ItemsSource="{Binding Sections}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding ProjectFootprintHeader, StringFormat='Project Footprint - {0}'}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Projects}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="24"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Project" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock TextWrapping="Wrap"
                                                           Visibility="{Binding HasAbsoluteSourceUrl, Converter={StaticResource BoolToVis}}">
                                                    <Hyperlink NavigateUri="{Binding SourceUrl}" RequestNavigate="OnHyperlinkRequestNavigate">
                                                        <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ProjectName}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasNoAbsoluteSourceUrl, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="140"/>
                                <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="70"/>
                                <DataGridTextColumn Header="Stage" Binding="{Binding StageDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding CostDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Municipality" Binding="{Binding MunicipalityName}" Width="150"/>
                                <DataGridTextColumn Header="Complete" Binding="{Binding CompletionYear}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasAwards, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="Lifetime award value" FontSize="11" Foreground="#666"/>
                                <TextBlock Text="{Binding LifetimeValue, StringFormat=C0}" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Awards" FontSize="11" Foreground="#666"/>
                                <TextBlock Text="{Binding LifetimeCount}" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding RecentWins}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="24"
                                  MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding AwardedAtUtc, StringFormat=yyyy-MM-dd}" Width="100"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Buyer" Binding="{Binding AwardingOrganization}" Width="220"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding ContractValue, StringFormat=C0}" Width="110"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="12,6" Background="{StaticResource App.Background}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
