<UserControl x:Class="Kor.Operations.App.Opportunities.OrgDossierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Kor.Operations.Controls"
             xmlns:local="clr-namespace:Kor.Operations.App.Opportunities"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="OrgDossierView_Loaded"
             Unloaded="OrgDossierView_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:FalseToVisibilityConverter x:Key="FalseToVis"/>
        <local:IntelTypeLabelConverter x:Key="IntelTypeLabel"/>
        <local:DossierValueKindConverter x:Key="ValueKind"/>
        <local:UrlSplitConverter x:Key="UrlSplit"/>
        <local:NullOrEmptyStringToVisibilityConverter x:Key="EmptyToCollapsed"/>
        <local:CommaSplitConverter x:Key="CommaSplit"/>
        <local:PriorityToBrushConverter x:Key="PriorityBrush"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Panel.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="8,0,8,10"/>
        </Style>

        <!-- 2026-06-12 UX pass: section titles carry the same KOR accent rule
             as the BD report renderers — short underline hugging the text. -->
        <Style x:Key="SectionHeaderRule" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brand.Accent.Brush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0,0,0,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brand.Primary.Brush}"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        </Style>

        <!-- Small-caps technical label, slate, less shouty than the old SemiBold. -->
        <!-- Round 56: bumped from 10→11 so the small-caps label reads at the
             same weight as the value text next to it. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,4,10,2"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <!-- Round 56: every value mode (plain / single-url / multi-url / bullet)
             renders at 13px instead of WPF's default 12. The user flagged the
             dossier values as "tiny font" in ss8 — this gets them closer to a
             normal-document feel without making the small-caps labels look weak. -->
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <Style x:Key="IntelSubhead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brand.Primary.Brush}"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>

        <Style x:Key="IntelItemText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Research-dossier inner section. White card with a 4px
             Brand.Primary slate accent on the left so each provider block
             reads as its own thing without pulling focus from the page. -->
        <DataTemplate DataType="{x:Type local:DossierSection}">
            <Border Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{StaticResource Brand.Primary.Brush}"
                            CornerRadius="4,0,0,4"/>
                    <Expander Grid.Column="1" Margin="14,8,14,10" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProviderName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brand.Primary.Brush}"/>
                                    <TextBlock Text="{Binding RefreshedAt, StringFormat='  refreshed {0}'}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="8,2,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="12"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Expander.Header>

                        <!-- Field rows: small-caps label + value with three visual modes
                             (plain text, single-URL hyperlink, multi-URL bullet list). -->
                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DossierField}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <!-- Plain text (most fields) -->
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource FieldValue}"
                                                   Text="{Binding Value}"
                                                   Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=Plain}"/>

                                        <!-- Single URL -> Hyperlink (Website, Source Url, etc.) -->
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource FieldValue}"
                                                   Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=SingleUrl}">
                                            <Hyperlink NavigateUri="{Binding Value}"
                                                       RequestNavigate="OnHyperlinkRequestNavigate"
                                                       Foreground="{StaticResource CorporateBlue}">
                                                <Run Text="{Binding Value, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>

                                        <!-- Multi URL -> bullet list of hyperlinks (Source Urls with two/three links) -->
                                        <ItemsControl Grid.Column="1"
                                                      Margin="0,3"
                                                      ItemsSource="{Binding Value, Converter={StaticResource UrlSplit}}"
                                                      Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=MultiUrl}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
                                                        <Run Text="•  " Foreground="{StaticResource Text.Secondary}"/>
                                                        <Hyperlink NavigateUri="{Binding}"
                                                                   RequestNavigate="OnHyperlinkRequestNavigate"
                                                                   Foreground="{StaticResource CorporateBlue}">
                                                            <Run Text="{Binding Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Sectors / comma-list -> chip row -->
                                        <ItemsControl Grid.Column="1"
                                                      Margin="0,3,0,3"
                                                      ItemsSource="{Binding Value, Converter={StaticResource CommaSplit}}"
                                                      Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=ChipList}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource App.Background}"
                                                            BorderBrush="{StaticResource Panel.Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="999"
                                                            Padding="8,2"
                                                            Margin="0,2,4,2">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Text.Primary}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Person / partner row -> bullet -->
                                        <TextBlock Grid.Column="1"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3"
                                                   Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=Bullet}">
                                            <Run Text="•  " Foreground="{StaticResource CorporateBlue}" FontWeight="Bold"/>
                                            <Run Text="{Binding Value, Mode=OneWay}"/>
                                        </TextBlock>

                                        <!-- Priority / status -> colored pill -->
                                        <Border Grid.Column="1"
                                                Background="{Binding Value, Converter={StaticResource PriorityBrush}}"
                                                CornerRadius="999"
                                                Padding="10,3"
                                                Margin="0,3"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding Converter={StaticResource ValueKind}, ConverterParameter=PriorityChip}">
                                            <TextBlock Text="{Binding Value}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Typography.Capitals="AllSmallCaps"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasAnyIntel, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SectionHeaderRule}" VerticalAlignment="Center">
                                <TextBlock Text="AT A GLANCE" Style="{StaticResource SectionHeaderText}"/>
                            </Border>
                            <Button Grid.Column="1"
                                    Content="🔄 Refresh now"
                                    Command="{Binding RefreshIntelCommand}"
                                    Padding="8,2"
                                    FontSize="11"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Queues a Sonnet re-research; Worker picks it up within 30s; refresh takes ~6 min. Reload this dossier afterward to see updates."/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding IntelLastRefreshedText}"
                                       FontSize="11"
                                       Visibility="{Binding HasIntelLastRefreshedText, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStaleIntel}" Value="True">
                                                <Setter Property="Foreground" Value="#A03A3A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="{Binding RefreshRequestStatus}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource Brand.Primary.Brush}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasRefreshRequestStatus, Converter={StaticResource BoolToVis}}"/>

                        <!-- Synopsis as a quote-style lede: accent bar, regular
                             (non-italic) type — long italic paragraphs were the
                             top "hard to read" complaint (2026-06-12). -->
                        <Border BorderBrush="{StaticResource Brand.Accent.Brush}"
                                BorderThickness="3,0,0,0"
                                Padding="10,2,0,2"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasAnySynopsis, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SynopsisP1}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="{StaticResource Text.Primary}"
                                           LineHeight="20"
                                           Visibility="{Binding HasSynopsisP1, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding SynopsisP2}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{StaticResource Text.Secondary}"
                                           LineHeight="19"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding HasSynopsisP2, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Recommended actions" Style="{StaticResource IntelSubhead}"/>
                        <TextBlock Text="No recommended actions on file yet."
                                   Style="{StaticResource FieldValue}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Visibility="{Binding HasIntelActions, Converter={StaticResource FalseToVis}}"/>
                        <!-- 2026-06-12 UX pass: each action is a structured row —
                             type pill + target/timing meta line, then the
                             recommendation body — instead of one run-on
                             paragraph (the top dossier readability complaint). -->
                        <ItemsControl ItemsSource="{Binding IntelActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0" Padding="0,7,0,7">
                                        <Border.ToolTip>
                                            <StackPanel>
                                                <!-- Full timing here — the visible meta line truncates long prose. -->
                                                <TextBlock Text="{Binding TimingNotes, StringFormat=Timing: {0}}"
                                                           MaxWidth="480" TextWrapping="Wrap"
                                                           Visibility="{Binding TimingNotes, Converter={StaticResource EmptyToCollapsed}}"/>
                                                <TextBlock>
                                                    <Run Text="Confidence: "/>
                                                    <Run Text="{Binding Confidence, Mode=OneWay}"/>
                                                    <Run Text="  Freshness: "/>
                                                    <Run Text="{Binding Freshness, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RefreshedAtUtc, StringFormat=Refreshed: {0:yyyy-MM-dd HH:mm} UTC}"/>
                                            </StackPanel>
                                        </Border.ToolTip>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Border Background="{StaticResource Brand.Primary.Brush}"
                                                            CornerRadius="999" Padding="8,1" Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ActionType, Converter={StaticResource IntelTypeLabel}, Mode=OneWay}"
                                                                   Foreground="White" FontSize="10" FontWeight="SemiBold"
                                                                   Typography.Capitals="AllSmallCaps"/>
                                                    </Border>
                                                    <!-- Empty fields collapse entirely — no bare "target:" /
                                                         "timing:" labels (Ian, 2026-06-12 ss1). -->
                                                    <TextBlock Text="{Binding TargetPersonName, StringFormat=target: {0}}"
                                                               FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                                               Visibility="{Binding TargetPersonName, Converter={StaticResource EmptyToCollapsed}}"/>
                                                    <TextBlock Text="{Binding TimingNotes, StringFormat=timing: {0}}"
                                                               FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                               Visibility="{Binding TimingNotes, Converter={StaticResource EmptyToCollapsed}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Recommendation}"
                                                           FontSize="12.5"
                                                           LineHeight="18"
                                                           Foreground="{StaticResource Text.Primary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,8,0"/>
                                            </StackPanel>
                                            <!-- R81: KOR-side Status mutation. Removing an action drops it
                                                 from the IntelActions collection; the next dossier load
                                                 also re-queries (read filter is Status='Open'). -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Top">
                                                <Button Content="✓ Done"
                                                        Command="{Binding DataContext.MarkActionDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,1" FontSize="10" Margin="0,0,4,0"
                                                        ToolTip="Mark this action as done (KOR has completed it)."/>
                                                <Button Content="✕ Dismiss"
                                                        Command="{Binding DataContext.MarkActionDismissedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,1" FontSize="10"
                                                        ToolTip="Dismiss this recommendation (KOR has decided not to pursue)."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Key people on file" Style="{StaticResource IntelSubhead}"/>
                        <TextBlock Text="No key people on file yet."
                                   Style="{StaticResource FieldValue}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Visibility="{Binding HasIntelPeople, Converter={StaticResource FalseToVis}}"/>
                        <ItemsControl ItemsSource="{Binding IntelPeople}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <StackPanel.ToolTip>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="Confidence: "/>
                                                    <Run Text="{Binding Confidence, Mode=OneWay}"/>
                                                    <Run Text="  Freshness: "/>
                                                    <Run Text="{Binding Freshness, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RefreshedAtUtc, StringFormat=Refreshed: {0:yyyy-MM-dd HH:mm} UTC}"/>
                                            </StackPanel>
                                        </StackPanel.ToolTip>
                                        <TextBlock Text="•  "
                                                   Foreground="{StaticResource Brand.Primary.Brush}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   VerticalAlignment="Top"/>
                                        <Border Background="#FDECEC"
                                                BorderBrush="#E2A0A0"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource FalseToVis}}">
                                            <TextBlock Text="former"
                                                       Foreground="#A03A3A"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource IntelItemText}">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Recent signals" Style="{StaticResource IntelSubhead}"/>
                        <TextBlock Text="No recent signals tracked."
                                   Style="{StaticResource FieldValue}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Visibility="{Binding HasIntelSignals, Converter={StaticResource FalseToVis}}"/>
                        <ItemsControl ItemsSource="{Binding IntelSignals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Subject leads its own line; detail drops to a
                                         secondary line — no more run-on signal blobs. -->
                                    <StackPanel Margin="0,3">
                                        <StackPanel.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SourceUrl, StringFormat=Source: {0}}"/>
                                                <TextBlock>
                                                    <Run Text="Confidence: "/>
                                                    <Run Text="{Binding Confidence, Mode=OneWay}"/>
                                                    <Run Text="  Freshness: "/>
                                                    <Run Text="{Binding Freshness, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RefreshedAtUtc, StringFormat=Refreshed: {0:yyyy-MM-dd HH:mm} UTC}"/>
                                            </StackPanel>
                                        </StackPanel.ToolTip>
                                        <TextBlock Style="{StaticResource IntelItemText}">
                                            <Run Text="•  " Foreground="{StaticResource Brand.Primary.Brush}" FontWeight="Bold"/>
                                            <Run Text="{Binding SignalType, Converter={StaticResource IntelTypeLabel}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Subject, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="12"
                                                   LineHeight="17"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="14,1,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Their portfolio (from research)" Style="{StaticResource IntelSubhead}"/>
                        <TextBlock Text="No research portfolio entries on file yet."
                                   Style="{StaticResource FieldValue}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Visibility="{Binding HasIntelWorks, Converter={StaticResource FalseToVis}}"/>
                        <ItemsControl ItemsSource="{Binding IntelWorks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource IntelItemText}">
                                        <TextBlock.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Notes}"/>
                                                <TextBlock>
                                                    <Run Text="Confidence: "/>
                                                    <Run Text="{Binding Confidence, Mode=OneWay}"/>
                                                    <Run Text="  Freshness: "/>
                                                    <Run Text="{Binding Freshness, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RefreshedAtUtc, StringFormat=Refreshed: {0:yyyy-MM-dd HH:mm} UTC}"/>
                                            </StackPanel>
                                        </TextBlock.ToolTip>
                                        <Run Text="•  " Foreground="{StaticResource Brand.Primary.Brush}" FontWeight="Bold"/>
                                        <Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Role, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding YearApprox, StringFormat=({0}), Mode=OneWay}" Foreground="{StaticResource Text.Secondary}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding HasIntelRisks, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Risks / vulnerabilities" Style="{StaticResource IntelSubhead}"/>
                            <ItemsControl ItemsSource="{Binding IntelRisks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource IntelItemText}">
                                            <TextBlock.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding MitigationNotes, StringFormat=Mitigation: {0}}"/>
                                                    <TextBlock>
                                                        <Run Text="Confidence: "/>
                                                        <Run Text="{Binding Confidence, Mode=OneWay}"/>
                                                        <Run Text="  Freshness: "/>
                                                        <Run Text="{Binding Freshness, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding RefreshedAtUtc, StringFormat=Refreshed: {0:yyyy-MM-dd HH:mm} UTC}"/>
                                                </StackPanel>
                                            </TextBlock.ToolTip>
                                            <Run Text="•  " Foreground="#A03A3A" FontWeight="Bold"/>
                                            <Run Text="{Binding RiskType, Converter={StaticResource IntelTypeLabel}, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=": "/>
                                            <Run Text="{Binding Description, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Border Background="{StaticResource CorporateBlue}" CornerRadius="999" Padding="8,3" Margin="14,2,0,0" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Margin="0,0,28,4" Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Website" FontSize="10" Foreground="#666"/>
                                <TextBlock>
                                    <Hyperlink NavigateUri="{Binding Website}" RequestNavigate="OnHyperlinkRequestNavigate">
                                        <Run Text="{Binding Website, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,4" Visibility="{Binding HasClendorClientId, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Clendor Client ID" FontSize="10" Foreground="#666"/>
                                <TextBlock Text="{Binding ClendorClientId}" FontSize="12.5"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Notes" FontSize="10" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Displacement Brief - the per-architect BD playbook (incumbent,
                     pipeline, pitch, decision-makers, first move). Synthesized by
                     the KOR-Structural-Partner-Map Sonnet session. Architects only. -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasDisplacementBrief, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SectionHeaderRule}" VerticalAlignment="Center">
                                <TextBlock Text="DISPLACEMENT BRIEF" Style="{StaticResource SectionHeaderText}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Background="{Binding DisplacementBrief.KorPriority, Converter={StaticResource PriorityBrush}}"
                                        CornerRadius="999"
                                        Padding="10,3"
                                        Margin="0,0,6,0"
                                        Visibility="{Binding DisplacementBrief.HasKorPriority, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding DisplacementBrief.KorPriority}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Typography.Capitals="AllSmallCaps"/>
                                </Border>
                                <Border Background="{StaticResource Panel.Border}"
                                        CornerRadius="999"
                                        Padding="10,3"
                                        Margin="0,0,6,0"
                                        Visibility="{Binding DisplacementBrief.HasMarket, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding DisplacementBrief.Market}"
                                               Foreground="{StaticResource Text.Primary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{StaticResource Panel.Border}"
                                        CornerRadius="999"
                                        Padding="10,3"
                                        Visibility="{Binding DisplacementBrief.HasConfidence, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Foreground="{StaticResource Text.Primary}" FontSize="11" FontWeight="SemiBold">
                                        <Run Text="confidence "/>
                                        <Run Text="{Binding DisplacementBrief.ConfidenceDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- The pitch (lead with this) -->
                        <Border Background="#FFF7E6"
                                BorderBrush="#F0C36D"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,10"
                                Margin="0,0,0,10"
                                Visibility="{Binding DisplacementBrief.HasKorDisplacementAngle, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="KOR'S DISPLACEMENT ANGLE"
                                           Typography.Capitals="AllSmallCaps"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#8A5A00"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DisplacementBrief.KorDisplacementAngle}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{StaticResource Text.Primary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Recommended first move -->
                        <Border Background="#EEF6FF"
                                BorderBrush="#A8C8EE"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,10"
                                Margin="0,0,0,10"
                                Visibility="{Binding DisplacementBrief.HasRecommendedFirstMove, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="RECOMMENDED FIRST MOVE"
                                           Typography.Capitals="AllSmallCaps"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CorporateBlue}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DisplacementBrief.RecommendedFirstMove}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{StaticResource Text.Primary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Current structural incumbents (who KOR is displacing) -->
                        <StackPanel Visibility="{Binding DisplacementBrief.HasIncumbents, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,10">
                            <TextBlock Text="Current structural incumbents"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding DisplacementBrief.CurrentStructuralIncumbents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Panel.Border}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,6,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FirmName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Text="{Binding EvidenceDisplay}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           Margin="0,1,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding ExploitableWeakness}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Text.Primary}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasExploitableWeakness, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Architect's active pipeline (the projects to chase) -->
                        <StackPanel Visibility="{Binding DisplacementBrief.HasActivePipeline, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,10">
                            <TextBlock Text="Architect's active pipeline"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding DisplacementBrief.ArchitectActivePipeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Panel.Border}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,6,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text.Primary}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding StageAndRfpLine}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           Margin="0,1,0,0"
                                                           Visibility="{Binding HasStageOrRfp, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding KorFit}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Text.Primary}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasKorFit, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Decision-makers (who at the architect to call) -->
                        <StackPanel Visibility="{Binding DisplacementBrief.HasDecisionMakers, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,10">
                            <TextBlock Text="Decision-makers"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding DisplacementBrief.DecisionMakers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Panel.Border}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,6,0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="13" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text=" — " Foreground="{StaticResource Text.Secondary}"/>
                                                    <Run Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasApproachVia, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="Approach via: "/>
                                                    <Run Text="{Binding ApproachVia, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasPicksStructural, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="Picks structural: "/>
                                                    <Run Text="{Binding PicksStructural, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Verification gaps - warns the user before they act on the brief -->
                        <Border Background="#FFF1F0"
                                BorderBrush="#E2A0A0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,8"
                                Margin="0,0,0,4"
                                Visibility="{Binding DisplacementBrief.HasVerificationGaps, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="VERIFY BEFORE ACTING"
                                           Typography.Capitals="AllSmallCaps"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#A03A3A"
                                           Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding DisplacementBrief.VerificationGaps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text.Primary}" Margin="0,2">
                                                <Run Text="•  " Foreground="#A03A3A"/>
                                                <Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="10" Foreground="{StaticResource Text.Secondary}" Margin="0,6,0,0">
                            <Run Text="Generated "/>
                            <Run Text="{Binding DisplacementBrief.GeneratedAtUtc, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasAtAGlance, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderRule}" Margin="0,0,0,10">
                            <TextBlock Text="AT A GLANCE" Style="{StaticResource SectionHeaderText}"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="HQ"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasHqCity, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding AtAGlance.HqCity}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasHqCity, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Sectors"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasSectors, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding AtAGlance.SectorsDisplay}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasSectors, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Key people"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasKeyPeople, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding AtAGlance.KeyPeopleDisplay}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasKeyPeople, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="BC Registry"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasRegistryStatus, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding AtAGlance.RegistryDisplay}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasRegistryStatus, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="Last KOR"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasLastKorEngagement, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding AtAGlance.LastKorEngagementUtc, StringFormat={}{0:yyyy-MM-dd}}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasLastKorEngagement, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0"
                                       Text="KOR projs"
                                       Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding AtAGlance.HasKorProjects, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{Binding AtAGlance.KorProjectsCount, StringFormat={}{0:N0}}"
                                       Style="{StaticResource FieldValue}"
                                       Visibility="{Binding AtAGlance.HasKorProjects, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasDeltekSnapshot, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderRule}" Margin="0,0,0,10">
                            <TextBlock Text="DELTEK SNAPSHOT" Style="{StaticResource SectionHeaderText}"/>
                        </Border>

                        <TextBlock Text="{Binding DeltekSnapshot.ErrorMessage}"
                                   Style="{StaticResource FieldValue}"
                                   Foreground="#8A3A3A"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding DeltekSnapshot.HasError, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Visibility="{Binding DeltekSnapshot.HasNoError, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Client"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource FieldValue}">
                                    <Run Text="{Binding DeltekSnapshot.ClientId, Mode=OneWay}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding DeltekSnapshot.ClientName, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Lifetime billed"
                                           Style="{StaticResource FieldLabel}"
                                           Visibility="{Binding DeltekSnapshot.HasProjects, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource FieldValue}"
                                           Visibility="{Binding DeltekSnapshot.HasProjects, Converter={StaticResource BoolToVis}}">
                                    <Run Text="{Binding DeltekSnapshot.LifetimeFee, StringFormat={}{0:C0}, Mode=OneWay}"/>
                                    <Run Text=" across "/>
                                    <Run Text="{Binding DeltekSnapshot.ProjectCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                    <Run Text=" project(s)"/>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Latest"
                                           Style="{StaticResource FieldLabel}"
                                           Visibility="{Binding DeltekSnapshot.HasLatestProject, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Style="{StaticResource FieldValue}"
                                           Visibility="{Binding DeltekSnapshot.HasLatestProject, Converter={StaticResource BoolToVis}}">
                                    <Run Text="{Binding DeltekSnapshot.LatestProjectName, Mode=OneWay}"/>
                                    <Run Text=" (opened "/>
                                    <Run Text="{Binding DeltekSnapshot.LatestProjectStart, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Contacts"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding DeltekSnapshot.ContactCount, StringFormat={}{0:N0}, Mode=OneWay}"
                                           Style="{StaticResource FieldValue}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="AR outstanding"
                                           Style="{StaticResource FieldLabel}"
                                           Visibility="{Binding DeltekSnapshot.HasArOutstanding, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Style="{StaticResource FieldValue}"
                                           Visibility="{Binding DeltekSnapshot.HasArOutstanding, Converter={StaticResource BoolToVis}}">
                                    <Run Text="{Binding DeltekSnapshot.ArOutstanding, StringFormat={}{0:C0}, Mode=OneWay}"/>
                                    <Run Text=" (90+ days: "/>
                                    <Run Text="{Binding DeltekSnapshot.Ar90Plus, StringFormat={}{0:C0}, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="Recent projects"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,12,0,4"
                                       Visibility="{Binding DeltekSnapshot.HasRecentProjects, Converter={StaticResource BoolToVis}}"/>
                            <DataGrid ItemsSource="{Binding DeltekSnapshot.RecentProjects}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeight="22"
                                      MaxHeight="180"
                                      Visibility="{Binding DeltekSnapshot.HasRecentProjects, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Opened" Binding="{Binding OpenDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                    <DataGridTextColumn Header="Fee" Binding="{Binding Fee, StringFormat={}{0:C0}}" Width="110"/>
                                    <DataGridTextColumn Header="Billed" Binding="{Binding FeeBilled, StringFormat={}{0:C0}}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Some Deltek sections were unavailable for this client."
                                       Style="{StaticResource FieldValue}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontStyle="Italic"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding DeltekSnapshot.DegradedSections, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Expander Header="Raw research sources (debug view)"
                          IsExpanded="False"
                          Margin="8,0,8,10"
                          Foreground="{StaticResource Brand.Primary.Brush}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Research Dossiers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <!-- DataTemplate for DossierSection is defined in
                                     UserControl.Resources so the rendering is the
                                     same whether the list is empty or full. -->
                                <ItemsControl ItemsSource="{Binding Sections}"/>
                            </StackPanel>
                        </Border>

                <Border Style="{StaticResource SectionCard}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding ProjectFootprintHeader, StringFormat='Project Footprint - {0}'}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Projects}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="24"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Project" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock TextWrapping="Wrap"
                                                           Visibility="{Binding HasAbsoluteSourceUrl, Converter={StaticResource BoolToVis}}">
                                                    <Hyperlink NavigateUri="{Binding SourceUrl}" RequestNavigate="OnHyperlinkRequestNavigate">
                                                        <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ProjectName}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasNoAbsoluteSourceUrl, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="140"/>
                                <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="70"/>
                                <DataGridTextColumn Header="Stage" Binding="{Binding StageDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding CostDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Municipality" Binding="{Binding MunicipalityName}" Width="150"/>
                                <DataGridTextColumn Header="Complete" Binding="{Binding CompletionYear}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasAwards, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="Lifetime award value" FontSize="11" Foreground="#666"/>
                                <TextBlock Text="{Binding LifetimeValue, StringFormat=C0}" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Awards" FontSize="11" Foreground="#666"/>
                                <TextBlock Text="{Binding LifetimeCount}" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding RecentWins}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="24"
                                  MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding AwardedAtUtc, StringFormat=yyyy-MM-dd}" Width="100"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Buyer" Binding="{Binding AwardingOrganization}" Width="220"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding ContractValue, StringFormat=C0}" Width="110"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="12,6" Background="{StaticResource App.Background}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
