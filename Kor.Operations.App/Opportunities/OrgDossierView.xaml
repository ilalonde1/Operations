<UserControl x:Class="Kor.Operations.App.Opportunities.OrgDossierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Kor.Operations.Controls"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="OrgDossierView_Loaded"
             Unloaded="OrgDossierView_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="8,0,8,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,2,10,2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Border Background="{StaticResource CorporateBlue}" CornerRadius="999" Padding="8,3" Margin="14,2,0,0" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Margin="0,0,28,4" Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Website" FontSize="10" Foreground="#666"/>
                                <TextBlock>
                                    <Hyperlink NavigateUri="{Binding Website}" RequestNavigate="OnHyperlinkRequestNavigate">
                                        <Run Text="{Binding Website, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,4" Visibility="{Binding HasClendorClientId, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Clendor Client ID" FontSize="10" Foreground="#666"/>
                                <TextBlock Text="{Binding ClendorClientId}" FontSize="12.5"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Notes" FontSize="10" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Research Dossiers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#DDE5EC" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding RefreshedAt, StringFormat='  refreshed {0}'}"
                                                           Foreground="#666"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="190"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Margin="0,2"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding ProjectFootprintHeader, StringFormat='Project Footprint - {0}'}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Projects}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="24"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Project" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock TextWrapping="Wrap"
                                                           Visibility="{Binding HasAbsoluteSourceUrl, Converter={StaticResource BoolToVis}}">
                                                    <Hyperlink NavigateUri="{Binding SourceUrl}" RequestNavigate="OnHyperlinkRequestNavigate">
                                                        <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ProjectName}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasNoAbsoluteSourceUrl, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="140"/>
                                <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="70"/>
                                <DataGridTextColumn Header="Stage" Binding="{Binding StageDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding CostDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Municipality" Binding="{Binding MunicipalityName}" Width="150"/>
                                <DataGridTextColumn Header="Complete" Binding="{Binding CompletionYear}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasAwards, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="Lifetime award value" FontSize="11" Foreground="#666"/>
                                <TextBlock Text="{Binding LifetimeValue, StringFormat=C0}" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Awards" FontSize="11" Foreground="#666"/>
                                <TextBlock Text="{Binding LifetimeCount}" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding RecentWins}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="24"
                                  MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding AwardedAtUtc, StringFormat=yyyy-MM-dd}" Width="100"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Buyer" Binding="{Binding AwardingOrganization}" Width="220"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding ContractValue, StringFormat=C0}" Width="110"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="12,6" Background="{StaticResource App.Background}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
