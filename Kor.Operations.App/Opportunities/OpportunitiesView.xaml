<UserControl x:Class="Kor.Operations.App.Opportunities.OpportunitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Kor.Operations.Controls"
             xmlns:local="clr-namespace:Kor.Operations.App.Opportunities"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="OpportunitiesView_Loaded"
             Unloaded="OpportunitiesView_Unloaded">
    <UserControl.Resources>
        <local:NullableToAllConverter x:Key="NullableToAllConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heartbeat strip. Background tinted by VM-supplied brush so a stale
             worker is loud, not subtle. -->
        <Border Grid.Row="1" Margin="12,0,12,8" Padding="14,8"
                Background="{Binding HeartbeatBrush}">
            <TextBlock Text="{Binding HeartbeatLine}"
                       Foreground="White"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Action bar. Refresh, New, Edit, status transitions, ingestion. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,8">
            <Button Content="Refresh"  Width="100" Margin="0,0,8,0" Click="RefreshButton_Click"/>
            <Button Content="New"      Width="100" Margin="0,0,8,0" Click="NewButton_Click"
                    Background="{StaticResource Brand.Primary.Brush}" Foreground="White"/>
            <Button Content="Edit…"    Width="100" Margin="0,0,8,0" Click="EditButton_Click"/>
            <Button Content="Scoring…" Width="100" Margin="0,0,8,0" Click="ScoringButton_Click"/>
            <Button x:Name="PromoteToPursuitButton"
                    Content="Promote to Pursuit"
                    Width="140"
                    Margin="0,0,8,0"
                    Click="PromoteToPursuitButton_Click"
                    ToolTip="Create a Pursuit (engagement) from the selected opportunity, or open the existing one."/>

            <Button x:Name="GenerateBriefButton"
                    Content="Generate Brief"
                    Width="130"
                    Margin="0,0,8,0"
                    Click="GenerateBriefButton_Click"
                    ToolTip="Generate a one-page Word pursuit brief for the selected opportunity (saved to Desktop)."/>

            <Button x:Name="ClientIntelligenceButton"
                    Content="Client Intelligence"
                    Width="160"
                    Margin="0,0,8,0"
                    Click="ClientIntelligenceButton_Click"
                    ToolTip="Open the Deltek client intelligence window for the selected opportunity. Disabled when the row has no Deltek client link."/>

            <Button x:Name="RunNowButton"
                    Content="Run Source ▾"
                    Width="130"
                    Margin="0,0,16,0"
                    Click="RunNowButton_Click"
                    ToolTip="Queue an ingestion run for any enabled source. Worker picks up within ~30s.">
                <Button.ContextMenu>
                    <ContextMenu x:Name="RunNowMenu"/>
                </Button.ContextMenu>
            </Button>

            <Button x:Name="IngestionRunsButton"
                    Content="Ingestion Runs"
                    Width="140"
                    Margin="0,0,16,0"
                    Click="IngestionRunsButton_Click"
                    ToolTip="Open the recent-runs viewer. Refresh-on-demand. Shows what the Worker actually executed."/>

            <Separator Margin="0,4,16,4"/>

            <Button x:Name="MoveToButton" Content="Move to" Width="100" Margin="0,0,8,0"
                    Click="MoveToButton_Click"
                    ToolTip="Change the status of the selected opportunity.">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New"        Click="StatusMenuItem_Click" Tag="New"/>
                        <MenuItem Header="Pursuing"   Click="StatusMenuItem_Click" Tag="Pursuing"/>
                        <MenuItem Header="Submitted"  Click="StatusMenuItem_Click" Tag="Submitted"/>
                        <MenuItem Header="Won"        Click="StatusMenuItem_Click" Tag="Won"/>
                        <MenuItem Header="Lost"       Click="StatusMenuItem_Click" Tag="Lost"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>

        <!-- Filter ribbon -->
        <Border Grid.Row="3" Margin="12,0,12,8" Padding="10,6" Background="#F0F0F2" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter:" Margin="0,4,8,0" FontWeight="SemiBold"/>
                <TextBox Width="240" Margin="0,0,12,0"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Searches name, key, buyer, city, province"/>

                <TextBlock Text="Status:" Margin="0,4,4,0"/>
                <ComboBox Width="140" Margin="0,0,12,0"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding StatusFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullableToAllConverter}, FallbackValue=All}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Tier:" Margin="0,4,4,0"/>
                <ComboBox Width="120" Margin="0,0,12,0"
                          ItemsSource="{Binding TierFilterOptions}"
                          SelectedItem="{Binding TierFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullableToAllConverter}, FallbackValue=All}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Province:" Margin="0,4,4,0"/>
                <ComboBox Width="100" Margin="0,0,12,0"
                          ItemsSource="{Binding ProvinceFilterOptions}"
                          SelectedItem="{Binding ProvinceFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullableToAllConverter}, FallbackValue=All}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="Prime-Consultant RFPs only"
                          IsChecked="{Binding PrimeConsultantOnly}"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main split: opportunities (left) + selected opportunity detail (right) -->
        <Grid Grid.Row="4" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      x:Name="OpportunitiesGrid"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      ItemsSource="{Binding FilteredOpportunitiesView}"
                      SelectedItem="{Binding Selected}"
                      MouseDoubleClick="OpportunitiesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Repeat" Width="70" SortMemberPath="IsRepeatClient">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1F7A1F" CornerRadius="999"
                                        Margin="2" Padding="6,2" HorizontalAlignment="Left"
                                        Visibility="{Binding IsRepeatClient, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <TextBlock Text="Repeat" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tier" Width="90" SortMemberPath="TierDisplay">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding TierBrush}" CornerRadius="999"
                                        Margin="2" Padding="6,2,6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding TierDisplay}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Score"         Binding="{Binding ScoreDisplay}"          Width="60"/>
                    <DataGridTemplateColumn Header="Source" Width="120" SortMemberPath="SourceDisplay">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceDisplay}"
                                           ToolTip="{Binding OpportunityKey}"
                                           VerticalAlignment="Center"
                                           Padding="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Prime" Width="70" SortMemberPath="IsPrimeConsultantRfp">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#3B6E8F" CornerRadius="999"
                                        Margin="2" Padding="6,2" HorizontalAlignment="Left"
                                        Visibility="{Binding IsPrimeConsultantRfp, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <TextBlock Text="Prime" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name"          Binding="{Binding Name}"                  Width="*"/>
                    <DataGridTextColumn Header="Buyer"         Binding="{Binding BuyerName}"             Width="220"/>
                    <DataGridTextColumn Header="Status"        Binding="{Binding Status}"                Width="120"/>
                    <DataGridTextColumn Header="Discipline"    Binding="{Binding Discipline}"            Width="100"/>
                    <DataGridTextColumn Header="Value"         Binding="{Binding EstimatedValueDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Deadline"      Binding="{Binding DeadlineDisplay}"       Width="100"/>
                    <DataGridTextColumn Header="Owner"         Binding="{Binding OwnerStaffId}"          Width="80"/>
                    <DataGridTextColumn Header="Updated"       Binding="{Binding UpdatedAtDisplay}"      Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#D0D0D2" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Width="420" Background="White" Padding="14" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <!-- Header: project name -->
                        <TextBlock Text="{Binding Selected.Name}"
                                   FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Selected.OpportunityKey}"
                                   FontSize="11" Foreground="#506070" Margin="0,0,0,10"/>

                        <!-- Chips: Tier / Score / Status -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="{Binding Selected.TierBrush}" CornerRadius="999" Padding="8,3" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Selected.TierDisplay}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                            <Border Background="#506070" CornerRadius="999" Padding="8,3" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Selected.ScoreDisplay, StringFormat='Score {0}'}" Foreground="White" FontSize="11"/>
                            </Border>
                            <Border Background="#1E5BA8" CornerRadius="999" Padding="8,3">
                                <TextBlock Text="{Binding Selected.Model.Status}" Foreground="White" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <!-- Score breakdown collapsed by default to keep the panel calm. -->
                        <Expander Header="{Binding ScoreFactorsHeader}" Margin="0,0,0,10"
                                  Visibility="{Binding HasScoreFactors, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <ItemsControl ItemsSource="{Binding SelectedScoreFactors}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DeltaDisplay}"
                                                       FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1F7A1F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                                                <Setter Property="Foreground" Value="#C11E1E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Facts grid -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Buyer" Foreground="#506070" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.BuyerName}" TextWrapping="Wrap" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Location" Foreground="#506070" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.LocationDisplay}" TextWrapping="Wrap" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Value" Foreground="#506070" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.EstimatedValueDisplay}" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Deadline" Foreground="#506070" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.DeadlineDisplay}" Margin="0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Owner" Foreground="#506070" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.OwnerStaffId, TargetNullValue=''}" Margin="0,2"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Prime sector" Foreground="#506070" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Selected.PrimeProjectSector}" Margin="0,2"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Likely prime" Foreground="#506070" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Selected.PrimeLikelyType}" Margin="0,2"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="KOR fit" Foreground="#506070" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Selected.KorFitDisplay}" Margin="0,2"/>
                        </Grid>

                        <!-- Open the original RFP page in the browser -->
                        <Button Content="Open RFP"
                                HorizontalAlignment="Left"
                                Padding="10,4"
                                Margin="0,0,0,12"
                                Click="OpenRfpButton_Click"
                                Visibility="{Binding HasSourceUrl, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                ToolTip="{Binding SelectedSourceUrl}"/>

                        <!-- Description from the freshest linked OpportunityObservation. -->
                        <StackPanel Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                    Margin="0,0,0,12">
                            <TextBlock Text="Description" FontWeight="SemiBold" Foreground="#506070" Margin="0,0,0,4"/>
                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" FontSize="12"/>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- No-engagement state -->
                        <Border Background="#F4F8FB" BorderBrush="#C7D7E2" BorderThickness="1" CornerRadius="3"
                                Padding="10" Margin="0,4,0,0"
                                Visibility="{Binding NoEngagement, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Text="Not yet a Pursuit. Click 'Promote to Pursuit' above to start tracking activity, contacts, and proposal work."
                                       TextWrapping="Wrap" FontSize="11" Foreground="#506070"/>
                        </Border>

                        <!-- Engagement section -->
                        <StackPanel Visibility="{Binding HasEngagement, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="PURSUIT:" FontWeight="SemiBold" Foreground="#506070" Margin="0,3,8,0"/>
                                <Border Background="#1F7A1F" CornerRadius="999" Padding="8,3">
                                    <TextBlock Text="{Binding SelectedEngagementStageDisplay}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Button Content="Open in Pursuits..." Margin="12,0,0,0" Padding="8,3"
                                        Click="OpenInPursuitsButton_Click"
                                        ToolTip="Open the Pursuits window scoped to this engagement."/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Activity log + inline log form -->
                        <TextBlock Text="Activity" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                            <Button x:Name="LogActivityBtn" Content="Log" Width="60" Padding="6,3" DockPanel.Dock="Right"
                                    Click="LogActivityButton_Click"
                                    ToolTip="Log a note against this opportunity. Creates a Pursuit if none exists yet."/>
                            <TextBox x:Name="ActivitySubjectBox" Margin="0,0,6,0" Padding="4,3"
                                     KeyDown="ActivitySubjectBox_KeyDown"
                                     ToolTip="What happened? Hit Enter or click Log."/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SelectedActivities}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E2" BorderThickness="0,0,0,1" Padding="0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OccurredAtUtc, StringFormat='{}{0:yyyy-MM-dd}'}" Foreground="#506070" FontSize="11" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ActivityType}" Foreground="#506070" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Contacts + inline add form -->
                        <TextBlock Text="Contacts" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ContactNameBox" Grid.Column="0" Padding="4,3"
                                     ToolTip="Display name"/>
                            <TextBox x:Name="ContactEmailBox" Grid.Column="2" Padding="4,3"
                                     ToolTip="Email (optional)"/>
                            <Button x:Name="AddContactBtn" Grid.Column="4" Content="Add" Width="60" Padding="6,3"
                                    Click="AddContactButton_Click"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SelectedContacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E2" BorderThickness="0,0,0,1" Padding="0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="*" Foreground="#E5A800" Margin="0,0,4,0"
                                                           Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Role, StringFormat='  {0}'}" Foreground="#506070"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Email}" Foreground="#506070" FontSize="11"/>
                                            <TextBlock Text="{Binding Phone}" Foreground="#506070" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="5" Padding="12,6" Background="#F0F0F2">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
