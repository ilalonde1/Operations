<UserControl x:Class="Kor.Operations.App.Opportunities.MajorProjectsInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kor.Operations.App.Opportunities"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="View_Loaded"
             Unloaded="View_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="{StaticResource Text.Secondary}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Same filter look as Market History: a small label above each field, wrapping on a narrow window. -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,6" Background="{StaticResource App.Background}" CornerRadius="4">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Search" FontSize="11" Foreground="#666"/>
                    <TextBox Width="260"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Searches project, proponent, architect, structural engineer, contractor and municipality"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Show" FontSize="11" Foreground="#666"/>
                    <ComboBox Width="100"
                              ItemsSource="{Binding LifecycleFilterOptions}"
                              SelectedItem="{Binding LifecycleFilter}"
                              ToolTip="Active hides removed projects. Grabbed shows projects someone is pursuing; Removed shows 'not for us' projects with who, when and why. Nothing is deleted."/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Province" FontSize="11" Foreground="#666"/>
                    <ComboBox Width="90" ItemsSource="{Binding ProvinceFilterOptions}" SelectedItem="{Binding ProvinceFilter}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Stage" FontSize="11" Foreground="#666"/>
                    <ComboBox Width="170" ItemsSource="{Binding StageFilterOptions}" SelectedItem="{Binding StageFilter}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Sector" FontSize="11" Foreground="#666"/>
                    <ComboBox Width="170" ItemsSource="{Binding SectorFilterOptions}" SelectedItem="{Binding SectorFilter}"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,4">
                    <TextBlock Text="Min cost ($)" FontSize="11" Foreground="#666"/>
                    <TextBox Width="110" Text="{Binding MinCost, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                </StackPanel>
                <CheckBox Content="KOR markets only" VerticalAlignment="Bottom" Margin="0,0,14,8"
                          IsChecked="{Binding KorMarketsOnly}"
                          ToolTip="Hides wind, hydro and solar projects, roads, tunnels, substations and plant. A transit centre or fire hall filed under Infrastructure still shows."/>
                <CheckBox Content="Indigenous only" VerticalAlignment="Bottom" Margin="0,0,20,8" IsChecked="{Binding IndigenousOnly}"/>
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Attack sheet REF #" FontSize="11" Foreground="#666"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="RefBox" Width="70" Margin="0,0,4,0"
                                 KeyDown="RefBox_KeyDown"
                                 ToolTip="Type a REF # from the attack sheet and press Enter to open that play's dossier."/>
                        <Button Content="Open" Click="OpenRef_Click" Padding="10,2"/>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="10,4"
                Background="{StaticResource App.Background}"
                CornerRadius="4"
                Visibility="{Binding HasFunnelFilter, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Funnel:"
                           FontWeight="SemiBold"
                           Margin="0,4,8,0"/>
                <Border Style="{StaticResource Chip}" Background="#F2855B">
                    <TextBlock Text="{Binding FunnelFilterDisplay}"
                               Foreground="White"
                               FontSize="12"/>
                </Border>
                <TextBlock Margin="6,4,0,0">
                    <Hyperlink Click="ClearFunnel_Click">Clear</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      ItemsSource="{Binding FilteredProjectsView}"
                      SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <!-- The columns a lead reads; contractor, schedule and the rest are on the right when a row is picked.
                         Star widths so the grid fits the window instead of scrolling sideways. -->
                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="3*" MinWidth="220"/>
                    <DataGridTextColumn Header="Prov." Binding="{Binding Province}" Width="52"/>
                    <DataGridTextColumn Header="Stage" Binding="{Binding StageDisplay}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Sector" Binding="{Binding Sector}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="Cost" Binding="{Binding CostDisplay}" Width="110" SortMemberPath="EstimatedCostCad"/>
                    <DataGridTextColumn Header="Municipality" Binding="{Binding MunicipalityName}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="Proponent" Binding="{Binding ProponentName}" Width="1.4*" MinWidth="110"/>
                    <DataGridTextColumn Header="Architect" Binding="{Binding ArchitectName}" Width="1.2*" MinWidth="100"/>
                    <DataGridTextColumn Header="Structural" Binding="{Binding StructuralEngineerName}" Width="1.1*" MinWidth="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Panel.Border}" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Background="White" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding Selected.ProjectName}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource Chip}" Background="{StaticResource CorporateBlue}">
                                <TextBlock Text="{Binding Selected.Province}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{StaticResource Risk.HighConfidence.Foreground}"
                                    Visibility="{Binding Selected.IsIndigenous, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <TextBlock Text="Indigenous" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <!-- Pursuit lifecycle (migration 284): one primary action, plain words. -->
                        <TextBlock Text="{Binding SelectedLifecycleDisplay}"
                                   FontStyle="Italic" Foreground="#8A5A00" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding HasSelectedLifecycleNote, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Grab" Width="90" Margin="0,0,8,0"
                                    Style="{StaticResource D.Primary}"
                                    Click="GrabProject_Click"
                                    Visibility="{Binding CanGrabSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                    ToolTip="Grab this project: it becomes your pursuit and leaves the shared boards. 14 days with no next step and it goes back to the pool."/>
                            <Button Content="Not for us…" Width="100" Margin="0,0,8,0"
                                    Click="DismissProject_Click"
                                    Visibility="{Binding CanDismissSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                    ToolTip="Remove this project from the actionable pool with a reason. Admins can see and restore removed projects."/>
                            <Button Content="Release" Width="90" Margin="0,0,8,0"
                                    Click="ReleaseProject_Click"
                                    Visibility="{Binding CanReleaseSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                    ToolTip="Give this project back to the shared pool. Its pursuit is archived, unless its RFP has already joined it."/>
                            <Button Content="Restore" Width="90"
                                    Click="RestoreProject_Click"
                                    Visibility="{Binding CanRestoreSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                    ToolTip="Undo the removal — the project returns to the actionable pool."/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Location" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.LocationDisplay}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stage" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.StageDisplay}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.ProjectStatus}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cost" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.CostDisplay}" FontWeight="SemiBold" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Sector" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.Sector}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Sub/category" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}">
                                <Run Text="{Binding Selected.SubSector, Mode=OneWay, TargetNullValue=''}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding Selected.ProjectCategoryName, Mode=OneWay, TargetNullValue=''}"/>
                            </TextBlock>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Proponent" Style="{StaticResource DetailLabel}"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Selected.ProponentName}"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Foreground="{StaticResource CorporateBlue}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Left"
                                        Cursor="Hand"
                                        Click="OpenProponentDossier_Click"
                                        Visibility="{Binding HasSelectedProponentOrg, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                <TextBlock Text="{Binding Selected.ProponentName}"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource DetailValue}"
                                           Visibility="{Binding NoSelectedProponentOrg, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Architect" Style="{StaticResource DetailLabel}"/>
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Selected.ArchitectName}"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Foreground="{StaticResource CorporateBlue}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Left"
                                        Cursor="Hand"
                                        Click="OpenArchitectDossier_Click"
                                        Visibility="{Binding HasSelectedArchitectOrg, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                <TextBlock Text="{Binding Selected.ArchitectName}"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource DetailValue}"
                                           Visibility="{Binding NoSelectedArchitectOrg, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Structural" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Selected.StructuralEngineerName}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="General contractor" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Selected.GeneralContractorName}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Timeline" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Selected.TimelineDisplay}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Issue" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource DetailValue}">
                                <Run Text="{Binding Selected.IssueYear, Mode=OneWay, TargetNullValue=''}"/>
                                <Run Text=" Q"/>
                                <Run Text="{Binding Selected.IssueQuarter, Mode=OneWay, TargetNullValue=''}"/>
                            </TextBlock>
                        </Grid>

                        <WrapPanel Margin="0,0,0,8" Visibility="{Binding Selected.HasFundingFlags, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <Border Style="{StaticResource Chip}" Visibility="{Binding Selected.PublicFundingInd, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <TextBlock Text="Public" Foreground="White" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding Selected.ProvincialFunding, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <TextBlock Text="Provincial" Foreground="White" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding Selected.FederalFunding, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <TextBlock Text="Federal" Foreground="White" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding Selected.MunicipalFunding, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <TextBlock Text="Municipal" Foreground="White" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding Selected.GreenBuildingInd, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <TextBlock Text="Green" Foreground="White" FontSize="11"/>
                            </Border>
                        </WrapPanel>

                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding Selected.HasJobs, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Text="Jobs" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource DetailValue}">
                                <Run Text="Construction: "/>
                                <Run Text="{Binding Selected.ConstructionJobs, Mode=OneWay, StringFormat={}{0:N0}, TargetNullValue='unknown'}"/>
                                <Run Text="   Operating: "/>
                                <Run Text="{Binding Selected.OperatingJobs, Mode=OneWay, StringFormat={}{0:N0}, TargetNullValue='unknown'}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding Selected.HasIndigenousNames, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Text="Indigenous names" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Selected.IndigenousNames}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding Selected.HasDescription, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Text="Description" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Selected.ProjectDescription}" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Margin="0,2,0,0">
                            <TextBlock Visibility="{Binding HasSelectedSourceUrl, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                       Margin="0,0,0,4">
                                <Hyperlink NavigateUri="{Binding Selected.SourceUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                    <Run Text="Open source"/>
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Visibility="{Binding HasSelectedProjectWebsite, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <Hyperlink NavigateUri="{Binding Selected.ProjectWebsite}" RequestNavigate="Hyperlink_RequestNavigate">
                                    <Run Text="Open project website"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="4,8,4,2" Background="Transparent">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
