<Window x:Class="Kor.Operations.App.Opportunities.OpportunityDuplicateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Possible duplicate"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,10"
                   FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>

        <DataGrid Grid.Row="1" x:Name="MatchGrid" Margin="0,0,0,12"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  MouseDoubleClick="MatchGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Match" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding ConfidenceBrush}" CornerRadius="999"
                                    Padding="8,2" Margin="2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ConfidenceLabel}" Foreground="White"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Key"     Binding="{Binding OpportunityKey}"   Width="120"/>
                <DataGridTextColumn Header="Name"    Binding="{Binding Name}"             Width="*"/>
                <DataGridTextColumn Header="Buyer"   Binding="{Binding BuyerName}"        Width="150"/>
                <DataGridTextColumn Header="Status"  Binding="{Binding StatusDisplay}"    Width="90"/>
                <DataGridTextColumn Header=""        Binding="{Binding PursuitDisplay}"   Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open the existing one" Width="170" Margin="0,0,8,0"
                    Click="OpenExisting_Click" IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    ToolTip="Cancel this new entry and jump to the existing opportunity."/>
            <Button Content="Save as new anyway" Width="150" Margin="0,0,8,0"
                    Click="SaveAnyway_Click"
                    ToolTip="These are genuinely different — create the new opportunity."/>
            <Button Content="Cancel" Width="90" IsCancel="True"
                    ToolTip="Go back to editing."/>
        </StackPanel>
    </Grid>
</Window>
