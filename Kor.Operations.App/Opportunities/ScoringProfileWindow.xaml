<Window x:Class="Kor.Operations.App.Opportunities.ScoringProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opportunities — Scoring Profile"
        Width="900"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Scoring Profile"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0"
                   Margin="180,6,0,4"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Edits apply on Save. Use Recalc All to push the new profile into existing rows."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,8">
            <Button Content="Save"             Width="100" Margin="0,0,8,0" Click="SaveButton_Click"
                    Background="{StaticResource Brand.Primary.Brush}" Foreground="White"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
            <Button Content="Reset to defaults" Width="140" Margin="0,0,8,0" Click="ResetButton_Click"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
            <Button Content="Recalc all"        Width="100" Margin="0,0,8,0" Click="RecalcButton_Click"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
            <Button Content="Close"             Width="80"  Click="CloseButton_Click"/>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="0,0,0,8">
            <TabItem Header="Positive terms">
                <DataGrid x:Name="PositiveGrid"
                          ItemsSource="{Binding PositiveTerms}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Term"   Binding="{Binding Term, UpdateSourceTrigger=PropertyChanged}"   Width="*"/>
                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Negative terms">
                <DataGrid x:Name="NegativeGrid"
                          ItemsSource="{Binding NegativeTerms}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Term"   Binding="{Binding Term, UpdateSourceTrigger=PropertyChanged}"   Width="*"/>
                        <DataGridTextColumn Header="Weight (subtracted)" Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Region weights">
                <DataGrid x:Name="RegionGrid"
                          ItemsSource="{Binding RegionTerms}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Region term" Binding="{Binding Term, UpdateSourceTrigger=PropertyChanged}"   Width="*"/>
                        <DataGridTextColumn Header="Weight (signed)" Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Country hard rejects">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="4,4,4,8"
                               Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="One country term per line. Substring + case-insensitive. Anything matched short-circuits the score to HardReject (-100). Don't include 'USA', 'United States', or 'Canada' here."/>
                    <TextBox Grid.Row="1"
                             Text="{Binding HardRejectCountriesText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Courier New"/>
                </Grid>
            </TabItem>

            <TabItem Header="Thresholds">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Min score (clamp floor)"        Margin="0,6"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding MinScore}"              Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Max score (clamp ceiling)"      Margin="0,6"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding MaxScore}"              Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Hard reject score"              Margin="0,6"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding HardRejectScore}"       Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Repeat developer bonus"         Margin="0,6"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding RepeatDeveloperBonus}"  Margin="0,4"
                               ToolTip="Applied to any Opportunity with a DeltekClientId. The next three bonuses STACK on top of this one when the client has KOR work history."/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Prior-work bonus"               Margin="0,6"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding PriorWorkBonus}"        Margin="0,4"
                               ToolTip="Applied when Clendor.PriorWork = 'Y'."/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Recommend bonus"                Margin="0,6"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding RecommendBonus}"        Margin="0,4"
                               ToolTip="Applied when Clendor.Recommend = 'Y'."/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Lifetime-fee bonus"             Margin="0,6"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding LifetimeFeeBonus}"      Margin="0,4"
                               ToolTip="Applied when the client's lifetime KOR fees meet or exceed the threshold below. Set the threshold to 0 to apply to any client with KOR history."/>
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Lifetime-fee threshold"         Margin="0,6"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" Text="{Binding LifetimeFeeBonusThresholdCad}" Margin="0,4"
                               ToolTip="CAD threshold for the lifetime-fee bonus. 0 disables the threshold (any client with KOR history qualifies)."/>
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Deadline feasible bonus"        Margin="0,6"/>
                    <TextBox   Grid.Row="8" Grid.Column="1" Text="{Binding DeadlineFeasibleBonus}" Margin="0,4"/>
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Deadline crunch penalty"        Margin="0,6"/>
                    <TextBox   Grid.Row="9" Grid.Column="1" Text="{Binding DeadlineCrunchPenalty}" Margin="0,4"/>
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Deadline warning window (days)" Margin="0,6"/>
                    <TextBox   Grid.Row="10" Grid.Column="1" Text="{Binding DeadlineWarningWindowDays}" Margin="0,4"/>
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Min value threshold (CAD, 0=off)" Margin="0,6"/>
                    <TextBox   Grid.Row="11" Grid.Column="1" Text="{Binding MinimumValueThresholdCad}" Margin="0,4"/>
                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Tier: High (≥)"   Margin="0,6"/>
                    <TextBox   Grid.Row="12" Grid.Column="1" Text="{Binding TierHighThreshold}" Margin="0,4"/>
                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Tier: Medium (≥)" Margin="0,6"/>
                    <TextBox   Grid.Row="13" Grid.Column="1" Text="{Binding TierMediumThreshold}" Margin="0,4"/>
                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Tier: Low (≥)"   Margin="0,6"/>
                    <TextBox   Grid.Row="14" Grid.Column="1" Text="{Binding TierLowThreshold}" Margin="0,4"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Padding="12,6" Background="#F0F0F2">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>

    <Window.Resources>
        <local:InvertBoolConverter x:Key="InvertBool" xmlns:local="clr-namespace:Kor.Operations.App.Opportunities"/>
    </Window.Resources>
</Window>
