<Window x:Class="Kor.Operations.App.Opportunities.CompetitorProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:local="clr-namespace:Kor.Operations.App.Opportunities"
        Title="Competitor Profile"
        Width="1300" Height="800" WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullOrEmptyStringToVisibilityConverter x:Key="NullToVisHide"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar" Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="{Binding VendorName}"
                            SubtitleText="Competitor profile"
                            AvatarDiameter="96" AvatarBorderThickness="2"/>

        <Border Grid.Row="1" Background="{StaticResource App.Background}" Padding="14" Margin="8,0,8,8" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Lifetime won" FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding LifetimeValue, StringFormat=C0}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Contracts" FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding LifetimeCount}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Avg contract" FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding AvgContractValue, StringFormat=C0}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Active window" FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ActiveWindow}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FFF8E5" BorderBrush="#E5C870" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="8,0,8,8"
                Visibility="{Binding HasAgentProfile, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Vendor Profile (AI-researched)" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AgentEnrichedAtUtc, StringFormat='  {0:yyyy-MM-dd}'}"
                               FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <Border Background="{Binding OverlapScoreBrush}" CornerRadius="999" Padding="8,2" Margin="12,0,0,0"
                            Visibility="{Binding HasOverlapScore, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OverlapScoreLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Text="  " Foreground="White" FontSize="10"/>
                            <TextBlock Text="{Binding OverlapScoreText}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding AgentVendorProfile}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"/>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,28,4" Visibility="{Binding HasVendorWebsite, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Website" FontSize="10" Foreground="#666"/>
                        <TextBlock>
                            <Hyperlink NavigateUri="{Binding AgentVendorWebsite}" RequestNavigate="OnHyperlinkRequestNavigate">
                                <Run Text="{Binding AgentVendorWebsite, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,4" Visibility="{Binding HasLinkedInUrl, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="LinkedIn" FontSize="10" Foreground="#666"/>
                        <TextBlock>
                            <Hyperlink NavigateUri="{Binding AgentVendorLinkedInUrl}" RequestNavigate="OnHyperlinkRequestNavigate">
                                <Run Text="{Binding AgentVendorLinkedInUrl, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,4">
                        <TextBlock Text="HQ" FontSize="10" Foreground="#666"/>
                        <TextBlock Text="{Binding AgentVendorHqLocation, FallbackValue=''}" FontSize="12.5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,4">
                        <TextBlock Text="Size band" FontSize="10" Foreground="#666"/>
                        <TextBlock Text="{Binding AgentVendorSizeBand, FallbackValue=''}" FontSize="12.5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,4">
                        <TextBlock Text="Founded" FontSize="10" Foreground="#666"/>
                        <TextBlock Text="{Binding AgentVendorFoundedYear, FallbackValue=''}" FontSize="12.5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,4" Visibility="{Binding AgentContractProjectType, Converter={StaticResource NullToVisHide}}">
                        <TextBlock Text="Project type" FontSize="10" Foreground="#666"/>
                        <TextBlock Text="{Binding AgentContractProjectType}" FontSize="12.5"/>
                    </StackPanel>
                    <!-- Round 37d (R2 audit follow-up): AgentKorOverlapScore was set
                         by the VM (Round 6f) but the XAML binding was missed, so the
                         chip never showed and the property tripped UnusedViewModelPropertyTests.
                         Wired back into the agent-stat strip per Round 6f intent. -->
                    <StackPanel Margin="0,0,28,4" Visibility="{Binding AgentKorOverlapScore, Converter={StaticResource NullToVisHide}}">
                        <TextBlock Text="KOR overlap" FontSize="10" Foreground="#666"/>
                        <TextBlock FontSize="12.5">
                            <Run Text="{Binding AgentKorOverlapScore, Mode=OneWay}"/><Run Text="/10"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,4">
                        <TextBlock Text="Ownership" FontSize="10" Foreground="#666"/>
                        <TextBlock Text="{Binding AgentVendorOwnershipStatus, FallbackValue=''}" FontSize="12.5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,4" Visibility="{Binding HasParentCompany, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Parent company" FontSize="10" Foreground="#666"/>
                        <TextBlock Text="{Binding AgentVendorParentCompany}" FontSize="12.5"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Specialties" FontSize="10" Foreground="#666" Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding AgentVendorSpecialties}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF8E5" BorderBrush="#D4B370" BorderThickness="1" CornerRadius="999"
                                        Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Other offices" FontSize="10" Foreground="#666" Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding AgentVendorLocations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#EEF4FB" BorderBrush="#7AAEDE" BorderThickness="1" CornerRadius="999"
                                        Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Certifications / registrations" FontSize="10" Foreground="#666" Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding AgentVendorCertifications}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F0F7EE" BorderBrush="#8FB87D" BorderThickness="1" CornerRadius="999"
                                        Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Leadership" FontSize="10" Foreground="#666" Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding AgentVendorLeadership}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12.5">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="  " Foreground="#999"/>
                                    <Run Text="{Binding Title, FallbackValue='', Mode=OneWay}" Foreground="#444"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,8,0,0" Visibility="{Binding HasRecentNews, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Recent news" FontSize="10" Foreground="#666" Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding AgentVendorRecentNews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock FontSize="12.5">
                                        <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnHyperlinkRequestNavigate">
                                            <Run Text="{Binding Headline, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Date, FallbackValue=''}" FontSize="10" Foreground="#888"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Competition notes:" FontSize="11" Foreground="#666" Margin="0,8,0,2"
                           Visibility="{Binding AgentCompetitionNotes, Converter={StaticResource NullToVisHide}}"/>
                <TextBlock Text="{Binding AgentCompetitionNotes}" TextWrapping="Wrap" FontSize="12" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,4,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Wins by year" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding ByYear}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="22">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="60"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding TotalValue, StringFormat=C0}" Width="*"/>
                            <DataGridTextColumn Header="Contracts" Binding="{Binding ContractCount}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="4,0,4,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Top buyers (by $)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding TopBuyers}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="22">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Buyer" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding TotalValue, StringFormat=C0}" Width="100"/>
                            <DataGridTextColumn Header="N" Binding="{Binding ContractCount}" Width="40"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="4,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="By source" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding BySource}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="22">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding TotalValue, StringFormat=C0}" Width="100"/>
                            <DataGridTextColumn Header="N" Binding="{Binding ContractCount}" Width="40"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="8,0,8,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Recent wins (latest 25)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="11" Foreground="#666" Margin="0,6,0,0"/>
                <DataGrid ItemsSource="{Binding RecentWins}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="22"
                          AlternatingRowBackground="#FAFAFA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding AwardedAtUtc, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Buyer" Binding="{Binding AwardingOrganization}" Width="220"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding ContractValue, StringFormat=C0}" Width="110"/>
                        <DataGridTextColumn Header="RFP Ref" Binding="{Binding ExternalReference}" Width="120"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
