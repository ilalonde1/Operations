<Window x:Class="Kor.Operations.App.Opportunities.IngestionRunsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingestion Runs"
        Width="1100"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Ingestion Runs"
                   FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0"
                   Text="Most recent 50 — newest first. Use Refresh after triggering a run."
                   FontSize="11" Foreground="#506070" Margin="0,22,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Width="100" Margin="0,0,8,0" Click="RefreshButton_Click"/>
            <TextBlock x:Name="SummaryLine" VerticalAlignment="Center"
                       FontSize="11" Foreground="#506070"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="RunsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Started" Binding="{Binding StartedDisplay}" Width="150"/>
                <DataGridTextColumn Header="Ended" Binding="{Binding EndedDisplay}" Width="90"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="80"/>
                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="240"/>
                <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="StatusDisplay">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusBrush}" CornerRadius="999"
                                    Margin="2" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StatusDisplay}" Foreground="White"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Counts (new / dup / skip / fail)"
                                    Binding="{Binding CountsDisplay}" Width="220"/>
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorSummary}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Foreground" Value="#C11E1E"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Padding="0,6,0,0">
            <TextBlock x:Name="StatusLine" FontSize="12" Foreground="#506070"/>
        </Border>
    </Grid>
</Window>
