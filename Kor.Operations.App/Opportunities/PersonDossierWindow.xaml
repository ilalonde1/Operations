<Window x:Class="Kor.Operations.App.Opportunities.PersonDossierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Person Dossier"
        Width="760"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="AffiliationTemplate">
            <Border BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="0,8"
                    Margin="0,0,0,2">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="14">
                        <Hyperlink Click="OnOrgClick">
                            <Run Text="{Binding OrgName, Mode=OneWay}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0">
                        <Run Text="{Binding Title, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding Department, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource Text.Secondary}"
                               FontSize="11"
                               Margin="0,2,0,0">
                        <Run Text="{Binding StartDateApprox, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding EndDateApprox, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:KorHeader Grid.Row="0"
                            x:Name="HeaderBar"
                            Margin="2,0,2,8"
                            HeaderText="Person Dossier"
                            SubtitleText="{Binding DisplayName}"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentRoleLine}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Margin="0,0,16,6"
                                       Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}">
                                <Hyperlink NavigateUri="{Binding Email, StringFormat=mailto:{0}}"
                                           RequestNavigate="OnHyperlinkRequestNavigate">
                                    <Run Text="{Binding Email, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding Phone}"
                                       Margin="0,0,16,6"
                                       Visibility="{Binding HasPhone, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Margin="0,0,16,6"
                                       Visibility="{Binding HasLinkedin, Converter={StaticResource BoolToVis}}">
                                <Hyperlink NavigateUri="{Binding LinkedinUrl}"
                                           RequestNavigate="OnHyperlinkRequestNavigate">
                                    <Run Text="{Binding LinkedinUrl, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                        </WrapPanel>
                        <TextBlock Foreground="{StaticResource Text.Secondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasLastSeen, Converter={StaticResource BoolToVis}}">
                            <Run Text="Last seen "/>
                            <Run Text="{Binding LastSeenDisplay, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Notes}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Current affiliations" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding CurrentAffiliations}"
                                      ItemTemplate="{StaticResource AffiliationTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,12"
                        Opacity="0.82"
                        Visibility="{Binding HasFormerAffiliations, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Former affiliations" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding FormerAffiliations}"
                                      ItemTemplate="{StaticResource AffiliationTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasSignals, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Recent signals" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding RecentSignals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Panel.Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding SignalType, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Subject, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Foreground="{StaticResource Text.Secondary}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding OrgName, Mode=OneWay}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding OccurredAtApprox, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Open actions" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding OpenActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Panel.Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource App.Background}"
                                                        BorderBrush="{StaticResource Panel.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="999"
                                                        Padding="8,2"
                                                        Margin="0,0,8,4">
                                                    <TextBlock Text="{Binding ActionType}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Recommendation}"
                                                           TextWrapping="Wrap"
                                                           FontWeight="SemiBold"
                                                           Margin="0,2,0,4"/>
                                            </Grid>
                                            <TextBlock Foreground="{StaticResource Text.Secondary}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12">
                                                <Run Text="{Binding TimingNotes, Mode=OneWay}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding OrgName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="16,8,16,12"
                   Foreground="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
</Window>
