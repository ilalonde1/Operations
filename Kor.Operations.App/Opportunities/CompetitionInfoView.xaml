<UserControl x:Class="Kor.Operations.App.Opportunities.CompetitionInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kor.Operations.App.Opportunities"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="View_Loaded"
             Unloaded="View_Unloaded">
    <UserControl.Resources>
        <local:OpportunityDeadlineConverter x:Key="OpportunityDeadlineConverter"/>
        <local:BoolToCheckConverter x:Key="BoolToCheckConverter"/>
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="Historical RFPs">
            <Grid DataContext="{Binding Rfps}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource App.Background}" Padding="10">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Keyword" FontSize="11" Foreground="#666"/>
                                <TextBox Width="240" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Year" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="100" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Province" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="80" ItemsSource="{Binding Provinces}" SelectedItem="{Binding SelectedProvince}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Status" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="120" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Min Est. Value" FontSize="11" Foreground="#666"/>
                                <TextBox Width="120" Text="{Binding MinEstimatedValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            </StackPanel>
                            <CheckBox Content="KOR markets only" IsChecked="{Binding KorRelevantOnly}"
                                      VerticalAlignment="Bottom" Margin="0,0,16,4"
                                      ToolTip="On (default): only BC, AB, WA, OR, CA — and hides obvious non-engineering noise (snow removal, janitorial, IT packages, supply trucks, painting, landscaping, catering, etc.). Untick to see the full uncurated archive."/>
                            <CheckBox Content="Has downloaded docs" IsChecked="{Binding HasDocumentsOnly}"
                                      VerticalAlignment="Bottom" Margin="0,0,16,4"/>
                            <Button Content="Apply" Width="80" Height="28"
                                    VerticalAlignment="Bottom" Margin="0,0,8,1"
                                    Command="{Binding ApplyCommand}"/>
                            <Button Content="ⓘ About sources" Width="150" Height="28"
                                    VerticalAlignment="Bottom" Margin="0,0,0,1"
                                    Click="OpenAboutSources_Click"/>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource App.Background}" Padding="10,6">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#444"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" RowHeight="24" HeadersVisibility="Column"
                              AlternatingRowBackground="#FAFAFA" CanUserSortColumns="True"
                              MouseDoubleClick="RfpRow_DoubleClick">
                        <DataGrid.Columns>
                            <!-- Round 53: ID column (OpportunityKey, internal lookup
                                 like "BCBID-NXC-J7H6N") dropped — not actionable
                                 for browsing; double-click opens the full record. -->
                            <!-- 2026-10-21: the columns a lead reads, sized to the window (it was 13 fixed widths and
                                 always scrolled sideways, with "Provinc" cut off and Status/Amends/Commodities mostly
                                 empty). Double-click still opens everything. -->
                            <DataGridTextColumn Header="Title" Binding="{Binding Name}" Width="2.4*" MinWidth="260"/>
                            <DataGridTextColumn Header="Buyer" Binding="{Binding BuyerName}" Width="1.3*" MinWidth="150"/>
                            <DataGridTextColumn Header="Prov." Binding="{Binding ProjectProvince}" Width="52"/>
                            <DataGridTextColumn Header="Closed" Binding="{Binding SubmissionDeadlineUtc, Converter={StaticResource OpportunityDeadlineConverter}}" Width="180" SortMemberPath="SubmissionDeadlineUtc"/>
                            <DataGridTextColumn Header="Est. value" Binding="{Binding EstimatedValue, StringFormat=C0}" Width="100"/>
                            <DataGridTextColumn Header="Awarded to" Binding="{Binding AwardedToOrganization}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="Awarded $" Binding="{Binding AwardedValue, StringFormat=C0}" Width="100"/>
                            <DataGridTextColumn Header="Docs" Binding="{Binding DocumentCount}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Awards">
            <Grid DataContext="{Binding Awards}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource App.Background}" Padding="10">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Keyword (title/buyer/winner)" FontSize="11" Foreground="#666"/>
                                <TextBox Width="240" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Winner (vendor name)" FontSize="11" Foreground="#666"/>
                                <TextBox Width="200" Text="{Binding Vendor, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Year" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="100" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Source" FontSize="11" Foreground="#666"/>
                                <ComboBox Width="200" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Min Contract $" FontSize="11" Foreground="#666"/>
                                <TextBox Width="120" Text="{Binding MinContractValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            </StackPanel>
                            <CheckBox Content="Competes with KOR only" IsChecked="{Binding CompetesWithKorOnly}"
                                      VerticalAlignment="Bottom" Margin="0,0,16,4"/>
                            <Button Content="Apply" Width="80" Height="28"
                                    VerticalAlignment="Bottom" Margin="0,0,8,1"
                                    Command="{Binding ApplyCommand}"/>
                            <Button Content="ⓘ About sources" Width="150" Height="28"
                                    VerticalAlignment="Bottom" Margin="0,0,0,1"
                                    Click="OpenAboutSources_Click"/>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource App.Background}" Padding="10,6">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#444"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" RowHeight="24" HeadersVisibility="Column"
                              AlternatingRowBackground="#FAFAFA" CanUserSortColumns="True"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Competes" Width="75" SortMemberPath="AgentCompetesWithKor" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"
                                                   Foreground="{StaticResource Risk.HighConfidence.Foreground}"
                                                   Text="{Binding AgentCompetesWithKor, Converter={StaticResource BoolToCheckConverter}, FallbackValue=''}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Winner" Width="220" SortMemberPath="AwardedToOrganization" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AwardedToOrganization}" Foreground="{StaticResource CorporateBlue}"
                                                   TextDecorations="Underline" Cursor="Hand"
                                                   MouseLeftButtonUp="WinnerCell_Click"
                                                   ToolTip="{Binding AwardedToOrganization}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Agent Profile (AI)" Width="380" SortMemberPath="AgentVendorProfile" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AgentVendorProfile}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding AgentVendorProfile}"
                                                   ToolTipService.ShowDuration="20000"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Contract $" Binding="{Binding ContractValue, StringFormat=C0}" Width="110" SortMemberPath="ContractValue"/>
                            <DataGridTextColumn Header="Awarded" Binding="{Binding AwardedAtUtc, StringFormat=yyyy-MM-dd}" Width="95" SortMemberPath="AwardedAtUtc"/>
                            <DataGridTemplateColumn Header="Buyer" Width="200" SortMemberPath="AwardingOrganization" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AwardingOrganization}" Foreground="{StaticResource CorporateBlue}"
                                                   TextDecorations="Underline" Cursor="Hand"
                                                   MouseLeftButtonUp="BuyerCell_Click"
                                                   ToolTip="{Binding AwardingOrganization}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" MinWidth="240"/>
                            <DataGridTextColumn Header="RFP Ref" Binding="{Binding ExternalReference}" Width="120"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="160"/>
                            <DataGridTextColumn Header="Contract #" Binding="{Binding ContractNumber}" Width="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding SolicitationType}" Width="110"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding IssuingLocation}" Width="150"/>
                            <DataGridTextColumn Header="Currency" Binding="{Binding ContractCurrency}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- 2026-10-13: competitor watch moved here from the BD dashboard. -->
        <TabItem Header="Competitor watch">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock FontSize="14" FontWeight="SemiBold">
                        <Run Text="Structural competitors — capacity read from research"/>
                        <Run Text="  double-click opens the dossier" FontSize="11" FontWeight="Normal" Foreground="#666"/>
                    </TextBlock>
                    <TextBlock Text="{Binding CompetitorWatchNote}" FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <DataGrid Grid.Row="1"
                          x:Name="CompetitorWatchGrid"
                          ItemsSource="{Binding CompetitorWatch}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          MouseDoubleClick="CompetitorRow_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Firm" Binding="{Binding DisplayName}" Width="260"/>
                        <DataGridTemplateColumn Header="Capacity read" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CapacityRead}" TextWrapping="Wrap" FontSize="12" Padding="4,4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
