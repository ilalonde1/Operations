<Window x:Class="Kor.Operations.PMTools.ProjectWeekDrillDownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Hours"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="720"
        MinWidth="600"
        Height="480"
        MinHeight="360"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OvtWeekCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOvertime}" Value="True">
                    <Setter Property="Foreground" Value="#B45309"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ProjectNameText"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}"/>
                    <TextBlock x:Name="SummaryText"
                               FontSize="12"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Close"
                        Width="84"
                        Height="32"
                        VerticalAlignment="Top"
                        Style="{StaticResource Button.Secondary}"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="WeekGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      HorizontalScrollBarVisibility="Disabled"
                      AlternatingRowBackground="#F8FAFC"
                      RowBackground="Transparent"
                      RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding WeekLabel}" Width="*" MinWidth="180">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Week (Mon – Sun)" Style="{StaticResource ColHeader}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding RegHrs, StringFormat={}{0:0.0}}" Width="90">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Reg Hrs" Style="{StaticResource ColHeader}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding OvtHrs, StringFormat={}{0:0.0}}" Width="90">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Ovt Hrs" Style="{StaticResource ColHeader}"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource OvtWeekCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding TotalHrs, StringFormat={}{0:0.0}}" Width="90">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Total" Style="{StaticResource ColHeader}"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,8" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{StaticResource Text.Secondary}"/>
        </Border>
    </Grid>
</Window>
