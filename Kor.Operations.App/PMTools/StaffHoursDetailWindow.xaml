<Window x:Class="Kor.Operations.PMTools.StaffHoursDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fin="clr-namespace:Kor.Operations.Financials"
        Title="Staff Hours Detail"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="860"
        MinWidth="700"
        Height="640"
        MinHeight="480"
        Loaded="Window_Loaded"
        ToolTipService.InitialShowDelay="200"
        ToolTipService.ShowDuration="20000">
    <Window.Resources>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="i"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Ovt colouring for project grid -->
        <Style x:Key="OvtCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOvertime}" Value="True">
                    <Setter Property="Foreground" Value="#B45309"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- VsTarget colouring for week grid -->
        <Style x:Key="VsTargetCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VsTargetStatus}" Value="Over">
                    <Setter Property="Foreground" Value="#B45309"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VsTargetStatus}" Value="Under">
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OvtWeekCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOvertime}" Value="True">
                    <Setter Property="Foreground" Value="#B45309"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="EmployeeNameText"
                               FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}"/>
                    <TextBlock x:Name="SummaryText"
                               FontSize="12" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Close"
                        Width="84" Height="32"
                        VerticalAlignment="Top"
                        Style="{StaticResource Button.Secondary}"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>

        <!-- Tab control -->
        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">

            <!-- Tab 1: By Project -->
            <TabItem Header="By Project">
                <Border Style="{StaticResource Card}" Padding="8" Margin="0,8,0,0">
                    <DataGrid x:Name="ProjectGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              HorizontalScrollBarVisibility="Disabled"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="Transparent"
                              RowHeight="32">
                        <DataGrid.Columns>

                            <DataGridTextColumn Binding="{Binding ProjectName}" Width="*" MinWidth="180">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Project" Style="{StaticResource ColHeader}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Wbs1}" Width="110">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Project #" Style="{StaticResource ColHeader}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Phase}" Width="70">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Phase" Style="{StaticResource ColHeader}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding RegHrs, StringFormat={}{0:0.0}}" Width="90">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Reg Hrs" Style="{StaticResource ColHeader}"/>
                                        <Border Style="{StaticResource InfoIconBorder}" Margin="4,0,0,0"
                                                ToolTip="{fin:FinancialMetricTooltip Key=StaffUtil_RegHrs}">
                                            <TextBlock Style="{StaticResource InfoIconText}"/>
                                        </Border>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding OvtHrs, StringFormat={}{0:0.0}}" Width="90">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ovt Hrs" Style="{StaticResource ColHeader}"/>
                                        <Border Style="{StaticResource InfoIconBorder}" Margin="4,0,0,0"
                                                ToolTip="{fin:FinancialMetricTooltip Key=StaffUtil_OvtHrs}">
                                            <TextBlock Style="{StaticResource InfoIconText}"/>
                                        </Border>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OvtCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding TotalHrs, StringFormat={}{0:0.0}}" Width="90">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Total Hrs" Style="{StaticResource ColHeader}"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding PctOfTotal, StringFormat={}{0:P0}}" Width="90">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="% of Total" Style="{StaticResource ColHeader}"/>
                                        <Border Style="{StaticResource InfoIconBorder}" Margin="4,0,0,0"
                                                ToolTip="{fin:FinancialMetricTooltip Key=StaffUtil_PctOfTotal}">
                                            <TextBlock Style="{StaticResource InfoIconText}"/>
                                        </Border>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Tab 2: By Week -->
            <TabItem Header="By Week">
                <Border Style="{StaticResource Card}" Padding="8" Margin="0,8,0,0">
                    <DataGrid x:Name="WeekGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              HorizontalScrollBarVisibility="Disabled"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="Transparent"
                              RowHeight="32">
                        <DataGrid.Columns>

                            <DataGridTextColumn Binding="{Binding WeekLabel}" Width="*" MinWidth="180">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Week (Mon – Sun)" Style="{StaticResource ColHeader}"/>
                                        <Border Style="{StaticResource InfoIconBorder}" Margin="4,0,0,0"
                                                ToolTip="Weeks are Monday-anchored (Mon–Sun). Most recent week appears first. Partial weeks at the edge of the 84-day window may show fewer hours than a full week.">
                                            <TextBlock Style="{StaticResource InfoIconText}"/>
                                        </Border>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding RegHrs, StringFormat={}{0:0.0}}" Width="90">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Reg Hrs" Style="{StaticResource ColHeader}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding OvtHrs, StringFormat={}{0:0.0}}" Width="90">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ovt Hrs" Style="{StaticResource ColHeader}"/>
                                        <Border Style="{StaticResource InfoIconBorder}" Margin="4,0,0,0"
                                                ToolTip="{fin:FinancialMetricTooltip Key=StaffUtil_OvtHrs}">
                                            <TextBlock Style="{StaticResource InfoIconText}"/>
                                        </Border>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OvtWeekCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding TotalHrs, StringFormat={}{0:0.0}}" Width="90">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Total" Style="{StaticResource ColHeader}"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding VsTargetDisplay}" Width="100">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="vs 37.5 Target" Style="{StaticResource ColHeader}"/>
                                        <Border Style="{StaticResource InfoIconBorder}" Margin="4,0,0,0"
                                                ToolTip="{fin:FinancialMetricTooltip Key=StaffUtil_VsTarget}">
                                            <TextBlock Style="{StaticResource InfoIconText}"/>
                                        </Border>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource VsTargetCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,8" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText"
                       FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
        </Border>
    </Grid>
</Window>
