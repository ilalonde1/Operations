<Window x:Class="Kor.Operations.PMTools.HistoricalAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fin="clr-namespace:Kor.Operations.Financials"
        xmlns:ctrl="clr-namespace:Kor.Operations.Controls"
        xmlns:local="clr-namespace:Kor.Operations.PMTools"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="KOR NewerForma — Historical Project Analytics"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1500"
        MinWidth="1100"
        Height="800"
        MinHeight="550"
        Loaded="Window_Loaded"
        ToolTipService.InitialShowDelay="200"
        ToolTipService.ShowDuration="20000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <local:ComparisonBrushConverter x:Key="CompBrush"/>
        <local:LessThanConverter x:Key="LessThan"/>
        <local:GreaterThanConverter x:Key="GreaterThan"/>
        <Style x:Key="CellRight" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <!-- Detail card section header (colored left accent bar) -->
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandOrange}"/>
            <Setter Property="Padding" Value="8,4,0,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="CornerRadius" Value="0,4,4,0"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
        <!-- Detail card metric label -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <!-- Detail card metric value -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="MetricCompare" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Filter bar -->
            <RowDefinition Height="Auto"/>  <!-- Summary + legend -->
            <RowDefinition Height="*"/>     <!-- Master-detail -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
            <RowDefinition Height="Auto"/>  <!-- AI panel -->
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Filter bar (two rows, color-grouped) ═══ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,6">
            <StackPanel>
                <!-- Row 1: View mode, data filters, search, buttons -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                    <ComboBox Width="140" Height="28" FontWeight="SemiBold" Margin="0,0,8,0"
                              ItemsSource="{Binding ViewModeOptions}" SelectedItem="{Binding ViewMode}" />

                    <!-- Data filters (gray bg) -->
                    <Border Background="#F3F4F6" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status:" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Width="85" Height="24" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"/>
                            <TextBlock Text="Data:" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox Width="130" Height="24" ItemsSource="{Binding HoursFilterOptions}" SelectedItem="{Binding SelectedHoursFilter}"/>
                            <TextBlock Text="Year:" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox Width="70" Height="24" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}"/>
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <TextBox Width="200" Height="28" Padding="8,0" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,8,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>

                    <Button Height="28" Padding="10,0" Margin="0,0,4,0"
                            Style="{StaticResource Button.Accent}" Click="HelpBtn_Click"
                            ToolTip="What do all these numbers mean? Click for a plain-English guide.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="?" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Help" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Close" Width="60" Height="28"
                            Style="{StaticResource Button.Secondary}" Click="CloseBtn_Click"/>
                </WrapPanel>

                <!-- Row 2: People filters + project classification filters -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- People filters (blue bg) -->
                    <Border Background="#EFF6FF" CornerRadius="5" Padding="8,3" Margin="0,0,8,0"
                            ToolTip="Filter by who managed the project">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PM:" Foreground="#1E40AF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Width="150" Height="24" ItemsSource="{Binding PmOptions}" SelectedItem="{Binding SelectedPm}"/>
                            <TextBlock Text="Drafting Mgr:" Foreground="#1E40AF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox Width="150" Height="24" ItemsSource="{Binding DraftingMgrOptions}" SelectedItem="{Binding SelectedDraftingMgr}"/>
                        </StackPanel>
                    </Border>

                    <!-- Project classification filters (orange bg) -->
                    <Border Background="#FFF7ED" CornerRadius="5" Padding="8,3" Margin="0,0,8,0"
                            ToolTip="Filter by project classification from Deltek">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Construction:" Foreground="#9A3412" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Width="180" Height="24" ItemsSource="{Binding ConstructionTypeOptions}" SelectedItem="{Binding SelectedConstructionType}"/>
                            <TextBlock Text="Category:" Foreground="#9A3412" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox Width="110" Height="24" ItemsSource="{Binding ProjectCategoryOptions}" SelectedItem="{Binding SelectedProjectCategory}"/>
                            <TextBlock Text="Drafting:" Foreground="#9A3412" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox Width="80" Height="24" ItemsSource="{Binding DraftingTypeOptions}" SelectedItem="{Binding SelectedDraftingType}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Row 1: Portfolio Summary ═══ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,6" Margin="0,0,0,5">
            <StackPanel>
                <!-- Key metric cards -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F3F4F6" CornerRadius="4" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Total number of projects shown after applying your filters above. Change the Data or Year filter to see different subsets.">
                        <StackPanel>
                            <TextBlock Text="{Binding KpiCountLabel, Mode=OneWay}" FontSize="8.5" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12">
                                <Run Text="{Binding KpiCount, Mode=OneWay}" FontWeight="Bold" FontSize="15"/>
                                <Run Text="{Binding KpiCountUnit, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}"/>
                                <Run Text="{Binding TotalFee, Mode=OneWay, StringFormat='$\{0:N0\}'}" FontWeight="Bold"/>
                                <Run Text="total fee" Foreground="{StaticResource Text.Secondary}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Background="#EFF6FF" CornerRadius="4" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="How project hours split between engineering (design/analysis) and drafting (CAD production). Example: 60%/40% means 60% of production time is engineering.">
                        <StackPanel>
                            <TextBlock Text="ENGINEERING vs DRAFTING" FontSize="8.5" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock FontSize="14" FontWeight="Bold">
                                <Run Text="{Binding WeightedEngPct, Mode=OneWay, StringFormat='\{0:P0\}'}" Foreground="#2563EB"/>
                                <Run Text=" eng / " Foreground="#9CA3AF"/>
                                <Run Text="{Binding WeightedDraftPct, Mode=OneWay, StringFormat='\{0:P0\}'}" Foreground="#7C3AED"/>
                                <Run Text=" draft" Foreground="#9CA3AF"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Background="#F0FDF4" CornerRadius="4" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="MEDIAN fee per production hour across all visible projects (with 50+ hours). Shows the typical project billing rate. Different from PM Summary $/Hr (full fee per PM) and Employee $/Hr (proportional fee per person).">
                        <StackPanel>
                            <TextBlock Text="FEE EARNED PER HOUR (low / typical / high)" FontSize="8.5" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12">
                                <Run Text="{Binding P25FeePerHr, Mode=OneWay, StringFormat='$\{0:N0\}'}" Foreground="#86EFAC"/>
                                <Run Text=" / " Foreground="#9CA3AF"/>
                                <Run Text="{Binding MedianFeePerHr, Mode=OneWay, StringFormat='$\{0:N0\}'}" FontWeight="Bold" FontSize="15" Foreground="#16A34A"/>
                                <Run Text=" / " Foreground="#9CA3AF"/>
                                <Run Text="{Binding P75FeePerHr, Mode=OneWay, StringFormat='$\{0:N0\}'}" Foreground="#86EFAC"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Background="#FAF5FF" CornerRadius="4" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="How often the total budget estimate (eng+draft combined) was within ±50% of actual production hours. Measured on completed projects only. Typical Error shows the median percentage the estimate is off by.">
                        <StackPanel>
                            <TextBlock Text="BUDGET ESTIMATE ACCURACY (±50%)" FontSize="8.5" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding BudgetAccuracyPct, Mode=OneWay, StringFormat='\{0:P0\}'}" FontWeight="Bold" FontSize="15" Foreground="#7C3AED"/>
                                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                           ToolTip="The median percentage by which estimates differ from actual hours. Lower = more precise. This is the typical error — half of projects are closer, half are further.">
                                    <Run Text="Typical error: ±"/><Run Text="{Binding MedianAbsError, Mode=OneWay, StringFormat='\{0:P0\}'}" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Inline secondary stats -->
                    <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="10.5" Margin="0,0,14,0"
                                       ToolTip="Of all hours logged by the firm, what % went to real billable projects. Total includes overhead, vacation, sick, CPD, admin (99XXX project codes). Only hours on real project numbers count as billable.">
                                <Run Text="Firm Billable:"/><Run Text="{Binding FirmBillablePct, Mode=OneWay, StringFormat='\{0:P0\}'}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="10.5" Margin="0,0,14,0"
                                       ToolTip="Money paid to outside firms (geotech, mechanical, envelope, etc.) across visible projects.">
                                <Run Text="Subconsultants:"/><Run Text="{Binding TotalSubCost, Mode=OneWay, StringFormat='$\{0:N0\}'}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="10.5" Margin="0,0,14,0"
                                       ToolTip="Total unpaid invoices across visible projects. Money clients owe us that hasn't been collected yet.">
                                <Run Text="Unpaid Invoices:"/><Run Text="{Binding TotalArOutstanding, Mode=OneWay, StringFormat='$\{0:N0\}'}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>

                <!-- Legend — single horizontal row -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="Projects not shown because of your Data filter. For example, 'Has Hours + Fee' hides projects with no hours or no fee.">
                        <Run Text="{Binding ExcludedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                        <Run Text="projects hidden by filter"/>
                    </TextBlock>
                    <TextBlock Text="│" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <Border Background="#FEF2F2" CornerRadius="2" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Low earning rate" Foreground="#991B1B" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Red row: This project earns less per hour (after paying subconsultants) than 75% of the portfolio. May indicate underpricing or scope creep."/>
                    <Border Background="#FFFBEB" CornerRadius="2" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="High subconsultant cost" Foreground="#92400E" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Amber row: Over 40% of this project's fee was paid to outside firms. Less revenue stays in-house."/>
                    <TextBlock Text="Red text" Foreground="#DC2626" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="= overdue invoices (90+ days)" Foreground="{StaticResource Text.Secondary}" FontSize="9.5" VerticalAlignment="Center"
                               ToolTip="Red text means this project has invoices more than 90 days past due. Client may need a follow-up call."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Row 2: Master-detail split ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>   <!-- Project list -->
                <ColumnDefinition Width="380"/>                <!-- Detail card -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Project list (narrow, scannable) ── -->
            <DataGrid Grid.Column="0"
                      x:Name="HistGrid"
                      Visibility="{Binding IsProjectView, Converter={StaticResource BoolToVisibility}}"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5E7EB"
                      HeadersVisibility="Column"
                      RowHeight="26"
                      FontSize="12"
                      BorderThickness="1"
                      BorderBrush="{StaticResource Panel.Border}"
                      Background="{StaticResource Panel.Background}"
                      AlternatingRowBackground="#FAFBFC"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Margin="0,0,6,0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource GreaterThan}">
                                        <Binding Path="SubPctOfFee"/>
                                        <Binding><Binding.Source><sys:Double>0.4</sys:Double></Binding.Source></Binding>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="#FFFBEB"/>
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource LessThan}">
                                        <Binding Path="NetFeePerHr"/>
                                        <Binding Path="DataContext.P25FeePerHr" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="#FEF2F2"/>
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource GreaterThan}">
                                        <Binding Path="Ar90Plus"/>
                                        <Binding><Binding.Source><sys:Double>0</sys:Double></Binding.Source></Binding>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project #" Binding="{Binding Wbs1}" Width="88">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Deltek WBS1 project number"/></Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Project Name" Binding="{Binding Name}" Width="220">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Project name from Deltek. Click a row to see full details in the panel on the right."/></Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PM" Binding="{Binding Pm}" Width="105">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Project Manager assigned in Deltek"/></Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="48">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Project phase: SD, DD, CD, or CA"/></Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding ConstructionType}" Width="85">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Construction type — Concrete, Woodframe, Steel, etc. From Deltek."/></Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Fee" Binding="{Binding Fee, StringFormat='$\{0:#,##0\}'}" Width="85">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Total project fee from Deltek (PR.Fee)"/></Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Billed" Binding="{Binding PercentBilled, StringFormat='\{0:P0\}'}" Width="50">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="% of fee billed to date (Revenue ÷ Fee)"/></Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Eng%" Binding="{Binding EngPct, StringFormat='\{0:P0\}'}" Width="46">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="What % of the project's production time was engineering (vs drafting). Example: 60% means 60% engineering, 40% drafting."/></Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="$/Hr" Binding="{Binding FeePerHr, StringFormat='$\{0:N0\}'}" Width="52">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="How much fee the firm earns for every hour of engineering + drafting work on this project. Higher = more efficient. The typical project earns about $185/hr."/></Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Net$/Hr" Binding="{Binding NetFeePerHr, StringFormat='$\{0:N0\}'}" Width="58">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="After paying subconsultants, how much does the firm actually earn per hour? This is the REAL profitability number. Low Net$/Hr = the project is less profitable than it looks."/></Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Sub%" Binding="{Binding SubPctOfFee, StringFormat='\{0:P0\}'}" Width="46">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Subconsultant cost as % of fee. Subconsultants are outside firms (geotech, mechanical, etc.) paid from the project fee. High % means less revenue stays in-house."/></Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="62">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Project duration in months. Open to Close date, or Open to today if still active."/></Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="48">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Project status: A = Active, I/C = Inactive/Closed"/></Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── LEFT (alt): PM Summary grid ── -->
            <DataGrid Grid.Column="0"
                      x:Name="PmGrid"
                      Visibility="{Binding IsPmSummaryView, Converter={StaticResource BoolToVisibility}}"
                      ItemsSource="{Binding PmSummaryRows}"
                      SelectionChanged="PmGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5E7EB"
                      HeadersVisibility="Column"
                      RowHeight="28"
                      FontSize="12"
                      BorderThickness="1"
                      BorderBrush="{StaticResource Panel.Border}"
                      Background="{StaticResource Panel.Background}"
                      AlternatingRowBackground="#FAFBFC"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Margin="0,0,6,0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="6,4"/>
