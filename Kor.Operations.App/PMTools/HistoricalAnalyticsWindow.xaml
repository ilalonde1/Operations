                                        ToolTipService.ToolTip="Engineering as % of production hours">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Sub%" Binding="{Binding AvgSubPct, StringFormat='\{0:P0\}'}" Width="50"
                                        ToolTipService.ToolTip="Subconsultant cost as % of total fee">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Med $/Hr" Binding="{Binding MedianFeePerHr, StringFormat='$\{0:N0\}'}" Width="68"
                                        ToolTipService.ToolTip="Median fee per hour for this type — the typical billing rate">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#7C3AED"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Accuracy" Binding="{Binding BudgetAccuracyPct, StringFormat='\{0:P0\}'}" Width="68"
                                        ToolTipService.ToolTip="Budget estimate accuracy for this construction type — what % of closed projects (50+ hrs) had actual total hours within ±50% of the estimate.">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Sample" Binding="{Binding ClosedProjectCount}" Width="55"
                                        ToolTipService.ToolTip="Number of closed projects used to calculate accuracy">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── LEFT (alt 4): YoY Trend grid ── -->
            <DataGrid Grid.Column="0" x:Name="YoYGrid"
                      Visibility="{Binding IsYoYTrendView, Converter={StaticResource BoolToVisibility}}"
                      ItemsSource="{Binding YearTrendRows}"
                      SelectionChanged="YoYGrid_SelectionChanged"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                      SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                      HeadersVisibility="Column" RowHeight="30" FontSize="12.5"
                      BorderThickness="1" BorderBrush="{StaticResource Panel.Border}"
                      Background="{StaticResource Panel.Background}" AlternatingRowBackground="#FAFBFC"
                      VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="55"
                                        ToolTipService.ToolTip="Year the project was opened"/>
                    <DataGridTextColumn Header="Projects" Binding="{Binding ProjectCount}" Width="65"
                                        ToolTipService.ToolTip="Number of projects in this group">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Total Fee" Binding="{Binding TotalFee, StringFormat='$\{0:#,##0\}'}" Width="100"
                                        ToolTipService.ToolTip="Sum of all project fees in this group">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Avg Fee" Binding="{Binding AvgFee, StringFormat='$\{0:#,##0\}'}" Width="90"
                                        ToolTipService.ToolTip="Average project fee for this year">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="$/Hr" Binding="{Binding AvgFeePerHr, StringFormat='$\{0:N0\}'}" Width="58"
                                        ToolTipService.ToolTip="Fee per production hour for this year">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Net$/Hr" Binding="{Binding AvgNetFeePerHr, StringFormat='$\{0:N0\}'}" Width="62"
                                        ToolTipService.ToolTip="Fee minus subconsultants per production hour">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Eng%" Binding="{Binding WeightedEngPct, StringFormat='\{0:P0\}'}" Width="50"
                                        ToolTipService.ToolTip="Engineering as % of production hours">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Sub%" Binding="{Binding AvgSubPct, StringFormat='\{0:P0\}'}" Width="50"
                                        ToolTipService.ToolTip="Subconsultant cost as % of total fee">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Firm Bill%" Binding="{Binding FirmBillablePct, StringFormat='\{0:P0\}'}" Width="72">
                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="What % of the firm's total hours went to real billable projects this year. Excludes overhead, vacation, sick, CPD (99XXX project codes)."/></Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── RIGHT: Detail card ── -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- header -->
                        <RowDefinition Height="*"/>   <!-- scroll content -->
                    </Grid.RowDefinitions>

                    <!-- Branded header bar -->
                    <Border Grid.Row="0" Background="{StaticResource Brand.Primary.Brush}" Padding="16,10" CornerRadius="10,10,0,0">
                        <TextBlock Text="D E T A I L S" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedRow}" Margin="16,12,16,12">
                        <!-- Empty state -->
                        <TextBlock x:Name="EmptyStateText"
                                   Text="Click a row in the list to view details here."
                                   Foreground="{StaticResource Text.Secondary}" FontSize="12.5"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,30,0,0"/>

                        <!-- Summary detail content (for PM/DM/Employee/Fee Band/etc. views) -->
                        <!-- DataContext overridden to Window so bindings resolve to ViewModel, not SelectedRow -->
                        <StackPanel x:Name="SummaryDetailContent" Visibility="Collapsed"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding DetailSubtitle}" FontSize="13" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding DetailMetrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl>
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <!-- Default: metric row -->
                                                                <Grid Margin="0,2" ToolTip="{Binding Tooltip}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource MetricLabel}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource MetricValue}"/>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <!-- Section header -->
                                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ContentControl">
                                                                        <Border BorderThickness="3,0,0,0" BorderBrush="{Binding AccentColor}" Background="#FAFBFC"
                                                                                CornerRadius="0,4,4,0" Padding="8,4,0,4" Margin="0,8,0,4">
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <!-- Explanation card -->
                                                        <DataTrigger Binding="{Binding IsExplanation}" Value="True">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ContentControl">
                                                                        <Border Background="{Binding AccentColor}" CornerRadius="6" Padding="10,8" Margin="0,6,0,4">
                                                                            <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                                                                       TextWrapping="Wrap" ToolTip="{Binding Tooltip}"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Project detail content -->
                        <StackPanel x:Name="DetailContent" Visibility="Collapsed">

                            <!-- ── IDENTITY ── -->
                            <TextBlock Text="{Binding Wbs1}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,14">
                                <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                    <TextBlock FontSize="11"><Run Text="PM:" Foreground="#6B7280"/> <Run Text="{Binding Pm, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E40AF"/></TextBlock>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4"
                                        ToolTip="Drafting manager assigned to this project in Deltek.">
                                    <TextBlock FontSize="11"><Run Text="DM:" Foreground="#6B7280"/> <Run Text="{Binding DraftingManager, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E40AF"/></TextBlock>
                                </Border>
                                <Border Background="#F0FDF4" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                    <TextBlock FontSize="11"><Run Text="Phase:" Foreground="#6B7280"/> <Run Text="{Binding Phase, Mode=OneWay}" FontWeight="SemiBold" Foreground="#166534"/></TextBlock>
                                </Border>
                                <Border Background="#F3F4F6" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                    <TextBlock FontSize="11"><Run Text="Status:" Foreground="#6B7280"/> <Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                </Border>
                                <Border Background="#FAF5FF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                    <TextBlock FontSize="11"><Run Text="Duration:" Foreground="#6B7280"/> <Run Text="{Binding DurationDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="#6B21A8"/></TextBlock>
                                </Border>
                                <Border Background="#FFF7ED" CornerRadius="4" Padding="8,3" Margin="0,0,6,4"
                                        ToolTip="Construction type from Deltek — determines structural system and typical hour profile.">
                                    <TextBlock FontSize="11"><Run Text="Type:" Foreground="#6B7280"/> <Run Text="{Binding ConstructionType, Mode=OneWay}" FontWeight="SemiBold" Foreground="#9A3412"/></TextBlock>
                                </Border>
                                <Border Background="#FFFBEB" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                    <TextBlock FontSize="11"><Run Text="Category:" Foreground="#6B7280"/> <Run Text="{Binding ProjectCategory, Mode=OneWay}" FontWeight="SemiBold" Foreground="#92400E"/></TextBlock>
                                </Border>
                                <Border Background="#F0F9FF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                    <TextBlock FontSize="11"><Run Text="Drafting:" Foreground="#6B7280"/> <Run Text="{Binding DraftingType, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0369A1"/></TextBlock>
                                </Border>
                            </WrapPanel>

                            <!-- ── FINANCIAL ── -->
                            <Border Style="{StaticResource SectionBorder}" BorderBrush="#2563EB">
                                <TextBlock Text="FINANCIAL" Style="{StaticResource SectionHeader}"/>
                            </Border>
                            <TextBlock Text="Net Fee and Net $/Hr are the numbers that matter — they show what the firm actually earns after paying subconsultants. Green/red comparisons are vs portfolio median."
                                       FontSize="10" Foreground="{StaticResource Text.Secondary}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Fee" Style="{StaticResource MetricLabel}" ToolTip="Total project fee from Deltek (PR.Fee). Includes fixed-fee extras."/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Fee, StringFormat='$\{0:#,##0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="% Billed" Style="{StaticResource MetricLabel}" ToolTip="How much of the fee has been invoiced. Revenue ÷ Fee."/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PercentBilled, StringFormat='\{0:P0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Subconsultant Cost" Style="{StaticResource MetricLabel}" ToolTip="Money paid to outside firms (geotechnical, mechanical, envelope, etc.) on this project. From Deltek accounts payable."/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SubCost, StringFormat='$\{0:#,##0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Subconsultant %" Style="{StaticResource MetricLabel}" ToolTip="What % of the project fee went to outside firms. High % means less revenue stays in-house."/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SubPctOfFee, StringFormat='\{0:P0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource MetricCompare}" Margin="6,2,0,2"
                                           Text="{Binding DataContext.AvgSubPct, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='vs {0:P0}'}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource CompBrush}" ConverterParameter="lower">
                                            <Binding Path="SubPctOfFee"/><Binding Path="DataContext.AvgSubPct" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource MetricLabel}" ToolTip="Fee minus subconsultant costs. This is how much the firm actually keeps.">
                                    <Run Text="Net Fee"/><Run Text=" (fee − subconsultants)" Foreground="{StaticResource Text.Secondary}" FontSize="10"/>
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NetFee, StringFormat='$\{0:#,##0\}', Mode=OneWay}" Style="{StaticResource MetricValue}" FontWeight="Bold"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Fee / Hr" Style="{StaticResource MetricLabel}" ToolTip="Fee ÷ production hours (Eng + Draft). The gross billing rate. Compare to the $185/hr portfolio median."/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FeePerHr, StringFormat='$\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource MetricCompare}" Margin="6,2,0,2"
                                           Text="{Binding DataContext.AvgFeePerHr, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='vs ${0:N0}'}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource CompBrush}" ConverterParameter="higher">
                                            <Binding Path="FeePerHr"/><Binding Path="DataContext.AvgFeePerHr" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource MetricLabel}" ToolTip="(Fee minus Subs) ÷ production hours. The REAL rate the firm earns per hour. This is the number that matters.">
                                    <Run Text="Net $ / Hr"/><Run Text=" (net fee ÷ prod hrs)" Foreground="{StaticResource Text.Secondary}" FontSize="10"/>
                                </TextBlock>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding NetFeePerHr, StringFormat='$\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}" FontWeight="Bold"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource MetricCompare}" Margin="6,2,0,2"
                                           Text="{Binding DataContext.AvgNetFeePerHr, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='vs ${0:N0}'}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource CompBrush}" ConverterParameter="higher">
                                            <Binding Path="NetFeePerHr"/><Binding Path="DataContext.AvgNetFeePerHr" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Grid>

                            <!-- ── HOURS ── -->
                            <Border Style="{StaticResource SectionBorder}" BorderBrush="#16A34A">
                                <TextBlock Text="HOURS" Style="{StaticResource SectionHeader}"/>
                            </Border>
                            <TextBlock Text="Top = production hours (eng + draft). Middle = other labor codes. Note: Admin and Non-Billable time is typically charged to overhead projects, not individual jobs."
                                       FontSize="10" Foreground="{StaticResource Text.Secondary}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Engineering" Style="{StaticResource MetricLabel}" ToolTip="Hours charged to engineering labor code (LaborCode 10). Design, analysis, calculations."/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EngHrs, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Drafting" Style="{StaticResource MetricLabel}" ToolTip="Hours charged to drafting labor code (LaborCode 20). CAD production, detailing."/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DraftHrs, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Eng / Draft Split" Style="{StaticResource MetricLabel}" FontWeight="SemiBold" ToolTip="Engineering hours as % of production hours vs Drafting %. The peer-based budget estimate uses actual splits from similar projects."/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricValue}" FontWeight="Bold">
                                    <Run Text="{Binding EngPct, StringFormat='\{0:P0\}', Mode=OneWay}" Foreground="#2563EB"/>
                                    <Run Text="/" Foreground="{StaticResource Text.Secondary}"/>
                                    <Run Text="{Binding DraftPct, StringFormat='\{0:P0\}', Mode=OneWay}" Foreground="#7C3AED"/>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource MetricCompare}" Margin="6,2,0,2"
                                           Text="{Binding DataContext.AvgEngPct, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='vs {0:P0}'}"/>
                                <!-- spacer row 3 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Inspection Hrs" Style="{StaticResource MetricLabel}" ToolTip="Hours charged to inspection labor code (LaborCode 40). Field reviews and site visits."/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InspHrs, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Total Inspections" Style="{StaticResource MetricLabel}" ToolTip="Total number of site inspections — each time entry with LaborCode 40 counts as one inspection visit."/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TotalInspections, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Inspections Last Month" Style="{StaticResource MetricLabel}" ToolTip="Number of inspections in the previous calendar month."/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastMonthInspections, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Doc Prep" Style="{StaticResource MetricLabel}" ToolTip="Hours charged to document preparation (LaborCode 50). Specs, reports, submittals."/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DocPrepHrs, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="General" Style="{StaticResource MetricLabel}" ToolTip="Hours charged to general labor code (LaborCode 60). Coordination, meetings, project management."/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding GenHrs, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Admin" Style="{StaticResource MetricLabel}" ToolTip="Hours charged to admin labor code (LaborCode 70). Administrative tasks."/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding AdminHrs, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Non-Billable" Style="{StaticResource MetricLabel}" ToolTip="Hours charged to non-billable labor code (LaborCode 80). Internal work, rework, training."/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding NonBillHrs, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <!-- spacer row 11 -->
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Total (all codes)" Style="{StaticResource MetricLabel}" FontWeight="SemiBold" ToolTip="Sum of all labor codes. Engineering includes checking hours."/>
                                <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding TotalAllHrs, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}" FontWeight="Bold"/>
                            </Grid>

                            <!-- ── BUDGET ESTIMATION ── -->
                            <Border Style="{StaticResource SectionBorder}" BorderBrush="#7C3AED" Margin="0,8,0,6">
                                <TextBlock Text="BUDGET ESTIMATION (peer-based)" Style="{StaticResource SectionHeader}"/>
                            </Border>
                            <TextBlock Text="Estimated from median hours of similar closed projects (fee ±50%, same construction type/phase). Falls back to formula if fewer than 3 peers found."
                                       FontSize="10" Foreground="{StaticResource Text.Secondary}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Peers Used" Style="{StaticResource MetricLabel}" ToolTip="Number of similar closed projects used for the estimate. 0 = no peers found, fell back to formula. 3-8 = peer-based median."/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricValue}">
                                    <TextBlock.Text>
                                        <Binding Path="BudgetPeerCount" Mode="OneWay" StringFormat="{}{0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Est Eng Budget" Style="{StaticResource MetricLabel}" ToolTip="Median engineering hours from similar closed projects (same fee range, construction type, phase). Falls back to formula if &lt;3 peers. Purple = estimated."/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EstEngBudget, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}" Foreground="#7C3AED"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Est Draft Budget" Style="{StaticResource MetricLabel}" ToolTip="Median drafting hours from similar closed projects (same fee range, construction type, phase). Falls back to formula if &lt;3 peers. Purple = estimated."/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EstDraftBudget, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}" Foreground="#7C3AED"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MetricLabel}" ToolTip="Estimated eng budget minus actual eng hours. Positive = estimate predicted more hours than were used (conservative). Negative = actual hours exceeded the estimate (under-predicted).">
                                    <Run Text="Eng Δ"/><Run Text=" (est − actual)" FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EngBudgetDelta, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource MetricLabel}" ToolTip="Estimated draft budget minus actual draft hours. Positive = conservative estimate. Negative = under-predicted.">
                                    <Run Text="Draft Δ"/><Run Text=" (est − actual)" FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DraftBudgetDelta, StringFormat='\{0:N0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                            </Grid>

                            <!-- ── A/R AGING ── -->
                            <Border Style="{StaticResource SectionBorder}" BorderBrush="#EA580C" Margin="0,8,0,6">
                                <TextBlock Text="ACCOUNTS RECEIVABLE" Style="{StaticResource SectionHeader}"/>
                            </Border>
                            <TextBlock Text="Unpaid invoices for this project. 90+ days is a collection risk — consider following up."
                                       FontSize="10" Foreground="{StaticResource Text.Secondary}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="AR Outstanding" Style="{StaticResource MetricLabel}" FontWeight="SemiBold" ToolTip="Total unpaid invoice balances for this project."/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ArTotal, StringFormat='$\{0:#,##0\}', Mode=OneWay}" Style="{StaticResource MetricValue}" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Current (0-30d)" Style="{StaticResource MetricLabel}" ToolTip="Invoices due within the last 30 days. Normal — not yet overdue."/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ArCurrent, StringFormat='$\{0:#,##0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="31-60 days" Style="{StaticResource MetricLabel}" ToolTip="Invoices 31-60 days past due. Starting to age — follow up."/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Ar31To60, StringFormat='$\{0:#,##0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="61-90 days" Style="{StaticResource MetricLabel}" ToolTip="Invoices 61-90 days past due. Collection risk increases significantly. Escalate."/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Ar61To90, StringFormat='$\{0:#,##0\}', Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="90+ days" Style="{StaticResource MetricLabel}" Foreground="#DC2626" ToolTip="Invoices over 90 days past due. High collection risk — may indicate disputes, billing quality issues, or client financial problems."/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Ar90Plus, StringFormat='$\{0:#,##0\}', Mode=OneWay}" Style="{StaticResource MetricValue}" Foreground="#DC2626"/>
                            </Grid>

                            <!-- ── SIMILAR COMPLETED PROJECTS ── -->
                            <Border Style="{StaticResource SectionBorder}" BorderBrush="#059669" Margin="0,8,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SIMILAR COMPLETED PROJECTS" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Style="{StaticResource MetricLabel}" Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center"
                                               ToolTip="Closed projects with 50+ production hours and fee within ±50%. Matched by phase when possible. These are real projects — the median of their hours is a data-driven estimate.">
                                        <Run Text="Based on"/>
                                        <Run Text="{Binding DataContext.PeerCount, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="peers"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Peer guidance -->
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#166534" Margin="0,0,0,4">
                                <Run FontWeight="SemiBold" Text="⬇ RECOMMENDED ESTIMATE"/>
                                <Run Text="— these are the individual closed projects used to estimate the budget above. The budget section uses their median hours. 5+ peers = good confidence."/>
                            </TextBlock>

                            <!-- Peer estimate summary -->
                            <Border Background="#F0FDF4" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                    ToolTip="Median hours from similar completed projects. This is what projects like this one actually took.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Peer Median Eng Hrs" FontSize="11.5" Foreground="#166534" FontWeight="SemiBold" Margin="0,1"
                                               ToolTip="Median engineering hours from similar completed projects."/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataContext.PeerMedianEngHrs, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='\{0:N0\}', Mode=OneWay}"
                                               FontSize="14" FontWeight="Bold" Foreground="#166534" TextAlignment="Right" Margin="0,1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Peer Median Draft Hrs" FontSize="11.5" Foreground="#166534" Margin="0,1"
                                               ToolTip="Median drafting hours from similar completed projects."/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataContext.PeerMedianDraftHrs, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='\{0:N0\}', Mode=OneWay}"
                                               FontSize="14" FontWeight="Bold" Foreground="#166534" TextAlignment="Right" Margin="0,1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Peer Median Total" FontSize="11.5" Foreground="#166534" FontWeight="SemiBold" Margin="0,1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataContext.PeerMedianTotalHrs, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='\{0:N0\}', Mode=OneWay}"
                                               FontSize="14" FontWeight="Bold" Foreground="#166534" TextAlignment="Right" Margin="0,1"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Peer Median $/Hr" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,1"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DataContext.PeerMedianFeePerHr, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='$\{0:N0\}', Mode=OneWay}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" TextAlignment="Right" Margin="0,1"/>
                                </Grid>
                            </Border>

                            <!-- Peer project list -->
                            <DataGrid ItemsSource="{Binding DataContext.SimilarProjects, RelativeSource={RelativeSource AncestorType=Window}}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E5E7EB" RowHeight="22" FontSize="11"
                                      MaxHeight="200" BorderThickness="1" BorderBrush="#E5E7EB" Background="White"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,8">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#ECFDF5"/>
                                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Project" Binding="{Binding Wbs1}" Width="70"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Fee" Binding="{Binding Fee, StringFormat='$\{0:#,##0\}'}" Width="75">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Eng" Binding="{Binding EngHrs, StringFormat='\{0:N0\}'}" Width="50">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Draft" Binding="{Binding DraftHrs, StringFormat='\{0:N0\}'}" Width="50">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="$/Hr" Binding="{Binding FeePerHr, StringFormat='$\{0:N0\}'}" Width="50">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- ── REVENUE TIMELINE ── -->
                            <Border Style="{StaticResource SectionBorder}" BorderBrush="#0891B2" Margin="0,8,0,6">
                                <TextBlock Text="REVENUE TIMELINE" Style="{StaticResource SectionHeader}"/>
                            </Border>
                            <DataGrid ItemsSource="{Binding RevenueTimeline}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E5E7EB" RowHeight="20" FontSize="11"
                                      MaxHeight="180" BorderThickness="1" BorderBrush="#E5E7EB" Background="White"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,4">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#ECFEFF"/>
                                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="70"
                                                        ToolTipService.ToolTip="Accounting period (YYYYMM format)"/>
                                    <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat='$\{0:#,##0\}'}" Width="*"
                                                        ToolTipService.ToolTip="Revenue earned/recognized in this period">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Billed" Binding="{Binding Billed, StringFormat='$\{0:#,##0\}'}" Width="*"
                                                        ToolTipService.ToolTip="Amount invoiced to client in this period">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Row 3: Status bar ═══ -->
        <Border Grid.Row="3" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                <ProgressBar x:Name="LoadingBar" Width="120" Height="4" Margin="12,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <ctrl:AiQueryPanel x:Name="AiPanel" Grid.Row="4"/>
    </Grid>
</Window>
