<Window x:Class="Kor.Operations.PMTools.PmToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:fin="clr-namespace:Kor.Operations.Financials"
        xmlns:converters="clr-namespace:Kor.Operations.Converters"
        Title="KOR NewerForma - PM Tools"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1650"
        MinWidth="1400"
        Height="900"
        SizeToContent="Manual"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ToolTipService.InitialShowDelay="200">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:IsPositiveConverter x:Key="IsPositiveConverter"/>
        <Style x:Key="SectionTabButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8FAFC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFF1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhaseFilterButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Panel.Border}"/>
        </Style>
        <Style x:Key="RiskCell" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <controls:KorHeader x:Name="HeaderBar"
                                HeaderText="PM Tools"
                                SubtitleText="Project delivery health, capacity risk, and team workload."
                                AvatarDiameter="96"
                                AvatarBorderThickness="2"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Last refreshed:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastRefreshedDisplay}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusHint}" Margin="16,0,0,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Width="96"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="RefreshBtn_Click"
                        IsEnabled="{Binding CanRefresh}"/>
                <Button Grid.Column="2"
                        Content="Close"
                        Width="84"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Background="#FFFDE8E8"
                BorderBrush="#FFCC5C5C"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,8"
                Visibility="{Binding ErrorVisibility}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="3"
                Background="#FFFEF3C7"
                BorderBrush="#FFF59E0B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,8"
                Visibility="{Binding MyProjectsWarningVisibility}">
            <TextBlock Text="{Binding MyProjectsWarning}" TextWrapping="Wrap"/>
        </Border>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="Active Projects" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalProjects}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="At Risk / Critical" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                        <TextBlock FontWeight="SemiBold" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding AtRiskOrCriticalCount}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AtRiskOrCriticalCount, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,24,0">
                        <TextBlock Text="Eng Hours Remaining" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalEngHoursRemaining, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,24,0">
                        <TextBlock Text="Draft Hours Remaining" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalDraftHoursRemaining, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Over Eng Budget" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                        <TextBlock FontWeight="SemiBold" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding OverEngBudgetCount}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverEngBudgetCount, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                      <Grid Grid.Row="0" Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Phase:" Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="All" Click="PhaseAll_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhaseAll}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="SD" Click="PhaseSD_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhaseSD}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="DD" Click="PhaseDD_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhasDD}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="CD" Click="PhaseCD_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhaseCD}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                              <Button Content="CA" Click="PhaseCA_Click">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhaseCA}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                              <TextBlock Text="Sort:" Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                              <Button Content="Fee" Click="SortByFee_Click">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSortFee}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                              <Button Content="Name" Click="SortByName_Click">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSortName}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                              <Button Content="At Risk" Click="SortByAtRisk_Click">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSortAtRisk}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Margin="0,0,16,0">
                              <TextBlock Text="Search" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                              <TextBox Width="240" MinHeight="32" VerticalContentAlignment="Center" Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                              <CheckBox Content="My Projects only" VerticalAlignment="Center" IsChecked="{Binding ShowMyProjectsOnly}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Margin="12,0,0,0">
                              <Button Content="Export to Excel"
                                      Height="32"
                                      MinWidth="140"
                                      Click="ExportPmGroupsBtn_Click"
                                      IsEnabled="{Binding CanExportPmGroups}"/>
                          </StackPanel>
                      </Grid>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PmGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            BorderBrush="{StaticResource Panel.Border}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Background="#FFFFFFFF">
                                        <StackPanel>
                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Width="28"
                                                        Height="28"
                                                        Margin="0,0,10,0"
                                                        Padding="0"
                                                        Tag="{Binding}"
                                                        Click="PmGroupExpand_Click"
                                                        Style="{StaticResource Button.Secondary}">
                                                    <TextBlock Text="{Binding ExpandIcon}"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PmName}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding ProjectCount, StringFormat={}{0} projects}"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Fee" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                                    <TextBlock Text="{Binding TotalFee, StringFormat={}{0:C0}}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Eng Hrs / Budget" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding TotalEngHrs, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding TotalEngBudget, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Draft Hrs / Budget" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding TotalDraftHrs, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding TotalDraftBudget, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="6"
                                                        Margin="12,0,0,0"
                                                        Padding="10,5"
                                                        CornerRadius="999"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AtRiskOrCriticalCount, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Healthy"/>
                                                                <Setter Property="Foreground" Value="#166534"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AtRiskOrCriticalCount, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding AtRiskOrCriticalCount, StringFormat={}{0} at risk}"/>
                                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <DataGrid AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      CanUserSortColumns="True"
                                                      HeadersVisibility="Column"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      RowHeight="28"
                                                      ItemsSource="{Binding Projects}"
                                                      MouseDoubleClick="ProjectGrid_MouseDoubleClick"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <DataGrid.Resources>
                                                    <SolidColorBrush x:Key="PmProj.Row.Red" Color="#FEE2E2"/>
                                                    <SolidColorBrush x:Key="PmProj.Row.Yellow" Color="#FEF3C7"/>
                                                    <SolidColorBrush x:Key="PmProj.Row.Orange" Color="#FFEDD5"/>
                                                    <SolidColorBrush x:Key="PmProj.Row.Green" Color="#DCFCE7"/>
                                                    <SolidColorBrush x:Key="PmProj.Conf.Red" Color="#B91C1C"/>
                                                    <SolidColorBrush x:Key="PmProj.Conf.Orange" Color="#C2410C"/>
                                                    <SolidColorBrush x:Key="PmProj.Conf.Yellow" Color="#A16207"/>
                                                    <SolidColorBrush x:Key="PmProj.Conf.Green" Color="#166534"/>
                                                </DataGrid.Resources>
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                <Setter Property="Background" Value="{StaticResource PmProj.Row.Red}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                <Setter Property="Background" Value="{StaticResource PmProj.Row.Yellow}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                <Setter Property="Background" Value="{StaticResource PmProj.Row.Orange}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                                                <Setter Property="Background" Value="{StaticResource PmProj.Row.Green}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Project #" Binding="{Binding Wbs1}" Width="100"/>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                                                    <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="95"/>
                                                    <DataGridTextColumn Header="Drafting Mgr" Binding="{Binding DraftingManager}" Width="150"/>
                                                    <DataGridTextColumn Header="Eng Hrs" Binding="{Binding EngHrs, StringFormat={}{0:N1}}" Width="80"/>
                                                    <DataGridTextColumn Header="Eng Budget" Binding="{Binding EngBudget, StringFormat={}{0:N1}}" Width="95"/>
                                                    <DataGridTextColumn Header="Eng %" Binding="{Binding EngPercent, StringFormat={}{0:P1}}" Width="75"/>
                                                    <DataGridTemplateColumn Header="Eng Remaining" Width="110" SortMemberPath="RemainingEngHours">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding RemainingEngHours, StringFormat={}{0:N1}}"
                                                                           Padding="4,0"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEngOverBudget}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Draft Hrs" Binding="{Binding DraftHrs, StringFormat={}{0:N1}}" Width="80"/>
                                                    <DataGridTextColumn Header="Draft Budget" Binding="{Binding DraftBudget, StringFormat={}{0:N1}}" Width="95"/>
                                                    <DataGridTextColumn Header="Draft %" Binding="{Binding DraftPercent, StringFormat={}{0:P1}}" Width="75"/>
                                                    <DataGridTemplateColumn Header="Draft Remaining" Width="110" SortMemberPath="RemainingDraftHours">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding RemainingDraftHours, StringFormat={}{0:N1}}"
                                                                           Padding="4,0"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDraftOverBudget}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Chk" Binding="{Binding ChkHrs, StringFormat={}{0:N1}}" Width="60"/>
                                                    <DataGridTextColumn Header="Insp" Binding="{Binding InspHrs, StringFormat={}{0:N1}}" Width="60"/>
                                                    <DataGridTemplateColumn Header="Delivery Risk" Width="145" SortMemberPath="ConfidenceLevel">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding DeliveryRiskTooltip}">
                                                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Fill" Value="{StaticResource PmProj.Conf.Green}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                                        <Setter Property="Fill" Value="{StaticResource PmProj.Conf.Red}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                                        <Setter Property="Fill" Value="{StaticResource PmProj.Conf.Orange}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                                        <Setter Property="Fill" Value="{StaticResource PmProj.Conf.Yellow}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <TextBlock Text="{Binding DeliveryRisk}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource PmProj.Conf.Green}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                                        <Setter Property="Foreground" Value="{StaticResource PmProj.Conf.Red}"/>
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                                        <Setter Property="Foreground" Value="{StaticResource PmProj.Conf.Orange}"/>
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                                        <Setter Property="Foreground" Value="{StaticResource PmProj.Conf.Yellow}"/>
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <GridSplitter Grid.Row="2" Height="5" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center" Cursor="SizeNS"
                          Background="{StaticResource Panel.Border}"/>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CapacityRiskTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CapacityRiskSubtitle}" Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FFFFFFFF" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Engineering" MinWidth="130" Click="ShowEngineeringCapacityRisk_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsEngineeringCapacitySelected}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Border Grid.Column="1" Width="1" Background="{StaticResource Panel.Border}"/>
                                <Button Grid.Column="2" Content="Drafting" MinWidth="110" Click="ShowDraftingCapacityRisk_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsDraftingCapacitySelected}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="PM" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                            <ComboBox Width="210" MinHeight="32" ItemsSource="{Binding UtilizationPmOptions}" SelectedItem="{Binding SelectedUtilizationPm}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="Risk" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                            <ComboBox Width="160" MinHeight="32" ItemsSource="{Binding UtilizationRiskOptions}" SelectedItem="{Binding SelectedUtilizationRisk}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                            <TextBlock Text="Search" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                            <TextBox Width="280" MinHeight="32" VerticalContentAlignment="Center" Text="{Binding UtilizationSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <Button Content="Export to Excel" Height="32" MinWidth="140" Click="ExportUtilizationBtn_Click" IsEnabled="{Binding CanExportUtilization}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="UtilizationGrid"
                                  MaxHeight="400"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Disabled"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  RowHeight="28"
                                  ItemsSource="{Binding UtilizationView}"
                                  MouseDoubleClick="UtilizationGrid_MouseDoubleClick">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineeringCapacitySelected}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="Util.Row.Red" Color="#FEE2E2"/>
                                <SolidColorBrush x:Key="Util.Row.Amber" Color="#FEF3C7"/>
                                <SolidColorBrush x:Key="Util.Row.Green" Color="#DCFCE7"/>
                                <SolidColorBrush x:Key="Util.Conf.Red" Color="#B91C1C"/>
                                <SolidColorBrush x:Key="Util.Conf.Orange" Color="#C2410C"/>
                                <SolidColorBrush x:Key="Util.Conf.Yellow" Color="#A16207"/>
                                <SolidColorBrush x:Key="Util.Conf.Green" Color="#166534"/>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="Over budget">
                                            <Setter Property="Background" Value="{StaticResource Util.Row.Red}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="At risk">
                                            <Setter Property="Background" Value="{StaticResource Util.Row.Amber}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="Healthy">
                                            <Setter Property="Background" Value="{StaticResource Util.Row.Green}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="260"/>
                                <DataGridTextColumn Header="PM" Binding="{Binding Pm}" Width="160"/>
                                <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="110"/>
                                <DataGridTextColumn Header="Eng Budget" Binding="{Binding EngBudget, StringFormat={}{0:N1}}" Width="110"/>
                                <DataGridTextColumn Header="Eng Hours" Binding="{Binding EngHours, StringFormat={}{0:N1}}" Width="110"/>
                                <DataGridTextColumn Header="Remaining Eng Hours" Binding="{Binding RemainingEngHours, StringFormat={}{0:N1}}" Width="120"/>
                                <DataGridTextColumn Header="Engineering Budget Used (%)" Binding="{Binding PercentEngUsed, StringFormat={}{0:P1}}" Width="100"/>
                                <DataGridTemplateColumn Header="Delivery Risk" Width="150" SortMemberPath="ConfidenceLevel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding DeliveryConfidenceTooltip}">
                                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource Util.Conf.Green}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                    <Setter Property="Fill" Value="{StaticResource Util.Conf.Red}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                    <Setter Property="Fill" Value="{StaticResource Util.Conf.Orange}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                    <Setter Property="Fill" Value="{StaticResource Util.Conf.Yellow}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding ConfidenceDisplay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Util.Conf.Green}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Util.Conf.Red}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Util.Conf.Orange}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Util.Conf.Yellow}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid x:Name="DraftUtilizationGrid"
                                  MaxHeight="400"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Disabled"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  RowHeight="28"
                                  ItemsSource="{Binding DraftUtilizationView}"
                                  MouseDoubleClick="DraftUtilizationGrid_MouseDoubleClick">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDraftingCapacitySelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="DraftUtil.Row.Red" Color="#FEE2E2"/>
                                <SolidColorBrush x:Key="DraftUtil.Row.Amber" Color="#FEF3C7"/>
                                <SolidColorBrush x:Key="DraftUtil.Row.Green" Color="#DCFCE7"/>
                                <SolidColorBrush x:Key="DraftUtil.Conf.Red" Color="#B91C1C"/>
                                <SolidColorBrush x:Key="DraftUtil.Conf.Orange" Color="#C2410C"/>
                                <SolidColorBrush x:Key="DraftUtil.Conf.Yellow" Color="#A16207"/>
                                <SolidColorBrush x:Key="DraftUtil.Conf.Green" Color="#166534"/>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="Over budget">
                                            <Setter Property="Background" Value="{StaticResource DraftUtil.Row.Red}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="At risk">
                                            <Setter Property="Background" Value="{StaticResource DraftUtil.Row.Amber}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="Healthy">
                                            <Setter Property="Background" Value="{StaticResource DraftUtil.Row.Green}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="260"/>
                                <DataGridTextColumn Header="PM" Binding="{Binding Pm}" Width="160"/>
                                <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="110"/>
                                <DataGridTextColumn Header="Draft Budget" Binding="{Binding DraftBudget, StringFormat={}{0:N1}}" Width="110"/>
                                <DataGridTextColumn Header="Draft Hours" Binding="{Binding DraftHours, StringFormat={}{0:N1}}" Width="110"/>
                                <DataGridTextColumn Header="Remaining Draft Hours" Binding="{Binding RemainingDraftHours, StringFormat={}{0:N1}}" Width="120"/>
                                <DataGridTextColumn Header="Drafting Budget Used (%)" Binding="{Binding PercentDraftUsed, StringFormat={}{0:P1}}" Width="100"/>
                                <DataGridTemplateColumn Header="Delivery Risk" Width="150" SortMemberPath="ConfidenceLevel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding DeliveryConfidenceTooltip}">
                                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource DraftUtil.Conf.Green}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                    <Setter Property="Fill" Value="{StaticResource DraftUtil.Conf.Red}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                    <Setter Property="Fill" Value="{StaticResource DraftUtil.Conf.Orange}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                    <Setter Property="Fill" Value="{StaticResource DraftUtil.Conf.Yellow}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding ConfidenceDisplay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource DraftUtil.Conf.Green}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DraftUtil.Conf.Red}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DraftUtil.Conf.Orange}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DraftUtil.Conf.Yellow}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
