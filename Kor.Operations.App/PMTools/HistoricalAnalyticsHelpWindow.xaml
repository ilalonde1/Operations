<Window x:Class="Kor.Operations.PMTools.HistoricalAnalyticsHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historical Project Analytics — How It Works"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="720" Height="700" MinWidth="500" MinHeight="400"
        ToolTipService.InitialShowDelay="200">
    <Border Style="{StaticResource Card}" Margin="16" Padding="24,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="How This Tool Works" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4"/>
                <TextBlock Text="A plain-English guide to every number on this page." FontSize="13" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                <!-- WHERE THE DATA COMES FROM -->
                <TextBlock Text="WHERE THE DATA COMES FROM" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6"/>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,16">
                    Everything is pulled live from Deltek Vantagepoint via ODBC. Project info comes from the PR table. Hours come from tkDetail (timesheets). Fee billed comes from PRSummaryMain. Subconsultant costs come from apDetail. AR aging comes from the AR table. Nothing is estimated except the budget numbers (see below). If a number looks wrong, the source is Deltek.
                </TextBlock>

                <!-- THE PROJECT LIST -->
                <TextBlock Text="THE PROJECT LIST" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6"/>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,16">
                    The left panel shows every project matching your filters. Click any row to see full details on the right. Key columns:

                    • Fee — total project fee from Deltek
                    • Billed — % of fee invoiced to date
                    • E/D — engineering hours as a % of production hours (eng + draft)
                    • $/Hr — fee divided by production hours. How much the firm earns per hour of eng+draft work
                    • Net$/Hr — (fee minus subconsultant costs) divided by production hours. This is the REAL rate after paying subs. This is the number that matters for profitability
                    • Sub% — what percentage of the fee went to subconsultants
                    • Duration — months from project open to close (or to today if still active)
                </TextBlock>

                <!-- ROW COLORS -->
                <TextBlock Text="ROW COLORS — WHAT THEY MEAN" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6"/>
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#FEF2F2" CornerRadius="3" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Red background:"/> Net $/Hr is below the 25th percentile. This project earns less per hour than 75% of the portfolio. Could be a pricing issue, scope creep, or too many hours for the fee.
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#FFFBEB" CornerRadius="3" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Amber background:"/> Over 40% of the fee went to subconsultants. The firm keeps less of each dollar. Not necessarily bad — some projects need subs — but worth knowing.
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="White" CornerRadius="3" Width="16" Height="16" Margin="0,0,8,0" BorderBrush="#FCA5A5" BorderThickness="1"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="#DC2626" Text="Red text:"/> Invoices more than 90 days past due. Collection risk. May need a call to the client.
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- BUDGET FORMULA -->
                <TextBlock Text="THE BUDGET FORMULA — HOW ESTIMATED HOURS ARE CALCULATED" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6"/>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6">
                    When Deltek has no budgeted hours for a project (no PRLabor record), the app estimates them from the project fee. Here's how:
                </TextBlock>
                <Border Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4">
                            Step 1: Get the target billing rate
                        </TextBlock>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8">
                            The default is $185/hr — the portfolio median from projects with 50+ production hours. This can be adjusted in PM Tools using the rate inputs and Recalculate button. The Fee Bands view in Historical Analytics shows how $/hr varies by project size, which can inform what target to use.
                        </TextBlock>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4">
                            Step 2: Calculate total estimated hours
                        </TextBlock>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8">
                            Total Hours = Fee ÷ Target $/hr. A $200K project at $185/hr = 1,081 total hours.
                        </TextBlock>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4">
                            Step 3: Split between Engineering and Drafting
                        </TextBlock>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap">
                            Historical data shows 58% of production hours are engineering, 42% are drafting. The Eng Rate (474) and Draft Rate (655) control this split through a harmonic mean formula. These can be adjusted in PM Tools and recalculated.
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,16">
                    Estimated budgets show in purple with an asterisk (*) in the PM Tools grid. Projects with actual Deltek budgets (PRLabor records) are never affected by the formula.
                </TextBlock>

                <!-- SIMILAR PROJECTS -->
                <TextBlock Text="SIMILAR COMPLETED PROJECTS — THE MOST USEFUL NUMBER ON THIS PAGE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6"/>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6">
                    When you click a project, the detail card shows the most similar completed projects from the firm's history. "Similar" means:
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="12,0,0,4">
                    • Closed/inactive (so the hours are final, not still growing)
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="12,0,0,4">
                    • Fee within ±50% of the selected project
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="12,0,0,4">
                    • Same phase (SD/DD/CD/CA) when possible — falls back to all phases if fewer than 3 matches
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="12,0,0,4">
                    • 50+ production hours (eliminates trivial projects)
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,4">
                    The green box shows the median eng hours, draft hours, and total hours from those peers. This is a data-driven estimate — not a formula, but actual hours from real projects. The list below shows each peer so you can see the range and judge for yourself.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,16">
                    If you see "Based on 12 peers" you can trust the estimate. If it says "Based on 2 peers" take it with a grain of salt — there just aren't enough similar projects to be confident.
                </TextBlock>

                <!-- CONSTRUCTION TYPE, CATEGORY, DRAFTING TYPE -->
                <TextBlock Text="CONSTRUCTION TYPE, PROJECT CATEGORY, DRAFTING TYPE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6"/>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    Three project classification fields from Deltek:
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="12,0,0,4">
                    <Run FontWeight="SemiBold">Construction Type</Run> — the structural system (Concrete Highrise, Woodframe, Structural Steel, etc.). This is the most important classification for comparing project economics. A concrete highrise has a very different hour profile and $/hr than a woodframe building. Use the "Construction Type" view mode to see the breakdown.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="12,0,0,4">
                    <Run FontWeight="SemiBold">Project Category</Run> — Large Project, Small Project, or Report. Use as a filter to isolate project sizes.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run FontWeight="SemiBold">Drafting Type</Run> — CAD, RV (Revit), or General. Use as a filter to compare CAD vs Revit project performance.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,16">
                    All three appear as filter dropdowns in the toolbar and as colored badges in the project detail card. The Similar Projects feature also prefers matching construction type when finding peer projects.
                </TextBlock>

                <!-- VIEW MODES -->
                <TextBlock Text="THE FOUR VIEW MODES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6"/>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run FontWeight="SemiBold">Projects</Run> — every project, one row each. Click to see details. This is where you dig into individual projects.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run FontWeight="SemiBold">PM Summary</Run> — groups all projects by project manager. Shows each PM's total fee managed, avg $/hr, eng/draft split, AR outstanding.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run FontWeight="SemiBold">DM Summary</Run> — same as PM Summary but grouped by drafting manager.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run FontWeight="SemiBold">Employee Summary</Run> — shows every person who logged hours. Total hours includes ALL time (including overhead, vacation, sick). Billable % shows what share of their time went to real projects vs overhead. The "Fee Attributed" column gives each person credit proportional to their share of each project's production hours. $/Hr shows how much fee revenue they generate per hour of work.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run FontWeight="SemiBold">Fee Bands</Run> — groups projects by fee size ($0-$25K, $25K-$50K, etc). Shows how metrics change with project size. The "Med $/Hr" column shows the median billing rate for each band — these are the rates used in the budget formula.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,16">
                    <Run FontWeight="SemiBold">YoY Trend</Run> — groups projects by the year they were opened. Shows how the firm's metrics are changing over time. Are we getting more efficient? Is $/hr going up or down?
                </TextBlock>

                <!-- DATA QUALITY -->
                <TextBlock Text="DATA QUALITY — WHY SOME PROJECTS ARE EXCLUDED" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6"/>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    The "Data" filter controls which projects are included. Default is "Has Hours + Fee" which excludes test projects, admin codes, and projects with no hours. For meaningful analysis, use "Fee ≥ $25K + Hours" to focus on real projects.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    $/hr statistics only include projects with 50+ production hours. Projects with 5 hours and $200K fee would show $40,000/hr which is meaningless.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                    All portfolio comparisons use median (not mean/average). One outlier project can't distort the whole picture.
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,16">
                    Budget accuracy is only measured against closed/inactive projects. Active projects have incomplete hours — comparing them to total-project estimates is meaningless.
                </TextBlock>

                <!-- GLOSSARY -->
                <TextBlock Text="GLOSSARY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Fee" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Total project fee from Deltek." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Net Fee" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Fee minus subconsultant costs. What the firm actually keeps." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="$/Hr" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Fee ÷ production hours (eng + draft). Gross billing rate." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Net $/Hr" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Net fee ÷ production hours. The real rate after paying subs." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Eng / Draft" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Engineering hours vs drafting hours as percentages of production time." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Overhead" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Hours logged to overhead/admin project numbers (99XXX — General Overhead, Vacation, Sick, CPD, Statutory Holiday, etc.) as a percentage of total hours." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Billable %" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Hours on real billable projects ÷ total hours. Non-billable = any time logged to overhead project numbers (99XXX codes like General Overhead, Vacation, Sick Leave, CPD, Business Development). If someone logs 500 total hours but 200 are on 99XXX projects, their billable % is 60%." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Budget Accuracy" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Of closed projects with 50+ eng hours, what % had actual hours within ±35% of the formula estimate." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Eng Δ / Draft Δ" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Estimated budget minus actual hours. Positive = formula overestimated (conservative). Negative = actual exceeded estimate." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="P25 / P75" FontWeight="SemiBold" FontSize="11.5" Margin="0,2"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="25th and 75th percentile. P25 = 25% of projects are below this. P75 = 25% are above. The range between them is where most projects fall." FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                </Grid>

                <Button Content="Close" Width="100" Height="32" HorizontalAlignment="Right"
                        Style="{StaticResource Button.Secondary}" Click="CloseBtn_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
