<Window x:Class="Kor.Operations.PMTools.WorkloadMeetingWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="KOR NewerForma — Workload Meeting"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1280"
        MinWidth="900"
        Height="780"
        SizeToContent="Manual"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <!-- Round 38b — extracted from the top half of the legacy PmToolsWindow
         (Workload Meeting + bi-weekly priorities). The meeting ViewModel is
         a Singleton (see AppModule Round 38a) so the live priority link with
         PmCapacityWindow continues to work: priority changes flow through the
         shared VM and the capacity window's row badges update on the same
         PropertyChanged tick. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FECACA"/>
                    <Setter Property="BorderBrush" Value="#F87171"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FCA5A5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SortHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#374151"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header band -->
        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <controls:KorHeader x:Name="HeaderBar"
                                HeaderText="Workload Meeting"
                                SubtitleText="Bi-weekly meeting board, priority projects, and per-project notes."
                                AvatarDiameter="96"
                                AvatarBorderThickness="2"/>
        </StackPanel>

        <!-- Action strip: Refresh meetings list + Close -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Bi-weekly Workload Meeting — priorities, contacts &amp; notes."
                           Foreground="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Width="96"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="RefreshBtn_Click"/>
                <Button Grid.Column="2"
                        Content="Close"
                        Width="84"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>

        <!-- Meeting panel (extracted from PmToolsWindow.xaml Row 0 inner Grid).
             DataContext is the shared meeting ViewModel set in code-behind. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header row -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Bi-Weekly Meeting:" Foreground="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Meetings}"
                                  SelectedItem="{Binding SelectedMeeting}"
                                  MinWidth="160" Height="32" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MeetingDate, StringFormat={}{0:MMM d, yyyy}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1" Content="New Meeting"
                            Height="32" Margin="0,0,8,0"
                            Style="{StaticResource Button.Accent}"
                            Command="{Binding NewMeetingCommand}"/>
                    <Button Grid.Column="2" Content="Delete Meeting"
                            Height="32" Margin="0,0,12,0"
                            Click="DeleteMeetingBtn_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMeeting}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Grid.Column="3"
                               Text="(Viewing past meeting — read only)"
                               Foreground="#F59E0B" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingPastMeeting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActivityText}"
                                   Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding MeetingError}"
                                   Foreground="#B91C1C" FontSize="11" TextWrapping="Wrap" MaxWidth="220"
                                   Visibility="{Binding HasMeetingError, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <Button Grid.Column="6"
                            Content="Save Meeting"
                            Height="32" Margin="8,0,8,0"
                            Command="{Binding SaveMeetingCommand}"
                            ToolTip="Flush all unsaved notes to the database now">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Danger}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentMeeting}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="7"
                            Content="Export to Excel"
                            Height="32" Margin="0,0,8,0"
                            Style="{StaticResource Button.Secondary}"
                            Click="ExportMeetingBtn_Click"
                            IsEnabled="{Binding HasPriorityProjects}"
                            ToolTip="Export this meeting to a formatted Excel workbook"/>
                    <Button Grid.Column="8"
                            Content="{Binding MeetingPanelToggleLabel}"
                            Height="32"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ToggleMeetingPanelCommand}"
                            MinWidth="160"/>
                </Grid>

                <!-- Priority projects board -->
                <Grid Grid.Row="1" Margin="0,0,0,10"
                      Visibility="{Binding IsMeetingPanelExpanded, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column headers -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding PrioritySortHeader}"
                                Command="{Binding SortCommand}" CommandParameter="Priority"
                                Style="{StaticResource SortHeaderButton}"/>
                        <Button Grid.Column="1" Content="{Binding ProjectSortHeader}"
                                Command="{Binding SortCommand}" CommandParameter="Project"
                                Style="{StaticResource SortHeaderButton}" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="{Binding PmSortHeader}"
                                Command="{Binding SortCommand}" CommandParameter="PM"
                                Style="{StaticResource SortHeaderButton}"/>
                        <TextBlock Grid.Column="3" Text="Notes" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                    </Grid>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                               Text="No priority projects yet. Use the PM Capacity &amp; Risk window's per-row Priority dropdown to assign P1–P5."
                               Foreground="{StaticResource Text.Secondary}" FontSize="11" FontStyle="Italic"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPriorityProjects}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Prioritized projects list -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasPriorityProjects, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding PriorityProjects}"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Priority badge -->
                                            <Border Grid.Column="0" Background="{Binding PriorityBrush}"
                                                    CornerRadius="4" Padding="8,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PriorityLabel}" Foreground="White"
                                                           FontWeight="Bold" FontSize="13"/>
                                            </Border>

                                            <!-- Project number + name -->
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Wbs1}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding ProjectName}" FontSize="11"
                                                           Foreground="#374151" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- PM name -->
                                            <TextBlock Grid.Column="2" Text="{Binding PmName}" FontSize="12"
                                                       Foreground="#374151" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>

                                            <!-- Per-project notes -->
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" MinHeight="56"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalAlignment="Stretch"
                                                     IsEnabled="{Binding DataContext.IsCurrentMeeting, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     ToolTip="Notes for this project — saved automatically"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Overall meeting notes (secondary) -->
                <Grid Grid.Row="2"
                      Visibility="{Binding IsMeetingPanelExpanded, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Overall Notes:" Foreground="{StaticResource Text.Secondary}"
                               FontSize="11" VerticalAlignment="Top" Margin="0,5,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding MeetingNotes, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="72" MaxHeight="160" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             IsEnabled="{Binding IsCurrentMeeting}"
                             VerticalContentAlignment="Top"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
