<Window x:Class="Kor.Operations.PMTools.WorkloadMeetingWindow"
        x:ClassModifier="internal"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:fin="clr-namespace:Kor.Operations.Financials"
        xmlns:bus="clr-namespace:Kor.Operations.Financials;assembly=Kor.Operations.Business"
        xmlns:converters="clr-namespace:Kor.Operations.Converters"
        Title="KOR NewerForma - Workload Meeting"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1650"
        MinWidth="1400"
        Height="900"
        SizeToContent="Manual"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ToolTipService.InitialShowDelay="200">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:IsPositiveConverter x:Key="IsPositiveConverter"/>
        <!-- Round 52: Meeting Mode plumbing. The proxy's Data is assigned to the
             meeting VM in the window ctor; DataGrid columns bind through it
             because they sit outside the visual tree. -->
        <converters:BindingProxy x:Key="MeetingPanelProxy"/>
        <converters:BoolToCollapsedConverter x:Key="BoolToCollapsed"/>
        <fin:PercentToWidthConverter x:Key="PctToWidth"/>
        <fin:PercentToStarGridLengthConverter x:Key="PctToStar"/>
        <fin:StringToBrushConverter x:Key="StringToBrush"/>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="i"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTabButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8FAFC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFF1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FECACA"/>
                    <Setter Property="BorderBrush" Value="#F87171"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FCA5A5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SortHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#374151"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhaseFilterButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Panel.Border}"/>
        </Style>
        <Style x:Key="RiskCell" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <controls:KorHeader x:Name="HeaderBar"
                                HeaderText="Workload Meeting"
                                SubtitleText="Bi-weekly meeting board with priorities, plus the PM-by-PM project portfolio."
                                AvatarDiameter="96"
                                AvatarBorderThickness="2"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Last refreshed:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastRefreshedDisplay}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StalenessWarning}"
                               Margin="10,0,0,0"
                               Foreground="#F59E0B"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsDataStale, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding StatusHint}" Margin="16,0,0,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="KPI Dictionary"
                        MinWidth="130"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="KpiDictionaryBtn_Click"/>
                <Button Grid.Column="2"
                        Content="Refresh"
                        Width="96"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="RefreshBtn_Click"
                        IsEnabled="{Binding CanRefresh}"/>
                <Button Grid.Column="3"
                        Content="Close"
                        Width="84"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Background="#FFFDE8E8"
                BorderBrush="#FFCC5C5C"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,8"
                Visibility="{Binding ErrorVisibility}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="3"
                Background="#FFFEF3C7"
                BorderBrush="#FFF59E0B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,8"
                Visibility="{Binding MyProjectsWarningVisibility}">
            <TextBlock Text="{Binding MyProjectsWarning}" TextWrapping="Wrap"/>
        </Border>
        <!-- Round 51: restore proportional rows + GridSplitter (lost when R48b
             rebuilt this window). Meeting board top, draggable separator,
             KPI/Health/PM-Groups scroll area bottom — same shape as the
             pre-split PmToolsWindow had. -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="360*" MinHeight="120"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="700*" MinHeight="200"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"
                    DataContext="{Binding MeetingPanel, ElementName=RootWindow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Bi-Weekly Meeting:" Foreground="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Meetings}"
                                      SelectedItem="{Binding SelectedMeeting}"
                                      MinWidth="160" Height="32" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MeetingDate, StringFormat={}{0:MMM d, yyyy}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" Content="New Meeting"
                                Height="32" Margin="0,0,8,0"
                                Style="{StaticResource Button.Accent}"
                                Command="{Binding NewMeetingCommand}"/>
                        <Button Grid.Column="2" Content="Delete Meeting"
                                Height="32" Margin="0,0,12,0"
                                Click="DeleteMeetingBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMeeting}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Grid.Column="3"
                                   Text="(Viewing past meeting  read only)"
                                   Foreground="#F59E0B" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingPastMeeting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Round 52: priority summary chips — click jumps the PM lists
                             below to the first project at that priority. -->
                        <ItemsControl Grid.Column="4" ItemsSource="{Binding PriorityChips}"
                                      VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="PriorityChip_Click" Margin="0,0,6,0" Cursor="Hand"
                                            ToolTip="Jump to the first project at this priority in the lists below">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{Binding ColorHex, Converter={StaticResource StringToBrush}}"
                                                        CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding Label}" Foreground="White"
                                                               FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActivityText}"
                                       Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                       Margin="0,0,8,0"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding MeetingError}"
                                       Foreground="#B91C1C" FontSize="11" TextWrapping="Wrap" MaxWidth="220"
                                       Visibility="{Binding HasMeetingError, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <Button Grid.Column="6"
                                Content="Save Meeting"
                                Height="32" Margin="8,0,8,0"
                                Command="{Binding SaveMeetingCommand}"
                                ToolTip="Flush all unsaved notes to the database now">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Danger}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentMeeting}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="7"
                                Content="Export to Excel"
                                Height="32" Margin="0,0,8,0"
                                Style="{StaticResource Button.Secondary}"
                                Click="ExportMeetingBtn_Click"
                                IsEnabled="{Binding HasPriorityProjects}"
                                ToolTip="Export this meeting to a formatted Excel workbook"/>
                        <!-- Round 52: Meeting Mode — trims the PM grids below to the
                             meeting columns and expands every PM group. -->
                        <Button Grid.Column="8"
                                Content="{Binding MeetingModeToggleLabel}"
                                Height="32" Margin="0,0,8,0"
                                Command="{Binding ToggleMeetingModeCommand}"
                                MinWidth="130"
                                ToolTip="Reshape the project lists for running the meeting: only Priority, Notes, % Billed, Eng/Draft % and Risk stay visible, and all PM groups expand.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMeetingMode}" Value="True">
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="BorderBrush" Value="#FFCC8400"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="9"
                                Content="{Binding MeetingPanelToggleLabel}"
                                Height="32"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding ToggleMeetingPanelCommand}"
                                MinWidth="160"/>
                    </Grid>

                    <!-- Priority projects board -->
                    <Grid Grid.Row="1" Margin="0,0,0,10"
                          Visibility="{Binding IsMeetingPanelExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Column headers -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding PrioritySortHeader}"
                                    Command="{Binding SortCommand}" CommandParameter="Priority"
                                    Style="{StaticResource SortHeaderButton}"/>
                            <Button Grid.Column="1" Content="{Binding ProjectSortHeader}"
                                    Command="{Binding SortCommand}" CommandParameter="Project"
                                    Style="{StaticResource SortHeaderButton}" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Content="{Binding PmSortHeader}"
                                    Command="{Binding SortCommand}" CommandParameter="PM"
                                    Style="{StaticResource SortHeaderButton}"/>
                            <TextBlock Grid.Column="3" Text="Notes" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                        </Grid>

                        <!-- Empty state -->
                        <TextBlock Grid.Row="1"
                                   Text="No priority projects yet. Use the Priority dropdown in each project row below to assign P1&#x2013;P5."
                                   Foreground="{StaticResource Text.Secondary}" FontSize="11" FontStyle="Italic"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPriorityProjects}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Prioritized projects list -->
                        <ScrollViewer Grid.Row="1" MaxHeight="420"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasPriorityProjects, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding PriorityProjects}"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Priority badge -->
                                            <Border Grid.Column="0" Background="{Binding PriorityBrush}"
                                                    CornerRadius="4" Padding="8,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PriorityLabel}" Foreground="White"
                                                           FontWeight="Bold" FontSize="13"/>
                                            </Border>

                                            <!-- Project number + name -->
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Wbs1}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding ProjectName}" FontSize="11"
                                                           Foreground="#374151" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- PM name -->
                                            <TextBlock Grid.Column="2" Text="{Binding PmName}" FontSize="12"
                                                       Foreground="#374151" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>

                                            <!-- Per-project notes -->
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" MinHeight="56"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalAlignment="Stretch"
                                                     IsEnabled="{Binding DataContext.IsCurrentMeeting, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     ToolTip="Notes for this project — saved automatically"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Overall meeting notes (secondary) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsMeetingPanelExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Overall Notes:" Foreground="{StaticResource Text.Secondary}"
                                   FontSize="11" VerticalAlignment="Top" Margin="0,5,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding MeetingNotes, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="72" MaxHeight="160" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 IsEnabled="{Binding IsCurrentMeeting}"
                                 VerticalContentAlignment="Top"/>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Row="1" Height="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="#E5E7EB" ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                          ToolTip="Drag to resize the Workload Board"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PmTools_ActiveProjects}" Cursor="Hand">
                            <TextBlock Text="Active Projects" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalProjects}" FontWeight="SemiBold" FontSize="18"/>
                            <Border CornerRadius="8" Padding="8,2,8,2" Margin="10,4,0,0"
                                    VerticalAlignment="Center" Background="#DBEAFE"
                                    ToolTip="Budgets are based on peer median — how long similar completed projects actually took. To switch to target-rate budgets, use the Financials window.">
                                <TextBlock Text="Peer Median" FontSize="9" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PmTools_EngHoursRemaining}" Cursor="Hand">
                            <TextBlock Text="Eng Hours Remaining" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalEngHoursRemaining, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PmTools_DraftHoursRemaining}" Cursor="Hand">
                            <TextBlock Text="Draft Hours Remaining" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalDraftHoursRemaining, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PmTools_OverEngBudget}" Cursor="Hand">
                            <TextBlock Text="Over Eng Budget" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding OverEngBudgetCount}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverEngBudgetCount, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="24,0,0,0">
                        <StackPanel Orientation="Horizontal" ToolTip="Number of active projects where drafting hours spent exceed the estimated drafting budget." Cursor="Hand">
                            <TextBlock Text="Over Draft Budget" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
