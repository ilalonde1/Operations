                      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Phase:" Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="All" Click="PhaseAll_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhaseAll}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="SD" Click="PhaseSD_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhaseSD}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="DD" Click="PhaseDD_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhasDD}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="CD" Click="PhaseCD_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhaseCD}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                              <Button Content="CA" Click="PhaseCA_Click">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPhaseCA}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                              <TextBlock Text="Sort:" Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                              <Button Content="Fee" Click="SortByFee_Click">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSortFee}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                              <Button Content="Unbilled" Click="SortByUnbilled_Click">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSortUnbilled}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                              <Button Content="Name" Click="SortByName_Click">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSortName}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                              <Button Content="At Risk" Click="SortByAtRisk_Click">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSortAtRisk}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock Text="Scope:" Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                              <Button Content="Watchlist" Click="ScopeWatchlist_Click"
                                      ToolTip="Show only projects flagged on the Deltek watchlist (default view).">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsWatchlistOnly}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                              <Button Content="All Active" Click="ScopeAllActive_Click"
                                      ToolTip="Show ALL active projects for each PM, including those not on the watchlist.">
                                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseFilterButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAllActive}" Value="True"><Setter Property="Background" Value="#FFFFE0B2"/><Setter Property="BorderBrush" Value="#FFCC8400"/><Setter Property="Foreground" Value="#FF8A4B00"/></DataTrigger></Style.Triggers></Style></Button.Style>
                              </Button>
                              <Border Width="1" Background="{StaticResource Panel.Border}" Margin="12,2" VerticalAlignment="Stretch"/>
                              <TextBlock Text="Type:" Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                              <ComboBox Width="155" MinHeight="28" ItemsSource="{Binding ConstructionTypeOptions}" SelectedItem="{Binding SelectedConstructionType}"
                                        ToolTip="Filter by construction type"/>
                              <Border Width="1" Background="{StaticResource Panel.Border}" Margin="12,2" VerticalAlignment="Stretch"/>
                              <CheckBox Content="My Projects only" IsChecked="{Binding ShowMyProjectsOnly}" VerticalAlignment="Center"/>
                          </StackPanel>
                          <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center"
                                  ToolTip="Budget estimation uses peer-based matching: median hours from similar completed projects.&#x0a;&#x0a;How peers are found:&#x0a;1. Projects within ±15% of the total fee (tight match)&#x0a;2. Widens to ±30% if fewer than 3 tight peers exist&#x0a;3. Further filtered by construction type, category, and phase&#x0a;&#x0a;Falls back to formula when &lt;3 peers found:&#x0a;Budget = Total Fee ÷ Target $/hr, split by Eng/Draft rates&#x0a;&#x0a;To compare peer vs target-rate budgets, use the Financials window toggle.">
                              <StackPanel>
                                  <TextBlock Text="BUDGET ESTIMATION RATES" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                  <StackPanel Orientation="Horizontal">
                                      <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11.5" VerticalAlignment="Center">
                                          <Run Text="Eng:"/>
                                          <Run Text="{Binding EngRate, Mode=OneWay, StringFormat={}{0:0}}" FontWeight="SemiBold"/>
                                      </TextBlock>
                                      <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0">
                                          <Run Text="Draft:"/>
                                          <Run Text="{Binding DraftRate, Mode=OneWay, StringFormat={}{0:0}}" FontWeight="SemiBold"/>
                                      </TextBlock>
                                      <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0">
                                          <Run Text="Combined:"/>
                                          <Run Text="{Binding CombinedRate, Mode=OneWay, StringFormat={}{0:0}}" FontWeight="SemiBold"/>
                                      </TextBlock>
                                      <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0">
                                          <Run Text="Target $/hr:"/>
                                          <Run Text="{Binding TargetBilling, Mode=OneWay, StringFormat={}{0:0}}" FontWeight="SemiBold"/>
                                      </TextBlock>
                                  </StackPanel>
                              </StackPanel>
                          </Border>
                          <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="12,0,0,0">
                              <Button Content="Export to Excel"
                                      Height="32"
                                      MinWidth="140"
                                      Click="ExportPmGroupsBtn_Click"
                                      IsEnabled="{Binding CanExportPmGroups}"/>
                          </StackPanel>
                      </Grid>
                    <ItemsControl Grid.Row="1" x:Name="PmGroupsList" ItemsSource="{Binding PmGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            BorderBrush="{StaticResource Panel.Border}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Background="#FFFFFFFF">
                                        <StackPanel>
                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Width="28"
                                                        Height="28"
                                                        Margin="0,0,10,0"
                                                        Padding="0"
                                                        Tag="{Binding}"
                                                        Click="PmGroupExpand_Click"
                                                        Style="{StaticResource Button.Secondary}">
                                                    <TextBlock Text="{Binding ExpandIcon}"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PmName}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding ProjectCount, StringFormat={}{0} projects}"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Fee" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                                    <TextBlock Text="{Binding TotalFee, StringFormat={}{0:C0}}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Unbilled" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                                    <TextBlock Text="{Binding TotalUnbilled, StringFormat={}{0:C0}}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Eng Hrs / Budget" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding TotalEngHrs, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding TotalEngBudget, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="5" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Draft Hrs / Budget" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding TotalDraftHrs, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding TotalDraftBudget, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="7"
                                                        Margin="12,0,0,0"
                                                        Padding="10,5"
                                                        CornerRadius="999"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Risk.HighConfidence.Background}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AtRiskOrCriticalCount, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Risk.Critical.Background}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Healthy"/>
                                                                <Setter Property="Foreground" Value="{StaticResource Risk.HighConfidence.Foreground}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AtRiskOrCriticalCount, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding AtRiskOrCriticalCount, StringFormat={}{0} at risk}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Risk.Critical.Foreground}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <DataGrid AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      CanUserSortColumns="True"
                                                      HeadersVisibility="Column"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      MinRowHeight="28"
                                                      ItemsSource="{Binding Projects}"
                                                      MouseDoubleClick="ProjectGrid_MouseDoubleClick"
                                                      RowDetailsVisibilityMode="Collapsed"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <DataGrid.Resources>
                                                </DataGrid.Resources>
                                                <!-- Round 52: per-project meeting notes, editable right in the PM
                                                     list — full-width under the row so there's no horizontal
                                                     scroll. Mirrors the meeting board's notes TextBox; saves
                                                     through the same debounced VM path. -->
                                                <DataGrid.RowDetailsTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,1,0,1" Padding="10,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Meeting Notes:" Foreground="{StaticResource Text.Secondary}"
                                                                           FontSize="11" VerticalAlignment="Top" Margin="0,5,8,0"/>
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding MeetingNotes, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontSize="12" MinHeight="56" MaxHeight="160"
                                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                                         VerticalContentAlignment="Top"
                                                                         VerticalScrollBarVisibility="Auto"
                                                                         HorizontalAlignment="Stretch"
                                                                         TextChanged="MeetingNotesTextBox_TextChanged"
                                                                         ToolTip="Notes for this project — saved automatically">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Setter Property="IsEnabled"
                                                                                    Value="{Binding MeetingPanel.IsCurrentMeeting, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <Style.Triggers>
                                                                                <!-- Notes attach to the meeting's priority row; without one the
                                                                                     store UPDATE would silently hit zero rows. HasMeetingRow (not
                                                                                     MeetingPriority) because the ComboBox sets priority optimistically
                                                                                     before the upsert lands — typing in that window dropped keystrokes. -->
                                                                                <DataTrigger Binding="{Binding HasMeetingRow}" Value="False">
                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGrid.RowDetailsTemplate>
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <!-- Round 52: left edge stripe in the priority colour so
                                                             prioritized rows pop while scanning. Uniform 3px border
                                                             (transparent when unprioritized) keeps cells aligned. -->
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MeetingPriority}" Value="1">
                                                                <Setter Property="BorderBrush" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MeetingPriority}" Value="2">
                                                                <Setter Property="BorderBrush" Value="#EA580C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MeetingPriority}" Value="3">
                                                                <Setter Property="BorderBrush" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MeetingPriority}" Value="4">
                                                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MeetingPriority}" Value="5">
                                                                <Setter Property="BorderBrush" Value="#6B7280"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static bus:DeliveryConfidenceLevel.Critical}">
                                                                <Setter Property="Background" Value="{StaticResource Risk.Critical.Background}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static bus:DeliveryConfidenceLevel.AtRisk}">
                                                                <Setter Property="Background" Value="{StaticResource Risk.AtRisk.Background}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static bus:DeliveryConfidenceLevel.Watch}">
                                                                <Setter Property="Background" Value="{StaticResource Risk.Watch.Background}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static bus:DeliveryConfidenceLevel.HighConfidence}">
