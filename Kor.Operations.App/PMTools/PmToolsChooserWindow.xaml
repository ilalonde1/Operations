<Window x:Class="Kor.Operations.PMTools.PmToolsChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="KOR NewerForma — PM Tools"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="780"
        Height="500"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Same card style used by HomeWindow so the chooser visually matches the
             Home tiles. Local copy because the style is window-scoped, not app-wide. -->
        <SolidColorBrush x:Key="Card.Hover" Color="#FFF8EAE5"/>
        <Style x:Key="HomeCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14" Background="Transparent">
                            <Border x:Name="Card"
                                    Background="{StaticResource Panel.Background}"
                                    BorderBrush="{StaticResource Panel.Border}"
                                    BorderThickness="1"
                                    CornerRadius="14" Padding="22">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1.5" Opacity="0.18" BlurRadius="7"/>
                                </Border.Effect>
                                <ContentPresenter/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Card.Hover}"/>
                                <Setter TargetName="Card" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:KorHeader Grid.Row="0"
                            x:Name="HeaderBar"
                            HeaderText="PM Tools"
                            SubtitleText="Pick a tool."
                            AvatarDiameter="64"
                            AvatarBorderThickness="2"
                            Margin="0,0,0,16"/>

        <UniformGrid Grid.Row="1" Columns="2" Rows="1" Margin="0,0,0,12">
            <Button x:Name="WorkloadMeetingCard"
                    Click="OpenWorkloadMeeting_Click"
                    Margin="0,0,8,0"
                    Style="{StaticResource HomeCardButton}">
                <StackPanel>
                    <Grid>
                        <Ellipse Width="32" Height="32" Fill="#EFEFF1"/>
                        <TextBlock Text="🗓" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Workload Meeting" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBlock Text="Bi-weekly meeting board with P1–P5 priorities, per-project notes, and the meeting export."
                               Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999"
                            Margin="0,10,0,0" Padding="6,3" HorizontalAlignment="Left">
                        <TextBlock Text="Open" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Button>

            <Button x:Name="PmCapacityCard"
                    Click="OpenPmCapacity_Click"
                    Margin="8,0,0,0"
                    Style="{StaticResource HomeCardButton}">
                <StackPanel>
                    <Grid>
                        <Ellipse Width="32" Height="32" Fill="#EFEFF1"/>
                        <TextBlock Text="🧭" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="PM Capacity &amp; Risk" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBlock Text="Active-projects KPIs, portfolio delivery health, PM groups, and Engineering / Drafting capacity risk."
                               Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999"
                            Margin="0,10,0,0" Padding="6,3" HorizontalAlignment="Left">
                        <TextBlock Text="Open" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Button>
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="84" Height="32"
                    Style="{StaticResource Button.Secondary}"
                    Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
