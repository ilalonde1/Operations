<Window x:Class="Kor.Operations.PMTools.StaffUtilizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOR NewerForma — Staff Utilization"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1040"
        MinWidth="860"
        Height="680"
        MinHeight="480"
        Loaded="Window_Loaded"
        ToolTipService.InitialShowDelay="200"
        ToolTipService.ShowDuration="20000">
    <Window.Resources>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="i"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UtilCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="High">
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Normal">
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Low">
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="2,0,2,12">
            <TextBlock Text="Staff Utilization"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Text.Primary}"/>
            <TextBlock Text="Rolling 12-week billable hours per staff member vs. 37.5 hr/week capacity target. Source: Deltek tkDetail."
                       FontSize="13" Foreground="{StaticResource Text.Secondary}" Margin="0,3,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Search employee:"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource Text.Secondary}" FontSize="13"/>
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         TextChanged="SearchBox_TextChanged"/>
                <Button x:Name="RefreshBtn"
                        Grid.Column="2"
                        Content="Refresh"
                        Width="96"
                        Height="32"
                        Margin="8,0,0,0"
                        ToolTip="Reload hours from Deltek for the current 12-week window."
                        Click="RefreshBtn_Click"/>
                <Button Grid.Column="3"
                        Content="Close"
                        Width="84"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>

        <!-- Data grid -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="UtilGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      HorizontalScrollBarVisibility="Disabled"
                      AlternatingRowBackground="#F8FAFC"
                      RowBackground="Transparent"
                      RowHeight="34">

                <DataGrid.Columns>

                    <!-- Employee Name -->
                    <DataGridTextColumn Binding="{Binding EmployeeName}" Width="*" MinWidth="160">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Employee" Style="{StaticResource ColHeader}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- This Week -->
                    <DataGridTextColumn Binding="{Binding WeekHrs, StringFormat={}{0:0.0}}" Width="110">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="This Week" Style="{StaticResource ColHeader}"/>
                                <Border Style="{StaticResource InfoIconBorder}" Margin="5,0,0,0"
                                        ToolTip="Hours logged in the 7-day rolling window ending today (RegHrs + OvtHrs from Deltek tkDetail). A single week can be affected by holidays, leave, or end-of-period timing — use the 4-wk or 12-wk averages for a more reliable picture.">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                                </Border>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- 4-Wk Avg -->
                    <DataGridTextColumn Binding="{Binding FourWkAvg, StringFormat={}{0:0.0}}" Width="110">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="4-Wk Avg" Style="{StaticResource ColHeader}"/>
                                <Border Style="{StaticResource InfoIconBorder}" Margin="5,0,0,0"
                                        ToolTip="Average hours per week over the past 28 days (4-week total ÷ 4). A short-term workload trend — useful for spotting recent ramp-up or cool-down before the full 12-week average catches up.">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                                </Border>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- 12-Wk Total -->
                    <DataGridTextColumn Binding="{Binding TwelveWkHrs, StringFormat={}{0:0.0}}" Width="120">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="12-Wk Total" Style="{StaticResource ColHeader}"/>
                                <Border Style="{StaticResource InfoIconBorder}" Margin="5,0,0,0"
                                        ToolTip="Total hours logged across all projects over the past 84 days (12 weeks). Includes all labor codes — engineering, drafting, admin, and non-billable. Source: Deltek tkDetail.RegHrs + OvtHrs.">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                                </Border>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- 12-Wk Avg -->
                    <DataGridTextColumn Binding="{Binding TwelveWkAvg, StringFormat={}{0:0.0}}" Width="110">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="12-Wk Avg" Style="{StaticResource ColHeader}"/>
                                <Border Style="{StaticResource InfoIconBorder}" Margin="5,0,0,0"
                                        ToolTip="Average hours per week over the 12-week window (12-Wk Total ÷ 12). This is the basis for the Utilization % — more stable than a single week and representative of sustainable workload.">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                                </Border>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- Utilization % -->
                    <DataGridTextColumn Binding="{Binding UtilizationPct, StringFormat={}{0:P0}}" Width="120">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Utilization %" Style="{StaticResource ColHeader}"/>
                                <Border Style="{StaticResource InfoIconBorder}" Margin="5,0,0,0"
                                        ToolTip="12-Wk Avg ÷ 37.5 hrs/week.&#x0a;&#x0a;37.5 hrs/week = the standard full-time capacity target (7.5 hrs × 5 days).&#x0a;&#x0a;Values above 100% indicate consistent overtime. Values below 60% may signal bench time, leave, or significant non-billable work not captured in tkDetail.">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                                </Border>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource UtilCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status -->
                    <DataGridTextColumn Binding="{Binding Status}" Width="90">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Status" Style="{StaticResource ColHeader}"/>
                                <Border Style="{StaticResource InfoIconBorder}" Margin="5,0,0,0"
                                        ToolTip="Derived from Utilization %:&#x0a;&#x0a;High   ≥ 90%  — fully loaded or over capacity. Review project assignments to avoid burnout.&#x0a;Normal  60–89% — healthy billable workload.&#x0a;Low    &lt; 60%  — bandwidth may be available, or staff may be on leave / non-billable work not tracked here.">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                                </Border>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource UtilCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Legend + status footer -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Utilization bands:"
                               Foreground="{StaticResource Text.Secondary}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border CornerRadius="10" Background="#DCFCE7" Padding="8,2" Margin="0,0,6,0">
                        <TextBlock Text="High  ≥ 90%" FontSize="12" Foreground="#166534" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="10" Background="#FEF3C7" Padding="8,2" Margin="0,0,6,0">
                        <TextBlock Text="Normal  60–89%" FontSize="12" Foreground="#92400E" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="10" Background="#FEE2E2" Padding="8,2" Margin="0,0,12,0">
                        <TextBlock Text="Low  &lt; 60%" FontSize="12" Foreground="#991B1B" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Target: 37.5 hrs/week"
                               Foreground="{StaticResource Text.Secondary}" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="StatusText"
                           FontSize="12" Foreground="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
