<Window x:Class="Kor.Operations.StandardDetails.RetireDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retire detail"
        Width="520" MinHeight="260"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource App.Background}">
    <Border Margin="10" Style="{StaticResource Card}" Padding="14">
        <StackPanel>
            <TextBlock x:Name="WindowTitleText" Text="Retire detail" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="PromptText" Margin="0,4,0,12" TextWrapping="Wrap"
                       Foreground="{StaticResource Text.Secondary}"/>

            <Border Background="#FFFDF6E7" BorderBrush="#FFE8D9A8" BorderThickness="1" CornerRadius="6"
                    Padding="12,10" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FF6B5A21"
                           Text="It leaves the palette immediately, so no drafter can place it again. Its number is never reused — it has been printed on issued drawings. You can restore it later if this turns out to be wrong."/>
            </Border>

            <TextBlock Text="Reason" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <TextBox x:Name="ReasonBox" Height="72" MaxLength="400" Padding="10,6" FontSize="12.5"
                     Background="#FFFFFFFF" Foreground="#FF111111" CaretBrush="#FF111111"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     ToolTip="Required. Example: superseded by KOR-D-00417, or withdrawn after the 2026 CSA update."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Width="90" Height="32" Margin="0,0,8,0" Content="Cancel" Style="{StaticResource Button.Secondary}" Click="Cancel_Click"/>
                <Button x:Name="RetireButton" Width="110" Height="32" Content="Retire" Style="{StaticResource Button.Secondary}" Click="Retire_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
