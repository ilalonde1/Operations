<Window x:Class="Kor.Operations.StandardDetails.RegistersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Standards Registers"
        Width="1000" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <LinearGradientBrush x:Key="DialogHero" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7F2EF" Offset="0"/>
            <GradientStop Color="#FFEEE5DE" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Margin="10" Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource DialogHero}" CornerRadius="10,10,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Standards Registers" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Read-only view of both registers the engineer governs: the KOR-D details and the canonical components."
                               Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1" Margin="12,10,12,6" BorderThickness="0" Background="Transparent">
                <TabItem Header="Details Register">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DetailSearchBox" Height="32" VerticalContentAlignment="Center"
                                     ToolTip="Search by detail number or title"/>
                            <Button Grid.Column="1" Width="88" Height="32" Margin="8,0,0,0" Content="Search"
                                    Style="{StaticResource Button.Secondary}" Click="DetailSearch_Click"/>
                            <TextBlock Grid.Column="2" x:Name="DetailSummary" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                        </Grid>
                        <DataGrid x:Name="DetailsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionChanged="DetailsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Detail #" Binding="{Binding DetailNumber}" Width="110"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Discipline" Binding="{Binding Discipline}" Width="110"/>
                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="130"/>
                                <DataGridTextColumn Header="Placeable" Binding="{Binding PlaceableText}" Width="80"/>
                                <DataGridTextColumn Header="Diverges" Binding="{Binding DivergesText}" Width="75"/>
                                <DataGridTextColumn Header="Linked Document" Binding="{Binding LinkedDocument}" Width="200"/>
                                <DataGridTextColumn Header="Doc Status" Binding="{Binding DocStatus}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ApproveButton" Content="Approve (human-confirmed)" Height="34" Padding="14,0" Margin="0,0,8,0" IsEnabled="False" Style="{StaticResource Button.Primary}" Click="Approve_Click"/>
                            <Button x:Name="RejectButton" Content="Reject" Height="34" Padding="14,0" Margin="0,0,12,0" IsEnabled="False" Style="{StaticResource Button.Secondary}" Click="Reject_Click"/>
                            <TextBlock x:Name="ApprovalHint" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Components Register">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ComponentSearchBox" Height="32" VerticalContentAlignment="Center"
                                     ToolTip="Search by label, family, type or palette"/>
                            <Button Grid.Column="1" Width="88" Height="32" Margin="8,0,0,0" Content="Search"
                                    Style="{StaticResource Button.Secondary}" Click="ComponentSearch_Click"/>
                            <TextBlock Grid.Column="2" x:Name="ComponentSummary" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                        </Grid>
                        <DataGrid x:Name="ComponentsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Palette" Binding="{Binding Palette}" Width="150"/>
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn Header="Family" Binding="{Binding FamilyName}" Width="200"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="130"/>
                                <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="120"/>
                                <DataGridTextColumn Header="Retired" Binding="{Binding RetiredText}" Width="70"/>
                                <DataGridTextColumn Header="Instances" Binding="{Binding InstanceCount}" Width="80"/>
                                <DataGridTextColumn Header="Used In" Binding="{Binding UsedInDetails}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" BorderBrush="#FFE6E8EB" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="100" Height="34" Margin="0,0,8,0" Content="Refresh" Style="{StaticResource Button.Secondary}" Click="Refresh_Click"/>
                    <Button Width="100" Height="34" Content="Close" Style="{StaticResource Button.Secondary}" Click="Close_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
