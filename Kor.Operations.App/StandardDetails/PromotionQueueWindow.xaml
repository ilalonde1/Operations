<Window x:Class="Kor.Operations.StandardDetails.PromotionQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Promotion Queue"
        Width="900" MinHeight="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource App.Background}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <LinearGradientBrush x:Key="DialogHero" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7F2EF" Offset="0"/>
            <GradientStop Color="#FFEEE5DE" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Margin="10" Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource DialogHero}" CornerRadius="10,10,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Promotion Queue" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Review pending, completed, and failed KorStandards promotion requests."
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="14,12,14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="OutboxGrid"
                          Height="380"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Detail #" Binding="{Binding DetailNumber}" Width="105"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetConfidence}" Width="130"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                        <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedByUserName}" Width="125"/>
                        <DataGridTextColumn Header="Requested UTC" Binding="{Binding RequestedUtcDisplay}" Width="155"/>
                        <DataGridTextColumn Header="Result/Error" Binding="{Binding DisplayMessage}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1"
                           x:Name="QueueMessageText"
                           Text="Ready."
                           Margin="2,8,0,0"
                           Foreground="{StaticResource Text.Secondary}"/>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#FFE6E8EB" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="130" Height="34" Margin="0,0,8,0" Content="Process Pending" ToolTip="Process pending KorStandards promotion requests" Click="ProcessPending_Click"/>
                    <Button Width="95" Height="34" Margin="0,0,8,0" Content="Refresh" Style="{StaticResource Button.Secondary}" ToolTip="Reload promotion queue rows" Click="Refresh_Click"/>
                    <Button Width="95" Height="34" Content="Close" Style="{StaticResource Button.Secondary}" ToolTip="Close the promotion queue" Click="Close_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
