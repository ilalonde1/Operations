<Window x:Class="Kor.Operations.StandardDetails.StandardDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Standard Details"
        Width="1400" Height="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeroBand" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7F2EF" Offset="0"/>
            <GradientStop Color="#FFECE4DE" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="TitleLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,2"/>
        </Style>

        <Style x:Key="HintLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF4F5F7"/>
            <Setter Property="Foreground" Value="#FF2E3A46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#FFDCE2E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFF1F3F5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF9F8F6"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE6EEF8"/>
                    <Setter Property="Foreground" Value="#FF12263A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeBorder" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#FFE7EEF5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Draft">
                    <Setter Property="Background" Value="#FFE8EDF2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Submitted">
                    <Setter Property="Background" Value="#FFFDEEC9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Approved">
                    <Setter Property="Background" Value="#FFDDF4E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Rejected">
                    <Setter Property="Background" Value="#FFF9DADA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Published">
                    <Setter Property="Background" Value="#FFD9EEF4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Archived">
                    <Setter Property="Background" Value="#FFEAEAEA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OfficialBadgeBorder" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#FFEAECEF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#FFDDF4E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Background" Value="#FFF2F3F5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GuidanceBanner" TargetType="Border">
            <Setter Property="Background" Value="#FFF2F7FC"/>
            <Setter Property="BorderBrush" Value="#FFD8E7F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="MetricValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF243647"/>
        </Style>

        <Style x:Key="StepChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFF1F3F6"/>
            <Setter Property="BorderBrush" Value="#FFD9DEE5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StepChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF4F6275"/>
        </Style>

        <Style x:Key="GroupTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="Standard Details"
                            SubtitleText="Document Management"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <Border Grid.Row="1" Margin="12,0,12,8" Padding="12" CornerRadius="12" Background="{StaticResource HeroBand}" BorderBrush="#FFE3D8D0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#FFFFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Single Source of Truth" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OfficialMetricText" Text="One official revision per record" Style="{StaticResource MetricValueLabel}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#FFFFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Controlled Workflow" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WorkflowMetricText" Text="Draft -> Submit -> Approve -> Publish" Style="{StaticResource MetricValueLabel}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FFFFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Group-Based Organization" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GroupMetricText" Text="Nested groups and subgroup assignment" Style="{StaticResource MetricValueLabel}"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Text="Tip: Select a record, pick a target group, then click Move Selected Record."/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="12,0,12,8" Padding="10" ToolTip="Use search and actions to manage document records and revisions.">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         FontSize="13"
                         ToolTip="Search by record title or description. Example: seismic, footing, anchor bolt"/>
                <Button Grid.Column="1"
                        Content="Search"
                        Width="92"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Run search using the text in the search box"
                        Click="Search_Click"/>
                <Button x:Name="CreateRecordButton"
                        Grid.Column="2"
                        Content="New Record"
                        Width="130"
                        Style="{StaticResource PrimaryActionButton}"
                        ToolTip="Create a new document record in the selected group (recommended first step)"
                        Click="CreateDocument_Click"/>
                <Button x:Name="UploadVersionButton"
                        Grid.Column="3"
                        Content="Add Revision"
                        Width="120"
                        Style="{StaticResource PrimaryActionButton}"
                        ToolTip="Upload a new file revision for the selected document record"
                        Click="UploadVersion_Click"/>
                <Button x:Name="LinkDetailButton"
                        Grid.Column="4"
                        Content="Link Detail"
                        Width="110"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Link the selected document record to a KOR-D standard detail"
                        Click="LinkDetail_Click"/>
                <Button x:Name="RegistersButton"
                        Grid.Column="5"
                        Content="Registers..."
                        Width="110"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Open the read-only Details and Components registers"
                        Click="Registers_Click"/>
                <Button Grid.Column="6"
                        Content="Promotion Queue..."
                        Width="145"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Review and process pending KorStandards promotion requests"
                        Click="PromotionQueue_Click"/>
                <Button Grid.Column="7"
                        Content="Refresh"
                        Width="92"
                        Height="34"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Reload groups, records, and version data from the database"
                        Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="12,0,12,8" Padding="10" BorderBrush="#FFCDD7E1" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Current Selection" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>

                <TextBlock Grid.Column="2" Text="Record:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBlock Grid.Column="3" x:Name="SelectedRecordValue" Text="None selected" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}"/>

                <TextBlock Grid.Column="4" Text="Revision:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBlock Grid.Column="5" x:Name="SelectedRevisionValue" Text="None selected" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}"/>

                <TextBlock Grid.Column="6" Text="Status/File:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="SelectedStatusBadge" Style="{StaticResource StatusBadgeBorder}" Tag="None" Margin="0,0,8,0">
                        <TextBlock x:Name="SelectedStatusValue" Text="None" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="SelectedFileValue" Text="Choose a revision to see details" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Row="1" Grid.ColumnSpan="8" x:Name="WorkflowHintBorder" Style="{StaticResource GuidanceBanner}">
                    <StackPanel>
                        <TextBlock x:Name="WorkflowHintText"
                                   Text="Select a document record to begin."
                                   FontWeight="SemiBold"
                                   Foreground="#FF1E3A5F"/>
                        <TextBlock x:Name="ActivityMessageText"
                                   Text="Ready."
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Document Groups" Style="{StaticResource TitleLabel}"/>
                    <TextBlock Grid.Row="1" Text="Organize record ownership with top-level groups and subgroups." Style="{StaticResource HintLabel}"/>

                    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                        <Border x:Name="StepSelectRecordChip" Style="{StaticResource StepChipBorder}">
                            <TextBlock x:Name="StepSelectRecordText" Text="1 Select Record" Style="{StaticResource StepChipText}"/>
                        </Border>
                        <Border x:Name="StepSelectGroupChip" Style="{StaticResource StepChipBorder}">
                            <TextBlock x:Name="StepSelectGroupText" Text="2 Select Target Group" Style="{StaticResource StepChipText}"/>
                        </Border>
                        <Border x:Name="StepMoveRecordChip" Style="{StaticResource StepChipBorder}">
                            <TextBlock x:Name="StepMoveRecordText" Text="3 Move Selected Record" Style="{StaticResource StepChipText}"/>
                        </Border>
                    </WrapPanel>

                    <WrapPanel Grid.Row="3" Margin="0,0,0,8">
                        <Button x:Name="AddGroupButton" Content="Add Group" Width="95" Height="30" Margin="0,0,6,0" Style="{StaticResource Button.Secondary}" ToolTip="Create a new top-level group" Click="AddGroup_Click"/>
                        <Button x:Name="AddSubgroupButton" Content="Add Subgroup" Width="105" Height="30" Margin="0,0,6,0" Style="{StaticResource Button.Secondary}" ToolTip="Create a subgroup under the selected group" Click="AddSubgroup_Click"/>
                        <Button x:Name="RenameGroupButton" Content="Rename" Width="75" Height="30" Margin="0,0,6,0" Style="{StaticResource Button.Secondary}" ToolTip="Rename selected group" Click="RenameGroup_Click"/>
                        <Button x:Name="RemoveGroupButton" Content="Remove" Width="75" Height="30" Margin="0,0,6,0" Style="{StaticResource Button.Secondary}" ToolTip="Delete selected group (must be empty)" Click="RemoveGroup_Click"/>
                        <Button x:Name="AssignRecordButton" Content="Move Selected Record" Width="140" Height="30" ToolTip="Move the selected record to the selected group. Use 'All Records' to ungroup." Click="AssignRecordToGroup_Click"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox x:Name="FilterByGroupCheckBox"
                                  Content="Filter records to selected group"
                                  IsChecked="False"
                                  VerticalAlignment="Center"
                                  ToolTip="On: tree selection filters the record list. Off: tree selection sets assignment target only."
                                  Checked="FilterByGroupCheckBox_Changed"
                                  Unchecked="FilterByGroupCheckBox_Changed"/>
                        <TextBlock Text="(Off is recommended when moving existing records)"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>

                    <Border Grid.Row="5" BorderBrush="#FFE0E4E8" BorderThickness="1" CornerRadius="8" Padding="4">
                        <TreeView x:Name="GroupsTree"
                                  ItemContainerStyle="{StaticResource GroupTreeItemStyle}"
                                  FontSize="11"
                                  SelectedItemChanged="GroupsTree_SelectedItemChanged"
                                  ToolTip="Group target selector. Turn on filter toggle above to also filter the records list.">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Border x:Name="GroupNodeBorder" Padding="3,1" CornerRadius="3" Background="Transparent">
                                        <TextBlock Text="{Binding Name}"/>
                                    </Border>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
                                            <Setter TargetName="GroupNodeBorder" Property="Background" Value="#FFF4F8FC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="GroupNodeBorder" Property="Background" Value="#FFDCEEF9"/>
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <TextBlock Grid.Row="6" Text="Document Records" Style="{StaticResource TitleLabel}" Margin="0,6,0,2"/>
                    <Grid Grid.Row="7">
                        <DataGrid x:Name="DocumentsGrid"
                                  AutoGenerateColumns="False"
                                  Height="240"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#FFF0F2F4"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  RowStyle="{StaticResource GridRow}"
                                  ToolTip="Record list. Use the filter toggle above if you want tree selection to filter this list."
                                  SelectionChanged="DocumentsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Record Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Detail #" Binding="{Binding DetailNumber}" Width="95"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="130"/>
                                <DataGridTextColumn Header="Official Rev" Binding="{Binding CurrentOfficialText}" Width="95"/>
                                <DataGridTextColumn Header="Latest Status" Binding="{Binding LatestStatusText}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No records yet. Click New Record to create your first document record."
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF7B8B9A">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=DocumentsGrid}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Version History" Style="{StaticResource TitleLabel}"/>
                        <TextBlock Grid.Row="1" Text="Newest revisions first. Publishing sets the one official revision." Style="{StaticResource HintLabel}"/>
                        <Grid Grid.Row="2">
                            <DataGrid x:Name="VersionsGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#FFF0F2F4"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      RowStyle="{StaticResource GridRow}"
                                      ToolTip="Version history for the selected record"
                                      SelectionChanged="VersionsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Variant" Binding="{Binding VariantKey}" Width="82"/>
                                    <DataGridTextColumn Header="Revision" Binding="{Binding VersionLabel}" Width="88"/>
                                    <DataGridTemplateColumn Header="Status" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusBadgeBorder}" Tag="{Binding StatusText}" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Official" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OfficialBadgeBorder}" Tag="{Binding IsCurrentOfficial}" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding IsCurrentOfficial}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedUtcDisplay}" Width="170"/>
                                    <DataGridTextColumn Header="File Name" Binding="{Binding OriginalFileName}" Width="*"/>
                                    <DataGridTextColumn Header="Size (KB)" Binding="{Binding FileSizeKb}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No revisions yet. Click Add Revision after selecting a record."
                                       IsHitTestVisible="False"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FF7B8B9A">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=VersionsGrid}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Workflow Actions" Style="{StaticResource TitleLabel}" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="OpenFileButton" Content="Open File" Width="95" Height="34" Margin="0,0,8,0" Style="{StaticResource ActionButton}" ToolTip="Open the selected version file" Click="OpenFile_Click"/>
                            <Button x:Name="SubmitButton" Content="Submit for Review" Width="120" Height="34" Margin="0,0,8,0" Style="{StaticResource ActionButton}" ToolTip="Move Draft revision to Submitted for review" Click="Submit_Click"/>
                            <Button x:Name="ApproveButton" Content="Approve" Width="85" Height="34" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" ToolTip="Approve selected revision and log approval record" Click="Approve_Click"/>
                            <Button x:Name="RejectButton" Content="Reject" Width="85" Height="34" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" ToolTip="Reject selected revision and log rejection record" Click="Reject_Click"/>
                            <Button x:Name="DeleteRecordButton" Content="Delete Record" Width="110" Height="34" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" ToolTip="Delete selected record and all its revision history" Click="DeleteRecord_Click"/>
                            <Button x:Name="PublishButton" Content="Publish Official" Width="120" Height="34" Style="{StaticResource PrimaryActionButton}" ToolTip="Set selected revision as Published and official" Click="Publish_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Workflow Guide: Draft -> Submitted -> Approved/Rejected -> Published"
                                   FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
