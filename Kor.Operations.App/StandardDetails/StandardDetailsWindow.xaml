            <Button x:Name="LinkDetailButton" Click="LinkDetail_Click"/>
            <Button x:Name="RegistersButton" Click="Registers_Click"/>
            <Button x:Name="PromotionQueueButton" Click="PromotionQueue_Click"/>
            <Button x:Name="PublishToMasterButton" Click="PublishToMaster_Click"/>
            <Button x:Name="ComposeSheetButton" Click="ComposeSheet_Click"/>
            <Button x:Name="AddGroupButton" Click="AddGroup_Click"/>
            <Button x:Name="AddSubgroupButton" Click="AddSubgroup_Click"/>
            <Button x:Name="RenameGroupButton" Click="RenameGroup_Click"/>
            <Button x:Name="RemoveGroupButton" Click="RemoveGroup_Click"/>
