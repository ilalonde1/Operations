<Window x:Class="Kor.Operations.StandardDetails.StandardDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Standard Details"
        Width="1320" Height="800"
        MinWidth="1060" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#FFF1F2F4"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- ===== styles the (hidden) legacy controls still need to compile ===== -->
        <Style x:Key="TitleLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HintLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#FF7B8B9A"/>
        </Style>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF939BA4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#FFEEF0F2"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="StatusBadgeBorder" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Background" Value="#FFE7EEF5"/>
        </Style>
        <Style x:Key="OfficialBadgeBorder" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Background" Value="#FFEAECEF"/>
        </Style>

        <!-- ===== new visible design ===== -->
        <!-- clean list row -->
        <Style x:Key="ListRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFF1F3F5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF8FAFC"/></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFEAF1FB"/>
                    <Setter Property="BorderBrush" Value="#FFDD5A2A"/>
                    <Setter Property="BorderThickness" Value="3,0,0,1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#FF252B31"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="0" VerticalAlignment="Center"><ContentPresenter VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- discipline filter chip (single-select via GroupName) -->
        <Style x:Key="ChipRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="17" Height="34" Padding="16,0" Background="White" BorderBrush="#FFD5DAE0" BorderThickness="1">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="#FF48515B" FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFF3F5F7"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF2E353D"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF2E353D"/>
                                <Setter TargetName="t" Property="Foreground" Value="White"/>
                                <Setter TargetName="t" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Details / Parts segmented tab -->
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="7" Padding="22,7" Background="Transparent">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="#FF6B7480" FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="White"/>
                                <Setter TargetName="t" Property="Foreground" Value="#FF20262D"/>
                                <Setter TargetName="t" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- flat pill button (Reject) and primary (Approve) -->
        <Style x:Key="RejectButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="White" BorderBrush="#FFD5DAE0" BorderThickness="1" Padding="20,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFF6F7F9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ApproveButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="#FF1E7E43" Padding="22,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FF1A6E3A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tools button on the dark band -->
        <Style x:Key="ToolsButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="#FF3A424B" BorderBrush="#FF4C555F" BorderThickness="1" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FF454E58"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <!-- ============ DARK HEADER BAND ============ -->
        <Border Grid.Row="0" Background="#FF2E353D">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFDD5A2A" CornerRadius="9" Width="40" Height="40" VerticalAlignment="Center">
                        <TextBlock Text="&#9670;" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Standard Details" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Approve the details drafters are allowed to place." Foreground="#FFAEB6BF" FontSize="12" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ToolsButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ToolsButtonStyle}" Click="ToolsButton_Click"
                        ToolTip="Advanced actions: compose a sheet, publish to master, refresh">
                    <TextBlock Text="Tools  &#9662;" Foreground="#FFE8ECEF" FontSize="13"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Compose Sheet..." Click="ComposeSheet_Click"/>
                            <MenuItem Header="Publish to Master..." Click="PublishToMaster_Click"/>
                            <Separator/>
                            <MenuItem Header="Sync Part Images" Click="SyncPartImages_Click"/>
                            <Separator/>
                            <MenuItem Header="Refresh" Click="Refresh_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- ============ TOOLBAR: search + discipline chips + summary ============ -->
        <Grid Grid.Row="1" Margin="18,14,18,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                <Border Background="White" BorderBrush="#FFDCE1E7" BorderThickness="1" CornerRadius="8" Width="250" Height="38" VerticalAlignment="Center">
                    <Grid Margin="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Stroke="#FFAAB2BB" StrokeThickness="2" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Width="185" Margin="9,0,0,0" VerticalContentAlignment="Center"
                                     BorderThickness="0" Background="Transparent" FontSize="13"
                                     KeyDown="SearchBox_KeyDown"
                                     ToolTip="Search by detail number or title, then press Enter"/>
                        </StackPanel>
                        <TextBlock Text="Search detail # or title..." Foreground="#FF9AA3AC" FontSize="13" Margin="21,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <RadioButton x:Name="ChipAll" GroupName="Disc" Content="All" IsChecked="True" Margin="14,0,8,0" Style="{StaticResource ChipRadio}" Checked="DisciplineChip_Checked"/>
                <RadioButton GroupName="Disc" Content="Concrete" Style="{StaticResource ChipRadio}" Checked="DisciplineChip_Checked"/>
                <RadioButton GroupName="Disc" Content="Steel" Style="{StaticResource ChipRadio}" Checked="DisciplineChip_Checked"/>
                <RadioButton GroupName="Disc" Content="General" Style="{StaticResource ChipRadio}" Checked="DisciplineChip_Checked"/>
                <RadioButton GroupName="Disc" Content="Wood Frame" Style="{StaticResource ChipRadio}" Checked="DisciplineChip_Checked"/>
                <ComboBox x:Name="KindFilterCombo"
                          Width="166"
                          Height="34"
                          Margin="6,0,0,0"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="KindFilter_SelectionChanged"
                          ToolTip="Filter details by type">
                    <ComboBoxItem Content="All types" Tag=""/>
                    <ComboBoxItem Content="Typical detail" Tag="typical"/>
                    <ComboBoxItem Content="Custom detail" Tag="custom"/>
                    <ComboBoxItem Content="Note / schedule" Tag="general-note"/>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="HeroSummaryText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="#FF5B646E" Text="Loading..."/>
        </Grid>

        <!-- ============ CONTENT: left list  |  right detail ============ -->
        <Grid Grid.Row="2" Margin="18,8,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CatalogListColumn" Width="2.25*" MinWidth="360"/>
                <ColumnDefinition x:Name="DetailPaneColumn" Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Details/Parts tabs + list -->
            <Grid Grid.Column="0" Margin="0,0,9,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFE7EAEE" CornerRadius="9" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SheetsTab" GroupName="Catalog" Content="Sheets" Style="{StaticResource TabRadio}" Checked="CatalogTab_Checked"/>
                        <RadioButton x:Name="DetailsTab" GroupName="Catalog" Content="Details" IsChecked="True" Style="{StaticResource TabRadio}" Checked="CatalogTab_Checked"/>
                        <RadioButton x:Name="PartsTab" GroupName="Catalog" Content="Parts" Style="{StaticResource TabRadio}" Checked="CatalogTab_Checked"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#FFE3E6EA" BorderThickness="1" CornerRadius="10">
                    <DataGrid x:Name="DocumentsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              ScrollViewer.CanContentScroll="True"
                              Background="Transparent"
                              BorderThickness="0"
                              RowBackground="Transparent"
                              Margin="6,4,6,6"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              RowStyle="{StaticResource ListRow}"
                              CellStyle="{StaticResource ListCell}"
                              SelectionChanged="DocumentsGrid_SelectionChanged">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF6F7F9" BorderBrush="#FFE2E5E9" BorderThickness="0,0,0,1" Padding="10,7">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FF5D6670" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ListIdColumn" Header="DETAIL #" Binding="{Binding DetailNumber}" Width="118">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="10,0,0,0"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="#FF3B434C"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#FF252B31"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="ListGroupColumn" Header="DISCIPLINE" Binding="{Binding GroupName}" Width="135">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="#FF68727D"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="11" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFEFF1F3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Approved"><Setter Property="Background" Value="#FFE7F4EA"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Active"><Setter Property="Background" Value="#FFE7F4EA"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Pending"><Setter Property="Background" Value="#FFFBF3E2"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Held"><Setter Property="Background" Value="#FFFBF3E2"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Rejected"><Setter Property="Background" Value="#FFFBECEB"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Retired"><Setter Property="Background" Value="#FFEDEEF0"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF8A929B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Approved"><Setter Property="Fill" Value="#FF2C7A3F"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Active"><Setter Property="Fill" Value="#FF2C7A3F"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Pending"><Setter Property="Fill" Value="#FFD9A21B"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Held"><Setter Property="Fill" Value="#FFD9A21B"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Rejected"><Setter Property="Fill" Value="#FFB23A2E"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FF5B636D"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Approved"><Setter Property="Foreground" Value="#FF2C7A3F"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Active"><Setter Property="Foreground" Value="#FF2C7A3F"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Pending"><Setter Property="Foreground" Value="#FF8A6D1F"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Held"><Setter Property="Foreground" Value="#FF8A6D1F"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Rejected"><Setter Property="Foreground" Value="#FFB23A2E"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- RIGHT: selected detail -->
            <Border Grid.Column="1" Margin="9,0,0,0" Background="White" BorderBrush="#FFE3E6EA" BorderThickness="1" CornerRadius="10">
                <Grid Margin="20,16,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- title + status pill -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitleText" Text="Select a detail" FontSize="19" FontWeight="SemiBold" Foreground="#FF20262D" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DetailSubtitleText" Text="Pick a detail on the left to review it." FontSize="12.5" Foreground="#FF8A929B" Margin="0,3,0,0"/>
                            <StackPanel x:Name="DetailTypePanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="Change Type" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="#FF5D6670" Margin="0,0,8,0"/>
                                <ComboBox x:Name="DetailTypeCombo"
                                          Width="168"
                                          Height="30"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="DetailTypeCombo_SelectionChanged"
                                          ToolTip="Set selected detail type">
                                    <ComboBoxItem Content="Typical detail" Tag="typical"/>
                                    <ComboBoxItem Content="Custom detail" Tag="custom"/>
                                    <ComboBoxItem Content="Note / schedule" Tag="note-schedule"/>
                                </ComboBox>
                                <TextBlock x:Name="DetailTypeSavedText"
                                           Text="✓ Saved"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FF1E6B3A"/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="DetailStatusPill" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="16" Padding="12,5" Background="#FFEFF1F3" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DetailStatusDot" Width="8" Height="8" Fill="#FF8A929B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DetailStatusPillText" Text="" Foreground="#FF5B636D" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- drawing box -->
                    <Border Grid.Row="1" BorderBrush="#FFE1E4E8" BorderThickness="1" CornerRadius="8" Background="White" ClipToBounds="True">
                        <Grid>
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,26,26"/></GeometryDrawing.Geometry>
                                            <GeometryDrawing.Pen><Pen Brush="#FFF1F3F5" Thickness="1"/></GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="26" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Cursor="Hand" MouseLeftButtonUp="PreviewImage_Click"
                                   ToolTip="Click to zoom"/>
                            <TextBlock x:Name="PreviewEmpty" Text="Select a detail to see its drawing."
                                       IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" FontSize="13" Foreground="#FF7B8B9A"/>
                            <Border x:Name="ZoomHintBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                    Background="#E6202730" CornerRadius="6" Padding="9,4" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Text="Click to zoom" Foreground="White" FontSize="11"/>
                            </Border>
                            <TextBlock x:Name="DrawingFootnote" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,8"
                                       Text="" FontSize="10.5" FontStyle="Italic" Foreground="#FFAEB4BB" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <!-- action bar -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OpenSheetPdfButton"
                                Grid.Column="0"
                                Width="108"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource RejectButtonStyle}"
                                Click="OpenSheetPdf_Click"
                                Visibility="Collapsed"
                                ToolTip="Open selected catalog item as a PDF">
                            <TextBlock x:Name="OpenSheetPdfButtonText" Text="Open PDF" Foreground="#FF48515B" FontSize="12.5" FontWeight="SemiBold"/>
                        </Button>
                        <TextBlock x:Name="ActionHintText" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                                   FontSize="12.5" Foreground="#FF7A828B" TextTrimming="CharacterEllipsis"
                                   Text="This is the actual drawing. Approve it and it goes into the drafters' palette."/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RejectButton" Style="{StaticResource RejectButtonStyle}" Margin="0,0,10,0" Click="Reject_Click"
                                    ToolTip="Reject — the detail is not a standard and never goes in the palette">
                                <TextBlock Text="&#10005;  Reject" Foreground="#FF48515B" FontSize="13.5" FontWeight="SemiBold"/>
                            </Button>
                            <Button x:Name="ApproveButton" Style="{StaticResource ApproveButtonStyle}" Click="Approve_Click"
                                    ToolTip="Approve — the detail becomes placeable and goes into the drafters' palette">
                                <TextBlock Text="&#10003;  Approve" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ thin status strip ============ -->
