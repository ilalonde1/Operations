            <Button x:Name="PublishButton" Click="Publish_Click"/>
            <Button x:Name="RefreshButtonLegacy" Click="Refresh_Click"/>
            <Button x:Name="SearchButtonLegacy" Click="Search_Click"/>
        </Grid>
    </Grid>
</Window>
