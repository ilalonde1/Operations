<Window x:Class="Kor.Operations.StandardDetails.SheetComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compose Standard Details Sheet"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <LinearGradientBrush x:Key="DialogHero" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7F2EF" Offset="0"/>
            <GradientStop Color="#FFEEE5DE" Offset="1"/>
        </LinearGradientBrush>
        <!-- PrimaryActionButton is defined locally in StandardDetailsWindow; a separate window
             cannot see another window's resources, so define it here too (crashed on open otherwise). -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Margin="10" Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource DialogHero}" CornerRadius="10,10,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Compose Standard Details Sheet" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText"
                               Text="Approved details load from KorStandards; sheet occupancy is checked against the active AUTHORING model."
                               Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="12,10,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="32" VerticalContentAlignment="Center"
                                 ToolTip="Search by detail number, title, or view name"/>
                        <Button Grid.Column="1" Width="88" Height="32" Margin="8,0,0,0" Content="Search"
                                Style="{StaticResource Button.Secondary}" Click="Search_Click"/>
                    </Grid>
                    <DataGrid x:Name="DetailsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Detail #" Binding="{Binding DetailNumber}" Width="105"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="View" Binding="{Binding CanonicalViewName}" Width="190"/>
                            <DataGridTextColumn Header="Current Sheet" Binding="{Binding CurrentSheetText}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" x:Name="AddButton" Width="120" Height="34" Margin="0,8,0,0"
                            HorizontalAlignment="Right" Content="Add"
                            Style="{StaticResource PrimaryActionButton}" Click="Add_Click"/>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sheet #" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" x:Name="SheetNumberBox" Height="32" Margin="6,0,12,0"
                                 VerticalContentAlignment="Center" MaxLength="40" ToolTip="New sheet number"/>
                        <TextBlock Grid.Column="2" Text="Name" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="3" x:Name="SheetNameBox" Height="32" Margin="6,0,12,0"
                                 VerticalContentAlignment="Center" MaxLength="300" ToolTip="New sheet name"/>
                        <TextBlock Grid.Column="4" Text="Like" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="5" x:Name="LikeSheetBox" Height="32" Margin="6,0,0,0"
                                 VerticalContentAlignment="Center" MaxLength="80" ToolTip="Existing sheet number/name whose title block will be copied"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="PlacementsGrid" Grid.Row="0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Detail #" Binding="{Binding DetailNumber}" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="View" Binding="{Binding CanonicalViewName}" IsReadOnly="True" Width="190"/>
                                <DataGridTextColumn Header="X mm" Binding="{Binding XmmText, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                <DataGridTextColumn Header="Y mm" Binding="{Binding YmmText, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                <DataGridTextColumn Header="Scale" Binding="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <TextBlock x:Name="PlacementSummaryText" VerticalAlignment="Center" Margin="0,0,12,0"
                                       FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                            <Button Width="100" Height="34" Content="Remove" Style="{StaticResource Button.Secondary}" Click="Remove_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#FFE6E8EB" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="100" Height="34" Margin="0,0,8,0" Content="Refresh"
                            Style="{StaticResource Button.Secondary}" Click="Refresh_Click"/>
                    <Button Width="100" Height="34" Margin="0,0,8,0" Content="Cancel"
                            Style="{StaticResource Button.Secondary}" Click="Cancel_Click"/>
                    <Button x:Name="OpenPdfButton" Width="110" Height="34" Margin="0,0,8,0" Content="Open PDF"
                            Style="{StaticResource Button.Secondary}" Click="OpenPdf_Click"/>
                    <Button x:Name="SaveButton" Width="120" Height="34" Content="Save Sheet"
                            Style="{StaticResource PrimaryActionButton}" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
