<Window x:Class="Kor.Operations.StandardDetails.SheetComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compose Standard Details Sheet"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <LinearGradientBrush x:Key="DialogHero" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7F2EF" Offset="0"/>
            <GradientStop Color="#FFEEE5DE" Offset="1"/>
        </LinearGradientBrush>
        <!-- PrimaryActionButton is defined locally in StandardDetailsWindow; a separate window
             cannot see another window's resources, so define it here too (crashed on open otherwise). -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Margin="10" Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource DialogHero}" CornerRadius="10,10,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Compose Standard Details Sheet" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText"
                               Text="Approved details load from KorStandards; sheet occupancy is checked against the active AUTHORING model."
                               Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="12,10,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Padding="10,0" FontSize="13" Background="#FFFFFFFF" Foreground="#FF111111" CaretBrush="#FF111111" x:Name="SearchBox" Height="32" VerticalContentAlignment="Center"
                                 ToolTip="Search by detail number, title, or view name"/>
                        <Button Grid.Column="1" Width="88" Height="32" Margin="8,0,0,0" Content="Search"
                                Style="{StaticResource Button.Secondary}" Click="Search_Click"/>
                    </Grid>
                    <!-- Double-click a row to place it. Select-then-Add still works; nobody should have
                         to use two controls to do the obvious thing with a list. -->
                    <DataGrid x:Name="DetailsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              MouseDoubleClick="DetailsGrid_MouseDoubleClick"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Detail #" Binding="{Binding DetailNumber}" Width="105"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="View" Binding="{Binding CanonicalViewName}" Width="190"/>
                            <DataGridTextColumn Header="Current Sheet" Binding="{Binding CurrentSheetText}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" x:Name="AddButton" Width="120" Height="34" Margin="0,8,0,0"
                            HorizontalAlignment="Right" Content="Add"
                            Style="{StaticResource PrimaryActionButton}" Click="Add_Click"/>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- The number is assigned on save (next free S1.NN) and the title block is copied
                             from the newest S1 sheet; neither is entered. Only the name is the user's. -->
                        <TextBlock Text="Sheet #" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" x:Name="SheetNumberText" VerticalAlignment="Center" Margin="0,0,18,0"
                                   Foreground="#666" Text="assigned on save"
                                   ToolTip="The next free S1.NN in the standards model, assigned when the sheet is saved."/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0">
                            <Run Text="Name"/><Run Text=" *" Foreground="#FFC0392B"/>
                        </TextBlock>
                        <TextBox Padding="10,0" FontSize="13" Background="#FFFFFFFF" Foreground="#FF111111" CaretBrush="#FF111111" Grid.Column="3" x:Name="SheetNameBox" Height="32" Margin="0,0,0,0"
                                 VerticalContentAlignment="Center" MaxLength="300" ToolTip="Required. Name this sheet, then Create PDF sheet."
                                 TextChanged="SheetNameBox_TextChanged"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="155"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFEEF1F4" BorderBrush="#FFD5DAE0" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <Border x:Name="SheetHost"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="#FFDDE3EA"
                                        ClipToBounds="True"
                                        SizeChanged="SheetHost_SizeChanged">
                                    <Canvas x:Name="SheetCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle x:Name="SheetPaper" Fill="White" Stroke="#FF7B8794" StrokeThickness="1"/>
                                        <Rectangle x:Name="TitleBlockRegion" Fill="#FFF8FAFC" Stroke="#FFB8C1CC" StrokeThickness="1"/>
                                        <Line x:Name="TitleBlockTopLine" Stroke="#FFD6DDE5" StrokeThickness="1"/>
                                        <Line x:Name="TitleBlockMiddleLine" Stroke="#FFD6DDE5" StrokeThickness="1"/>
                                        <Line x:Name="TitleBlockBottomLine" Stroke="#FFD6DDE5" StrokeThickness="1"/>
                                        <ItemsControl x:Name="PlacementItems">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                                                        <Thumb DragStarted="PlacementThumb_DragStarted" DragDelta="PlacementThumb_DragDelta" Cursor="SizeAll">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="White" BorderBrush="#FFDD5A2A" BorderThickness="2" CornerRadius="4" SnapsToDevicePixels="True">
                                                                        <Grid ClipToBounds="True">
                                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" Visibility="{Binding ThumbnailVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8" FontSize="11" Foreground="#FF5B636D" Visibility="{Binding PlaceholderVisibility}"/>
                                                                            <Border Background="#E62E353D" VerticalAlignment="Top" Padding="6,3">
                                                                                <TextBlock Text="{Binding DetailNumber}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                        <Thumb Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="PlacementThumb_DragStarted" DragDelta="ResizeThumb_DragDelta">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="#FFDD5A2A" BorderBrush="White" BorderThickness="1" CornerRadius="2"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="PlacementsGrid" Grid.Row="1" Margin="0,8,0,0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Detail #" Binding="{Binding DetailNumber}" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="View" Binding="{Binding CanonicalViewName}" IsReadOnly="True" Width="190"/>
                                <DataGridTextColumn Header="X mm" Binding="{Binding XmmText, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                <DataGridTextColumn Header="Y mm" Binding="{Binding YmmText, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                <DataGridTextColumn Header="Scale" Binding="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <CheckBox x:Name="SnapCheckBox" Content="Snap" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock x:Name="PlacementSummaryText" VerticalAlignment="Center" Margin="0,0,12,0"
                                       FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                            <Button Width="100" Height="34" Content="Remove" Style="{StaticResource Button.Secondary}" Click="Remove_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#FFE6E8EB" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- A disabled button must say why it is disabled. Without this the composer
                         reads as broken: everything greyed out and nothing on screen explaining it. -->
                    <TextBlock x:Name="ActionHintText" Grid.Column="0" VerticalAlignment="Center"
                               Margin="0,0,16,0" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Secondary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="100" Height="34" Margin="0,0,8,0" Content="Refresh"
                                Style="{StaticResource Button.Secondary}" Click="Refresh_Click"/>
                        <Button Width="100" Height="34" Margin="0,0,8,0" Content="Cancel"
                                Style="{StaticResource Button.Secondary}" Click="Cancel_Click"/>
                        <!-- Governed outputs: hidden outright for anyone who cannot publish, rather than
                             shown dead forever. Collapsed by default; shown only when publishing is allowed. -->
                        <!-- Named for what it does: re-opens a sheet ALREADY SAVED to the master, by number,
                             through Revit. The catalog's "Open PDF" is a different thing (a stored PDF, no
                             Revit) and two buttons with one name read as a fault. -->
                        <Button x:Name="OpenPdfButton" Width="150" Height="34" Margin="0,0,8,0" Content="Open saved sheet"
                                IsEnabled="False" Visibility="Collapsed"
                                ToolTip="Re-opens a sheet already saved to the master, by its number, through Revit."
                                Style="{StaticResource Button.Secondary}" Click="OpenPdf_Click"/>
                        <Button x:Name="CreatePdfSheetButton" Width="140" Height="34" Margin="0,0,8,0" Content="Create PDF sheet"
                                Style="{StaticResource Button.Secondary}" Click="CreatePdfSheet_Click"
                                ToolTip="Builds a personal PDF from the captured detail art. No Revit needed - an uncontrolled working copy, not the governed standard."/>
                        <Button x:Name="SaveButton" Width="120" Height="34" Content="Save to master"
                                IsEnabled="False" Visibility="Collapsed"
                                ToolTip="Writes a governed sheet into the master model. Requires Revit with the AUTHORING template open (gatekeeper)."
                                Style="{StaticResource PrimaryActionButton}" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
