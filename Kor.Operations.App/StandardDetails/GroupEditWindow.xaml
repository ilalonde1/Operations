<Window x:Class="Kor.Operations.StandardDetails.GroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group"
        Width="430" MinHeight="220"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource App.Background}">
    <Border Margin="10" Style="{StaticResource Card}" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="WindowTitleText" Text="Group" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" x:Name="PromptText" Text="Enter group name" Margin="0,4,0,10" Foreground="{StaticResource Text.Secondary}"/>

            <TextBlock Grid.Row="2" Text="Group Name" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <TextBox Grid.Row="3" x:Name="GroupNameBox" Height="34" MaxLength="200" VerticalContentAlignment="Center" ToolTip="Max 200 characters. Example: Concrete, Concrete/Seismic, Foundation"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Width="90" Height="32" Margin="0,0,8,0" Content="Cancel" Style="{StaticResource Button.Secondary}" Click="Cancel_Click"/>
                <Button Width="90" Height="32" Content="Save" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
