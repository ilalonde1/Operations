<Window x:Class="Kor.Operations.StandardDetails.AddDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a Standard Detail"
        Width="1080" Height="700"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <LinearGradientBrush x:Key="DialogHero" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7F2EF" Offset="0"/>
            <GradientStop Color="#FFEEE5DE" Offset="1"/>
        </LinearGradientBrush>
        <!-- Defined locally: a window cannot see another window's resources, and referencing
             StandardDetailsWindow's copy crashed the composer on open. -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Border Margin="10" Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource DialogHero}" CornerRadius="10,10,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Add a Standard Detail" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText"
                               Text="Draw the detail in AUTHORING first. Pick its view below, give it a title, and it becomes a numbered standard."
                               Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="12,10,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ the drawings in the model that are not yet standards ============ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}"
                               Text="DRAWINGS IN THE MODEL THAT ARE NOT YET STANDARDS"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="32" Padding="10,0" FontSize="13"
                                 Background="#FFFFFFFF" Foreground="#FF111111" CaretBrush="#FF111111"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 ToolTip="Filter by view name"/>
                        <Button Grid.Column="1" Width="104" Height="32" Margin="8,0,0,0" Content="Reload"
                                Style="{StaticResource Button.Secondary}" Click="Reload_Click"
                                ToolTip="Ask the Revit session again which views exist"/>
                    </Grid>

                    <!-- Double-click picks it. Nobody should need two controls to do the obvious
                         thing with a list. -->
                    <DataGrid x:Name="ViewsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True"
                              SelectionChanged="ViewsGrid_SelectionChanged"
                              MouseDoubleClick="ViewsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="View name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="ListCountText" Grid.Row="3" Margin="0,6,0,0"
                               FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                               Text="Not loaded."/>
                </Grid>

                <!-- ============ what the gatekeeper types ============ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="TITLE"/>
                    <TextBox x:Name="TitleBox" Grid.Row="1" Height="34" Padding="10,0" FontSize="13"
                             Background="#FFFFFFFF" Foreground="#FF111111" CaretBrush="#FF111111"
                             VerticalContentAlignment="Center" Margin="0,0,0,12"
                             MaxLength="400"
                             TextChanged="TitleBox_TextChanged"
                             ToolTip="What an engineer will search for. The view name is offered as a starting point."/>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="DISCIPLINE"/>
                            <ComboBox x:Name="DisciplineCombo" Height="34" FontSize="13" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="Concrete" Tag="Concrete"/>
                                <ComboBoxItem Content="Steel" Tag="Steel"/>
                                <ComboBoxItem Content="Wood Frame" Tag="Wood Frame"/>
                                <ComboBoxItem Content="General" Tag="General"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="TYPE"/>
                            <ComboBox x:Name="TypeCombo" Height="34" FontSize="13" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="Typical detail" Tag="typical"/>
                                <ComboBoxItem Content="Custom detail" Tag="custom"/>
                                <ComboBoxItem Content="Note / schedule" Tag="note-schedule"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="WHY IT IS BEING MADE A STANDARD"/>
                    <TextBox x:Name="BasisBox" Grid.Row="4" Height="70" Padding="10,6" FontSize="12.5"
                             Background="#FFFFFFFF" Foreground="#FF111111" CaretBrush="#FF111111"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12" MaxLength="1000"
                             ToolTip="Recorded in the governance log against this detail. Optional, but it is what someone reads a year from now."/>

                    <Border Grid.Row="5" Background="#FFF6F7F9" BorderBrush="#FFE6E8EB" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="WHAT HAPPENS WHEN YOU ADD IT" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ExplainerText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Text="The catalogue mints the next KOR-D number, records the detail and the Revit view it lives in, and stamps that number onto the view's View Prefix so the model and the catalogue cannot disagree. The detail starts unverified: capture its drawing, approve it, then publish to MASTER and every drafter has it."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#FFF6F7F9" BorderBrush="#FFE6E8EB" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                               Text="Connecting to the Revit session..."/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="Close" Width="104" Height="34" Margin="0,0,8,0"
                                Style="{StaticResource Button.Secondary}" Click="Cancel_Click"/>
                        <Button x:Name="AddButton" Content="Add detail" Width="150"
                                Style="{StaticResource PrimaryActionButton}" IsEnabled="False"
                                Click="Add_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
