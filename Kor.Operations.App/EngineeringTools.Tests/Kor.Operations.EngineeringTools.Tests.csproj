<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <!-- No browser is launched here; keep the 445 MB Playwright driver out of this output. -->
    <PlaywrightPlatform>none</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\\Kor.Operations.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF test fixtures: copied to output so tests can read them via relative path -->
    <None Include="PdfToSafe\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Golden-file baselines for snapshot tests -->
    <None Include="PdfToSafe\Fixtures\*.expected.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
