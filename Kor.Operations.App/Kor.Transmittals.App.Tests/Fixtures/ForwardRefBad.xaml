<Window
    x:Class="Kor.Operations.Tests.Fixtures.ForwardRefBad"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <Style x:Key="BadTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForwardBrush}" />
        </Style>
        <SolidColorBrush x:Key="ForwardBrush" Color="Red" />
    </Window.Resources>
    <Grid>
        <TextBlock Style="{StaticResource BadTextStyle}" Text="Bad forward reference" />
    </Grid>
</Window>
