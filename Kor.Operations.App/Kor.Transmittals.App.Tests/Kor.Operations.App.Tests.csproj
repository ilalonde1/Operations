<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Kor.Operations.App.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);SA0001</NoWarn>
    <StyleCopEnabled>false</StyleCopEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.Graph" Version="5.105.0" />
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.0" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="1.22.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MsgReader" Version="6.0.9" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Data.Odbc" Version="10.0.3" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kor.Operations.App.csproj" />
    <ProjectReference Include="..\..\Kor.EmailSearch.Core\Kor.EmailSearch.Core.csproj" />
    <ProjectReference Include="..\..\Kor.Opportunities.Core\Kor.Opportunities.Core.csproj" />
    <ProjectReference Include="..\..\Kor.Opportunities.Data\Kor.Opportunities.Data.csproj" />
    <ProjectReference Include="..\..\Kor.Operations.Core\Kor.Operations.Core.csproj" />
    <ProjectReference Include="..\..\Kor.Operations.Data\Kor.Operations.Data.csproj" />
    <ProjectReference Include="..\..\Kor.Operations.Graph\Kor.Operations.Graph.csproj" />
    <ProjectReference Include="..\..\Kor.Operations.Mcp\Kor.Operations.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fixture XAMLs are inert data for the analyzer tests — NOT WPF Pages.
         Remove the default UseWPF Page/ApplicationDefinition globs for them first,
         then re-include as Content so they copy to bin/. -->
    <Page Remove="Fixtures\**\*.xaml" />
    <ApplicationDefinition Remove="Fixtures\**\*.xaml" />
    <Resource Remove="Fixtures\**\*.xaml" />
    <Content Include="Fixtures\DuplicateResourceKey_FileA.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\DuplicateResourceKey_FileB.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\EmptyCatchBad.cs.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\ForwardRefBad.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\MissingBindingPropertyBad.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\SyncOverAsyncBad.cs.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\ThrowExRewrapBad.cs.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\UnknownKeyBad.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\UnusedAppResourceKeyBad.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\UnusedVmPropertyBad.cs.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\UnusedPrivateMethodBad.cs.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\UnusedPrivateTypeBad.cs.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Update="TestData\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
