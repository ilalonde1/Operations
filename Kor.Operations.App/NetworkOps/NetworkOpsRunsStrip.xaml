<UserControl x:Class="Kor.Operations.App.NetworkOps.NetworkOpsRunsStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nops="clr-namespace:Kor.Operations.App.NetworkOps"
             FontFamily="Mulish, Segoe UI" Visibility="Collapsed">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kor.Operations.App;component/NetworkOps/NetworkOpsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- A link-styled toggle whose label flips Show/Hide with its state (same as To clear's reasons disclosure). -->
            <Style x:Key="Runs.Disclose" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{x:Static nops:NetworkOpsBrushes.Link}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Content" Value="{Binding ExpandLabel}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Content" Value="{Binding CollapseLabel}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Every run in flight, and those finished in the last hour: one line each, machines on demand. Hidden when there are none. -->
    <ItemsControl x:Name="RunList" Margin="12,0,12,8">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="{x:Static nops:NetworkOpsBrushes.ActionTint}" BorderBrush="{x:Static nops:NetworkOpsBrushes.ActionEdge}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2" Fill="{Binding Accent}" Margin="0,1,12,1"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Line}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Started}" Style="{StaticResource Ops.Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <ToggleButton x:Name="MachinesToggle" Style="{StaticResource Runs.Disclose}" IsChecked="{Binding IsExpanded, Mode=OneTime}"
                                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                                              ToolTip="Each machine in this run and how it is going."/>
                                <Button Content="Dismiss" Style="{StaticResource Ops.Link}" Margin="8,0,0,0" Click="Dismiss_Click"
                                        Visibility="{Binding DismissVisibility}" ToolTip="Hide this finished run (it stays in each machine's history)."/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Machines}" Margin="16,8,0,0"
                                      Visibility="{Binding IsChecked, ElementName=MachinesToggle, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12.5" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
