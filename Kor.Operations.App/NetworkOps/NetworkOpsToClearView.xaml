<UserControl x:Class="Kor.Operations.App.NetworkOps.NetworkOpsToClearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Mulish, Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kor.Operations.App;component/NetworkOps/NetworkOpsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The distance to green, in one line. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="12,0,12,10" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="HeadlineAccent" Width="5" RadiusX="2.5" RadiusY="2.5" Margin="0,2,16,2"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadlineText" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                    <TextBlock x:Name="HeadlineDetail" Style="{StaticResource Ops.Caption}" Margin="0,2,0,0"/>
                    <!-- The at-a-glance rollup: every open issue grouped into broad categories with a machine count, worst
                         first. The whole worklist read in one line of chips, before the detail cards below. -->
                    <ItemsControl x:Name="CategoryStrip" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A clickable filter chip: click to show only this kind of problem, click the live one again for all. -->
                                <Border CornerRadius="13" Padding="10,4" Margin="0,0,8,6" ToolTip="{Binding Tip}" Cursor="Hand" MouseLeftButtonUp="Chip_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F2F4F6"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#DCE4EC"/>
                                                    <Setter Property="BorderBrush" Value="#5B7A99"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                        <Border Background="#E2E6EA" CornerRadius="9" Padding="6,0" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Clear in one action: issues regrouped by the fix that clears them, machines de-duplicated. Code-behind
                         shows this only when a fix consolidates 2+ reasons, so the saving leads (one restart for three reboot
                         reasons, with the overlap called out) instead of three separate counts the eye has to add up. -->
                    <StackPanel x:Name="ActionSection" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock Text="CLEAR IN ONE ACTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="one fix clears several reasons at once — machines counted once" Style="{StaticResource Ops.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl x:Name="ActionStrip">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F4F8FB" BorderBrush="#D3DEE8" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2" Fill="{Binding SeverityBrush}" Margin="0,1,12,1"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{StaticResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Reasons}" Style="{StaticResource Ops.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Overlap}" Visibility="{Binding ShowOverlap, Converter={StaticResource BoolToVis}}"
                                                           FontSize="12.5" FontWeight="SemiBold" Foreground="#1F7A4D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding RunLabel}" Style="{StaticResource Ops.Primary}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Click="RunAction_Click" Visibility="{Binding CanRun, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Run this one fix on every machine that needs it, clearing every reason it covers on each. Audited; the cards below clear as each machine is fixed and re-checked."/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar. -->
        <Grid Grid.Row="1" Margin="12,0,12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="HelpCaption"
                           Text="Fix an issue on every machine that has it, or hand it to Claude. Acknowledging a finding parks it — it stops counting against green."
                           Style="{StaticResource Ops.Caption}" VerticalAlignment="Center"/>
                <!-- Appears only when a category chip is filtering the list; clears the filter. -->
                <Button x:Name="ClearFilterBtn" Style="{StaticResource Ops.Link}" Click="ClearFilter_Click"
                        VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Show every open issue again."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshBtn" Content="Re-check all" Margin="0,0,8,0" Click="Recheck_Click"
                        ToolTip="Run the health probe on every PC now, then refresh this list."/>
                <Button Content="↻" Style="{StaticResource Ops.Link}" FontSize="16" Click="Refresh_Click" ToolTip="Refresh this list"/>
            </StackPanel>
        </Grid>

        <!-- The worklist. -->
        <ScrollViewer Grid.Row="2" Margin="12,0,12,8" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="IssueList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <!-- Content is capped (not Width="*") so the actions sit right beside it instead of being
                                             pinned to the far edge with a wide empty gap; the trailing * keeps the issue and its
                                             actions grouped together on the left. -->
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Ops.Pill}" Background="{Binding SeverityBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SeverityText}" Style="{StaticResource Ops.PillText}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="4,0,24,0" MaxWidth="720">
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Where}" FontSize="12.5" Foreground="{StaticResource Text.Primary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <!-- Plain-English "what this means" (from the rule's knowledge entry): the explanation inline, not a click away. -->
                                        <TextBlock Text="{Binding Meaning}" Visibility="{Binding ShowMeaning, Converter={StaticResource BoolToVis}}"
                                                   FontSize="12.5" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource Ops.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FixHint}" Style="{StaticResource Ops.Caption}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="160">
                                        <Button Content="{Binding FixLabel}" Style="{StaticResource Ops.Primary}" Click="Fix_Click" Margin="0,0,0,6"
                                                Visibility="{Binding ShowFix, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Queue this fix on every machine that has the issue. Each run is audited; this list clears each as it's fixed and re-checked."/>
                                        <Border Background="#ECF6EC" BorderBrush="#BFE3BF" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="0,0,0,6"
                                                Visibility="{Binding ShowFixing, Converter={StaticResource BoolToVis}}"
                                                ToolTip="This fix is queued and running on the affected machines. The issue drops off once they clear and re-check.">
                                            <TextBlock Text="{Binding FixingText}" FontSize="12" Foreground="#166534" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Border>
                                        <!-- Ask Claude is the PRIMARY verb only when there is no one-click fix; otherwise it tucks into More. -->
                                        <Button Content="Ask Claude" Style="{StaticResource Ops.Primary}" Click="Ask_Click" Margin="0,0,0,6"
                                                Visibility="{Binding ShowAskPrimary, Converter={StaticResource BoolToVis}}"
                                                ToolTip="No one-click fix for this — open a Claude prompt for it (on the first machine): investigate and clear it with everything NetworkOps knows."/>
                                        <!-- Secondary dispositions behind one control, so the card shows one clear verb up front. -->
                                        <Button Content="More ▾" Style="{StaticResource Ops.Link}" HorizontalAlignment="Right" Click="More_Click"
                                                ToolTip="Ask Claude, acknowledge, or snooze this issue.">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Ask Claude" Click="Ask_Click"/>
                                                    <MenuItem Header="{Binding AckLabel}" Click="Acknowledge_Click"/>
                                                    <MenuItem Header="Snooze a week" Click="Snooze_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Ops.Empty}" Margin="0,40,0,0" Tag="{Binding ElementName=IssueList}"
                           Text="All green — nothing to clear. 🎉" FontSize="15"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
