<UserControl x:Class="Kor.Operations.App.NetworkOps.NetworkOpsNetworkView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Mulish, Segoe UI"
        Loaded="View_Loaded">
    <!-- What is plugged in where, by name and person (Ian, 2026-10-02). Two views of one map:
         Switches: each switch a panel of port tiles, front-panel order; a tile opens the device's page.
         Table: the tree on the left, the chosen switch's ports (or a search) as rows.
         Folded from a standalone window into a tab of the Command Center (2026-10-04); the same one surface. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kor.Operations.App;component/NetworkOps/NetworkOpsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeadlineText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Foreground="{StaticResource Text.Primary}"/>
                <TextBlock x:Name="SublineText" Style="{StaticResource Ops.Caption}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="PanelsViewBtn" Content="Switches" GroupName="NetView" Style="{StaticResource Ops.Segment}" IsChecked="True" Checked="View_Changed"
                             ToolTip="Each switch as a panel of its ports: click a port for its device."/>
                <RadioButton x:Name="TableViewBtn" Content="Table" GroupName="NetView" Style="{StaticResource Ops.Segment}" Checked="View_Changed" Margin="0,0,16,0"
                             ToolTip="The tree, and a switch's ports (or a search) as rows."/>
                <TextBlock Text="Find" Style="{StaticResource Ops.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="260" VerticalContentAlignment="Center" TextChanged="Search_Changed"
                         ToolTip="A PC, a person, an IP, a MAC or a maker: everything that matches, and where it is (shown in the table)."/>
                <Button Content="↻" Style="{StaticResource Ops.Link}" FontSize="16" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Read the map again"/>
            </StackPanel>
        </Grid>

        <!-- SWITCHES: every switch as a panel of port tiles, with the chosen port's details beside it. -->
        <Grid Grid.Row="1" x:Name="PanelsView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="PanelsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,5,0">
                <ItemsControl x:Name="PanelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10,10,6" Margin="{Binding Indent}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE839;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Ops.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Ports}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="132" MinHeight="54" Margin="0,0,5,5" Background="White" CornerRadius="5" BorderBrush="#E5E7EB" BorderThickness="1"
                                                        Opacity="{Binding Fade}" ToolTip="{Binding Tip}" Cursor="Hand" MouseLeftButtonUp="Port_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{Binding Stripe}" CornerRadius="4,0,0,4"/>
                                                        <StackPanel Grid.Column="1" Margin="7,4,6,4">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Speed}" FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                                                <TextBlock Text="{Binding Number}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- The chosen port, everything known; its device's page when it has one. -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="Port" Style="{StaticResource Ops.SectionTitle}"/>
                    <TextBlock x:Name="PortWhere" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" Text="Click a port."/>
                    <TextBlock x:Name="PortDetail" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Text.Primary}" LineHeight="20"/>
                    <Button x:Name="OpenDeviceBtn" Content="Open its page" Style="{StaticResource Ops.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Visibility="Collapsed" Click="OpenDevice_Click" ToolTip="This device's NetworkOps page: its parts, findings, history and Connect."/>
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Key" Style="{StaticResource Ops.Caption}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Ops.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Green: connected now · Amber: plugged in, not connected now · Slate: connected status not read · Blue: link to another switch · Grey: empty."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TABLE: the tree, and the chosen switch's ports (or a search's matches) as rows. -->
        <Grid Grid.Row="1" x:Name="TableView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,5,0">
                <ListBox x:Name="PlaceList" BorderThickness="0" Background="Transparent" SelectionChanged="Place_Changed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="{Binding Indent}" MinHeight="44">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Ops.Caption}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock x:Name="PlaceTitle" Style="{StaticResource Ops.SectionTitle}"/>
                        <TextBlock x:Name="PlaceSub" Style="{StaticResource Ops.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="Rows" Style="{StaticResource Ops.Grid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="WhereColumn" Header="Where" Binding="{Binding Where}" Width="190" Visibility="Collapsed"/>
                                <DataGridTextColumn x:Name="PortColumn" Header="Port" Binding="{Binding PortText}" Width="52"/>
                                <DataGridTemplateColumn Header="Device" Width="2*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3">
                                                <TextBlock Text="{Binding Device}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDevice}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Also}" TextWrapping="Wrap" FontSize="11" FontStyle="Italic" Foreground="{StaticResource Text.Secondary}"
                                                           Visibility="{Binding HasAlso, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Person" Binding="{Binding Person}" Width="130"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="115"/>
                                <DataGridTextColumn Header="Connected" Binding="{Binding When}" Width="170"/>
                                <DataGridTextColumn Header="Named by" Binding="{Binding NamedBy}" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Ops.Empty}" Tag="{Binding ElementName=Rows}" Text="Nothing here."/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Ops.Caption}" Margin="2,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
