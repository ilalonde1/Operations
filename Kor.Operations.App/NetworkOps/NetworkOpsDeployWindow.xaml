<Window x:Class="Kor.Operations.App.NetworkOps.NetworkOpsDeployWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fleet deploy"
        Width="1160"
        Height="820"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <!-- Tick machines, pick an operation (first: migrate to KOR-Operations), run it on each through its agent as SYSTEM.
         Each run is an ordinary audited action, so it shows in that machine's history too, and the row follows it to done. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kor.Operations.App;component/NetworkOps/NetworkOpsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Wrap" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="Fleet deploy" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
            <TextBlock x:Name="HeadlineText" Style="{StaticResource Ops.Caption}" FontSize="13" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Operation:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="OpBox" Width="320" DisplayMemberPath="Title" SelectionChanged="Op_Changed" VerticalAlignment="Center"/>
                    <Button Content="Tick all" Margin="18,0,6,0" Click="TickAll_Click"/>
                    <Button Content="Untick all" Style="{StaticResource Ops.Link}" Click="UntickAll_Click"/>
                </StackPanel>
                <TextBlock x:Name="OpExplain" Style="{StaticResource Wrap}" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <DataGrid x:Name="Grid" Style="{StaticResource Ops.Grid}" IsReadOnly="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsTicked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTick}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Click="Tick_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Machine" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="State" Binding="{Binding Who}" Width="280">
                            <DataGridTextColumn.ElementStyle><StaticResource ResourceKey="Wrap"/></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Deployment" Binding="{Binding Progress}" Width="*">
                            <DataGridTextColumn.ElementStyle><StaticResource ResourceKey="Wrap"/></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource Ops.Empty}" Tag="{Binding ElementName=Grid}" Text="No machines."/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RunBtn" Content="Run on 0 ticked" Style="{StaticResource Ops.Primary}" IsEnabled="False" Click="Run_Click"
                    ToolTip="Runs the chosen operation on every ticked machine, through its agent as SYSTEM. Each is audited and followed to completion here."/>
        </StackPanel>
        <TextBlock Grid.Row="4" x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="2,8,2,0"/>
    </Grid>
</Window>
