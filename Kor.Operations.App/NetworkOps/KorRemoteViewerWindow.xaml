<Window x:Class="Kor.Operations.App.NetworkOps.KorRemoteViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding Title}"
        Width="1600" Height="1000" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#3B4652"
        FontFamily="Mulish, Segoe UI"
        StateChanged="Window_StateChanged">
    <!-- ScreenConnect's viewer, the shape Ian asked for (2026-10-02): the machine's name and the controls in one dark strip
         that is also the title bar; the remote screen everywhere else. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kor.Operations.App;component/NetworkOps/NetworkOpsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Frame">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The strip: who, the controls, the window buttons. -->
            <Grid Grid.Row="0" Background="#3B4652">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#9CC3E6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DeviceName}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Width="8" Height="8" Fill="{Binding Light}" Margin="12,1,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#C9D1D9" FontSize="12" VerticalAlignment="Center"/>
                    <!-- Each monitor, or all of them (Ian, 2026-10-02: "switch to individual monitors or see all"). Only on a PC with more than one. -->
                    <ItemsControl ItemsSource="{Binding Monitors}" Margin="14,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding ShowsDisplays, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Monitor_Click" Tag="{Binding Number}" ToolTip="{Binding Tip}" Margin="0,0,4,0"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{Binding Fill}" BorderBrush="#7A8896" BorderThickness="1" CornerRadius="4" Padding="9,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Toast" Foreground="#9CC3E6" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <!-- The controls, on a tab hanging from the top edge (ScreenConnect's trapezoid). -->
                <Grid Grid.Column="1" VerticalAlignment="Top" Height="44">
                    <Path Fill="#1F2933" Stretch="Fill" Data="M0,0 L1,0 L0.96,1 L0.04,1 Z"/>
                    <StackPanel x:Name="Tools" Orientation="Horizontal" Margin="30,3,30,3" VerticalAlignment="Center" IsEnabled="{Binding IsReady}">
                        <Button x:Name="ScreenBtn" Style="{StaticResource Ops.RemoteTool}" Content="&#xE7F4;" Click="Screen_Click"
                                ToolTip="Screen: connect or disconnect, choose a monitor, full screen"/>
                        <Button x:Name="KeysBtn" Style="{StaticResource Ops.RemoteTool}" Content="&#xE945;" Click="Keys_Click"
                                ToolTip="Keys: Ctrl+Alt+Del, Win+L and the other combinations; lock the PC"/>
                        <Button x:Name="FixBtn" Style="{StaticResource Ops.RemoteTool}" Content="&#xE90F;" Click="Fix_Click"
                                ToolTip="Fix: what NetworkOps has open on this machine, and the fixes for it (run through the service, recorded)"/>
                        <Button x:Name="FilesBtn" Style="{StaticResource Ops.RemoteTool}" Content="&#xE8AB;" Click="Files_Click"
                                ToolTip="Files: copy to and from this machine (click again for the screen)"/>
                        <Button Style="{StaticResource Ops.RemoteTool}" Content="&#xE722;" Click="Screenshot_Click" IsEnabled="{Binding IsConnected}"
                                ToolTip="Save a screenshot of the remote screen to Pictures\KOR Remote"/>
                        <Button x:Name="PeopleBtn" Style="{StaticResource Ops.RemoteTool}" Content="&#xE716;" Click="People_Click"
                                ToolTip="Who is on it"/>
                        <Button Style="{StaticResource Ops.RemoteTool}" Content="&#xE8BD;" Click="Chat_Click"
                                ToolTip="Chat with the person at this machine"/>
                        <Button Style="{StaticResource Ops.RemoteTool}" Content="&#xE946;" Click="Info_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="This machine in NetworkOps: its parts, findings and history"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MoreBtn" Style="{StaticResource Ops.RemoteMore}" Content="More ▾" Click="More_Click"
                            ToolTip="Open in a browser window, reload">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in a browser window" Click="OpenInBrowser_Click"
                                          ToolTip="MeshCentral's full page in an Edge window: everything KOR Remote can do, including what this toolbar does not"/>
                                <MenuItem Header="Reload" Click="Reload_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource Ops.RemoteCaption}" Content="&#xE921;" Click="Minimise_Click" ToolTip="Minimise"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource Ops.RemoteCaption}" Content="&#xE922;" Click="Maximise_Click" ToolTip="Maximise"/>
                    <Button Style="{StaticResource Ops.RemoteCaption}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close (disconnects)"/>
                </StackPanel>
            </Grid>

            <!-- The remote screen: MeshCentral's own page, its header, menus and footer hidden. -->
            <Grid Grid.Row="1" Background="#2B333C">
                <wv2:WebView2 x:Name="View"/>
                <Border Background="#2B333C" Visibility="{Binding ShowsOverlay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Overlay}" Foreground="#E5E7EB" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
