<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One look for every NetworkOps window (Command Center, a device, Fix, Updates, Ask Claude). Merged by each window;
         NetworkOpsStyleTests fails a window that does not merge it, a button that styles itself inline, or a table
         without Ops.Grid : so the windows cannot drift back to looking different from each other.

         The hierarchy, in one line each:
           Ops.Primary  the one thing this strip is for (filled navy)  : at most one per strip
           (implicit)   everything else (quiet outline)
           Ops.Danger   undoes or removes something (red outline)
           Ops.Link     a light action beside a primary one (text only) -->

    <!-- ===== Buttons: one template, so hover and disabled look the same everywhere (the system one turns a navy
         button pale blue with white text on hover). ===== -->
    <ControlTemplate x:Key="Ops.ButtonTemplate" TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2F5496"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Ops.Button" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource Ops.ButtonTemplate}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD2D9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <!-- Every button in a NetworkOps window is an Ops.Button unless it says otherwise. -->
    <Style TargetType="Button" BasedOn="{StaticResource Ops.Button}"/>

    <Style x:Key="Ops.Primary" TargetType="Button" BasedOn="{StaticResource Ops.Button}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Brand.Primary.Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Primary.Brush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,5"/>
    </Style>

    <Style x:Key="Ops.Danger" TargetType="Button" BasedOn="{StaticResource Ops.Button}">
        <Setter Property="Foreground" Value="#B91C1C"/>
        <Setter Property="BorderBrush" Value="#F1B5B5"/>
    </Style>

    <Style x:Key="Ops.Link" TargetType="Button" BasedOn="{StaticResource Ops.Button}">
        <Setter Property="Foreground" Value="#2F5496"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="6,5"/>
    </Style>

    <!-- A menu of the rarer actions behind one "More" button (the device header). -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="Mulish, Segoe UI"/>
    </Style>

    <!-- ===== Text ===== -->
    <Style x:Key="Ops.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>
    <Style x:Key="Ops.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Ops.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- What an empty table says instead of a grey slab. Point Tag at the table: it hides itself once there are rows. -->
    <Style x:Key="Ops.Empty" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,48,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.HasItems, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tables: white, horizontal rules only, quiet headers, a soft selection. ===== -->
    <Style x:Key="Ops.ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F6F8FA"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="Ops.Cell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#E3EBF4"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Ops.Grid" TargetType="DataGrid" BasedOn="{StaticResource KorDataGridBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F2"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Ops.ColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource Ops.Cell}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>

    <!-- ===== Tabs: words with an underline on the chosen one, not the boxed system tabs. ===== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#EEF0F2"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="0,10,0,0"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Padding="12,6" Margin="0,0,4,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.Accent.Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Small pieces ===== -->
    <!-- A status pill (Critical, Healthy...): the colour comes from the binding. -->
    <Style x:Key="Ops.Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Ops.PillText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <!-- A quiet chip with a coloured dot: "Agent connected", "Remote control". -->
    <Style x:Key="Ops.Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Background" Value="#F3F5F7"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- A summary tile: one number, one word. A tile that filters the lists shows it is chosen with a navy outline. -->
    <Style x:Key="Ops.Tile" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Selected">
                <Setter Property="BorderBrush" Value="{StaticResource Brand.Primary.Brush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FBFCFD"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Ops.TileNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Ops.TileLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
    </Style>
</ResourceDictionary>
