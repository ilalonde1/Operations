<Window x:Class="Kor.Operations.App.NetworkOps.NetworkOpsCommandCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:nops="clr-namespace:Kor.Operations.App.NetworkOps"
        Title="NetworkOps Command Center"
        Width="1440"
        Height="960"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kor.Operations.App;component/NetworkOps/NetworkOpsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <nops:HealthStateToBrushConverter x:Key="StateToBrush"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- A row that has not been read recently is greyed, and says why on hover. -->
            <Style x:Key="StaleRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStale}" Value="True">
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="ToolTip" Value="Not read recently: this may be out of date."/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="StatePill">
                <Border Style="{StaticResource Ops.Pill}" Background="{Binding State, Converter={StaticResource StateToBrush}}">
                    <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Ops.PillText}"/>
                </Border>
            </DataTemplate>
            <!-- One machine as a card: its colour down the left edge, the name, what it is, what matters most, and one line
                 of who/when. A card not read lately is faded and says so on hover, as its table row is greyed. -->
            <DataTemplate x:Key="MachineCard">
                <Border Width="236" MinHeight="112" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" ToolTip="{Binding Headline}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Opacity" Value="0.55"/>
                                    <Setter Property="ToolTip" Value="Not read recently: this may be out of date."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding State, Converter={StaticResource StateToBrush}}" CornerRadius="7,0,0,7"/>
                        <Grid Grid.Column="1" Margin="11,8,11,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Ops.CardTitle}"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            <TextBlock Grid.Row="2" Text="{Binding Headline}" FontSize="12.5" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="3" Text="{Binding Footer}" ToolTip="{Binding Footer}" FontSize="11" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- connection-lost banner -->
            <RowDefinition Height="Auto"/>   <!-- primary nav (Fleet | To clear) -->
            <RowDefinition Height="Auto"/>   <!-- Fleet: headline + tiles -->
            <RowDefinition Height="Auto"/>   <!-- Fleet: toolbar -->
            <RowDefinition Height="*"/>      <!-- content (Fleet, or the To clear worklist) -->
            <RowDefinition Height="Auto"/>   <!-- status -->
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="NetworkOps Command Center"
                            SubtitleText="The rack, the network and every PC"
                            AvatarDiameter="64"
                            AvatarBorderThickness="2"/>

        <!-- Connection-lost banner: without it the page looks healthy while showing stale data. -->
        <Border Grid.Row="1"
                Background="#C11E1E"
                CornerRadius="8"
                Margin="12,0,12,8"
                Padding="14,8"
                Visibility="{Binding IsConnectionLost, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ConnectionLostMessage}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Primary nav: the console's surfaces as tabs. Network is folded in here (2026-10-04); Updates/Deploy/Ask Claude
             still open from the Fleet toolbar until each is folded in turn. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,8">
            <RadioButton x:Name="FleetTab" Content="Fleet" GroupName="ConsoleTab" Style="{StaticResource Ops.Segment}" IsChecked="True"
                         ToolTip="The rack and every PC, worst first."/>
            <RadioButton x:Name="ToClearTab" Content="To clear" GroupName="ConsoleTab" Style="{StaticResource Ops.Segment}" Margin="6,0,0,0"
                         Checked="ToClearTab_Checked"
                         ToolTip="Every open issue across the fleet, grouped, with fix-on-all — the path to all-green."/>
            <RadioButton x:Name="NetworkTab" Content="Network" GroupName="ConsoleTab" Style="{StaticResource Ops.Segment}" Margin="6,0,0,0"
                         Checked="NetworkTab_Checked"
                         ToolTip="Every switch and port, and what is plugged into each: PC, person, IP. Searchable."/>
        </StackPanel>

        <!-- Fleet: the page in one sentence, then four tiles counted across the rack AND the PCs. A tile is also a filter. -->
        <Grid Grid.Row="3" Margin="12,0,12,10" Visibility="{Binding IsChecked, ElementName=FleetTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,5,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="5" RadiusX="2.5" RadiusY="2.5" Fill="{Binding HeadlineBrush}" Margin="0,2,14,2"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadlineText" Text="{Binding Headline}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource Ops.Caption}" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="{Binding ServiceSubline}">
                            <Ellipse Width="8" Height="8" Fill="{Binding ServiceBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Style="{StaticResource Ops.Caption}" VerticalAlignment="Center">
                                <Run Text="NetworkOps service"/><Run Text=" "/><Run Text="{Binding ServiceHeadline, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="CriticalTile" Grid.Column="1" Style="{StaticResource Ops.Tile}" Margin="5,0" Tag="{Binding CriticalTileTag}" MouseLeftButtonUp="Tile_Click"
                    ToolTip="Critical, on the rack and the PCs. Click to show only these; click again to show everything.">
                <StackPanel>
                    <TextBlock Text="{Binding CriticalHeadline}" Style="{StaticResource Ops.TileNumber}" Foreground="#B91C1C"/>
                    <TextBlock Text="Critical" Style="{StaticResource Ops.TileLabel}"/>
                </StackPanel>
            </Border>
            <Border x:Name="AttentionTile" Grid.Column="2" Style="{StaticResource Ops.Tile}" Margin="5,0" Tag="{Binding AttentionTileTag}" MouseLeftButtonUp="Tile_Click"
                    ToolTip="Needs attention, on the rack and the PCs. Click to show only these.">
                <StackPanel>
                    <TextBlock Text="{Binding AttentionHeadline}" Style="{StaticResource Ops.TileNumber}" Foreground="#B45309"/>
                    <TextBlock Text="Need attention" Style="{StaticResource Ops.TileLabel}"/>
                </StackPanel>
            </Border>
            <Border x:Name="HealthyTile" Grid.Column="3" Style="{StaticResource Ops.Tile}" Margin="5,0" Tag="{Binding HealthyTileTag}" MouseLeftButtonUp="Tile_Click"
                    ToolTip="Nothing open, on the rack and the PCs. Click to show only these.">
                <StackPanel>
                    <TextBlock Text="{Binding HealthyHeadline}" Style="{StaticResource Ops.TileNumber}" Foreground="#166534"/>
                    <TextBlock Text="{Binding HealthyLabel}" Style="{StaticResource Ops.TileLabel}"/>
                </StackPanel>
            </Border>
            <Border x:Name="StaleTile" Grid.Column="4" Style="{StaticResource Ops.Tile}" Margin="5,0,0,0" Tag="{Binding StaleTileTag}" MouseLeftButtonUp="Tile_Click"
                    ToolTip="Not read recently (a PC in 3 days, the rack in 15 minutes), or never: what the page shows for them may be out of date. Click to show only these.">
                <StackPanel>
                    <TextBlock Text="{Binding StaleHeadline}" Style="{StaticResource Ops.TileNumber}" Foreground="#6B7280"/>
                    <TextBlock Text="Not seen lately" Style="{StaticResource Ops.TileLabel}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fleet toolbar: find and filter on the left, what to do on the right. -->
        <Grid Grid.Row="4" Margin="12,0,12,10" Visibility="{Binding IsChecked, ElementName=FleetTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox x:Name="FilterBox"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         ToolTip="Searches the rack and the PCs: a name, a model, a kind or what is wrong -- 'veeam', 'UPS', 'KOR-2', 'P340', 'disk'."/>
                <TextBlock Text="Find a PC, device or problem…" Foreground="#9CA3AF" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=FilterBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox Content="Only problems" Margin="14,0,0,0" VerticalAlignment="Center"
                          ToolTip="Hide rack devices and PCs with nothing open."
                          IsChecked="{Binding ProblemsOnly}"/>
                <RadioButton x:Name="CardsViewBtn" Content="Cards" GroupName="View" Style="{StaticResource Ops.Segment}" Margin="18,0,0,0"
                             IsChecked="{Binding CardView}" ToolTip="Every machine as a card."/>
                <RadioButton x:Name="TableViewBtn" Content="Table" GroupName="View" Style="{StaticResource Ops.Segment}"
                             IsChecked="{Binding TableView}" ToolTip="The same machines as a dense table."/>
            </StackPanel>
            <!-- Grouped by purpose, left to right: ACT on the fleet · open a focused TOOL · the selected PC · refresh.
                 Thin separators mark the groups so the row reads as four things, not nine. -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <!-- Tools: a focused workspace, each opened on its own. (Network moved to a console tab, 2026-10-04.) -->
                <Button Content="Updates" Margin="0,0,6,0" Click="Updates_Click"
                        ToolTip="What Windows Update has waiting on every PC and server, and installing it on many at once."/>
                <Button Content="Deploy" Margin="0,0,6,0" Click="Deploy_Click"
                        ToolTip="Install an app update or migration on ticked machines, through each PC's agent as SYSTEM (e.g. migrate to KOR-Operations)."/>
                <Button Content="Ask Claude" Margin="0,0,10,0" Click="AskClaude_Click"
                        ToolTip="Ask anything about the selected PC (or the whole network), or open a prompt for any problem: Claude starts in Windows Terminal with everything NetworkOps knows."/>
                <Border Width="1" Background="#E3E7EB" Margin="0,6,10,6"/>
                <!-- The selected PC. -->
                <Button x:Name="OpenPcBtn" Content="Open PC" Margin="0,0,10,0" Click="OpenPc_Click"
                        ToolTip="Open the selected PC (or double-click a row)."/>
                <Border Width="1" Background="#E3E7EB" Margin="0,6,10,6"/>
                <!-- Freshness. -->
                <Button x:Name="RecheckBtn" Content="Re-check all" Margin="0,0,8,0" Click="RecheckAll_Click"
                        ToolTip="Runs the health probe on every PC now (a few minutes) instead of waiting for the next scheduled sweep. New findings appear as each PC answers; the list refreshes when it finishes."/>
                <CheckBox Content="Auto-refresh" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" Margin="0,0,6,0"
                          ToolTip="Re-read everything every 15 seconds."/>
                <Button x:Name="RefreshBtn" Content="↻" Style="{StaticResource Ops.Link}" FontSize="16" Click="RefreshBtn_Click" ToolTip="Refresh now"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="12,0,12,10" Visibility="{Binding IsChecked, ElementName=FleetTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Cards: the rack, then the PCs, worst first, on one page that scrolls. Same rows and filters as the table. -->
            <ScrollViewer Grid.Column="0" Margin="0,0,5,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding CardView, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="Rack" Style="{StaticResource Ops.SectionTitle}"/>
                        <TextBlock Text="{Binding RackFreshness}" Style="{StaticResource Ops.Caption}" VerticalAlignment="Bottom" Margin="10,0,0,1"/>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="RackCards" Style="{StaticResource Ops.CardList}" ItemsSource="{Binding Rack}" ItemTemplate="{StaticResource MachineCard}"
                                 MouseDoubleClick="RackCards_MouseDoubleClick" PreviewKeyDown="RackCards_PreviewKeyDown" SelectionChanged="RackCards_SelectionChanged"/>
                        <TextBlock Style="{StaticResource Ops.Empty}" Margin="0,8,0,16" Tag="{Binding ElementName=RackCards}" Text="Nothing in the rack matches."/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="2,10,0,8">
                        <TextBlock Text="PCs" Style="{StaticResource Ops.SectionTitle}"/>
                        <TextBlock Text="double-click one to see what is wrong, what it means and what fixed it before" Style="{StaticResource Ops.Caption}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,1"/>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="FleetCards" Style="{StaticResource Ops.CardList}" ItemsSource="{Binding Fleet}" ItemTemplate="{StaticResource MachineCard}"
                                 MouseDoubleClick="FleetCards_MouseDoubleClick" PreviewKeyDown="FleetCards_PreviewKeyDown" SelectionChanged="FleetCards_SelectionChanged"/>
                        <TextBlock Style="{StaticResource Ops.Empty}" Margin="0,8,0,16" Tag="{Binding ElementName=FleetCards}" Text="No PC matches."/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Table: the rack and the PCs share the height (worst first in both, so the top rows are the ones that matter);
                 the PCs get more of it: there are three times as many. -->
            <Grid Grid.Column="0" Margin="0,0,5,0" Visibility="{Binding TableView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="180"/>
                    <RowDefinition Height="5*" MinHeight="220"/>
                </Grid.RowDefinitions>

                <!-- The rack: every piece of infrastructure, worst first. -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Rack" Style="{StaticResource Ops.SectionTitle}"/>
                            <TextBlock Text="{Binding RackFreshness}" Style="{StaticResource Ops.Caption}" VerticalAlignment="Bottom" Margin="10,0,0,1"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <DataGrid x:Name="RackGrid"
                                      Style="{StaticResource Ops.Grid}"
                                      ItemsSource="{Binding Rack}"
                                      RowStyle="{StaticResource StaleRow}"
                                      MouseDoubleClick="RackGrid_MouseDoubleClick"
                                      PreviewKeyDown="RackGrid_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="State" Width="140" SortMemberPath="State" CellTemplate="{StaticResource StatePill}"/>
                                    <DataGridTextColumn Header="Kind"         Binding="{Binding Kind}"      Width="80"/>
                                    <DataGridTextColumn Header="Device"       Binding="{Binding Name}"      Width="280"/>
                                    <DataGridTextColumn Header="What matters" Binding="{Binding Headline}"  Width="*"/>
                                    <DataGridTextColumn Header="Open"         Binding="{Binding LiveCount}" Width="56"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Ops.Empty}" Tag="{Binding ElementName=RackGrid}" Text="Nothing in the rack matches."/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- The PCs: most urgent first. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PCs" Style="{StaticResource Ops.SectionTitle}"/>
                            <TextBlock Text="double-click one to see what is wrong, what it means and what fixed it before" Style="{StaticResource Ops.Caption}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,1"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <DataGrid x:Name="FleetGrid"
                                      Style="{StaticResource Ops.Grid}"
                                      ItemsSource="{Binding Fleet}"
                                      RowStyle="{StaticResource StaleRow}"
                                      MouseDoubleClick="FleetGrid_MouseDoubleClick"
                                      PreviewKeyDown="FleetGrid_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <!-- Fixed widths + star minimums must fit the grid at the window's default size, or WPF squeezes
                                         the fixed columns and clips their headers ("Open" rendered as "Ope", 2026-09-30). -->
                                    <DataGridTemplateColumn Header="State" Width="135" SortMemberPath="State" CellTemplate="{StaticResource StatePill}"/>
                                    <DataGridTextColumn Header="PC"           Binding="{Binding Name}"            Width="100"/>
                                    <DataGridTextColumn Header="What matters" Binding="{Binding Headline}"        Width="2*" MinWidth="190"/>
                                    <DataGridTextColumn Header="Open"         Binding="{Binding LiveCount}"       Width="56"/>
                                    <DataGridTextColumn Header="On it now"    Binding="{Binding Presence}"        Width="*" MinWidth="140"/>
                                    <DataGridTextColumn Header="Agent"        Binding="{Binding Agent}"           Width="95"/>
                                    <DataGridTextColumn Header="Model"        Binding="{Binding Model}"           Width="120"/>
                                    <DataGridTextColumn Header="Checked"      Binding="{Binding LastCheckedText}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Ops.Empty}" Tag="{Binding ElementName=FleetGrid}" Text="No PC matches."/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Rack power: both UPSes, the verdict, whether the shutdown chain is armed. -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Power" Style="{StaticResource Ops.SectionTitle}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource Ops.Pill}" Background="{Binding PowerBrush}">
                                <TextBlock Text="{Binding PowerHeadline}" Style="{StaticResource Ops.PillText}"/>
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Ups}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8" ToolTip="{Binding Address}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="0,5,10,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Ops.Caption}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding PowerReason}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Visibility="{Binding HasPowerReason, Converter={StaticResource BoolToVis}}"/>
                        <Border BorderBrush="#EEF0F2" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,2,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ChainText}" Style="{StaticResource Ops.Caption}"/>
                                <TextBlock Text="{Binding LastRehearsalText}" Style="{StaticResource Ops.Caption}" Margin="0,3,0,0"/>
                                <Button x:Name="RehearseBtn" Content="Rehearse the shutdown now" Style="{StaticResource Ops.Link}" HorizontalAlignment="Left"
                                        Margin="-6,2,0,0" Click="RehearseBtn_Click"
                                        ToolTip="Runs every step of the UPS shutdown chain against the live rack WITHOUT shutting anything down: proves each host, VM, Synology and the final script still line up. Runs by itself every morning at 06:45."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Fleet patterns: what the PCs with a problem have in common that the others do not. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Patterns across the PCs" Style="{StaticResource Ops.SectionTitle}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Ops.Caption}" Margin="0,3,0,8"
                                   Text="A problem that goes with a model, driver or app far more often than chance would. A lead on the cause, not proof."
                                   ToolTip="One-sided Fisher exact test, p ≤ 0.01, over the facts that can explain a pattern (model, BIOS, drivers, Office, key apps)."/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl x:Name="PatternList" ItemsSource="{Binding Patterns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEF0F2" BorderThickness="0,0,0,1" Padding="0,8,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding MembersText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding SinceText}" Style="{StaticResource Ops.Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Ops.Empty}" Margin="0,16,0,0" Tag="{Binding ElementName=PatternList}" Text="No pattern stands out right now."/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- To clear: the worklist, hosted here and shown when its tab is picked (created in code with the client). -->
        <ContentControl x:Name="ToClearHost" Grid.Row="5" Margin="0,0,0,2"
                        Visibility="{Binding IsChecked, ElementName=ToClearTab, Converter={StaticResource BoolToVis}}"/>

        <!-- Network: the port map, hosted here and shown when its tab is picked (created in code with the client + navigator). -->
        <ContentControl x:Name="NetworkHost" Grid.Row="5" Margin="12,0,12,2"
                        Visibility="{Binding IsChecked, ElementName=NetworkTab, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="6" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
