<Window x:Class="Kor.Operations.App.NetworkOps.NetworkOpsFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fix"
        Width="720"
        SizeToContent="Height"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kor.Operations.App;component/NetworkOps/NetworkOpsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Choose a fix for one finding. Everything here runs on the machine as SYSTEM, through the service, and is
         recorded (who, what, the output). A restart is refused by the service while someone is active unless confirmed. -->
    <Border Style="{StaticResource Card}" Margin="12" Padding="16">
        <StackPanel>
            <TextBlock x:Name="FindingTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Text.Primary}"/>
            <TextBlock x:Name="PresenceText" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <Border x:Name="NoFixNote" Visibility="Collapsed" Background="#F6F8FA" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,14,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Primary}"
                           Text="There is no one-click fix for this yet. Ask Claude… on the finding works it out with everything NetworkOps knows; or type your own PowerShell below."/>
            </Border>
            <TextBlock Text="CHOOSE A FIX" Style="{StaticResource Ops.Label}" Margin="0,16,0,6"/>
            <ListBox x:Name="FixList" SelectionChanged="FixList_SelectionChanged" MaxHeight="320" BorderBrush="#E5E7EB" Padding="2">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,6,6,8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Explain}" TextWrapping="Wrap" MaxWidth="620" Foreground="{StaticResource Text.Secondary}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="ParamPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock x:Name="ParamLabel" Style="{StaticResource Ops.Label}"/>
                <TextBox x:Name="ParamBox" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" MinHeight="32" TextChanged="ParamBox_TextChanged"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="220"/>
            </StackPanel>

            <TextBlock x:Name="WarningText" Foreground="#C11E1E" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="RunBtn" Content="Run fix" Style="{StaticResource Ops.Primary}" Margin="0,0,8,0" IsEnabled="False" Click="Run_Click" IsDefault="True"/>
                <Button Content="Cancel" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
