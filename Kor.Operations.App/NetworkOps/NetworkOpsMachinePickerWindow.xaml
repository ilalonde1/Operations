<Window x:Class="Kor.Operations.App.NetworkOps.NetworkOpsMachinePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose machines"
        Width="440"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <!-- Pick which machines an issue's disposition (acknowledge/snooze) applies to, when it is open on more than one:
         clear the drive on the PC you've handled, leave the one that still needs attention. All checked by default. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kor.Operations.App;component/NetworkOps/NetworkOpsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource Card}" Margin="12" Padding="16">
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Text.Primary}"/>
            <TextBlock x:Name="SubText" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <Button Content="Select all" Style="{StaticResource Ops.Link}" Click="SelectAll_Click"/>
                <Button Content="Clear" Style="{StaticResource Ops.Link}" Margin="14,0,0,0" Click="ClearAll_Click"/>
            </StackPanel>

            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="4">
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MachineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="6,5"
                                          Foreground="{StaticResource Text.Primary}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="OkBtn" Content="OK" Style="{StaticResource Ops.Primary}" MinWidth="92" Click="Ok_Click" IsDefault="True"/>
                <Button Content="Cancel" MinWidth="92" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
