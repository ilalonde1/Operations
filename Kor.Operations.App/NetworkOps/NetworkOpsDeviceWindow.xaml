<Window x:Class="Kor.Operations.App.NetworkOps.NetworkOpsDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nops="clr-namespace:Kor.Operations.App.NetworkOps"
        Title="{Binding DeviceName, StringFormat='NetworkOps — {0}'}"
        Width="1300"
        Height="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <nops:HealthStateToBrushConverter x:Key="StateToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- A heading and a bulleted list, used by every section of the explanation. -->
        <DataTemplate x:Key="Bullet">
            <TextBlock TextWrapping="Wrap" Margin="0,1,0,1">
                <Run Text="•  "/><Run Text="{Binding Mode=OneWay}"/>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Who this PC or rack device is, and how fresh that is. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="12,12,12,8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DeviceName}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border CornerRadius="9" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center" Background="{Binding StateBrush}">
                            <TextBlock Text="{Binding StateLabel}" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding IdentityLine}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding HardwareLine}" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding FreshnessLine}" Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding PresenceLine}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding AgentLine}" Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding ShowsAgent, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="420">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding AgentButtonText}" Padding="12,6" Margin="0,0,6,0" Click="InstallAgent_Click"
                                IsEnabled="{Binding CanChangeAgent}" Visibility="{Binding ShowsAgent, Converter={StaticResource BoolToVis}}"
                                ToolTip="Puts the NetworkOps agent on this PC from APP01 (or replaces it with the version APP01 has). Done once the agent has called in."/>
                        <Button Content="Remove agent" Padding="12,6" Margin="0,0,6,0" Click="RemoveAgent_Click"
                                IsEnabled="{Binding CanChangeAgent}" Visibility="{Binding HasAgent, Converter={StaticResource BoolToVis}}"
                                ToolTip="Stops and deletes the agent on this PC; checks go back to the network route."/>
                        <Button x:Name="CheckNowBtn" Content="{Binding CheckButtonText}" Padding="16,6"
                                IsEnabled="{Binding CanCheck}" Click="CheckNow_Click"
                                ToolTip="{Binding CheckButtonTip}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CheckStatus}" TextWrapping="Wrap" Margin="0,6,0,0" HorizontalAlignment="Right" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="480"/>
            </Grid.ColumnDefinitions>

            <!-- What is wrong now. -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,4,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Open now" FontSize="14" FontWeight="SemiBold"/>
                    <DataGrid Grid.Row="1"
                              x:Name="FindingsGrid"
                              ItemsSource="{Binding OpenFindings}"
                              SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="90" SortMemberPath="Severity">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding Severity, Converter={StaticResource StateToBrush}}">
                                            <TextBlock Text="{Binding Severity}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Finding" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}"/>
                                            <TextBlock Text="{Binding QuietText}" TextWrapping="Wrap" FontStyle="Italic" Foreground="{StaticResource Text.Secondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Since" Binding="{Binding SinceText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Annotate the selected finding. The service still owns it: it clears when the PC is fixed. -->
                    <Grid Grid.Row="2" Margin="0,8,0,0" IsEnabled="{Binding HasSelection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ActionNote, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 ToolTip="Optional reason, saved with an acknowledge or snooze: 'new drive ordered', 'user is away'."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="FixBtn" Content="Fix…" Padding="14,4" Margin="0,0,10,0" FontWeight="SemiBold" Click="Fix_Click"
                                    IsEnabled="{Binding CanFix}"
                                    ToolTip="Run a fix for the selected finding on this machine (as SYSTEM, through the service, recorded). It is re-checked afterwards."/>
                            <Button Content="Acknowledge" Padding="10,4" Margin="0,0,6,0" Click="Acknowledge_Click"
                                    ToolTip="Known and accepted: stops counting against this device until it clears and comes back."/>
                            <Button Content="Snooze 1 day" Padding="10,4" Margin="0,0,6,0" Click="SnoozeDay_Click"/>
                            <Button Content="Snooze 1 week" Padding="10,4" Margin="0,0,6,0" Click="SnoozeWeek_Click"/>
                            <Button Content="Reopen" Padding="10,4" Click="Reopen_Click"
                                    Visibility="{Binding SelectedIsQuiet, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Undo an acknowledge or snooze: it counts again at once."/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="{Binding FixStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <!-- The selected finding, explained. -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0" Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="What it means" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <TextBlock Text="{Binding OthersHeading}" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="{Binding ElsewhereText}" TextWrapping="Wrap"/>

                        <!-- Fleet patterns compare PCs: the section is hidden on a rack device. -->
                        <StackPanel Visibility="{Binding ShowsPatterns, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Fleet pattern" Style="{StaticResource SectionHeading}"/>
                            <ItemsControl ItemsSource="{Binding PatternTexts}" ItemTemplate="{StaticResource Bullet}"/>
                        </StackPanel>

                        <TextBlock Text="Likely causes" Style="{StaticResource SectionHeading}"/>
                        <ItemsControl ItemsSource="{Binding Causes}" ItemTemplate="{StaticResource Bullet}"/>

                        <TextBlock Text="Known fixes, most likely first" Style="{StaticResource SectionHeading}"/>
                        <ItemsControl ItemsSource="{Binding KnownFixes}" ItemTemplate="{StaticResource Bullet}"/>

                        <TextBlock Text="What has cleared it on this fleet" Style="{StaticResource SectionHeading}"/>
                        <ItemsControl ItemsSource="{Binding LearnedFixes}" ItemTemplate="{StaticResource Bullet}"/>

                        <TextBlock Text="If nobody acts" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="{Binding IfIgnored}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- The past: what was wrong before, what changed, what people wrote. -->
        <TabControl Grid.Row="2" Margin="12,0,12,8">
            <TabItem Header="Past problems">
                <DataGrid ItemsSource="{Binding Cleared}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Finding"        Binding="{Binding Title}"    Width="320"/>
                        <DataGridTextColumn Header="Open → cleared" Binding="{Binding WhenText}" Width="260"/>
                        <DataGridTextColumn Header="What cleared it" Binding="{Binding How}"     Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="What changed on it">
                <DataGrid ItemsSource="{Binding Changes}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When"   Binding="{Binding WhenText}"    Width="150"/>
                        <DataGridTextColumn Header="Change" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Fixes run">
                <DataGrid ItemsSource="{Binding ActionsTaken}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When"   Binding="{Binding WhenText}" Width="140"/>
                        <DataGridTextColumn Header="Fix"    Binding="{Binding Fix}"      Width="220"/>
                        <DataGridTextColumn Header="By"     Binding="{Binding By}"       Width="220"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}"   Width="80"/>
                        <DataGridTextColumn Header="What it said" Binding="{Binding Result}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Notes">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 ToolTip="Anything worth knowing next time: 'reseated the GPU 30 Sep', 'user reports fan noise'."/>
                        <Button Grid.Column="1" Content="Add note" Padding="12,4" Margin="8,0,0,0" Click="AddNote_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Header}" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
