<Window x:Class="Kor.Operations.EmailFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="File Emails to Project"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- KorHeader (same style as other windows) -->
        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="File Emails to Project"
                            SubtitleText="Select a project and file emails"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2" />

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <!-- Emails -->
                <ColumnDefinition Width="4*"/>
                <!-- Projects -->
            </Grid.ColumnDefinitions>

            <!-- Left: emails to file -->
            <GroupBox Header="Emails to file"
                      Margin="0,0,8,0"
                      Padding="8"
                      Grid.Column="0">
                <Grid>
                    <ListBox x:Name="EmailsList"
                             AlternationCount="2"
                             ItemContainerStyle="{StaticResource KorStripedListBoxItem}"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Subject}"
                                           FontWeight="Regular"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- Right: project picker -->
            <GroupBox Header="Select project"
                      Margin="8,0,0,0"
                      Padding="8"
                      Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Search -->
                        <RowDefinition Height="2*"/>
                        <!-- All Projects (taller) -->
                        <RowDefinition Height="*"/>
                        <!-- My Favorites -->
                        <RowDefinition Height="Auto"/>
                        <!-- Selected Project -->
                    </Grid.RowDefinitions>

                    <!-- Search box -->
                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,8">
                        <TextBlock Text="Search All Projects:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox x:Name="ProjectSearchBox"
                                 MinWidth="200"
                                 MinHeight="28"
                                 VerticalAlignment="Center"
                                 Padding="6,4" VerticalContentAlignment="Center"
                                 TextChanged="ProjectSearchBox_TextChanged"
                                 KeyDown="ProjectSearchBox_KeyDown" />
                    </DockPanel>

                    <!-- My Favorite Projects -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="My Favourite Projects:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />

                        <ListBox Grid.Row="1"
                                 x:Name="FavoritesList"
                                          AlternationCount="2"
                                    ItemContainerStyle="{StaticResource KorStripedListBoxItem}"
                                 HorizontalContentAlignment="Stretch"
                                  BorderThickness="0"
                                 SelectionChanged="FavoritesList_SelectionChanged"
                                 Cursor="Hand"
                                 MouseDoubleClick="FavoritesList_MouseDoubleClick"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Margin="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Regular"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- All Projects -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="All Projects:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />

                        <ListBox Grid.Row="1"
                                 x:Name="ProjectsList"
                                          AlternationCount="2"
                                    ItemContainerStyle="{StaticResource KorStripedListBoxItem}"
                                 HorizontalContentAlignment="Stretch"
                                  BorderThickness="0"
                                 SelectionChanged="ProjectsList_SelectionChanged"
                                 Cursor="Hand"
                                 MouseDoubleClick="ProjectsList_MouseDoubleClick"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Margin="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Regular"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Selected Project summary -->
                    <StackPanel Grid.Row="3"
                                Margin="0,8,0,0">
                        <TextBlock Text="Selected Project:"
                                   Margin="0,0,0,2" />
                        <TextBox x:Name="SelectedProjectBox"
                                 IsReadOnly="True"
                                 Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                 BorderThickness="1"
                                 Padding="4"
                                 Text="" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2"
           Margin="0,8,0,0">
            <TextBlock x:Name="StatusText"
               VerticalAlignment="Center"
               Foreground="Gray"
               DockPanel.Dock="Left" />

            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">

                <!-- NEW: save attachments separately -->
                <CheckBox x:Name="SaveAttachmentsCheckBox"
                  Content="Save attachments separately"
                  VerticalAlignment="Center"
                  Margin="0,0,16,0" />

                <Button Content="Cancel"
                Width="90"
                Margin="0,0,8,0"
                IsCancel="True"
                Click="CancelButton_Click" />
                <Button Content="File Emails"
                Width="120"
                IsDefault="True"
                Click="FileButton_Click" />
            </StackPanel>
        </DockPanel>

        <!-- Spinner overlay: covers all 3 rows while filing is in progress -->
        <controls:LoadingOverlay x:Name="LoadingOverlay" Grid.RowSpan="3" Panel.ZIndex="100"/>

    </Grid>
</Window>
