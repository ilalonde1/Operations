<Application x:Class="Kor.Operations.OperationsApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brochures="clr-namespace:Kor.Operations.Brochures"
             xmlns:converters="clr-namespace:Kor.Operations.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Use your existing file and folder names -->
                <ResourceDictionary Source="Themes/KorTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <brochures:AddOneConverter x:Key="AddOneConverter"/>
            <brochures:FileNameFromPathConverter x:Key="FileNameFromPathConverter"/>
            <brochures:ImagePathConverter x:Key="ImagePathConverter"/>
            <converters:HexToColorConverter x:Key="HexToColorConverter"/>
            <Style x:Key="Help.SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="Help.Body" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>

            <!--
              Shared cell style for the unposted-invoicing visual treatment.
              Applies italic + amber (#92400E) + a discoverability tooltip when the row's
              HasUnpostedBilling is true. Single source of truth for the vocabulary.
              Does NOT fit two specialized sites: the FinancialsWindow headline tile
              (binds Headline.HasUnpostedBilling — different path) and the PM Tools
              bar-color % Billed cell (italic-only, keeps the bar color signal).
            -->
            <Style x:Key="UnpostedBillingCellStyle" TargetType="TextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasUnpostedBilling}" Value="True">
                        <Setter Property="FontStyle" Value="Italic"/>
                        <Setter Property="Foreground" Value="#92400E"/>
                        <Setter Property="ToolTip" Value="Italic + amber: includes invoices issued in Deltek AR but not yet posted to PRSummaryMain. Once posting catches up, the styling clears and the value matches posted figures."/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>


