<Application x:Class="Kor.Operations.OperationsApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:brochures="clr-namespace:Kor.Operations.Brochures"
             xmlns:converters="clr-namespace:Kor.Operations.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Use your existing file and folder names -->
                <ResourceDictionary Source="Themes/KorTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <brochures:AddOneConverter x:Key="AddOneConverter"/>
            <brochures:FileNameFromPathConverter x:Key="FileNameFromPathConverter"/>
            <brochures:ImagePathConverter x:Key="ImagePathConverter"/>
            <converters:HexToColorConverter x:Key="HexToColorConverter"/>
            <Style x:Key="Help.SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="Help.Body" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>


