<Application x:Class="Kor.Operations.OperationsApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:generalTools="clr-namespace:Kor.Operations.GeneralTools">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Use your existing file and folder names -->
                <ResourceDictionary Source="Themes/KorTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <generalTools:AddOneConverter x:Key="AddOneConverter"/>
            <generalTools:FileNameFromPathConverter x:Key="FileNameFromPathConverter"/>
            <generalTools:ImagePathConverter x:Key="ImagePathConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

