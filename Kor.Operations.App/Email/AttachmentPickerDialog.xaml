<Window x:Class="Kor.Operations.AttachmentPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Attachments"
        Width="680"
        Height="540"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <DockPanel Margin="14" LastChildFill="True">

        <!-- Header (subject + filename) -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Choose attachments to save"
                       FontWeight="SemiBold"
                       FontSize="15"/>
            <TextBlock x:Name="EmailSubjectText"
                       Margin="0,6,0,0"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="EmailFileNameText"
                       Margin="0,2,0,0"
                       Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons row (bottom) -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="SkipBtn"
                    Content="Skip Email"
                    Width="120"
                    Margin="0,0,8,0"
                    Style="{StaticResource Button.Secondary}"
                    Click="SkipBtn_Click"/>
            <Button x:Name="SaveBtn"
                    Content="Save Selected"
                    Width="140"
                    IsDefault="True"
                    Click="SaveBtn_Click"/>
        </StackPanel>

        <!-- Destination folder row (above buttons) -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Save to:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox Grid.Column="1"
                     x:Name="FolderBox"
                     VerticalAlignment="Center"
                     Padding="6,4"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="2"
                    Content="Browse..."
                    Width="100"
                    Margin="8,0,0,0"
                    Click="BrowseBtn_Click"/>
        </Grid>

        <!-- Select all/none row -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,6">
            <Button x:Name="SelectAllBtn"
                    Content="Select All"
                    Width="110"
                    Margin="0,0,6,0"
                    Style="{StaticResource Button.Secondary}"
                    Click="SelectAllBtn_Click"/>
            <Button x:Name="SelectNoneBtn"
                    Content="Select None"
                    Width="110"
                    Style="{StaticResource Button.Secondary}"
                    Click="SelectNoneBtn_Click"/>
            <TextBlock x:Name="HintText"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Text.Secondary}"/>
        </StackPanel>

        <!-- Attachment list (fills remaining space) -->
        <ListBox x:Name="AttachmentsList"
                 BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FileName}"
                                   Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding FileName}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding SizeDisplay}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
