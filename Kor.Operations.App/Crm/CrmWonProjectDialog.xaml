<Window x:Class="Kor.Operations.App.Crm.CrmWonProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Deltek project"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText"
                   TextWrapping="Wrap" FontWeight="SemiBold"
                   Foreground="{StaticResource Brand.Primary.Brush}"
                   Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" x:Name="ProjectList" Margin="0,0,0,10"
                 DisplayMemberPath="Display"/>

        <TextBlock Grid.Row="2" Text="…or type the WBS1 directly (any win can be linked, even when the buyer isn't a Deltek client yet)"
                   FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <TextBox Grid.Row="3" x:Name="ManualWbs1Box" Padding="10,0" Margin="0,0,0,12"
                 ToolTip="Typed WBS1 wins over the list selection."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Link project" Width="120" IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    Click="Link_Click"/>
        </StackPanel>
    </Grid>
</Window>
