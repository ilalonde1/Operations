<Window x:Class="Kor.Operations.App.Crm.ApcSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to APC" Width="1100" Height="860" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource App.Background}">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Sign in to Alberta Purchasing Connection" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Sign in with the company APC account below, the way you would in a browser. Once you are in, the app saves the session and this window says so; you can then close it. From then on the app downloads the documents of every APC tender someone has made a pursuit, into that pursuit."/>
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,8" CornerRadius="6" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Width="90" Click="Close_Click" Margin="12,0,0,0"/>
                <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" Text="Opening APC…"/>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser"/>
    </DockPanel>
</Window>
