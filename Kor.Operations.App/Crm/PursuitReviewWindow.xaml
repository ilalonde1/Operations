<Window x:Class="Kor.Operations.App.Crm.PursuitReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude's RFP review" Width="980" Height="860" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource App.Background}">
    <!-- The decision first: verdict and the reason that decides it, then the dates, then the questions; the background last. -->
    <DockPanel x:Name="Root" Margin="24,20,24,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Text.Primary}"/>
            <TextBlock x:Name="Byline" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Padding="18,14" CornerRadius="8" Margin="0,0,0,16"
                Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="VerdictPill" DockPanel.Dock="Left" CornerRadius="14" Padding="14,5" Margin="0,0,14,0" VerticalAlignment="Top">
                        <TextBlock x:Name="Verdict" FontSize="13" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="Deciding" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Primary}"/>
                </DockPanel>
                <TextBlock x:Name="Dates" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource Text.Primary}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="DraftButton" DockPanel.Dock="Left" Style="{StaticResource D.Primary}" Padding="16,6" Click="DraftEmail_Click"
                        ToolTip="Opens the questions as an unsent email to the buyer in your Outlook. Nothing is sent."/>
                <Button x:Name="ChecklistButton" DockPanel.Dock="Left" Style="{StaticResource D.Button}" Padding="14,6" Margin="8,0,0,0" Click="Checklist_Click"/>
                <Button DockPanel.Dock="Left" Content="Copy" Style="{StaticResource D.Button}" Padding="14,6" Margin="8,0,0,0" Click="Copy_Click"
                        ToolTip="Copy the whole review as text."/>
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource D.Button}" Padding="18,6" Click="Close_Click"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="ActionsHeading" Text="What to do" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{StaticResource Brand.Primary.Brush}"/>
                <ItemsControl x:Name="Actions" Margin="0,0,0,18">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="8" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1"
                                    Background="{StaticResource App.Background}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Margin="0,0,12,0" VerticalAlignment="Top"
                                            BorderBrush="{StaticResource Brand.Primary.Brush}" BorderThickness="2">
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Brand.Primary.Brush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" MinWidth="150">
                                        <TextBlock Text="{Binding Who}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Text="{Binding When}" FontSize="12" HorizontalAlignment="Right" Foreground="{Binding WhenBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Action}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Text="{Binding Why}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource Text.Secondary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="WhyHeading" Text="Why" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource Brand.Primary.Brush}"/>
                <ItemsControl x:Name="Reasons" Margin="0,0,0,18">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="•" FontSize="14" Margin="2,0,10,0" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Text.Primary}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="QuestionsHeading" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{StaticResource Brand.Primary.Brush}"/>
                <ItemsControl x:Name="Questions" Margin="0,0,0,18">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="8" Background="{StaticResource Panel.Background}"
                                    BorderBrush="{StaticResource Panel.Border}" BorderThickness="1">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Margin="0,0,12,0" VerticalAlignment="Top"
                                            Background="{StaticResource Brand.Primary.Brush}">
                                        <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Text="{Binding Why}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" Foreground="{StaticResource Text.Secondary}"/>
                                        <TextBlock Text="{Binding Ref}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource Text.Secondary}" FontStyle="Italic"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="What it is" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource Brand.Primary.Brush}"/>
                <TextBlock x:Name="Summary" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,16" Foreground="{StaticResource Text.Primary}"/>
                <TextBlock x:Name="Footnote" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
