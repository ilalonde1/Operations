<Window x:Class="Kor.Operations.App.Crm.CrmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="CRM (Business Development)"
        Width="1400"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="CRM (BD)"
                            SubtitleText="Engagements, contacts, and pursuit activity"
                            AvatarDiameter="64"
                            AvatarBorderThickness="2"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8">
            <Button Content="Refresh" Width="100" Margin="0,0,8,0" Click="RefreshButton_Click"/>
            <Button Content="Edit engagement…" Width="160" Margin="0,0,16,0" Click="EditEngagementButton_Click"/>
            <Separator Margin="0,4,16,4"/>
            <TextBlock Text="Set stage:" Margin="0,8,8,0"/>
            <Button Content="Pursuing"   Width="80" Margin="0,0,4,0" Click="StageButton_Click" Tag="Pursuing"/>
            <Button Content="Draft"      Width="62" Margin="0,0,4,0" Click="StageButton_Click" Tag="ProposalDraft"/>
            <Button Content="Submitted"  Width="80" Margin="0,0,4,0" Click="StageButton_Click" Tag="ProposalSubmitted"/>
            <Button Content="Presenting" Width="80" Margin="0,0,4,0" Click="StageButton_Click" Tag="Presenting"/>
            <Button Content="Negotiate"  Width="80" Margin="0,0,4,0" Click="StageButton_Click" Tag="Negotiating"/>
            <Button Content="Won"        Width="60" Margin="0,0,4,0" Click="StageButton_Click" Tag="Won"
                    Background="#228B22" Foreground="White"/>
            <Button Content="Lost"       Width="60" Margin="0,0,4,0" Click="StageButton_Click" Tag="Lost"/>
            <Button Content="Hold"       Width="56" Margin="0,0,4,0" Click="StageButton_Click" Tag="OnHold"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Engagements list -->
            <Border Grid.Column="0" Background="White" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Engagements" Margin="8,6" FontWeight="SemiBold"/>
                    <DataGrid Grid.Row="1"
                              x:Name="EngagementsGrid"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding Engagements}"
                              SelectedItem="{Binding Selected}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Stage" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StageBrush}" CornerRadius="999"
                                                Margin="2" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StageDisplay}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Key"     Binding="{Binding OpportunityKey}"     Width="140"/>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}"        Width="*"/>
                            <DataGridTextColumn Header="Buyer"   Binding="{Binding Buyer}"              Width="180"/>
                            <DataGridTextColumn Header="Owner"   Binding="{Binding OwnerDisplay}"       Width="80"/>
                            <DataGridTextColumn Header="Fee"     Binding="{Binding ProposedFeeDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedDisplay}"     Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#D0D0D2" ResizeBehavior="PreviousAndNext"/>

            <!-- Detail: contacts (top), activity log (bottom) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <!-- Contacts -->
                <Border Grid.Row="0" Background="White" Margin="0,0,0,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Contacts" Margin="8,6" FontWeight="SemiBold"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,8">
                            <TextBox x:Name="ContactNameBox" Width="170" Margin="0,0,4,0"
                                     ToolTip="Display name (required)"/>
                            <TextBox x:Name="ContactRoleBox" Width="130" Margin="0,0,4,0"
                                     ToolTip="Role / title"/>
                            <TextBox x:Name="ContactEmailBox" Width="200" Margin="0,0,4,0"
                                     ToolTip="Email"/>
                            <TextBox x:Name="ContactPhoneBox" Width="100" Margin="0,0,4,0"
                                     ToolTip="Phone"/>
                            <CheckBox x:Name="ContactPrimaryCheck" Content="primary" Margin="0,4,8,0"/>
                            <Button Content="Add" Width="60" Click="AddContactButton_Click"/>
                            <Button Content="Remove" Width="70" Margin="4,0,0,0" Click="RemoveContactButton_Click"/>
                        </StackPanel>

                        <DataGrid Grid.Row="2"
                                  x:Name="ContactsGrid"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding Contacts}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header=""        Binding="{Binding PrimaryDisplay}" Width="30"/>
                                <DataGridTextColumn Header="Name"    Binding="{Binding DisplayName}"    Width="*"/>
                                <DataGridTextColumn Header="Role"    Binding="{Binding Role}"           Width="140"/>
                                <DataGridTextColumn Header="Email"   Binding="{Binding Email}"          Width="200"/>
                                <DataGridTextColumn Header="Phone"   Binding="{Binding Phone}"          Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Activity log -->
                <Border Grid.Row="1" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Activity log" Margin="8,6" FontWeight="SemiBold"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,8">
                            <ComboBox x:Name="ActivityTypeBox" Width="110" Margin="0,0,4,0"
                                      ItemsSource="{Binding ActivityTypeOptions}" SelectedIndex="0"/>
                            <TextBox x:Name="ActivitySubjectBox" Width="240" Margin="0,0,4,0"
                                     ToolTip="Subject (required)"/>
                            <TextBox x:Name="ActivityBodyBox" Width="320" Margin="0,0,4,0"
                                     ToolTip="Notes (optional)"/>
                            <Button Content="Log" Width="60" Click="LogActivityButton_Click"/>
                        </StackPanel>

                        <DataGrid Grid.Row="2"
                                  x:Name="ActivitiesGrid"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding Activities}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When"     Binding="{Binding OccurredDisplay}" Width="130"/>
                                <DataGridTextColumn Header="Type"     Binding="{Binding TypeDisplay}"     Width="90"/>
                                <DataGridTextColumn Header="Subject"  Binding="{Binding Subject}"         Width="*"/>
                                <DataGridTextColumn Header="By"       Binding="{Binding CreatedBy}"       Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Padding="12,6" Background="#F0F0F2">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
