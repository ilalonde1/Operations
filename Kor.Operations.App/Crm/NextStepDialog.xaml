<Window x:Class="Kor.Operations.App.Crm.NextStepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Next step" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource App.Background}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PursuitText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Next step"/>
        <TextBox x:Name="NoteBox" MaxLength="500" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                 controls:Placeholder.Text="Who to call or what to send" Margin="0,4,0,12"/>
        <TextBlock Text="By"/>
        <DatePicker x:Name="DuePicker" Margin="0,4,0,8"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Save" IsDefault="True" Click="Save_Click" Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</Window>
