<UserControl x:Class="Kor.Operations.App.Crm.BdTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kor.Operations.App.Crm"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="View_Loaded"
             Unloaded="View_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:RegionEqualsConverter x:Key="RegionEqualsConverter"/>

        <!-- Region tab — Brand.Primary slate fill when selected (DataTrigger
             compares the tab's text to the VM.SelectedRegion); outline +
             slate text otherwise. -->
        <Style x:Key="RegionTab" TargetType="Button" BasedOn="{StaticResource Button.ActionBar}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding"   Value="14,4"/>
            <Setter Property="Margin"    Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource RegionEqualsConverter}">
                            <Binding/>
                            <Binding Path="DataContext.SelectedRegion" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource Brand.Primary.Brush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brand.Primary.Brush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact label for stat cards. -->
        <Style x:Key="StatCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        </Style>

        <!-- Hand cursor + slate hover on engagement rows. -->
        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDEEF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Title + Refresh button -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="BD Tracking" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="2026 spreadsheet, ingested" FontSize="11" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="↻ Refresh" Width="100" Click="RefreshButton_Click"
                    Style="{StaticResource Button.ActionBar}"
                    ToolTip="Reload BD-tracking engagements from the database."/>
        </Grid>

        <!-- Row 1: Region tabs (matches spreadsheet tabs) -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding RegionOptions}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}"
                            Style="{StaticResource RegionTab}"
                            Click="RegionTab_Click"
                            Tag="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Row 2: filter strip + rollup card -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Region:" Margin="0,4,6,0" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                <TextBlock Text="{Binding SelectedRegion}" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}" Margin="0,4,16,0"/>
                <TextBlock Text="Initiator:" Margin="0,4,6,0" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                <ComboBox x:Name="InitiatorCombo" Width="120" SelectedValue="{Binding SelectedInitiator}" ItemsSource="{Binding InitiatorOptionsList}"/>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,8" Background="{StaticResource Panel.Background}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="{Binding Rollup.ActivityCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>
                        <TextBlock Text="ENGAGEMENTS" Style="{StaticResource StatCaption}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="{Binding Rollup.SubmittedDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>
                        <TextBlock Text="SUBMITTED" Style="{StaticResource StatCaption}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="{Binding Rollup.AcceptedDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Risk.HighConfidence.Foreground}"/>
                        <TextBlock Text="ACCEPTED" Style="{StaticResource StatCaption}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Rollup.CaptureRateDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brand.Accent.Brush}"/>
                        <TextBlock Text="CAPTURE RATE" Style="{StaticResource StatCaption}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 3: Split grid (engagements) | splitter | detail panel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <DataGrid x:Name="EngagementsGrid"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          ItemsSource="{Binding FilteredEngagements}"
                          SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Region"    Binding="{Binding Region}"              Width="140"/>
                        <DataGridTextColumn Header="Initiator" Binding="{Binding Initiator}"           Width="80"/>
                        <DataGridTextColumn Header="Contact"   Binding="{Binding PrimaryContact}"      Width="140"/>
                        <DataGridTemplateColumn Header="Company" Width="*" SortMemberPath="BuyerDisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BuyerDisplayName}"
                                               Foreground="{StaticResource CorporateBlue}"
                                               TextDecorations="Underline"
                                               Cursor="Hand"
                                               MouseLeftButtonUp="OpenOrgDossier_Click"
                                               ToolTip="Click to open the Org Dossier for this company"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Latest"    Binding="{Binding LatestActivityDisplay}" Width="90"/>
                        <DataGridTextColumn Header="Type"      Binding="{Binding LatestActivityTypeDisplay}" Width="70"/>
                        <DataGridTextColumn Header="Acts"      Binding="{Binding ActivityCount}"     Width="50"/>
                        <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedDisplay}"    Width="100"/>
                        <DataGridTextColumn Header="Accepted"  Binding="{Binding AcceptedDisplay}"     Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state overlay: shown when the current filter has no
                     matching engagements. Hidden when the grid has rows or while
                     the VM is loading. -->
                <Border Background="{StaticResource Panel.Background}"
                        Padding="40,30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredEngagements.Count}" Value="0">
                                    <DataTrigger.Setters>
                                        <Setter Property="Visibility">
                                            <Setter.Value>
                                                <Visibility>Visible</Visibility>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger.Setters>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="No engagements"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="No BD touchpoints match the current region + initiator filter."
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Panel.Border}" ResizeBehavior="PreviousAndNext"/>

            <!-- Detail panel: visible only when an engagement is selected. -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="16"
                    Margin="6,0,0,0"
                    Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header: company name + region + initiator chip. -->
                        <TextBlock Text="{Binding Selected.BuyerDisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999" Padding="8,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Selected.Region}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource Brand.Accent.Brush}" CornerRadius="999" Padding="8,2">
                                <TextBlock Text="{Binding Selected.Initiator}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- $$ summary -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Selected.SubmittedDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>
                                <TextBlock Text="SUBMITTED" Style="{StaticResource StatCaption}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Selected.AcceptedDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Risk.HighConfidence.Foreground}"/>
                                <TextBlock Text="ACCEPTED" Style="{StaticResource StatCaption}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Potential Projects -->
                        <TextBlock Text="POTENTIAL PROJECTS" Style="{StaticResource StatCaption}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Selected.PotentialProjects, TargetNullValue='(none captured)'}"
                                   Foreground="{StaticResource Text.Primary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <!-- Cross-linked MPI projects (Round 36a) -->
                        <TextBlock Text="LINKED MPI PROJECTS" Style="{StaticResource StatCaption}" Margin="0,0,0,4"
                                   Visibility="{Binding SelectedLinkedProjects.Count, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        <ItemsControl ItemsSource="{Binding SelectedLinkedProjects}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,0,0,1" Padding="0,4"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="OpenLinkedMpiProject_Click"
                                            ToolTip="Click for MPI project detail">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource CorporateBlue}" TextDecorations="Underline"/>
                                                <Border Background="{StaticResource CorporateBlue}" CornerRadius="999" Padding="6,1" Margin="8,1,0,0">
                                                    <TextBlock Text="{Binding ConfidenceDisplay}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MatchedText, StringFormat='matched: {0}'}"
                                                       Foreground="{StaticResource Text.Secondary}" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Activities -->
                        <TextBlock Text="ACTIVITIES" Style="{StaticResource StatCaption}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding SelectedActivities}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OccurredDisplay}" Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,0,8,0"/>
                                                <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999" Padding="6,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding TypeDisplay}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding ContactName}" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Body}"
                                                       Foreground="{StaticResource Text.Primary}"
                                                       TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Contacts -->
                        <TextBlock Text="CONTACTS" Style="{StaticResource StatCaption}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding SelectedContacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,0,0,1" Padding="0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Role, StringFormat='  {0}'}" Foreground="{StaticResource Text.Secondary}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Email}" Foreground="{StaticResource CorporateBlue}" FontSize="11"/>
                                            <TextBlock Text="{Binding Phone}" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Row 4: status bar -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
    </Grid>
</UserControl>
