<Window x:Class="Kor.Operations.App.Crm.CrmEngagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit engagement"
        Width="640"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Stage" Margin="0,0,0,8" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="StageBox" Margin="0,0,0,8"
                  ItemsSource="{Binding StageOptions}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Owner" Margin="0,0,0,8" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="OwnerCombo" Margin="0,0,0,8"
                  IsEditable="True" IsTextSearchEnabled="True"
                  DisplayMemberPath="Display" TextSearch.TextPath="Display"
                  ToolTip="Pick from the firm roster. Leaving this unchanged keeps the current owner — an owner can never be blanked from here."/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Proposed fee (CAD)" Margin="0,0,0,8" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="FeeBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Proposed hours" Margin="0,0,0,8" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="HoursBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Target margin (%)" Margin="0,0,0,8" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="MarginBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Notes" Margin="0,0,0,8"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="NotesBox" Margin="0,0,0,8"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Outcome notes" Margin="0,0,0,8"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="OutcomeBox" Margin="0,0,0,8" Height="60"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="100" Click="SaveButton_Click"
                    Background="{StaticResource Brand.Primary.Brush}" Foreground="White" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
