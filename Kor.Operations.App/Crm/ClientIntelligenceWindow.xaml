<Window x:Class="Kor.Operations.App.Crm.ClientIntelligenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="{Binding WindowTitle}"
        Width="980"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#506070"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                <TextBlock Text="Find client:" VerticalAlignment="Center" FontSize="11" Foreground="#666" Margin="0,0,6,0"/>
                <Grid>
                    <TextBox x:Name="ClientSearchBox" Width="280" VerticalAlignment="Center"
                             TextChanged="ClientSearchBox_TextChanged"
                             KeyDown="ClientSearchBox_KeyDown"
                             ToolTip="Type any part of a client name (e.g. 'vancouver', 'NSDA', 'bird')"/>
                    <Popup x:Name="ClientSearchPopup" PlacementTarget="{Binding ElementName=ClientSearchBox}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#888" BorderThickness="1" Padding="0">
                            <ListBox x:Name="ClientSearchResults" Width="380" MaxHeight="320"
                                     BorderThickness="0"
                                     MouseLeftButtonUp="ClientSearchResults_MouseLeftButtonUp"
                                     KeyDown="ClientSearchResults_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,3">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                                            <TextBlock Text="{Binding ClientId}" FontSize="10" Foreground="#888"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
            <controls:KorHeader x:Name="HeaderBar"
                                HeaderText="{Binding HeaderText}"
                                SubtitleText="Deltek client roll-up"
                                AvatarDiameter="32"
                                AvatarBorderThickness="2"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8">
            <Border Background="#1F7A1F" CornerRadius="999" Padding="6,2" Margin="0,0,8,0"
                    Visibility="{Binding BadgeRepeatVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <TextBlock Text="Repeat client" Style="{StaticResource BadgeText}"/>
            </Border>
            <Border Background="#22588B" CornerRadius="999" Padding="6,2" Margin="0,0,8,0"
                    Visibility="{Binding BadgePriorWorkVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <TextBlock Text="Prior work" Style="{StaticResource BadgeText}"/>
            </Border>
            <Border Background="#1F7A1F" CornerRadius="999" Padding="6,2" Margin="0,0,8,0"
                    Visibility="{Binding BadgeRecommendVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <TextBlock Text="Recommended" Style="{StaticResource BadgeText}"/>
            </Border>
            <Border Background="#5C5470" CornerRadius="999" Padding="6,2" Margin="0,0,8,0"
                    Visibility="{Binding BadgeGovernmentVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <TextBlock Text="Government" Style="{StaticResource BadgeText}"/>
            </Border>
            <Border Background="#C11E1E" CornerRadius="999" Padding="6,2" Margin="0,0,8,0"
                    Visibility="{Binding BadgeCompetitorVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <TextBlock Text="Competitor" Style="{StaticResource BadgeText}"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Margin="12,0,12,8" Padding="10,6"
                Background="#FFF1E6" BorderBrush="#E0A878" BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding DegradeWarningVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <TextBlock Text="Some sections were unavailable (likely Deltek read permissions). Showing the data we could load."
                       FontSize="12"
                       Foreground="#7A4C16"/>
        </Border>

        <TabControl Grid.Row="3" Margin="12,0,12,12">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding LifetimeFeeDisplay, StringFormat=Lifetime: {0}}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LatestProjectDisplay, StringFormat=Latest project: {0}}" FontSize="13" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ArSummaryDisplay, StringFormat=AR: {0}}" FontSize="13" Margin="0,0,0,14"/>

                        <TextBlock Text="Memo:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MemoText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="Company facts:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid DataContext="{Binding Intelligence.Company}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Style="{StaticResource CardLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Type, TargetNullValue=''}" Style="{StaticResource CardValue}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Status" Style="{StaticResource CardLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Status, TargetNullValue=''}" Style="{StaticResource CardValue}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Specialty" Style="{StaticResource CardLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Specialty, TargetNullValue=''}" Style="{StaticResource CardValue}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Market" Style="{StaticResource CardLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Market, TargetNullValue=''}" Style="{StaticResource CardValue}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Website" Style="{StaticResource CardLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Website, TargetNullValue=''}" Style="{StaticResource CardValue}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Parent ID" Style="{StaticResource CardLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ParentId, TargetNullValue=''}" Style="{StaticResource CardValue}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Employees" Style="{StaticResource CardLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Employees, TargetNullValue=''}" Style="{StaticResource CardValue}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Annual revenue" Style="{StaticResource CardLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AnnualRevenue, StringFormat={}{0:C0}, TargetNullValue=''}" Style="{StaticResource CardValue}"/>
                        </Grid>
                        <!-- Recent news mentions -->
                        <Border Background="#F5F0FF" BorderBrush="#9F84D6" BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,12"
                                Visibility="{Binding HasNewsMentions, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="Recent news mentions" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#4B2D8F" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding BdIntelligence.RecentNewsMentions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="10,8" Background="White"
                                                    BorderBrush="#D8CFEE" BorderThickness="1" CornerRadius="4">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Border Background="#7A5BD0" CornerRadius="999" Padding="6,1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding MentionType, FallbackValue=other}"
                                                                       Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding FeedName, FallbackValue=''}"
                                                                   FontSize="10" Foreground="#666" VerticalAlignment="Center"/>
                                                        <TextBlock Text="  " FontSize="10" Foreground="#999" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PublishedAtUtc, StringFormat={}{0:yyyy-MM-dd}, FallbackValue=''}"
                                                                   FontSize="10" Foreground="#666" VerticalAlignment="Center"/>
                                                        <TextBlock Text="  conf " FontSize="10" Foreground="#999"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding Confidence}" FontSize="10"
                                                                   Foreground="#666" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2">
                                                        <Hyperlink NavigateUri="{Binding ArticleUrl}"
                                                                   RequestNavigate="NewsMentionHyperlink_RequestNavigate">
                                                            <Run Text="{Binding ArticleTitle, Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Excerpt, FallbackValue=''}"
                                                               FontSize="11.5" Foreground="#444" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="Projects ("/>
                        <Run Text="{Binding Projects.Count, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </TabItem.Header>
                <DataGrid ItemsSource="{Binding Projects}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="WBS1" Binding="{Binding Wbs1}" Width="100"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Open date" Binding="{Binding OpenDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60"/>
                        <DataGridTextColumn Header="Fee" Binding="{Binding Fee, StringFormat={}{0:C0}}" Width="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Fee billed" Binding="{Binding FeeBilled, StringFormat={}{0:C0}}" Width="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="People">
                <DataGrid ItemsSource="{Binding Contacts}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SourceFlag}" Value="ViaProject">
                                    <Setter Property="Background" Value="#F8F8F8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="*" Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceFlag}" Width="80"/>
                        <DataGridTextColumn Header="FirstName" Binding="{Binding FirstName}" Width="110"/>
                        <DataGridTextColumn Header="LastName" Binding="{Binding LastName}" Width="110"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="160"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                        <DataGridTextColumn Header="CellPhone" Binding="{Binding CellPhone}" Width="130"/>
                        <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="60"/>
                        <DataGridTextColumn Header="Via" Binding="{Binding ProjectAppearanceCount, TargetNullValue=''}" Width="40">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Last" Binding="{Binding MostRecentProjectYear, TargetNullValue=''}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="AR">
                <StackPanel Orientation="Horizontal" Margin="12">
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="Total Outstanding" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding ArTotalOutstandingDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="Outstanding 90+" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding ArOutstanding90PlusDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding Ar90PlusBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="Open Invoices" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding ArOpenInvoiceCountDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Activity">
                <DataGrid ItemsSource="{Binding RecentActivity}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="StartDate" Binding="{Binding StartDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn Header="Employee" Binding="{Binding Employee}" Width="110"/>
                        <DataGridTextColumn Header="Wbs1" Binding="{Binding Wbs1}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Past KOR Projects">
                <Grid Margin="12">
                    <TextBlock Text="No past KOR projects on file for this client."
                               VerticalAlignment="Top"
                               FontSize="13"
                               Foreground="#506070"
                               Visibility="{Binding NoWonProjects, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                    <DataGrid ItemsSource="{Binding WonProjects}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              Visibility="{Binding HasWonProjects, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="WBS1" Binding="{Binding Wbs1}" Width="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Project Manager" Binding="{Binding ProjectManager}" Width="150"/>
                            <DataGridTextColumn Header="StartDate" Binding="{Binding StartDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="EndDate" Binding="{Binding EndDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Past KOR Pursuits">
                <Grid Margin="12">
                    <TextBlock Text="No KOR pursuits on file for this client."
                               VerticalAlignment="Top"
                               FontSize="13"
                               Foreground="#506070"
                               Visibility="{Binding NoPastPursuits, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                    <DataGrid ItemsSource="{Binding PastPursuits}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              Visibility="{Binding HasPastPursuits, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="90"/>
                            <DataGridTextColumn Header="Buyer" Binding="{Binding BuyerName}" Width="180"/>
                            <DataGridTextColumn Header="Opened" Binding="{Binding PursuitOpenedDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="Award" Binding="{Binding AwardDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="Lost to" Binding="{Binding LostToName}" Width="160"/>
                            <DataGridTemplateColumn Header="Source" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EEF4FB" BorderBrush="#7AAEDE" BorderThickness="1"
                                                CornerRadius="999" Padding="6,1" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ExternalSource}" FontSize="10" Foreground="#22588B"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="BD Intelligence" Visibility="{Binding HasBdData, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <!-- KOR pursuit history -->
                        <Border Background="#FFF8E5" BorderBrush="#E5C870" BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,12"
                                Visibility="{Binding HasPursuits, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="KOR pursuit history with this client" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Total pursuits" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.Pursuits.TotalCount}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Won" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.Pursuits.WonCount}" FontSize="22" FontWeight="SemiBold" Foreground="#16A34A"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Submitted" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.Pursuits.SubmittedCount}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="In pursuit" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.Pursuits.PursuingCount}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Lost" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.Pursuits.LostCount}" FontSize="22" FontWeight="SemiBold" Foreground="#C11E1E"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Total bid fee" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.Pursuits.TotalBidFee, StringFormat=C0, TargetNullValue=''}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding BdIntelligence.RecentPursuits}"
                                          AutoGenerateColumns="False" HeadersVisibility="Column"
                                          CanUserAddRows="False" IsReadOnly="True" Margin="0,8,0,0" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="100"/>
                                        <DataGridTextColumn Header="Fee" Binding="{Binding BidFee, StringFormat=C0, TargetNullValue=''}" Width="100"/>
                                        <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=''}" Width="100"/>
                                        <DataGridTextColumn Header="Award" Binding="{Binding AwardDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=''}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- External RFP activity (this client as a buyer) -->
                        <Border Background="#EEF4FB" BorderBrush="#7AAEDE" BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,12"
                                Visibility="{Binding HasExternalActivity, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="External RFP activity (this client as a buyer)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Awards issued" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.ExternalActivity.AwardCount}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Open RFPs now" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.ExternalActivity.ActiveOpportunityCount}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Total awarded" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.ExternalActivity.TotalAwardedValue, StringFormat=C0, TargetNullValue=''}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Distinct vendors" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.ExternalActivity.DistinctVendorsAwarded}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding BdIntelligence.RecentExternalAwards}"
                                          AutoGenerateColumns="False" HeadersVisibility="Column"
                                          CanUserAddRows="False" IsReadOnly="True" Margin="0,8,0,0" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                        <DataGridTextColumn Header="Awarded to" Binding="{Binding AwardedTo}" Width="200"/>
                                        <DataGridTextColumn Header="$" Binding="{Binding Value, StringFormat=C0, TargetNullValue=''}" Width="100"/>
                                        <DataGridTextColumn Header="Awarded" Binding="{Binding AwardedAtUtc, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=''}" Width="100"/>
                                        <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Competitor activity (this client also wins contracts as a vendor) -->
                        <Border Background="#FEF2F2" BorderBrush="#CC3333" BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,12"
                                Visibility="{Binding HasCompetitorActivity, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="As a competitor (wins they've taken)" FontSize="13" FontWeight="SemiBold" Foreground="#990000" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Contracts won" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.CompetitorActivity.AwardsAsVendorCount}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Total value" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.CompetitorActivity.TotalContractsWonValue, StringFormat=C0, TargetNullValue=''}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Distinct buyers" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.CompetitorActivity.DistinctBuyersWonFrom}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Latest win" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding BdIntelligence.CompetitorActivity.LatestVendorWinAtUtc, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=''}" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Padding="12,6" Background="#F0F0F2">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
