<UserControl x:Class="Kor.Operations.App.Controls.OrgSearchTypeahead"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kor.Operations.App.Controls">
    <UserControl.Resources>
        <local:OrgKindLabelConverter x:Key="KindLabel"/>
    </UserControl.Resources>
    <Grid>
        <!-- R88 fix: placeholder TextBlock removed because it overlaid the typed
             text in BdWorkspace's resource theme even with code-behind Collapsed.
             The control is unambiguous from context (sits under "Search org /
             project / person" label in the parent host). -->
        <TextBox x:Name="SearchBox"
                 Height="32"
                 Padding="10,0"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 Background="#FFFFFFFF"
                 Foreground="#FF111111"
                 CaretBrush="#FF111111"
                 BorderBrush="{StaticResource Panel.Border}"
                 BorderThickness="1"
                 TextChanged="SearchBox_TextChanged"
                 KeyDown="SearchBox_KeyDown"/>

        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=SearchBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               MinWidth="{Binding ActualWidth, ElementName=SearchBox}"
               Width="380"
               MaxHeight="360">
            <Border Background="White"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1"
                    Padding="0">
                <DockPanel>
                <TextBlock x:Name="MessageText" DockPanel.Dock="Top" Margin="10,8" TextWrapping="Wrap"
                           Foreground="{StaticResource Text.Secondary}" Visibility="Collapsed"/>
                <ListBox x:Name="ResultsList"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         KeyDown="ResultsList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Kind, Converter={StaticResource KindLabel}}" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
