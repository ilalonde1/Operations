<UserControl x:Class="Kor.Operations.App.Controls.OrgSearchTypeahead"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- R88 fix: placeholder TextBlock removed because it overlaid the typed
             text in BdWorkspace's resource theme even with code-behind Collapsed.
             The control is unambiguous from context (sits under "Search org /
             project / person" label in the parent host). -->
        <TextBox x:Name="SearchBox"
                 Height="32"
                 Padding="10,0"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 Background="#FFFFFFFF"
                 Foreground="#FF111111"
                 CaretBrush="#FF111111"
                 BorderBrush="{StaticResource Panel.Border}"
                 BorderThickness="1"
                 TextChanged="SearchBox_TextChanged"
                 KeyDown="SearchBox_KeyDown"/>

        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=SearchBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               Width="{Binding ActualWidth, ElementName=SearchBox}"
               MaxHeight="320">
            <Border Background="White"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1"
                    Padding="0">
                <ListBox x:Name="ResultsList"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         KeyDown="ResultsList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
