<UserControl x:Class="Kor.Operations.Controls.AiQueryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Panel-local brushes — derived from KorTheme.xaml so any future
             theme tweak flows through automatically. Kept inline as DynamicResource
             references throughout the panel, not duplicated as new brush keys. -->
    </UserControl.Resources>
    <Border Background="{DynamicResource Surface.Subtle}"
            BorderBrush="{DynamicResource Panel.Border}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
        <StackPanel>
            <TextBlock FontSize="12" Margin="0,0,0,8">
                <Run Text="What The Heck Does All This Mean!?!" FontWeight="Bold" FontSize="13"
                     Foreground="{DynamicResource Brand.Primary.Brush}"/>
                <LineBreak/>
                <Run Text="Ask real questions. With conversational follow-ups. Can analyze data from any app window you have open. More windows, more context, more accuracy."
                     Foreground="{DynamicResource Text.Secondary}" FontSize="10.5" FontStyle="Italic"/>
            </TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="QuestionBox" FontSize="12" Padding="6,4"
                             VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource Panel.Border}"
                             Background="Transparent"
                             KeyDown="QuestionBox_KeyDown"/>
                    <TextBlock IsHitTestVisible="False"
                               Text="Ask about employees, projects, PMs, budgets, clients — the AI sees all loaded data"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Padding="8,5"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QuestionBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button x:Name="AskBtn" Grid.Column="1" Content="Ask" Margin="6,0,0,0" Padding="10,4"
                        Style="{StaticResource Button.Primary}" FontSize="11" Click="AskBtn_Click"/>
            </Grid>

            <!-- Indeterminate progress bar visible only while a request is in flight.
                 Gives the user a real "I'm working" signal during 8-17s /ask calls
                 instead of a frozen UI with stale "Thinking..." text. -->
            <ProgressBar x:Name="BusyBar"
                         Height="2"
                         Margin="0,6,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Foreground="{DynamicResource Brand.Accent.Brush}"
                         Background="Transparent"
                         BorderThickness="0"/>

            <Grid x:Name="ResponseContainer" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <Button x:Name="CopyBtn" Content="Copy" Click="CopyBtn_Click"
                            Padding="8,2" FontSize="10" Margin="0,0,4,0"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Copy the AI response to clipboard"/>
                    <Button x:Name="CloseBtn" Content="✕" Click="CloseBtn_Click"
                            Padding="8,2" FontSize="10" MinWidth="24"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Close and clear the response"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <!-- MarkdownPresenter fills this panel with TextBlocks + bullet
                         grids + code-block borders. Plain "Thinking..." is shown
                         here as a single child while the request is in flight. -->
                    <StackPanel x:Name="ResponseStack" Margin="0,0,8,0"/>
                </ScrollViewer>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
