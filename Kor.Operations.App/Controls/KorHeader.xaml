<UserControl x:Class="Kor.Operations.Controls.KorHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root"
             MinHeight="72"
             Padding="0"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             ClipToBounds="False">

    <!-- Rounded band that does NOT clip children -->
    <Grid ClipToBounds="False">
        <Rectangle RadiusX="16" RadiusY="16"
                   Fill="{StaticResource Brand.Primary.Brush}"/>

        <!-- Tight content padding -->
        <Grid Margin="16,6,16,6" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: logo + titles -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/logo.png" Width="65" Height="67" Margin="0,0,16,0"/>
                 <StackPanel>
                     <TextBlock Text="{Binding HeaderText, ElementName=root}"
                                Foreground="{StaticResource Text.Inverse}"
                                FontSize="18" FontWeight="SemiBold"/>
                     <TextBlock Text="{Binding SubtitleText, ElementName=root}"
                                Foreground="#CCFFFFFF" FontSize="12"/>

                     <!-- Deltek connectivity banner (only visible when Deltek appears offline) -->
                     <Border Background="#B00020"
                             CornerRadius="6"
                             Padding="8,3"
                             Margin="0,6,0,0">
                         <Border.Style>
                             <Style TargetType="Border">
                                 <Setter Property="Visibility" Value="Collapsed"/>
                                 <Style.Triggers>
                                     <DataTrigger Binding="{Binding ShowDeltekBanner, ElementName=root}" Value="True">
                                         <Setter Property="Visibility" Value="Visible"/>
                                     </DataTrigger>
                                 </Style.Triggers>
                             </Style>
                         </Border.Style>
                         <TextBlock Text="{Binding DeltekBannerText, ElementName=root}"
                                    Foreground="White"
                                    FontSize="11"
                                    TextWrapping="Wrap"/>
                     </Border>
                 </StackPanel>
             </StackPanel>

            <!-- RIGHT: avatar + user -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="False">
                <!-- Avatar host -->
                <Grid Width="{Binding AvatarDiameter, ElementName=root}"
                      Height="{Binding AvatarDiameter, ElementName=root}"
                      Margin="0,0,16,0"
                      VerticalAlignment="Center"
                      ClipToBounds="False"
                      RenderOptions.BitmapScalingMode="HighQuality">

                    <!-- Initials layer (default collapsed; visible when AvatarImageSource is null) -->
                    <Grid x:Name="InitialsLayer">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvatarImageSource, ElementName=root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Stroke="#f15c3b"
                                 StrokeThickness="{Binding AvatarBorderThickness, ElementName=root}"
                                 Fill="#415465"
                                 Margin="2"/>
                        <TextBlock Text="{Binding Initials, ElementName=root}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#ffffff"/>
                    </Grid>

                    <!-- Photo layer (default visible; collapsed when AvatarImageSource is null) -->
                    <Ellipse x:Name="PhotoLayer"
                             Stroke="#f15c3b"
                             StrokeThickness="{Binding AvatarBorderThickness, ElementName=root}"
                             Margin="2">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvatarImageSource, ElementName=root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarImageSource, ElementName=root}"
                                        Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <StackPanel>
                    <TextBlock Text="{Binding UserDisplayName, ElementName=root}"
                               Foreground="White" FontSize="13"/>
                    <TextBlock Text="{Binding UserEmail, ElementName=root}"
                               Foreground="#CCFFFFFF" FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <!-- Optional right slot -->
            <ContentPresenter Grid.Column="1"
                              Content="{Binding RightContent, ElementName=root}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              Margin="0,0,12,0"/>
        </Grid>
    </Grid>
</UserControl>
