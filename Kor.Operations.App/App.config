<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!-- Existing Vantagepoint ODBC settings -->
		<add key="Vp.Dsn" value="Deltek"/>
		<add key="Vp.User" value=""/>
		<add key="Vp.Password" value=""/>
		<!-- Deltek catalog name (the database prefix used in all SQL queries) -->
		<add key="Vp.Catalog" value="C0000052267P_1_KOR00000000"/>
		<!-- PRLabor LaborID values for engineering and drafting budget lookups -->
		<add key="Vp.PrLaborIdEng" value="ENG"/>
		<add key="Vp.PrLaborIdDraft" value="DRAFT"/>
		<!-- Budget estimation rates — controls eng/draft hour split.
		     Calibrated Apr 2026 from Historical Project Analytics:
		     EngRate=474 + DraftRate=655 produces 58%/42% eng/draft split.
		     Target billing rate ($185/hr) is in FinancialsService.CalcBudget. -->
		<add key="Vp.EngRate" value="474"/>
		<add key="Vp.DraftRate" value="655"/>
		<add key="Vp.TargetBillingRate" value="185"/>
		<add key="Vp.PartnerImputedCostRate" value="250"/>
		<add key="Compensation.PoolRate" value="0.10"/>

		<!-- GroupType-based P&L classification. Defaults baked in code: Income="4,8", Expense="5,6,7".
		     Override only if KOR's GLParentGroup.GroupType mapping changes.
		     1=Asset 2=Liability 3=Equity 4=OperatingRevenue 5=ReimbExpense 6=DirectExpense 7=IndirectExpense 8=OtherIncome
		-->
		<!-- <add key="Financials.PnL.IncomeGroupTypes" value="4,8" /> -->
		<!-- <add key="Financials.PnL.ExpenseGroupTypes" value="5,6,7" /> -->

		<!-- GLTable dropdown filter. Default: "%Income Statement%". Hides Balance Sheet / Equity tables. -->
		<!-- <add key="Financials.PnL.GlTableNameLike" value="%Income Statement%" /> -->

		<!-- Fiscal year start month (1-12). Default = 1 (January) — KOR runs on
		     calendar year. Override only if Daler confirms otherwise; affects
		     the P&L "YTD" column total and the default opening date range. -->
		<!-- <add key="Financials.PnL.FiscalYearStartMonth" value="1" /> -->
		<add key="Financials.PnL.OverheadRate" value="1.65" />

		<!-- Billed P&L revenue accounts — Daler's source-of-truth list (2026-05-05 transcript):
		     "these are the four numbers for the revenue, 4001, 4003, 4210, 4220, 4240. So these
		     are the four numbers, four sources of revenue, nothing else." (Says four, lists five.)
		     4240 (Add-On Revenue) is INCLUDED — its negative entries are legitimate contra-revenue
		     (credit memos / billing adjustments), not a sign-quirk. 4250 (Mgmt & Admin) and 4260
		     (Intercompany Revenue) are NOT external client revenue and were the dominant cause
		     of the ~$94k/Jan, ~$110k/Mar overstatement vs Daler's Crystal Income Statement. 4500
		     does not exist in KOR's catalog. -->
		<add key="Financials.Billed.RevenueAccounts" value="4001.00,4003.00,4210.00,4220.00,4240.00"/>
		<add key="Financials.Billed.ExpenseAccountRanges" value="5000.00-5999.99,6000.00-6999.99,7000.00-7999.99"/>
		<add key="Financials.Billed.OtherIncomeAccountRanges" value="8000.00-8999.99"/>
		<!-- Batch 73 KOR account reclassifications. 7290 is Deltek's suspense / pre-posting accrual
		     bucket — $111K in sub-ledger / $0 in GLSummary, not in the accountant's chart of accounts.
		     7970 is Realized/Unrealized G&L — non-operating, accountant reports under Other Income.
		     8200 (Goodwill) + 8300 (Bank Charges) sit in the 8xxx "other" range but the accountant
		     treats them as Operating Expense. Together these account for the previous ~$100K/month
		     expense overstatement vs the accountant's Income Statement. -->
		<add key="Financials.Billed.ExpenseAccountExcludes" value="7290,7970"/>
		<add key="Financials.Billed.ExpenseAccountIncludes" value="8200,8300"/>
		<add key="Financials.Billed.OtherIncomeAccountExcludes" value="8200,8300"/>
		<add key="Financials.Billed.OtherIncomeAccountIncludes" value="7970"/>
		<add key="Financials.Billed.UsdToCadRate" value="1.36"/>
		<!-- Default Org filter for the Billed P&L tab. CAD makes the view match Daler's
		     "Income Statement - Kor Structural" Crystal report (which is filtered to the
		     Canadian entity). With "" (all orgs) the app sums USA-org rows after USD->CAD
		     conversion, which inflates totals vs Daler by the FX'd USA contribution
		     (e.g. Mar 2026: app +$77,620 over Daler = $57,073 USD x 1.36). Switch to
		     "" or "USA" via the in-app Org dropdown when intentionally needed. -->
		<add key="Financials.Billed.DefaultOrg" value="CAD"/>
		<!-- Operating cash accounts (Daler 2026-05-14): CAD entity = 1110+1120, USA entity = 1170 only.
		     Excludes petty cash (1000) and USD savings (1175) — both real cash but not operationally
		     meaningful for the liquidity tile. Match either "1110" or "1110.00". -->
		<add key="Financials.Cash.AccountWhitelist" value="1110.00,1120.00,1170.00"/>
		<add key="Financials.Cash.UsdToCadRate" value="1.36"/>
		<!-- Force-classify a cash account into the USA (USD) bucket regardless of its
		     home Org. Empty by default: Deltek already stores GLSummary.Amount in
		     each account's home-org functional currency (verified 2026-05-14 against
		     accountant balance sheet — 1120.00 is a USD-denominated CHQ inside the
		     CAD entity but its GLSummary entries are recorded in CAD, so any
		     reclassification to USA bucket would double-apply USD→CAD FX). Only
		     populate this if KOR ever holds USD funds in an account whose GLSummary
		     entries are NOT auto-converted by Deltek. Match either "1120" or "1120.00". -->
		<add key="Financials.Cash.UsdAccounts" value=""/>

		<!-- Redirector (existing) -->
		<add key="RedirectorBaseUrl" value="https://tracking.korstructural.com"/>

		<!-- =============== Deltek Headshot (new) =============== -->
		<!-- Build the actual ODBC connection string from your DSN + credentials -->
		<add key="DeltekOdbcDsn" value="DSN=Deltek;"/>

		<!-- We're pulling photos as BLOBs from the DB (not file paths) -->
		<add key="DeltekPhotoMode" value="Blob"/>

		<!-- Fast gate: if HasPhoto exists we use it; else infer from EmployeePhoto -->
		<add key="DeltekSql_HasPhotoByEmail"
			 value="SELECT CAST(COALESCE(m.HasPhoto, CASE WHEN m.EmployeePhoto IS NOT NULL THEN 1 ELSE 0 END) AS int) FROM dbo.EMMain m WITH (NOLOCK) WHERE LOWER(m.EMail)=LOWER(?)"/>

		<!-- Main fetch (prefer order): Thumbnail > Photo > EMMain.EmployeePhoto -->
		<add key="DeltekSql_BlobByEmail"
			 value="SELECT TOP 1 COALESCE(p.PhotoThumbnail, p.Photo, m.EmployeePhoto) AS PhotoBlob FROM dbo.EMMain m WITH (NOLOCK) LEFT JOIN dbo.EMPhoto p WITH (NOLOCK) ON p.Employee = m.Employee WHERE LOWER(m.EMail)=LOWER(?) ORDER BY CASE WHEN p.PhotoThumbnail IS NOT NULL THEN 0 WHEN p.Photo IS NOT NULL THEN 1 WHEN m.EmployeePhoto IS NOT NULL THEN 2 ELSE 3 END"/>
		<!-- ====================================================== -->

		<!-- Optional: hard-set the signed-in UPN/email if you ever need to override autodetect -->
		<!-- <add key="UserUpnOverride" value="first.last@korstructural.com" /> -->
		<!-- Security groups for card visibility (semicolon/comma-separated users). -->
		<!-- If key is absent/empty, card remains visible to all users. -->
		<!-- <add key="SecurityGroup.Financials.Members" value="ian.lalonde@korstructural.com;finance.lead@korstructural.com" /> -->

		<!-- Microsoft Graph delegated (MSAL) configuration (no secrets) -->
		<add key="Graph.TenantId" value="d9be1f7f-aacf-461a-8d1b-5528b86d540f"/>
		<add key="Graph.ClientId" value="69b68cd2-a051-4782-a45e-4f1276942c06"/>
		<!-- SharePoint/OneDrive Drive ID used by uploads + link creation -->
		<add key="Graph.DriveId" value="b!HqrMoNOgUUGvNaCTLXFmqQFminbwGPxGlsEOlzz3pnq3Q3c2O_cTT60-cOGCd7wU"/>
		<add key="ProjectsRoot" value="\\Kor-fs01\Projects\Projects"/>
		<add key="Brochure.SharedProposalsRootPath" value="\\Kor-fs01\Drafting\BrochureProposals" />
		<add key="BD.PursuitFilesRoot" value="\\KOR-FS01\BD Brain" />

		<add key="SecurityGroup.Financials.Members" value="jmarkulin@korstructural.com;ilalonde@korstructural.com;jdesroches@korstructural.com;dsingh@korstructural.com" />
		<add key="SecurityGroup.BrochureBuilder.Members" value="jmarkulin@korstructural.com;ilalonde@korstructural.com;ishabana@korstructural.com;dsingh@korstructural.com" />
		<add key="SecurityGroup.FeeProposalBuilder.Members" value="jmarkulin@korstructural.com;ilalonde@korstructural.com;jdesroches@korstructural.com;dsingh@korstructural.com" />
		<add key="SecurityGroup.PMTools.Members" value="andrean@korstructural.com;cmurtagh@korstructural.com;gdow@korstructural.com;ilalonde@korstructural.com;jbryson@korstructural.com;jdesroches@korstructural.com;jmarkulin@korstructural.com;jstuart@korstructural.com;kevinw@korstructural.com;omara@korstructural.com;rbeirne@korstructural.com" />
		<add key="SecurityGroup.StandardDetails.Members" value="jmarkulin@korstructural.com;ilalonde@korstructural.com;jdesroches@korstructural.com" />
		<add key="SecurityGroup.StandardDetailsAdmins.Members" value="ilalonde@korstructural.com" />
		<add key="SecurityGroup.StandardDetailsContributors.Members" value="ilalonde@korstructural.com;jmarkulin@korstructural.com" />
		<add key="SecurityGroup.StandardDetailsApprovers.Members" value="ilalonde@korstructural.com" />
		<add key="SecurityGroup.StandardDetailsPublishers.Members" value="ilalonde@korstructural.com" />
		<add key="SecurityGroup.EngineeringTools.Members" value="ilalonde@korstructural.com;jmarkulin@korstructural.com" />
		<add key="SecurityGroup.FileSyncCommandCenter.Members" value="ilalonde@korstructural.com" />
		<add key="SecurityGroup.Opportunities.Members" value="ilalonde@korstructural.com" />
		<add key="SecurityGroup.BusinessDevelopment.Members" value="ilalonde@korstructural.com" />
		<add key="SecurityGroup.Compensation.Members" value="jmarkulin@korstructural.com;ilalonde@korstructural.com;jdesroches@korstructural.com;dsingh@korstructural.com" />
		<add key="StandardDetails.FileStorageRootPath" value="\\Kor-fs01\Drafting" />
		<add key="EmailIndex:MaxAttachmentBytes" value="52428800" />
		<!-- 50 MB -->
		<add key="EmailIndex:BlockedExtensions" value=".exe,.bat,.cmd,.ps1,.msi,.vbs,.dll" />

		<!-- Watchlist sync service — routes CustWatchlist toggles through the deltek-webhook
		     service which relays them to the Deltek Vantagepoint REST API. AppApi credential
		     is distinct from the Deltek webhook credential used by Deltek for inbound calls. -->
		<add key="WatchlistSync.ServiceUrl" value="https://deltek-webhook.korstructural.com" />
		<add key="WatchlistSync.Username" value="kor-operations-app" />
		<add key="WatchlistSync.Password" value="Watchlist-Sync-2026-KorOps!" />
		<add key="McpServer.ServiceUrl" value="http://kor-app01:5500" />
		<add key="McpServer.Username" value="kor-operations-app" />
		<add key="McpServer.Password" value="$$$RW3sbChamp2021!!!" />
		<add key="EmployeeSummaryExcludedIds" value="IANLALONDE,DALERSINGH" />

		<!-- Posted GL P&L sign convention. Deltek GLSummary stores revenue as negative
		     (credit balance) and expenses positive. Flipping makes the displayed values
		     match accounting convention (revenue positive, expenses negative) so Net
		     Income = Revenue + Expenses comes out with the right sign. -->
		<add key="Financials.PnL.GlFlipSign" value="true" />
	</appSettings>


	<connectionStrings>
		<!-- Existing transmittals DB -->
		<add name="KorTransmittalsDb"
			 connectionString="Server=KOR-APP01\SQLEXPRESS;Database=KorTransmittals;User Id=transmittals_app;Password=ChangeThisStrongPassword!2025;Encrypt=True;TrustServerCertificate=True;" />

		<!-- Email index DB -->
		<add name="KorEmailIndex"
			 connectionString="Server=KOR-APP01\SQLEXPRESS;Database=KorEmailIndex;User Id=;Password=;Encrypt=True;TrustServerCertificate=True;" />

		<!-- BD opportunity-pipeline DB. Schema script: Scripts\20260502_opportunities_schema.sql -->
		<add name="KorOpportunitiesDb"
			 connectionString="Server=KOR-APP01\SQLEXPRESS;Database=KorOpportunitiesDb;User Id=opportunities_app;Password=$$$RW3sbChamp2021!!!;Encrypt=True;TrustServerCertificate=True;" />
	</connectionStrings>
</configuration>



