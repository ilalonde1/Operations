<UserControl x:Class="Kor.Operations.Financials.GlProfitLossView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:fin="clr-namespace:Kor.Operations.Financials"
        Background="{StaticResource App.Background}"
        Loaded="Window_Loaded"
        ToolTipService.InitialShowDelay="200">

    <UserControl.Resources>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="i"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                            ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_DateRange}" Cursor="Hand">
                    <TextBlock Text="From:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Margin="6,0,0,0" Width="130"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                            ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_DateRange}" Cursor="Hand">
                    <TextBlock Text="To:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Margin="6,0,0,0" Width="130"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                            ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_Table}" Cursor="Hand">
                    <TextBlock Text="Table:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Tables}"
                              SelectedItem="{Binding SelectedTable}"
                              DisplayMemberPath="Display"
                              Margin="6,0,0,0"
                              Width="260"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_Org}" Cursor="Hand">
                    <TextBlock Text="Org:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding OrgFilter}" Margin="6,0,0,0" Width="160" MinHeight="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Flip Sign" IsChecked="{Binding FlipSign}" Margin="0,0,0,0" VerticalAlignment="Center"
                              ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_FlipSign}"/>
                    <CheckBox Content="Hide zeros" IsChecked="{Binding HideZeroRows}" Margin="12,0,0,0" VerticalAlignment="Center"
                              ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_HideZeros}"/>
                </StackPanel>

                <Button Grid.Column="5"
                        Content="KPI Dictionary"
                        MinWidth="150"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="MetricDictionaryBtn_Click"/>

                <Button Grid.Column="6"
                        Content="Refresh"
                        Width="96"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="RefreshBtn_Click"
                        IsEnabled="{Binding CanRefresh}"/>

                <Button Grid.Column="7"
                        Content="Export to Excel"
                        MinWidth="140"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="ExportBtn_Click"
                        ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_Export}"
                        IsEnabled="{Binding CanExport}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFFDE8E8"
                        BorderBrush="#FFCC5C5C"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,8"
                        Visibility="{Binding ErrorVisibility}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FFFEF3C7"
                            BorderBrush="#FFF59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,8"
                            Visibility="{Binding PostingLagVisibility}">
                        <TextBlock Text="{Binding PostingLagBanner}"
                                   Foreground="#FF92400E"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Executive summary -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_RevenuePeriod}" Cursor="Hand">
                                    <TextBlock Text="Revenue (Period)" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SummaryRevenue}" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_ExpensesPeriod}" Cursor="Hand">
                                    <TextBlock Text="Expenses (Period)" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SummaryExpenses}" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_NetIncomePeriod}" Cursor="Hand">
                                    <TextBlock Text="Net Income (Period)" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SummaryNet}" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_NetMarginPeriod}" Cursor="Hand">
                                    <TextBlock Text="Net Margin (Period)" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SummaryMargin}" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="Transparent" Padding="10" Margin="8,0,0,0">
                            <Grid>
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                             </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_NetIncomeTrend}" Cursor="Hand">
                                    <TextBlock Text="Net Income Trend (Last 12)" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <Canvas x:Name="NetTrendCanvas" Grid.Row="1" Height="44" Margin="0,6,0,2" Background="Transparent" SizeChanged="NetTrendCanvas_SizeChanged">
                                    <Polyline x:Name="NetTrendLine" Stroke="#0F766E" StrokeThickness="2" Panel.ZIndex="1"/>
                                </Canvas>
                                <UniformGrid x:Name="NetTrendLabelGrid" Grid.Row="2" Columns="12" Margin="0,0,0,8"/>
                                <Grid Grid.Row="3" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=GlPnL_RevVsExpTrend}" Cursor="Hand" Margin="0,0,10,0">
                                        <TextBlock Text="Rev vs Exp (Last 12)" Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Top"/>
                                        <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                            <TextBlock Style="{StaticResource InfoIconText}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="10,1,0,0" VerticalAlignment="Center">
                                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#22C55E" Opacity="0.85" Margin="0,0,4,0"/>
                                            <TextBlock Text="Rev" Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,0,8,0"/>
                                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#F97316" Opacity="0.85" Margin="0,0,4,0"/>
                                            <TextBlock Text="Exp" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Canvas x:Name="RevExpCanvas" Grid.Column="1" Height="56" Background="Transparent" SizeChanged="RevExpCanvas_SizeChanged"/>
                                </Grid>
                                <UniformGrid x:Name="RevExpLabelGrid" Grid.Row="4" Columns="12" Margin="0,2,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <DataGrid x:Name="PnLGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              MouseDoubleClick="PnLGrid_MouseDoubleClick"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              FrozenColumnCount="1"
                              AlternatingRowBackground="#07000000"
                              RowBackground="Transparent"
                              ColumnHeaderHeight="34"
                              FontSize="12"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Margin" Value="0,6,0,10"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <StackPanel>
                                                        <Border Background="#08000000"
                                                                BorderBrush="#12000000"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="8"
                                                                Padding="10,6"
                                                                Margin="0,0,0,6">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource Text.Primary}"
                                                                           DockPanel.Dock="Left"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} lines}"
                                                                           Foreground="{StaticResource Text.Secondary}"
                                                                           Margin="10,1,0,0"
                                                                           DockPanel.Dock="Right"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <ItemsPresenter/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="26"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#0C000000"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#08000000"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#12038C7E"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding [RowKind]}" Value="SectionTotal">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Background" Value="#0C000000"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding [RowKind]}" Value="GrandTotal">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Background" Value="#14000000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,0,8,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#12000000"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

