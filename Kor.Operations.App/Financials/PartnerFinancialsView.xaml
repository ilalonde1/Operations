<UserControl x:Class="Kor.Operations.Financials.PartnerFinancialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fin="clr-namespace:Kor.Operations.Financials"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <fin:SparklineConverter x:Key="Sparkline"/>
        <fin:StringToBrushConverter x:Key="StringToBrush"/>

        <Style x:Key="PartnerGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF9F9F9"/>
        </Style>

        <Style x:Key="MoneyCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Partner Financials"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left"
                                Background="#FFFFF7ED"
                                BorderBrush="#FFF59E0B"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6,1"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsFxProvisional, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding FxTooltip}">
                            <TextBlock Text="{Binding FxBadgeText}"
                                       Foreground="#FF92400E"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       ToolTip="{fin:FinancialMetricTooltip Key=BM_FxProvisional}"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11"
                               Margin="0,3,0,0" Opacity="0.85"
                               Visibility="{Binding AsOfVisibility}">
                        <Run Text="{Binding AsOfLabel, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="LedgerAR invoiced revenue by PR Principal | Last activity: "/>
                        <Run Text="{Binding LastMoPeriodLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Year"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               ToolTip="{fin:FinancialMetricTooltip Key=BM_YearSelector}"
                               Cursor="Hand"/>
                    <ComboBox ItemsSource="{Binding Years}"
                              SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="88"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True"
                                 Width="80"
                                 Height="6"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="Loading"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="11"
                               FontStyle="Italic"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#FFFDE8E8"
                BorderBrush="#FFCC5C5C"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
            <TabControl>
                <TabItem Header="{Binding CombinedGridTitle}" ToolTip="{fin:FinancialMetricTooltip Key=BM_CombinedGrid}">
                    <DataGrid Style="{StaticResource PartnerGridStyle}" ItemsSource="{Binding CombinedRows}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="26"/>
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="SeparatorBrush" Value="Transparent"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter Property="Background" Value="#FFF0F4FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStale}" Value="True">
                                        <Setter Property="Foreground" Value="#FFB0B8C4"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="4" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Rectangle Fill="#FF3B82F6" Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="26" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="ToggleBtn_Click" BorderThickness="0" Padding="2,0" FocusVisualStyle="{x:Null}" Cursor="Hand" FontSize="10">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Content" Value="+"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Content" Value="-"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Label}" Width="240" MinWidth="150">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="PARTNER / PROJECT" ToolTip="{fin:FinancialMetricTooltip Key=BM_Label}" Cursor="Hand"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding InfoText}" Width="130" MinWidth="70">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="INFO" ToolTip="{fin:FinancialMetricTooltip Key=BM_Info}" Cursor="Hand"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="YOY" Binding="{Binding YoyDeltaText}" Width="80" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalBilled, StringFormat={}{0:C0}}" Width="92" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="JAN" Binding="{Binding JanText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="FEB" Binding="{Binding FebText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="MAR" Binding="{Binding MarText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="APR" Binding="{Binding AprText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="MAY" Binding="{Binding MayText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="JUN" Binding="{Binding JunText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="JUL" Binding="{Binding JulText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="AUG" Binding="{Binding AugText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="SEP" Binding="{Binding SepText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="OCT" Binding="{Binding OctText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="NOV" Binding="{Binding NovText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="DEC" Binding="{Binding DecText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTemplateColumn Header="TREND" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="82" Height="20">
                                            <Polyline Points="{Binding MonthlyBilled, Converter={StaticResource Sparkline}}"
                                                      Stroke="{Binding SparklineColor, Converter={StaticResource StringToBrush}}"
                                                      StrokeThickness="1.5"
                                                      Stretch="None"/>
                                            <TextBlock Text="{Binding TrendArrow}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding LastMoText}" Width="86" ElementStyle="{StaticResource MoneyCellText}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{Binding DataContext.LastMoPeriodLabel, RelativeSource={RelativeSource AncestorType=DataGrid}, FallbackValue='LAST'}" ToolTip="{fin:FinancialMetricTooltip Key=BM_LastMo}" Cursor="Hand"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TwoMoAgoText}" Width="86" ElementStyle="{StaticResource MoneyCellText}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{Binding DataContext.TwoMoAgoPeriodLabel, RelativeSource={RelativeSource AncestorType=DataGrid}, FallbackValue='PRIOR'}" ToolTip="{fin:FinancialMetricTooltip Key=BM_2MoAgo}" Cursor="Hand"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="STREAK" Binding="{Binding StreakText}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="{Binding CadGridTitle}" ToolTip="{fin:FinancialMetricTooltip Key=BM_CadGrid}">
                    <DataGrid Style="{StaticResource PartnerGridStyle}" ItemsSource="{Binding CadRows}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="26">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Content="+" Click="ToggleBtn_Click" Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PARTNER / PROJECT" Binding="{Binding Label}" Width="260"/>
                            <DataGridTextColumn Header="INFO" Binding="{Binding InfoText}" Width="130"/>
                            <DataGridTextColumn Header="YOY" Binding="{Binding YoyDeltaText}" Width="80" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalBilled, StringFormat={}{0:C0}}" Width="92" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="JAN" Binding="{Binding JanText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="FEB" Binding="{Binding FebText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="MAR" Binding="{Binding MarText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="APR" Binding="{Binding AprText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="MAY" Binding="{Binding MayText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="JUN" Binding="{Binding JunText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="JUL" Binding="{Binding JulText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="AUG" Binding="{Binding AugText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="SEP" Binding="{Binding SepText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="OCT" Binding="{Binding OctText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="NOV" Binding="{Binding NovText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="DEC" Binding="{Binding DecText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTemplateColumn Header="TREND" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="82" Height="20">
                                            <Polyline Points="{Binding MonthlyBilled, Converter={StaticResource Sparkline}}"
                                                      Stroke="{Binding SparklineColor, Converter={StaticResource StringToBrush}}"
                                                      StrokeThickness="1.5"
                                                      Stretch="None"/>
                                            <TextBlock Text="{Binding TrendArrow}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="LAST" Binding="{Binding LastMoText}" Width="86" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="PRIOR" Binding="{Binding TwoMoAgoText}" Width="86" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="STREAK" Binding="{Binding StreakText}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="{Binding UsdGridTitle}" ToolTip="{fin:FinancialMetricTooltip Key=BM_UsdGrid}">
                    <DataGrid Style="{StaticResource PartnerGridStyle}" ItemsSource="{Binding UsdRows}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="26">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Content="+" Click="ToggleBtn_Click" Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PARTNER / PROJECT" Binding="{Binding Label}" Width="260"/>
                            <DataGridTextColumn Header="INFO" Binding="{Binding InfoText}" Width="130"/>
                            <DataGridTextColumn Header="YOY" Binding="{Binding YoyDeltaText}" Width="80" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalBilled, StringFormat={}{0:C0}}" Width="92" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="JAN" Binding="{Binding JanText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="FEB" Binding="{Binding FebText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="MAR" Binding="{Binding MarText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="APR" Binding="{Binding AprText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="MAY" Binding="{Binding MayText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="JUN" Binding="{Binding JunText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="JUL" Binding="{Binding JulText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="AUG" Binding="{Binding AugText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="SEP" Binding="{Binding SepText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="OCT" Binding="{Binding OctText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="NOV" Binding="{Binding NovText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="DEC" Binding="{Binding DecText}" Width="70" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTemplateColumn Header="TREND" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="82" Height="20">
                                            <Polyline Points="{Binding MonthlyBilled, Converter={StaticResource Sparkline}}"
                                                      Stroke="{Binding SparklineColor, Converter={StaticResource StringToBrush}}"
                                                      StrokeThickness="1.5"
                                                      Stretch="None"/>
                                            <TextBlock Text="{Binding TrendArrow}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="LAST" Binding="{Binding LastMoText}" Width="86" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="PRIOR" Binding="{Binding TwoMoAgoText}" Width="86" ElementStyle="{StaticResource MoneyCellText}"/>
                            <DataGridTextColumn Header="STREAK" Binding="{Binding StreakText}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="YoY">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="10,6" BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LY Total" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding YoyLastYearTotal, StringFormat={}{0:C0}}" Margin="0,0,18,0"/>
                                <TextBlock Text="CY Total" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding YoyCurrentYearTotal, StringFormat={}{0:C0}}" Margin="0,0,18,0"/>
                                <TextBlock Text="Difference" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding YoyDifferenceTotalText}"/>
                            </StackPanel>
                        </Border>
                        <DataGrid Style="{StaticResource PartnerGridStyle}" ItemsSource="{Binding YoyRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MONTH" Binding="{Binding Month}" Width="90"/>
                                <DataGridTextColumn Header="LY" Binding="{Binding LastYear, StringFormat={}{0:C0}}" Width="120" ElementStyle="{StaticResource MoneyCellText}"/>
                                <DataGridTextColumn Header="CY" Binding="{Binding CurrentYear, StringFormat={}{0:C0}}" Width="120" ElementStyle="{StaticResource MoneyCellText}"/>
                                <DataGridTextColumn Header="DIFF" Binding="{Binding DifferenceText}" Width="120" ElementStyle="{StaticResource MoneyCellText}"/>
                                <DataGridTextColumn Header="CHANGE" Binding="{Binding ChangePercentText}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Billings by Partner" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" ToolTip="{fin:FinancialMetricTooltip Key=BM_12MoChart}" Cursor="Hand"/>
                    <ItemsControl ItemsSource="{Binding ChartEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="265"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PartnerName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/>
                                    <Border Grid.Column="1" Height="16" CornerRadius="2" HorizontalAlignment="Left" Opacity="0.80" Background="{Binding LegendColor, Converter={StaticResource StringToBrush}}" Width="{Binding BarWidth}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalBilled, StringFormat={}{0:C0}}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Year-over-Year Growth" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" ToolTip="{fin:FinancialMetricTooltip Key=BM_YoyChart}" Cursor="Hand"/>
                    <ItemsControl ItemsSource="{Binding ChartEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PartnerName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/>
                                    <Border Grid.Column="1" Height="16" CornerRadius="2" HorizontalAlignment="Right" Background="#FFEF4444" Opacity="0.75" Width="{Binding YoyNegativeBarWidth}"/>
                                    <Rectangle Grid.Column="2" Fill="#FFD1D5DB"/>
                                    <Border Grid.Column="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Background="#FF16A34A" Opacity="0.75" Width="{Binding YoyPositiveBarWidth}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding YoyDeltaText}" VerticalAlignment="Center" FontSize="11" Margin="6,0,0,0" Foreground="{StaticResource Text.Secondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,10">
            <StackPanel>
                <TextBlock Text="60-Month Billing History by Partner" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" ToolTip="{fin:FinancialMetricTooltip Key=BM_60MoChart}" Cursor="Hand"/>
                <ItemsControl ItemsSource="{Binding MonthBars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Tooltip}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="160"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <ItemsControl Grid.Row="0" ItemsSource="{Binding Segments}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Height="{Binding SegmentHeight}" Margin="0.5,0" Background="{Binding Color, Converter={StaticResource StringToBrush}}" ToolTip="{Binding Tooltip}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="#FFE5E7EB" IsHitTestVisible="False"/>
                                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="1,3,0,0">
                                    <TextBlock Text="{Binding MonthLabel}" FontSize="8" HorizontalAlignment="Left" Foreground="{StaticResource Text.Secondary}"/>
                                    <TextBlock Text="{Binding YearLabel}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
