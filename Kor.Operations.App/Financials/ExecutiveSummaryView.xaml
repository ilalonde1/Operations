<UserControl x:Class="Kor.Operations.Financials.ExecutiveSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fin="clr-namespace:Kor.Operations.Financials"
             Background="Transparent">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="ExecutiveCardBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFF7FAFD" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="MetricCardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ExecutiveCardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Panel.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">

                            <Grid>
                                <Border x:Name="AccentStrip"
                                        Height="4"
                                        VerticalAlignment="Top"
                                        Background="#FF2563EB"
                                        Opacity="0.75"
                                        CornerRadius="10,10,0,0"/>
                                <ContentPresenter Margin="0" />

                                <!-- Hover affordance -->
                                <Border x:Name="DetailsBadge"
                                        Background="#0F000000"
                                        CornerRadius="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="10"
                                        Padding="8,4"
                                        Opacity="0">
                                    <TextBlock Text="Details"
                                               Foreground="{StaticResource Text.Secondary}"
                                               FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FFEFF6FF"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FF93C5FD"/>
                                <Setter TargetName="AccentStrip" Property="Opacity" Value="1"/>
                                <Setter TargetName="AccentStrip" Property="Background" Value="#FF2563EB"/>
                                <Setter TargetName="DetailsBadge" Property="Opacity" Value="1"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.01" ScaleY="1.01"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FFEFF6FF"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FF93C5FD"/>
                                <Setter TargetName="AccentStrip" Property="Background" Value="#FF2563EB"/>
                                <Setter TargetName="AccentStrip" Property="Opacity" Value="1"/>
                                <Setter TargetName="DetailsBadge" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <DockPanel>
                <TextBlock Text="Executive Summary" FontWeight="SemiBold" FontSize="18"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="Last updated:" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                <TextBlock Text="{Binding LastUpdatedDisplay}" Margin="6,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding StatusHint}" Margin="16,0,0,0" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                <TextBlock Text="{Binding ScopeEcho}" Margin="16,0,0,0"
                           Foreground="{StaticResource Text.Secondary}" FontSize="11"
                           Visibility="{Binding ScopeEchoVisibility}"/>
            </StackPanel>
            <Border Background="#FFFEE2E2"
                    BorderBrush="#FFB91C1C"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,6"
                    Margin="0,8,0,0"
                    Visibility="{Binding SchemaDriftVisibility}">
                <TextBlock Text="{Binding SchemaDriftBanner}"
                           Foreground="#FF7F1D1D"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
            <Border BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,6"
                    Margin="0,8,0,0"
                    Visibility="{Binding DataFreshnessVisibility}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFEF3C7"/>
                        <Setter Property="BorderBrush" Value="#FFF59E0B"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataFreshnessSeverity}" Value="Info">
                                <Setter Property="Background" Value="#FFEFF6FF"/>
                                <Setter Property="BorderBrush" Value="#FF93C5FD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataFreshnessSeverity}" Value="Warning">
                                <Setter Property="Background" Value="#FFFEF3C7"/>
                                <Setter Property="BorderBrush" Value="#FFF59E0B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding DataFreshnessBanner}"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FF92400E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataFreshnessSeverity}" Value="Info">
                                    <Setter Property="Foreground" Value="#FF1E40AF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataFreshnessSeverity}" Value="Warning">
                                    <Setter Property="Foreground" Value="#FF92400E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <Border BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,6"
                    Margin="0,8,0,0"
                    Visibility="{Binding PostingLagVisibility}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFEF3C7"/>
                        <Setter Property="BorderBrush" Value="#FFF59E0B"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PostingLagSeverity}" Value="Info">
                                <Setter Property="Background" Value="#FFEFF6FF"/>
                                <Setter Property="BorderBrush" Value="#FF93C5FD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PostingLagSeverity}" Value="Warning">
                                <Setter Property="Background" Value="#FFFEF3C7"/>
                                <Setter Property="BorderBrush" Value="#FFF59E0B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding PostingLagBanner}"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FF92400E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PostingLagSeverity}" Value="Info">
                                    <Setter Property="Foreground" Value="#FF1E40AF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PostingLagSeverity}" Value="Warning">
                                    <Setter Property="Foreground" Value="#FF92400E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- KPI cards -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                 <ItemsControl.ItemTemplate>
                     <DataTemplate>
                        <Button Style="{StaticResource MetricCardButton}"
                                MinWidth="286"
                                Height="84"
                                Margin="4"
                                VerticalAlignment="Top"
                                Click="KpiCard_Click">
                            <Grid Margin="9,6,9,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right"
                                            Background="#FFE5E7EB"
                                            BorderBrush="#FF9CA3AF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding ScopeBadgeVisibility}">
                                        <TextBlock Text="{Binding ScopeBadgeText}"
                                                   Foreground="#FF374151"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text.Secondary}" FontSize="11" FontWeight="SemiBold"/>
                                </DockPanel>

                                <TextBlock Grid.Row="1" Text="{Binding ValueText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ValueText}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Trends + Alerts -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Trends" FontWeight="SemiBold"/>
                        <TextBlock Text="Recent revenue, billings, AR, and delivery movement."
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Trends}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MetricCardButton}" Margin="0,0,0,8" Click="TrendCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="10">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                                <Border DockPanel.Dock="Right"
                                                        Background="#FFE5E7EB"
                                                        BorderBrush="#FF9CA3AF"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding ScopeBadgeVisibility}">
                                                    <TextBlock Text="{Binding ScopeBadgeText}"
                                                               Foreground="#FF374151"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <Border DockPanel.Dock="Right"
                                                        Background="#FFE8F5E9"
                                                        BorderBrush="#FF81C784"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding BadgeText}"
                                                               Foreground="#FF2E7D32"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ValueText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding StatusMessage}"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding StatusVisibility}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Grid Grid.Column="1" VerticalAlignment="Center" Height="34">
                                            <Border Background="#0F000000" CornerRadius="6"/>
                                            <Polyline Points="{Binding Points}"
                                                      StrokeThickness="2"
                                                      Stroke="#FF166534"
                                                      Fill="Transparent"
                                                      Margin="6,6,6,6"
                                                      Visibility="{Binding SparklineVisibility}"
                                                      StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Alerts" FontWeight="SemiBold"/>
                        <TextBlock Text="Portfolio signals from current Deltek and project data."
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Alerts}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MetricCardButton}" Margin="0,0,0,8" Click="AlertCard_Click">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource Text.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
