<Window x:Class="Kor.Operations.Financials.ProfitLossReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOR NewerForma - Financials - Profit &amp; Loss"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1300"
        MinWidth="1100"
        Height="820"
        MinHeight="640"
        Loaded="Window_Loaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Profit &amp; Loss (Derived)"
                           FontWeight="SemiBold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,0"/>

                <Button Grid.Column="2"
                        Content="Refresh"
                        Width="96"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="RefreshBtn_Click"
                        IsEnabled="{Binding CanRefresh}"/>

                <Button Grid.Column="3"
                        Content="Close"
                        Width="84"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFFDE8E8"
                        BorderBrush="#FFCC5C5C"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,8"
                        Visibility="{Binding ErrorVisibility}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="220"/>
                        <DataGridTextColumn Header="Line Item" Binding="{Binding LineItem}" Width="*"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding ValueDisplay}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
