<Window x:Class="Kor.Operations.Financials.FinancialMetricDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOR NewerForma - KPI Dictionary"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1120"
        MinWidth="900"
        Height="720"
        MinHeight="560">

    <Grid Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="CatAllBtn"
                                Content="All"
                                Click="CategoryAll_Click"
                                Style="{StaticResource Button.Secondary}"
                                Margin="0,0,8,0"/>
                        <Button x:Name="CatFinancialBtn"
                                Content="Financial"
                                Click="CategoryFinancial_Click"
                                Style="{StaticResource Button.Secondary}"
                                Margin="0,0,8,0"/>
                        <Button x:Name="CatPmBtn"
                                Content="PM"
                                Click="CategoryPm_Click"
                                Style="{StaticResource Button.Secondary}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 ToolTip="Search by name, key, definition, or query"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="ResultsCountText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <ListView x:Name="MetricsList"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Panel.Background}"
                                    BorderBrush="{StaticResource Panel.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"/>
                                        <Border DockPanel.Dock="Right"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="PM">
                                                            <Setter Property="Background" Value="#E0F2F1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Category}" Value="PM">
                                                                <Setter Property="Foreground" Value="#0F766E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Key}"
                                                   DockPanel.Dock="Right"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="11"
                                                   Margin="10,0,0,0"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               xml:space="preserve"
                                               TextWrapping="Wrap"/>

                                    <Expander Header="Technical Query" Margin="0,6,0,0">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Formula}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Formula}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>

                                        <Border Background="#0A000000" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Formula}"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>

