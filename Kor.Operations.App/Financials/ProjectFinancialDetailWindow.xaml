<Window x:Class="Kor.Operations.Financials.ProjectFinancialDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fin="clr-namespace:Kor.Operations.Financials"
        Title="KOR NewerForma - Financials - Project Detail"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1400"
        MinWidth="1200"
        Height="760"
        ToolTipService.InitialShowDelay="200">

    <Window.Resources>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="i"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding ProjectName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{x:Static fin:DisplayTerms.ProjectNumber}" Foreground="{StaticResource Text.Secondary}"/>
                        <TextBlock Text=": " Foreground="{StaticResource Text.Secondary}"/>
                        <TextBlock Text="{Binding Wbs1}" Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="KPI Dictionary"
                            Style="{StaticResource Button.Secondary}"
                            Height="28"
                            MinWidth="150"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,8"
                            Click="MetricDictionaryBtn_Click"/>
                    <Border Padding="8,4"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{StaticResource Panel.Border}"
                            ToolTip="{Binding DeliveryConfidenceTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#DCFCE7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                        <Setter Property="Background" Value="#FFEDD5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#166534"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                <Setter Property="Fill" Value="#B91C1C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                <Setter Property="Fill" Value="#C2410C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                <Setter Property="Fill" Value="#A16207"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                                <Setter Property="Fill" Value="#166534"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DeliveryConfidence}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding DeliveryConfidenceSummary}"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Width="320"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- SECTION 1: Summary Panel -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Summary" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="PM" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Pm}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="Phase" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Phase}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=TotalFees}" Cursor="Hand">
                                    <TextBlock Text="Fee" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Fee, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,0">
                                    <Run Text="{Binding InitialFee, StringFormat='Initial: {0:C0}', Mode=OneWay}"/>
                                    <Run Text=" + "/>
                                    <Run Text="{Binding ExtraFees, StringFormat='Extras: {0:C0}', Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=TotalFeeBilled}" Cursor="Hand">
                                    <TextBlock Text="Fee Billed" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding FeeBilled, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10" Visibility="{Binding SubconsultantCostVisibility}">
                                <TextBlock Text="Sub/AP Cost" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SubconsultantCost, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PercentBilled}" Cursor="Hand">
                                    <TextBlock Text="% Billed" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding PercentBilled, StringFormat={}{0:P1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursSpent}" Cursor="Hand">
                                    <TextBlock Text="Hours Spent" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding HoursSpent, StringFormat={}{0:N1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursBudgeted}" Cursor="Hand">
                                    <TextBlock Text="Hours Budgeted" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding HoursBudgeted, StringFormat={}{0:N1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursRemaining}" Cursor="Hand">
                                    <TextBlock Text="Hours Remaining" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding HoursRemaining, StringFormat={}{0:N1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PercentHoursSpent}" Cursor="Hand">
                                    <TextBlock Text="% Hours Spent" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding PercentHoursSpent, StringFormat={}{0:P1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=Backlog}" Cursor="Hand">
                                    <TextBlock Text="Backlog" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding BacklogDollars, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="Backlog %" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                           ToolTip="Unbilled fee as a percentage of total fee. (Fee - Fee Billed) / Fee."/>
                                <TextBlock Text="{Binding BacklogPercent, StringFormat={}{0:P1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="Total Inspections" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                           ToolTip="Total number of inspection time entries (LaborCode 40) logged to this project."/>
                                <TextBlock Text="{Binding TotalInspections}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="Inspections Last Month" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                           ToolTip="Number of inspection entries logged in the previous calendar month."/>
                                <TextBlock Text="{Binding LastMonthInspections}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Risk Drivers -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Risk Drivers" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoIconBorder}"
                                    Margin="8,0,0,0"
                                    ToolTip="{fin:FinancialMetricTooltip Key=RiskDrivers}">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding RiskDrivers}" Visibility="{Binding RiskDriversVisibility}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource Panel.Border}">
                                            <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding}" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No active delivery risks detected."
                                   Foreground="{StaticResource Text.Secondary}"
                                   Visibility="{Binding NoRiskDriversVisibility}"/>
                    </StackPanel>
                </Border>

                <!-- CFO Metrics -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="CFO Metrics" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoIconBorder}"
                                    Margin="8,0,0,0"
                                    ToolTip="Curated CFO-facing metrics computed from the same project snapshot used by the dashboard.">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding CfoMetrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6" ToolTip="{Binding Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource Text.Secondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueDisplay}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Delivery Trend -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Delivery Trend" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoIconBorder}"
                                    Margin="8,0,0,0"
                                    ToolTip="{fin:FinancialMetricTooltip Key=DeliveryTrend}">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DeliveryTrend}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,0" ToolTip="{Binding Tooltip}">
                                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#6B7280"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                            <Setter Property="Fill" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                            <Setter Property="Fill" Value="#C2410C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                            <Setter Property="Fill" Value="#A16207"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                                            <Setter Property="Fill" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: Discipline Breakdown -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Discipline Breakdown" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ItemsSource="{Binding Disciplines}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Discipline" Binding="{Binding Discipline}" Width="*"/>
                                <DataGridTextColumn Header="Hours" Binding="{Binding Hours, StringFormat={}{0:N1}}" Width="140"/>
                                <DataGridTextColumn Header="% of Total" Binding="{Binding PercentOfTotal, StringFormat={}{0:P1}}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2b: Team Breakdown -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <Expander x:Name="TeamBreakdownExpander"
                              Header="Team Breakdown"
                              IsExpanded="False"
                              Expanded="TeamBreakdownExpander_Expanded">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock x:Name="TeamBreakdownStatus"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <DataGrid x:Name="TeamBreakdownGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*"/>
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat={}{0:N1}}" Width="140"/>
                                    <DataGridTextColumn Header="% of Project Total" Binding="{Binding PercentOfProject, StringFormat={}{0:P1}}" Width="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- SECTION 3: Health Indicators -->
                <Border Style="{StaticResource Card}" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Health Indicators" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoIconBorder}"
                                    Margin="8,0,0,0"
                                    ToolTip="{fin:FinancialMetricTooltip Key=HealthIndicators}">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding BurnRiskVisibility}">
                            <TextBlock Text="Burn Risk" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoIconBorder}"
                                    Margin="8,0,0,0"
                                    ToolTip="{fin:FinancialMetricTooltip Key=BurnRisk}">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="🔥 Over Budget" Visibility="{Binding OverBudgetVisibility}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Text=" Overbilled" Visibility="{Binding OverbilledVisibility}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

