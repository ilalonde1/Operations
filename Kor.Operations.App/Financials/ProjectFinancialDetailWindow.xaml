<Window x:Class="Kor.Operations.Financials.ProjectFinancialDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fin="clr-namespace:Kor.Operations.Financials"
        Title="KOR NewerForma - Financials - Project Detail"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1400"
        MinWidth="1200"
        Height="760"
        ToolTipService.InitialShowDelay="200">

    <Window.Resources>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="i"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Shared drill-down employee detail panel -->
        <DataTemplate x:Key="EmployeeDrillDownTemplate">
            <StackPanel>
                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,3,0,3"
                        Cursor="Hand" Background="Transparent"
                        MouseLeftButtonUp="EmployeeEntry_DrillDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x25B6;" FontSize="7"
                                   Foreground="#D1D5DB" VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Employee}" FontSize="10"
                                   FontWeight="SemiBold" Foreground="#374151"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DisplayDetail, Mode=OneWay}"
                                   FontSize="10" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding DisplayHours, Mode=OneWay}"
                                   FontSize="10" HorizontalAlignment="Right"
                                   FontWeight="SemiBold" Foreground="#374151"/>
                    </Grid>
                </Border>
                <!-- Timesheet entries: grouped by month with compact day pills -->
                <ItemsControl ItemsSource="{Binding MonthGroups}"
                              Visibility="{Binding DrillDownVisibility, Mode=OneWay}"
                              Margin="12,4,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,2">
                                <!-- Month header -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding MonthLabel}" FontSize="9"
                                               FontWeight="SemiBold" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTotal, Mode=OneWay}"
                                               FontSize="9" Foreground="#9CA3AF"/>
                                </Grid>
                                <!-- Day pills in a wrap panel -->
                                <ItemsControl ItemsSource="{Binding Days}" Margin="4,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background, Mode=OneWay}"
                                                    CornerRadius="3" Padding="5,2,5,2" Margin="1,1,1,1"
                                                    ToolTip="{Binding Tooltip, Mode=OneWay}"
                                                    ToolTipService.InitialShowDelay="100">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayDay}" FontSize="8"
                                                               FontWeight="SemiBold" Foreground="#374151"/>
                                                    <TextBlock Text=":" FontSize="8" Foreground="#9CA3AF" Margin="1,0,2,0"/>
                                                    <TextBlock Text="{Binding DisplayHours, Mode=OneWay}" FontSize="8"
                                                               Foreground="#6B7280"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding ProjectName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{x:Static fin:DisplayTerms.ProjectNumber}" Foreground="{StaticResource Text.Secondary}"/>
                        <TextBlock Text=": " Foreground="{StaticResource Text.Secondary}"/>
                        <TextBlock Text="{Binding Wbs1}" Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="KPI Dictionary"
                            Style="{StaticResource Button.Secondary}"
                            Height="28"
                            MinWidth="150"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,8"
                            Click="MetricDictionaryBtn_Click"/>
                    <Border Padding="8,4"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{StaticResource Panel.Border}"
                            ToolTip="{Binding DeliveryConfidenceTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#DCFCE7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                        <Setter Property="Background" Value="#FFEDD5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#166534"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                <Setter Property="Fill" Value="#B91C1C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                <Setter Property="Fill" Value="#C2410C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                <Setter Property="Fill" Value="#A16207"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                                <Setter Property="Fill" Value="#166534"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DeliveryConfidence}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding DeliveryConfidenceSummary}"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Width="320"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- SECTION 1: Summary Panel -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Summary" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="PM" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Pm}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="Phase" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Phase}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="The original contract fee from Deltek, including any fixed-price extras. Does not include hourly/T&amp;M revenue — see Hourly Extras and Total Value for the full picture." Cursor="Hand">
                                    <TextBlock Text="Fixed Fee" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding FixedFee, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel x:Name="HourlyRevenueSummaryPanel" Margin="0,0,18,10" Visibility="Collapsed">
                                <TextBlock Text="Hourly Extras" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                           ToolTip="Additional revenue earned from hourly or time-and-materials work billed on top of the fixed contract fee."/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="HourlyRevenueSummaryValue" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="HourlyRevenueSummaryHours" FontSize="10" Foreground="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="TotalValueSummaryPanel" Margin="0,0,18,10" Visibility="Collapsed">
                                <TextBlock Text="Total Value" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                           ToolTip="The complete project value: fixed contract fee plus any hourly extras revenue. This is the number all metrics are measured against."/>
                                <TextBlock x:Name="TotalValueSummaryValue" FontWeight="Bold" FontSize="15" Foreground="#059669"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=TotalFeeBilled}" Cursor="Hand">
                                    <TextBlock Text="Fee Billed" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding EstimatedFeeBilled, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnpostedBilling}" Value="True">
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10" Visibility="{Binding SubconsultantCostVisibility}">
                                <TextBlock Text="Sub/AP Cost" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SubconsultantCost, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PercentBilled}" Cursor="Hand">
                                    <TextBlock Text="% Billed" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding EstimatedPercentBilled, StringFormat={}{0:P1}}" FontWeight="SemiBold" FontSize="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnpostedBilling}" Value="True">
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursSpent}" Cursor="Hand">
                                    <TextBlock Text="Hours Spent" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding HoursSpent, StringFormat={}{0:N1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursBudgeted}" Cursor="Hand">
                                    <TextBlock Text="Hours Budgeted" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding HoursBudgeted, StringFormat={}{0:N1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursRemaining}" Cursor="Hand">
                                    <TextBlock Text="Hours Remaining" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding HoursRemaining, StringFormat={}{0:N1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PercentHoursSpent}" Cursor="Hand">
                                    <TextBlock Text="% Hours Spent" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding PercentHoursSpent, StringFormat={}{0:P1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,18,10">
                                <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=Backlog}" Cursor="Hand">
                                    <TextBlock Text="Backlog" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource InfoIconText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding BacklogDollars, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="Backlog %" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                           ToolTip="Unbilled fee as a percentage of total fee. (Fee - Fee Billed) / Fee."/>
                                <TextBlock Text="{Binding BacklogPercent, StringFormat={}{0:P1}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="Total Inspections" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                           ToolTip="Total number of inspection time entries (LaborCode 40) logged to this project."/>
                                <TextBlock Text="{Binding TotalInspections}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="Inspections Last Month" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                           ToolTip="Number of inspection entries logged in the previous calendar month."/>
                                <TextBlock Text="{Binding LastMonthInspections}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fee Breakdown (collapsible) -->
                <Border x:Name="FeeBreakdownCard" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Header: click to toggle -->
                        <Grid Cursor="Hand" MouseLeftButtonUp="FeeBreakdown_ToggleClick" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fee Breakdown" FontWeight="SemiBold" FontSize="14"/>
                            <Border Grid.Column="2" CornerRadius="10" Width="20" Height="20"
                                    Background="#EFF6FF" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="FeeBreakdownChevron" Text="&#x25B6;"
                                           FontSize="10" Foreground="#3B82F6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Collapsed summary -->
                        <Grid x:Name="FeeBreakdownSummary" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FeeBreakdownSummaryText" FontSize="11"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock x:Name="FeeBreakdownSummaryTotal" Grid.Column="1"
                                       FontSize="12" FontWeight="Bold"/>
                        </Grid>

                        <!-- Expanded content -->
                        <StackPanel x:Name="FeeBreakdownContent" Margin="0,10,0,0">

                            <!-- Column headers -->
                            <Grid Margin="10,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Fee" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Hours" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="$/Hr" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Initial Contract -->
                            <TextBlock Text="INITIAL CONTRACT" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="InitialPhasesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="10,1,0,1" Cursor="Hand"
                                                  MouseLeftButtonUp="HourlyExtra_DrillDown"
                                                  Background="{Binding RowBackground, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="65"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#x25B6;" FontSize="8"
                                                           Foreground="#9CA3AF" VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           Visibility="{Binding HasHoursVisibility, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DisplayAmount, Mode=OneWay}"
                                                           FontSize="11" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DisplayHours, Mode=OneWay}"
                                                           FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding DisplayFeePerHour, Mode=OneWay}"
                                                           FontSize="10" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding FeePerHourForeground, Mode=OneWay}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding EmployeeBreakdown}"
                                                          Visibility="{Binding DrillDownVisibility, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource EmployeeDrillDownTemplate}"
                                                          Margin="26,2,0,6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="10,4,0,2"/>
                            <Grid Margin="10,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="InitialContractSubtotal" Grid.Column="1"
                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="InitialContractHrsSubtotal" Grid.Column="2"
                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Fixed Fee Extras -->
                            <TextBlock x:Name="FixedExtrasHeader" Text="FIXED FEE EXTRAS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,6,0,4"
                                       Visibility="Collapsed"/>
                            <ItemsControl x:Name="FixedExtrasList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="10,1,0,1" Cursor="Hand"
                                                  MouseLeftButtonUp="HourlyExtra_DrillDown"
                                                  Background="{Binding RowBackground, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="65"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#x25B6;" FontSize="8"
                                                           Foreground="#9CA3AF" VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           Visibility="{Binding HasHoursVisibility, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DisplayAmount, Mode=OneWay}"
                                                           FontSize="11" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DisplayHours, Mode=OneWay}"
                                                           FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding DisplayFeePerHour, Mode=OneWay}"
                                                           FontSize="10" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding FeePerHourForeground, Mode=OneWay}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding EmployeeBreakdown}"
                                                          Visibility="{Binding DrillDownVisibility, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource EmployeeDrillDownTemplate}"
                                                          Margin="26,2,0,6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="FixedExtrasSep" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                                    Margin="10,4,0,2" Visibility="Collapsed"/>
                            <Grid x:Name="FixedExtrasSubtotalRow" Margin="10,2,0,6" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FixedExtrasSubtotal" Grid.Column="1"
                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="FixedExtrasHrsSubtotal" Grid.Column="2"
                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Absorbed Extras (contract work tracked separately) -->
                            <TextBlock x:Name="AbsorbedExtrasHeader" Text="TRACKED WORK (FIXED FEE)" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,6,0,4"
                                       Visibility="Collapsed"/>
                            <ItemsControl x:Name="AbsorbedExtrasList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="10,1,0,1" Cursor="Hand"
                                                  MouseLeftButtonUp="HourlyExtra_DrillDown"
                                                  Background="{Binding RowBackground, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="65"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#x25B6;" FontSize="8"
                                                           Foreground="#9CA3AF" VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                                <TextBlock Grid.Column="2" Text="—" FontSize="11"
                                                           HorizontalAlignment="Right" Foreground="#D1D5DB"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DisplayHours, Mode=OneWay}"
                                                           FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding EmployeeBreakdown}"
                                                          Visibility="{Binding DrillDownVisibility, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource EmployeeDrillDownTemplate}"
                                                          Margin="26,2,0,6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="AbsorbedExtrasSep" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                                    Margin="10,4,0,2" Visibility="Collapsed"/>
                            <Grid x:Name="AbsorbedExtrasSubtotalRow" Margin="10,2,0,6" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="—" FontSize="11"
                                           HorizontalAlignment="Right" Foreground="#D1D5DB"/>
                                <TextBlock x:Name="AbsorbedExtrasHrsSubtotal" Grid.Column="2"
                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Fixed Fee Total -->
                            <Border BorderBrush="#9CA3AF" BorderThickness="0,1,0,0" Margin="0,4,0,6"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fixed Fee Total" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FixedFeeTotal" Grid.Column="1"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="FixedFeeHrsTotal" Grid.Column="2"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="FixedFeePerHrTotal" Grid.Column="3"
                                           FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="#6B7280"/>
                            </Grid>

                            <!-- Hourly Extras with drill-down -->
                            <TextBlock x:Name="HourlyExtrasHeader" Text="HOURLY EXTRAS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,14,0,4"
                                       Visibility="Collapsed"/>
                            <ItemsControl x:Name="HourlyExtrasList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="10,1,0,1" Cursor="Hand"
                                                  MouseLeftButtonUp="HourlyExtra_DrillDown"
                                                  Background="{Binding RowBackground, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#x25B6;" FontSize="8"
                                                           Foreground="#9CA3AF" VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DisplayAmount, Mode=OneWay}"
                                                           FontSize="11" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DisplayHours, Mode=OneWay}"
                                                           FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding EmployeeBreakdown}"
                                                          Visibility="{Binding DrillDownVisibility, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource EmployeeDrillDownTemplate}"
                                                          Margin="26,2,0,6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="HourlyExtrasSep" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                                    Margin="10,4,0,2" Visibility="Collapsed"/>
                            <Grid x:Name="HourlyExtrasSubtotalRow" Margin="10,2,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HourlyExtrasSubtotal" Grid.Column="1"
                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="HourlyExtrasHoursTotal" Grid.Column="2"
                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Grand Total -->
                            <Border BorderBrush="#374151" BorderThickness="0,2,0,0" Margin="0,10,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTAL PROJECT VALUE" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="GrandTotal" Grid.Column="1"
                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="GrandTotalHours" Grid.Column="2"
                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"
                                           Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock x:Name="GrandTotalFeePerHr" Grid.Column="3"
                                           FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                                           Foreground="#6B7280"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Risk Drivers -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Risk Drivers" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoIconBorder}"
                                    Margin="8,0,0,0"
                                    ToolTip="{fin:FinancialMetricTooltip Key=RiskDrivers}">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding RiskDrivers}" Visibility="{Binding RiskDriversVisibility}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource Panel.Border}">
                                            <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding}" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No active delivery risks detected."
                                   Foreground="{StaticResource Text.Secondary}"
                                   Visibility="{Binding NoRiskDriversVisibility}"/>
                    </StackPanel>
                </Border>



                <!-- SECTION 2: Discipline Breakdown -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Discipline Breakdown" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ItemsSource="{Binding Disciplines}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Discipline" Binding="{Binding Discipline}" Width="*"/>
                                <DataGridTextColumn Header="Hours" Binding="{Binding Hours, StringFormat={}{0:N1}}" Width="140"/>
                                <DataGridTextColumn Header="% of Total" Binding="{Binding PercentOfTotal, StringFormat={}{0:P1}}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2b: Team Breakdown -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                    <Expander x:Name="TeamBreakdownExpander"
                              Header="Team Breakdown"
                              IsExpanded="False"
                              Expanded="TeamBreakdownExpander_Expanded">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock x:Name="TeamBreakdownStatus"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <DataGrid x:Name="TeamBreakdownGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*"/>
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat={}{0:N1}}" Width="140"/>
                                    <DataGridTextColumn Header="% of Project Total" Binding="{Binding PercentOfProject, StringFormat={}{0:P1}}" Width="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- SECTION 3: Health Indicators -->
                <Border Style="{StaticResource Card}" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Health Indicators" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoIconBorder}"
                                    Margin="8,0,0,0"
                                    ToolTip="{fin:FinancialMetricTooltip Key=HealthIndicators}">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding BurnRiskVisibility}">
                            <TextBlock Text="Burn Risk" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoIconBorder}"
                                    Margin="8,0,0,0"
                                    ToolTip="{fin:FinancialMetricTooltip Key=BurnRisk}">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="🔥 Over Budget" Visibility="{Binding OverBudgetVisibility}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Text=" Overbilled" Visibility="{Binding OverbilledVisibility}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

