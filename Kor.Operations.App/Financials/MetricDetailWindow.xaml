                                        <DataGridTextColumn Header="Invoiced" Binding="{Binding BilledText}" Width="110">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Unbilled Gap" Binding="{Binding UnbilledText}" Width="115">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Billed/Earned" Binding="{Binding BilledVsRevenueText}" Width="105">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="AR/Invoiced" Binding="{Binding ArVsBilledText}" Width="105">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="AR Outstanding" Binding="{Binding ArOutstandingText}" Width="120">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <Button Content="Prev"
                                            Width="70"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding CanGoToPreviousTrendPayerPage}"
                                            Click="PreviousTrendPayerPage_Click"/>
                                    <TextBlock Text="{Binding TrendPayerPageText}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Text.Secondary}"
                                               FontSize="11"
                                               Margin="0,0,8,0"/>
                                    <Button Content="Next"
                                            Width="70"
                                            IsEnabled="{Binding CanGoToNextTrendPayerPage}"
                                            Click="NextTrendPayerPage_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Expander Header="Technical Query" Margin="0,14,0,0" Visibility="{Binding TechnicalQueryVisibility}">
                            <Border Background="#0A000000" CornerRadius="8" Padding="10" Margin="0,6,0,0">
                                <TextBox Text="{Binding TechnicalQueryText, Mode=OneWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource Text.Secondary}"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Text="Tip: use Copy summary to paste into email/Teams."
                           Foreground="{StaticResource Text.Secondary}"
                           FontSize="11"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copy summary" MinWidth="120" Margin="0,0,10,0" Click="CopySummary_Click"/>
            <Button Content="Close" MinWidth="90" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
