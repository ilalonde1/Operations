<Window x:Class="Kor.Operations.Financials.FinancialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:fin="clr-namespace:Kor.Operations.Financials"
        Title="KOR NewerForma - Financials"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1650"
        MinWidth="1400"
        Height="900"
        SizeToContent="Manual"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ToolTipService.InitialShowDelay="200">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <fin:RevenueBarHeightConverter x:Key="BarHeight" MaxHeight="110"/>
        <fin:BoolToActualLabelConverter x:Key="BoolToActualLabel"/>
        <!-- Accent launcher button style (matches PM Tools) — used for standalone-window launchers. -->
        <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="i"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTabButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8FAFC"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#FFF8FAFC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFF1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <controls:KorHeader x:Name="HeaderBar"
                                HeaderText="Financials"
                                SubtitleText="Real-time portfolio financial health, delivery risk, and budget performance."
                                AvatarDiameter="96"
                                AvatarBorderThickness="2"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Grid>
                 <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                 </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Last refreshed:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastRefreshedDisplay}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusHint}" Margin="16,0,0,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    <Border Margin="16,0,0,0" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scope:" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="Watchlist" Height="28" MinWidth="75" FontSize="11" Margin="0,0,4,0"
                                    Click="ScopeWatchlist_Click"
                                    ToolTip="Show only projects on the Deltek watchlist (default)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWatchlistOnly}" Value="True">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="All Active" Height="28" MinWidth="75" FontSize="11"
                                    Click="ScopeAllActive_Click"
                                    ToolTip="Show ALL active projects, including those not on the watchlist">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllActive}" Value="True">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Budget estimation rates (editable) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                ToolTipService.ShowDuration="30000">
                        <StackPanel.ToolTip>
                            <StackPanel MaxWidth="380">
                                <TextBlock Text="Budget Estimation" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4">
                                    <Run FontWeight="SemiBold">Primary:</Run><Run Text=" Peer-based — median hours from similar completed projects (fee ±50%, same construction type/phase, 50+ hrs, top 8 by fee proximity)."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4">
                                    <Run FontWeight="SemiBold">Fallback:</Run><Run Text=" Formula — (Fee / Target) × (Combined / Rate). Only used when fewer than 3 peers found."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#6B7280" Margin="0,0,0,4">
                                    These rates only affect the formula fallback. Most projects use peer-based estimates. Eng/Draft rates control the 58%/42% split. Target = portfolio median $/hr.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" FontStyle="Italic" Foreground="#9CA3AF">
                                    Only affects estimated budgets (purple in grids). Projects with Deltek PRLabor hours are never affected.
                                </TextBlock>
                            </StackPanel>
                        </StackPanel.ToolTip>
                        <TextBlock Text="Eng:" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBox Width="42" Height="26" FontSize="11" VerticalContentAlignment="Center" Padding="3,0"
                                 Text="{Binding EngRate, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"/>
                        <TextBlock Text="Draft:" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="8,0,3,0"/>
                        <TextBox Width="42" Height="26" FontSize="11" VerticalContentAlignment="Center" Padding="3,0"
                                 Text="{Binding DraftRate, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"/>
                        <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Run Text="="/>
                            <Run Text="{Binding CombinedRate, Mode=OneWay, StringFormat={}{0:0}}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="Target:" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="8,0,3,0"/>
                        <TextBox Width="42" Height="26" FontSize="11" VerticalContentAlignment="Center" Padding="3,0"
                                 Text="{Binding TargetBilling, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"/>
                        <!-- Budget Mode toggle -->
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Margin="12,0,0,0" Height="26">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BudgetModePeer" Content="Peer-Based" FontSize="10" VerticalContentAlignment="Center"
                                             Padding="6,0,6,0" IsChecked="{Binding IsPeerBudgetMode}"
                                             ToolTip="Budgets based on how long similar completed projects actually took. The Target rate is only used as a fallback when fewer than 3 peers are found."
                                             Style="{StaticResource {x:Type RadioButton}}"/>
                                <Border BorderBrush="#D1D5DB" BorderThickness="1,0,0,0"/>
                                <RadioButton x:Name="BudgetModeTarget" Content="Target Rate" FontSize="10" VerticalContentAlignment="Center"
                                             Padding="6,0,6,0" IsChecked="{Binding IsTargetRateBudgetMode}"
                                             ToolTip="Budgets calculated from Total Fee ÷ Target Rate for every project. Change the Target number and Recalculate to see the impact."
                                             Style="{StaticResource {x:Type RadioButton}}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Recalculate" Height="26" MinWidth="85" Margin="8,0,0,0" FontSize="10.5"
                                Click="RecalculateBtn_Click"
                                ToolTip="Apply these rates and budget mode, then refresh all metrics.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="KpiDictionaryBtn" Grid.Column="1"
                        Content="KPI Dictionary"
                        MinWidth="150"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="MetricDictionaryBtn_Click"/>

                <Button x:Name="DumpSchemaBtn" Grid.Column="2"
                        Content="Dump Deltek Schema"
                        MinWidth="170"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="DumpDeltekSchemaBtn_Click"/>

                <Button Grid.Column="3"
                        Content="Refresh"
                        Width="96"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="RefreshBtn_Click"
                        IsEnabled="{Binding CanRefresh}"/>

                <Button Grid.Column="4"
                        Content="Close"
                        Width="84"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="CloseBtn_Click"/>
             </Grid>
         </Border>

        <StackPanel Grid.Row="2">
            <Border Background="#FFFEF3C7"
                    BorderBrush="#FFF59E0B"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,8"
                    Visibility="{Binding PostingLagVisibility}">
                <TextBlock Text="{Binding PostingLagBanner}"
                           Foreground="#FF92400E"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- Error banner (collapsed unless error) -->
            <Border Background="#FFFDE8E8"
                    BorderBrush="#FFCC5C5C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,8"
                    Visibility="{Binding ErrorVisibility}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Section Switcher + Content -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="SectionSwitcherCard" Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <Border Background="#FFFFFFFF"
                        BorderBrush="{StaticResource Panel.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Overview"
                                MinWidth="150"
                                Click="ShowCommandCenter_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCommandCenterSelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource Panel.Border}"/>

                        <Button Grid.Column="2"
                                Content="Executive Summary"
                                MinWidth="170"
                                Click="ShowExecutiveSummary_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExecutiveSummarySelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="3" Width="1" Background="{StaticResource Panel.Border}"/>

                        <Button Grid.Column="4"
                                Content="P&amp;L Report"
                                MinWidth="130"
                                Click="PnLReportBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfitLossSelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="5" Width="1" Background="{StaticResource Panel.Border}"/>

                        <Button Grid.Column="6"
                                Content="Billings by Manager"
                                MinWidth="165"
                                Click="ShowBillingManagerReport_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBillingManagerSelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="7" Width="1" Background="{StaticResource Panel.Border}"/>

                        <Button Grid.Column="8"
                                Content="Clients"
                                MinWidth="120"
                                Click="ShowClients_Click"
                                ToolTip="Lifetime client analytics — fee, billings, AR aging, and project history per client.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClientsSelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="9" Width="1" Background="{StaticResource Panel.Border}"/>

                        <Button Grid.Column="10"
                                Content="Revenue Forecast"
                                MinWidth="155"
                                Click="ShowForecast_Click"
                                ToolTip="24 months of revenue history plus a 12-month forecast based on current pace and active project backlog.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsForecastSelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Sensitive-data launchers — separate windows, not section tabs -->
                        <Button Grid.Column="12"
                                Content="Staff Utilization"
                                MinWidth="140"
                                Height="32"
                                Margin="0,4,6,4"
                                Style="{StaticResource Button.Accent}"
                                Click="StaffUtilizationBtn_Click"
                                ToolTip="Open the Staff Utilization window — per-employee rolling 12-week hours and utilization vs. 37.5 hr/wk target."/>
                        <Button Grid.Column="13"
                                Content="Historical"
                                MinWidth="110"
                                Height="32"
                                Margin="0,4,4,4"
                                Style="{StaticResource Button.Accent}"
                                Click="HistoricalAnalyticsBtn_Click"
                                ToolTip="Open Historical Project Analytics — eng/draft hour breakdown and peer comparison across all projects with fee."/>
                    </Grid>
                </Border>
            </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding NonClientsVisibility}">
                    <Grid>
                        <!-- Existing Command Center content -->
                        <Grid Visibility="{Binding CommandCenterVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>

                        <!-- Keep DataGrids out of the ScrollViewer (virtualization/perf), but allow the
                             top summary/portfolio panels to scroll when the window is short. -->
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,8">
                            <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"
                                ToolTipService.InitialShowDelay="250"
                                ToolTipService.ShowDuration="20000">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="Projects" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Headline.Projects}" FontWeight="SemiBold" FontSize="18"/>
                            <!-- Budget mode pill -->
                            <Border CornerRadius="8" Padding="8,2,8,2" Margin="10,4,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding BudgetModePillVisibility}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTargetRateBudgetMode}" Value="True">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="9" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Peer Median"/>
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                            <Setter Property="ToolTip" Value="Budgets based on how long similar completed projects actually took."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTargetRateBudgetMode}" Value="True">
                                                    <Setter Property="Text" Value="Target Rate"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Setter Property="ToolTip" Value="Budgets calculated from Total Fee ÷ Target Rate. User controlled."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=TotalFees}" Cursor="Hand">
                            <TextBlock Text="Total Fees (lifetime)" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.TotalFees, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=TotalFeeBilled}" Cursor="Hand">
                            <TextBlock Text="Total Fee Billed (lifetime)" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.TotalFeeBilledWithUnposted, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Headline.HasUnpostedBilling}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Setter Property="Foreground" Value="#92400E"/>
                                            <Setter Property="ToolTip" Value="Italic + amber: includes invoices issued in Deltek AR but not yet posted to PRSummaryMain. Once posting catches up, the styling clears and the value matches posted figures."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursSpent}" Cursor="Hand">
                            <TextBlock Text="Hours Spent" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
