                            </Grid>
                        </Border>

            <!-- Portfolio Delivery Health -->
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"
                    Visibility="{Binding PortfolioVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Portfolio Delivery Health" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource InfoIconBorder}"
                                        Margin="8,0,0,0"
                                        ToolTip="{fin:FinancialMetricTooltip Key=PortfolioDeliveryHealth}">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                        </Border>
                            </StackPanel>
                            <TextBlock Text="Shows how many projects are financially stable versus trending toward risk."
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="11"
                                       Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Ellipse Width="8" Height="8" Fill="#166534" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="High Confidence" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Ellipse Width="8" Height="8" Fill="#A16207" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Watch" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#B91C1C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Critical" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Cursor="Hand"
                                        ToolTip="{fin:FinancialMetricTooltip Key=PortfolioRiskExposure}">
                                <TextBlock Text="Portfolio Risk Exposure" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource InfoIconBorder}" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PortfolioRiskExposureFee, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Height="26">
                        <Grid.Resources>
                            <fin:PercentToStarGridLengthConverter x:Key="PctToStar"/>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding PortfolioCriticalPct, Converter={StaticResource PctToStar}}"/>
                            <ColumnDefinition Width="{Binding PortfolioAtRiskPct, Converter={StaticResource PctToStar}}"/>
                            <ColumnDefinition Width="{Binding PortfolioStablePct, Converter={StaticResource PctToStar}}"/>
                            <ColumnDefinition Width="{Binding PortfolioHighConfidencePct, Converter={StaticResource PctToStar}}"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FEE2E2"
                                CornerRadius="6,0,0,6">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{Binding PortfolioCriticalCount, StringFormat={}{0} projects - Critical}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{fin:FinancialMetricTooltip Key=CriticalProjects}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#B91C1C" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PortfolioCriticalCount}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#FEF3C7">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{Binding PortfolioAtRiskCount, StringFormat={}{0} projects - At Risk}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{fin:FinancialMetricTooltip Key=WatchProjects}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#A16207" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PortfolioAtRiskCount}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#E5E7EB">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{Binding PortfolioStableCount, StringFormat={}{0} projects - Stable}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{fin:FinancialMetricTooltip Key=WatchProjects}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#6B7280" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PortfolioStableCount}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#DCFCE7"
                                CornerRadius="0,6,6,0">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{Binding PortfolioHighConfidenceCount, StringFormat={}{0} projects - High Confidence}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{fin:FinancialMetricTooltip Key=HealthyProjects}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#166534" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PortfolioHighConfidenceCount}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
                    <DataGrid x:Name="FinancialsGrid"
                              MaxHeight="520"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MouseDoubleClick="FinancialsGrid_MouseDoubleClick"
                              ItemsSource="{Binding Rows}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HealthStatus}" Value="Critical">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HealthStatus}" Value="At Risk">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HealthStatus}" Value="Watch">
                                        <Setter Property="Background" Value="#FEF9C3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HealthStatus}" Value="High Confidence">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Hotlist" Width="60" SortMemberPath="IsOnHotlist">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Toggle Deltek Hotlist (CustWatchlist) — click to add/remove project. Changes sync to Deltek within ~5 seconds."/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="HotlistCellBorder" CornerRadius="3" Padding="0" BorderThickness="1" BorderBrush="Transparent">
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsOnHotlist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="HotlistCheckbox_Click"
                                                      ToolTip="{Binding HotlistSyncError, FallbackValue='Toggle Hotlist (syncs to Deltek)'}"/>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHotlistSyncing}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasHotlistError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#DC2626"/>
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static fin:DisplayTerms.ProjectNumber}" Binding="{Binding Wbs1}" Width="110"
                                                ToolTipService.ToolTip="Deltek project number (WBS1)"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"
                                                ToolTipService.ToolTip="Project name from Deltek"/>
                            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="110"
                                                ToolTipService.ToolTip="Current project phase (SD/DD/CD/CA) from ProjectCustomTabFields"/>
                            <DataGridTextColumn Header="PM" Binding="{Binding Pm}" Width="160"
                                                ToolTipService.ToolTip="Project Manager assigned in Deltek"/>
                            <DataGridTextColumn Header="Drafting Manager" Binding="{Binding DraftingManager}" Width="140"
                                                ToolTipService.ToolTip="Drafting Manager assigned in ProjectCustomTabFields"/>
                            <DataGridTextColumn Header="Construction Type" Binding="{Binding ConstructionType}" Width="150"
                                                ToolTipService.ToolTip="Construction type (Woodframe, Concrete, Steel, etc.) from ProjectCustomTabFields"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding ProjectCategory}" Width="100"
                                                ToolTipService.ToolTip="Project category from ProjectCustomTabFields"/>
                            <DataGridTextColumn Header="Drafting Type" Binding="{Binding DraftingType}" Width="85"
                                                ToolTipService.ToolTip="Drafting type from ProjectCustomTabFields"/>

                            <DataGridTextColumn x:Name="ColFee" Header="Total Fee" Binding="{Binding TotalFee, StringFormat={}{0:C0}}" Width="110"
                                                ToolTipService.ToolTip="Total project fee: fixed contract plus any hourly extras revenue."/>
                            <DataGridTextColumn x:Name="ColFeeBilled" Header="Fee Billed"
                                                Binding="{Binding FeeBilledWithUnposted, StringFormat={}{0:C0}}" Width="110"
                                                ToolTipService.ToolTip="Total fee billed to date. Includes invoices issued but not yet posted to Deltek (italic + amber when unposted billings are folded in).">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource UnpostedBillingCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Sub Cost" Binding="{Binding SubconsultantCost, StringFormat={}{0:C0}}" Width="100"
                                                ToolTipService.ToolTip="Total subconsultant costs (accounts payable) charged to this project"/>
                            <DataGridTextColumn x:Name="ColPercentBilled"
                                                Binding="{Binding PercentBilledWithUnposted, StringFormat={}{0:P1}}" Width="90">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PercentBilled}" Cursor="Hand">
                                        <TextBlock Text="% Billed"/>
                                        <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                            <TextBlock Style="{StaticResource InfoIconText}"/>
                                        </Border>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource UnpostedBillingCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Eng" Binding="{Binding EngHrs, StringFormat={}{0:N1}}" Width="70"
                                                ToolTipService.ToolTip="Engineering hours spent (includes checking hours)"/>
                            <DataGridTextColumn Header="Draft" Binding="{Binding DraftHrs, StringFormat={}{0:N1}}" Width="70"
                                                ToolTipService.ToolTip="Drafting hours spent"/>
                            <DataGridTextColumn Header="Insp" Binding="{Binding InspHrs, StringFormat={}{0:N1}}" Width="70"
                                                ToolTipService.ToolTip="Inspection hours spent (LaborCode 40)"/>
                            <DataGridTextColumn Header="# Insp" Binding="{Binding TotalInspections}" Width="55"
                                                ToolTipService.ToolTip="Total number of site inspections (count of time entries with LaborCode 40)"/>
                            <DataGridTextColumn Header="# Last Mo" Binding="{Binding LastMonthInspections}" Width="65"
                                                ToolTipService.ToolTip="Number of inspections in the previous calendar month"/>

                            <DataGridTextColumn Header="Draft Budget" Binding="{Binding DraftBudget, StringFormat={}{0:N1}}" Width="110"
                                                ToolTipService.ToolTip="Estimated drafting hours for this project."/>
                            <DataGridTextColumn Header="Eng Budget" Binding="{Binding EngBudget, StringFormat={}{0:N1}}" Width="110"
                                                ToolTipService.ToolTip="Estimated engineering hours for this project."/>
                            <DataGridTextColumn Header="Budget Src" Binding="{Binding BudgetSource}" Width="85"
                                                ToolTipService.ToolTip="Where the budget estimate comes from: Deltek (entered in Vantagepoint), Peers (median of similar closed projects), or Formula (fee ÷ target rate). Only Formula budgets are affected by the Target rate setting."/>
                            <DataGridTextColumn Header="Draft%" Binding="{Binding DraftPercent, StringFormat={}{0:P1}}" Width="90"
                                                ToolTipService.ToolTip="Drafting hours spent as % of drafting budget"/>
                            <DataGridTextColumn Header="Eng%" Binding="{Binding EngPercent, StringFormat={}{0:P1}}" Width="90"
                                                ToolTipService.ToolTip="Engineering hours spent as % of engineering budget"/>

                            <DataGridTextColumn x:Name="ColFeePerHours" Header="Fee/Hours" Binding="{Binding FeePerHours, StringFormat={}{0:C2}}" Width="110"
                                                ToolTipService.ToolTip="Fee ÷ production hours (eng + draft + insp). Effective billing rate."/>
                            <DataGridTextColumn x:Name="ColBilledPerHours" Header="Billed/Hours" Binding="{Binding BilledPerHoursWithUnposted, StringFormat={}{0:C2}}" Width="110"
                                                ToolTipService.ToolTip="Fee billed ÷ total hours (all labor codes). Revenue earned per hour worked. Italic + amber when invoices issued but not yet posted to Deltek are folded in.">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource UnpostedBillingCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="5"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Cursor="SizeNS"
                              Background="{StaticResource Panel.Border}"/>

