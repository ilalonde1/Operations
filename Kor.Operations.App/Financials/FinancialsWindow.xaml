<Window x:Class="Kor.Operations.Financials.FinancialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:fin="clr-namespace:Kor.Operations.Financials"
        Title="KOR NewerForma - Financials"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Width="1650"
        MinWidth="1400"
        Height="900"
        SizeToContent="Manual"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ToolTipService.InitialShowDelay="200">

    <Window.Resources>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="i"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTabButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8FAFC"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#FFF8FAFC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFF1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <controls:KorHeader x:Name="HeaderBar"
                                HeaderText="Financials"
                                SubtitleText="Real-time portfolio financial health, delivery risk, and budget performance."
                                AvatarDiameter="96"
                                AvatarBorderThickness="2"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Grid>
                 <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                 </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Last refreshed:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastRefreshedDisplay}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusHint}" Margin="16,0,0,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="KpiDictionaryBtn" Grid.Column="1"
                        Content="KPI Dictionary"
                        MinWidth="150"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="MetricDictionaryBtn_Click"/>

                <Button x:Name="DumpSchemaBtn" Grid.Column="2"
                        Content="Dump Deltek Schema"
                        MinWidth="170"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="DumpDeltekSchemaBtn_Click"/>

                <Button Grid.Column="3"
                        Content="Refresh"
                        Width="96"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="RefreshBtn_Click"
                        IsEnabled="{Binding CanRefresh}"/>

                <Button Grid.Column="4"
                        Content="Close"
                        Width="84"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Click="CloseBtn_Click"/>
             </Grid>
         </Border>

        <!-- Error banner (collapsed unless error) -->
        <Border Grid.Row="2"
                Background="#FFFDE8E8"
                BorderBrush="#FFCC5C5C"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,8"
                Visibility="{Binding ErrorVisibility}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
        </Border>

        <!-- Section Switcher + Content -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="SectionSwitcherCard" Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <Border Background="#FFFFFFFF"
                        BorderBrush="{StaticResource Panel.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Overview"
                                MinWidth="150"
                                Click="ShowCommandCenter_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCommandCenterSelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource Panel.Border}"/>

                        <Button Grid.Column="2"
                                Content="Executive Summary"
                                MinWidth="170"
                                Click="ShowExecutiveSummary_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExecutiveSummarySelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="3" Width="1" Background="{StaticResource Panel.Border}"/>

                        <Button Grid.Column="4"
                                Content="P&amp;L Report"
                                MinWidth="130"
                                Click="PnLReportBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfitLossSelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="5" Width="1" Background="{StaticResource Panel.Border}"/>

                        <Button Grid.Column="6"
                                Content="Billings by Manager"
                                MinWidth="165"
                                Click="ShowBillingManagerReport_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBillingManagerSelected}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#FFFFE0B2"/>
                                            <Setter Property="Foreground" Value="#FF8A4B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- Existing Command Center content -->
                        <Grid Visibility="{Binding CommandCenterVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>

                        <!-- Keep DataGrids out of the ScrollViewer (virtualization/perf), but allow the
                             top summary/portfolio panels to scroll when the window is short. -->
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,8">
                            <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"
                                ToolTipService.InitialShowDelay="250"
                                ToolTipService.ShowDuration="20000">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="Projects" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                        <TextBlock Text="{Binding Headline.Projects}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=TotalFees}" Cursor="Hand">
                            <TextBlock Text="Total Fees" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.TotalFees, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=TotalFeeBilled}" Cursor="Hand">
                            <TextBlock Text="Total Fee Billed" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.TotalFeeBilled, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,18,0">
                        <TextBlock Text="Total GFA" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                        <TextBlock Text="{Binding Headline.TotalGfa, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursSpent}" Cursor="Hand">
                            <TextBlock Text="Hours Spent" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.HoursSpent, StringFormat={}{0:N1}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursBudgeted}" Cursor="Hand">
                            <TextBlock Text="Hours Budgeted" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.HoursBudgeted, StringFormat={}{0:N1}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=TotalUnbilled}" Cursor="Hand">
                            <TextBlock Text="Total Unbilled" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.TotalUnbilled, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="7" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PercentFeeUnbilled}" Cursor="Hand">
                            <TextBlock Text="% Fee Unbilled" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.PercentFeeUnbilled, StringFormat={}{0:P1}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=AvgFeePerFt2}" Cursor="Hand">
                            <TextBlock Text="Avg Fee per ft" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.AvgFeePerFt2, StringFormat={}{0:C2}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="9" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=HoursRemaining}" Cursor="Hand">
                            <TextBlock Text="Hours Remaining" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.HoursRemaining, StringFormat={}{0:N1}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="10" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PercentHoursSpent}" Cursor="Hand">
                            <TextBlock Text="% Hours Spent" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.PercentHoursSpent, StringFormat={}{0:P1}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="11" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=TeamDaysRemaining}" Cursor="Hand">
                            <TextBlock Text="Team-Days Remaining" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource InfoIconText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Headline.TeamDaysRemaining, StringFormat={}{0:N2}}" FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                            </Grid>
                        </Border>

            <!-- Portfolio Delivery Health -->
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"
                    Visibility="{Binding PortfolioVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Portfolio Delivery Health" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource InfoIconBorder}"
                                        Margin="8,0,0,0"
                                        ToolTip="{fin:FinancialMetricTooltip Key=PortfolioDeliveryHealth}">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                        </Border>
                            </StackPanel>
                            <TextBlock Text="Shows how many projects are financially stable versus trending toward risk."
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="11"
                                       Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Ellipse Width="8" Height="8" Fill="#166534" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="High Confidence" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Ellipse Width="8" Height="8" Fill="#A16207" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Watch" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#B91C1C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Critical" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Cursor="Hand"
                                        ToolTip="{fin:FinancialMetricTooltip Key=PortfolioRiskExposure}">
                                <TextBlock Text="Portfolio Risk Exposure" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource InfoIconBorder}" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource InfoIconText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PortfolioRiskExposureFee, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Height="26">
                        <Grid.Resources>
                            <fin:PercentToStarGridLengthConverter x:Key="PctToStar"/>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding PortfolioCriticalPct, Converter={StaticResource PctToStar}}"/>
                            <ColumnDefinition Width="{Binding PortfolioAtRiskPct, Converter={StaticResource PctToStar}}"/>
                            <ColumnDefinition Width="{Binding PortfolioStablePct, Converter={StaticResource PctToStar}}"/>
                            <ColumnDefinition Width="{Binding PortfolioHighConfidencePct, Converter={StaticResource PctToStar}}"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FEE2E2"
                                CornerRadius="6,0,0,6">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{Binding PortfolioCriticalCount, StringFormat={}{0} projects - Critical}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{fin:FinancialMetricTooltip Key=CriticalProjects}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#B91C1C" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PortfolioCriticalCount}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#FEF3C7">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{Binding PortfolioAtRiskCount, StringFormat={}{0} projects - At Risk}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{fin:FinancialMetricTooltip Key=WatchProjects}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#A16207" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PortfolioAtRiskCount}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#E5E7EB">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{Binding PortfolioStableCount, StringFormat={}{0} projects - Stable}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{fin:FinancialMetricTooltip Key=WatchProjects}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#6B7280" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PortfolioStableCount}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#DCFCE7"
                                CornerRadius="0,6,6,0">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{Binding PortfolioHighConfidenceCount, StringFormat={}{0} projects - High Confidence}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{fin:FinancialMetricTooltip Key=HealthyProjects}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#166534" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PortfolioHighConfidenceCount}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
                    <DataGrid x:Name="FinancialsGrid"
                              MaxHeight="520"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MouseDoubleClick="FinancialsGrid_MouseDoubleClick"
                              ItemsSource="{Binding Rows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static fin:DisplayTerms.ProjectNumber}" Binding="{Binding Wbs1}" Width="110"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="110"/>
                            <DataGridTextColumn Header="PM" Binding="{Binding Pm}" Width="160"/>

                            <DataGridTextColumn Header="GFA" Binding="{Binding Gfa, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn x:Name="ColFee" Header="Fee" Binding="{Binding Fee, StringFormat={}{0:C0}}" Width="110"/>
                            <DataGridTextColumn x:Name="ColFeeBilled" Header="Fee Billed" Binding="{Binding FeeBilled, StringFormat={}{0:C0}}" Width="110"/>
                            <DataGridTextColumn x:Name="ColPercentBilled" Binding="{Binding PercentBilled, StringFormat={}{0:P1}}" Width="90">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" ToolTip="{fin:FinancialMetricTooltip Key=PercentBilled}" Cursor="Hand">
                                        <TextBlock Text="% Billed"/>
                                        <Border Style="{StaticResource InfoIconBorder}" Margin="6,0,0,0">
                                            <TextBlock Style="{StaticResource InfoIconText}"/>
                                        </Border>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Eng" Binding="{Binding EngHrs, StringFormat={}{0:N1}}" Width="70"/>
                            <DataGridTextColumn Header="Draft" Binding="{Binding DraftHrs, StringFormat={}{0:N1}}" Width="70"/>
                            <DataGridTextColumn Header="Chk" Binding="{Binding ChkHrs, StringFormat={}{0:N1}}" Width="70"/>
                            <DataGridTextColumn Header="Insp" Binding="{Binding InspHrs, StringFormat={}{0:N1}}" Width="70"/>

                            <DataGridTextColumn Header="Draft Budget" Binding="{Binding DraftBudget, StringFormat={}{0:N1}}" Width="110"/>
                            <DataGridTextColumn Header="Eng Budget" Binding="{Binding EngBudget, StringFormat={}{0:N1}}" Width="110"/>
                            <DataGridTextColumn Header="Draft%" Binding="{Binding DraftPercent, StringFormat={}{0:P1}}" Width="90"/>
                            <DataGridTextColumn Header="Eng%" Binding="{Binding EngPercent, StringFormat={}{0:P1}}" Width="90"/>

                            <DataGridTextColumn x:Name="ColFeePerHours" Header="Fee/Hours" Binding="{Binding FeePerHours, StringFormat={}{0:C2}}" Width="110"/>
                            <DataGridTextColumn x:Name="ColBilledPerHours" Header="Billed/Hours" Binding="{Binding BilledPerHours, StringFormat={}{0:C2}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="5"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Cursor="SizeNS"
                              Background="{StaticResource Panel.Border}"/>

                <!-- Utilization analysis -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CapacityRiskTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CapacityRiskSubtitle}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="11"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#FFFFFFFF"
                                    BorderBrush="{StaticResource Panel.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Engineering"
                                            MinWidth="130"
                                            Click="ShowEngineeringCapacityRisk_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEngineeringCapacitySelected}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Background" Value="#FFFFE0B2"/>
                                                        <Setter Property="Foreground" Value="#FF8A4B00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Border Grid.Column="1" Width="1" Background="{StaticResource Panel.Border}"/>

                                    <Button Grid.Column="2"
                                            Content="Drafting"
                                            MinWidth="110"
                                            Click="ShowDraftingCapacityRisk_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDraftingCapacitySelected}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Background" Value="#FFFFE0B2"/>
                                                        <Setter Property="Foreground" Value="#FF8A4B00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Filter bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="PM" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                <ComboBox Width="210"
                                          MinHeight="32"
                                          ItemsSource="{Binding UtilizationPmOptions}"
                                          SelectedItem="{Binding SelectedUtilizationPm}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="Risk" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                <ComboBox Width="160"
                                          MinHeight="32"
                                          ItemsSource="{Binding UtilizationRiskOptions}"
                                          SelectedItem="{Binding SelectedUtilizationRisk}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                <TextBlock Text="Search" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                <TextBox Width="280"
                                         MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding UtilizationSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                                <Button Content="Export to Excel"
                                        Height="32"
                                        MinWidth="140"
                                        Click="ExportUtilizationBtn_Click"
                                        IsEnabled="{Binding CanExportUtilization}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="UtilizationGrid"
                                  Grid.Row="2"
                                  MaxHeight="520"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Disabled"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  RowHeight="28"
                                  ItemsSource="{Binding UtilizationView}"
                                  MouseDoubleClick="UtilizationGrid_MouseDoubleClick">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineeringCapacitySelected}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="Util.Row.Red" Color="#FEE2E2"/>
                                <SolidColorBrush x:Key="Util.Row.Amber" Color="#FEF3C7"/>
                                <SolidColorBrush x:Key="Util.Row.Green" Color="#DCFCE7"/>

                                <SolidColorBrush x:Key="Util.Conf.Red" Color="#B91C1C"/>
                                <SolidColorBrush x:Key="Util.Conf.Orange" Color="#C2410C"/>
                                <SolidColorBrush x:Key="Util.Conf.Yellow" Color="#A16207"/>
                                <SolidColorBrush x:Key="Util.Conf.Green" Color="#166534"/>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="Over budget">
                                            <Setter Property="Background" Value="{StaticResource Util.Row.Red}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="At risk">
                                            <Setter Property="Background" Value="{StaticResource Util.Row.Amber}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="Healthy">
                                            <Setter Property="Background" Value="{StaticResource Util.Row.Green}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="260"/>
                                <DataGridTextColumn Header="PM" Binding="{Binding Pm}" Width="160"/>
                                <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="110"/>
                                <DataGridTextColumn Header="Eng Budget" Binding="{Binding EngBudget, StringFormat={}{0:N1}}" Width="110"/>
                                <DataGridTextColumn Header="Eng Hours" Binding="{Binding EngHours, StringFormat={}{0:N1}}" Width="110"/>
                                <DataGridTextColumn Header="Remaining Engineering Hours" Binding="{Binding RemainingEngHours, StringFormat={}{0:N1}}" Width="120"/>
                                <DataGridTextColumn Header="Engineering Budget Used (%)" Binding="{Binding PercentEngUsed, StringFormat={}{0:P1}}" Width="100"/>
                                <DataGridTemplateColumn Header="Delivery Risk" Width="150" SortMemberPath="ConfidenceLevel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        ToolTip="{Binding DeliveryConfidenceTooltip}">
                                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource Util.Conf.Green}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                    <Setter Property="Fill" Value="{StaticResource Util.Conf.Red}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                    <Setter Property="Fill" Value="{StaticResource Util.Conf.Orange}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                    <Setter Property="Fill" Value="{StaticResource Util.Conf.Yellow}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                                                    <Setter Property="Fill" Value="{StaticResource Util.Conf.Green}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <TextBlock Text="{Binding ConfidenceDisplay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Util.Conf.Green}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Util.Conf.Red}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Util.Conf.Orange}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Util.Conf.Yellow}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Util.Conf.Green}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Fee" Binding="{Binding Fee, StringFormat={}{0:C0}}" Width="110"/>
                                <DataGridTextColumn Header="% Billed" Binding="{Binding PercentBilled, StringFormat={}{0:P1}}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid x:Name="DraftUtilizationGrid"
                                  Grid.Row="2"
                                  MaxHeight="520"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Disabled"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  RowHeight="28"
                                  ItemsSource="{Binding DraftUtilizationView}"
                                  MouseDoubleClick="DraftUtilizationGrid_MouseDoubleClick">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDraftingCapacitySelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="DraftUtil.Row.Red" Color="#FEE2E2"/>
                                <SolidColorBrush x:Key="DraftUtil.Row.Amber" Color="#FEF3C7"/>
                                <SolidColorBrush x:Key="DraftUtil.Row.Green" Color="#DCFCE7"/>

                                <SolidColorBrush x:Key="DraftUtil.Conf.Red" Color="#B91C1C"/>
                                <SolidColorBrush x:Key="DraftUtil.Conf.Orange" Color="#C2410C"/>
                                <SolidColorBrush x:Key="DraftUtil.Conf.Yellow" Color="#A16207"/>
                                <SolidColorBrush x:Key="DraftUtil.Conf.Green" Color="#166534"/>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="Over budget">
                                            <Setter Property="Background" Value="{StaticResource DraftUtil.Row.Red}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="At risk">
                                            <Setter Property="Background" Value="{StaticResource DraftUtil.Row.Amber}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskStatus}" Value="Healthy">
                                            <Setter Property="Background" Value="{StaticResource DraftUtil.Row.Green}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="260"/>
                                <DataGridTextColumn Header="PM" Binding="{Binding Pm}" Width="160"/>
                                <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="110"/>
                                <DataGridTextColumn Header="Draft Budget" Binding="{Binding DraftBudget, StringFormat={}{0:N1}}" Width="110"/>
                                <DataGridTextColumn Header="Draft Hours" Binding="{Binding DraftHours, StringFormat={}{0:N1}}" Width="110"/>
                                <DataGridTextColumn Header="Remaining Drafting Hours" Binding="{Binding RemainingDraftHours, StringFormat={}{0:N1}}" Width="120"/>
                                <DataGridTextColumn Header="Drafting Budget Used (%)" Binding="{Binding PercentDraftUsed, StringFormat={}{0:P1}}" Width="100"/>
                                <DataGridTemplateColumn Header="Delivery Risk" Width="150" SortMemberPath="ConfidenceLevel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        ToolTip="{Binding DeliveryConfidenceTooltip}">
                                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource DraftUtil.Conf.Green}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                    <Setter Property="Fill" Value="{StaticResource DraftUtil.Conf.Red}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                    <Setter Property="Fill" Value="{StaticResource DraftUtil.Conf.Orange}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                    <Setter Property="Fill" Value="{StaticResource DraftUtil.Conf.Yellow}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                                                    <Setter Property="Fill" Value="{StaticResource DraftUtil.Conf.Green}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <TextBlock Text="{Binding ConfidenceDisplay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource DraftUtil.Conf.Green}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Critical}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DraftUtil.Conf.Red}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.AtRisk}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DraftUtil.Conf.Orange}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.Stable}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DraftUtil.Conf.Yellow}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static fin:DeliveryConfidenceLevel.HighConfidence}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DraftUtil.Conf.Green}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Fee" Binding="{Binding Fee, StringFormat={}{0:C0}}" Width="110"/>
                                <DataGridTextColumn Header="% Billed" Binding="{Binding PercentBilled, StringFormat={}{0:P1}}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                    </Grid>
                        </Grid>
                        <Grid Visibility="{Binding ExecutiveSummaryVisibility}">
                            <fin:ExecutiveSummaryView DataContext="{Binding ExecutiveSummary}"/>
                        </Grid>
                        <Grid Visibility="{Binding ProfitLossVisibility}">
                            <fin:GlProfitLossView/>
                        </Grid>
                        <Grid Visibility="{Binding BillingManagerVisibility}">
                            <fin:BillingManagerReportView DataContext="{Binding BillingManagerReport}"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
        </Grid>
    </Grid>
</Window>

