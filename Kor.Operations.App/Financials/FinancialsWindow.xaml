                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CapacityRiskTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CapacityRiskSubtitle}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="11"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#FFFFFFFF"
                                    BorderBrush="{StaticResource Panel.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    VerticalAlignment="Top">
