                                                        <TextBlock Text="AR RISK" FontSize="8" FontWeight="Bold" Foreground="#991B1B"/>
                                                    </Border>
                                                    <Border Background="#F3F4F6" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                            Visibility="{Binding IsCold, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="No active projects and no activity in the last 12 months">
                                                        <TextBlock Text="COLD" FontSize="8" FontWeight="Bold" Foreground="#6B7280"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Projects" Binding="{Binding ProjectCount}" Width="65">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Total number of projects (active + closed) for this client"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Active" Binding="{Binding ActiveProjectCount}" Width="55">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Number of currently active projects"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Tenure" Binding="{Binding TenureDisplay}" Width="65" SortMemberPath="YearsAsClient">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Years since the client's first project opened"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Last Activity" Binding="{Binding LastActivityDisplay}" Width="85" SortMemberPath="LastActivityDate">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Most recent project activity (today if any active project, otherwise the latest close date)"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Lifetime Fee" Binding="{Binding LifetimeFee, StringFormat={}{0:C0}}" Width="105">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Sum of contracted fees across all projects for this client"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg/Project" Binding="{Binding AvgFeePerProject, StringFormat={}{0:C0}}" Width="90" SortMemberPath="AvgFeePerProject">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Average fee per project (Lifetime Fee ÷ Project Count)"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="% Billed" Binding="{Binding PercentBilledWithUnposted, StringFormat={}{0:P0}}" Width="70">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Lifetime billed (including unposted invoicing) as % of lifetime fee. Italic + amber when unposted billings are folded in."/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource UnpostedBillingCellStyle}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, StringFormat={}{0:C0}}" Width="100">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Total open AR balance across all projects for this client"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="90+ AR" Binding="{Binding Outstanding90Plus, StringFormat={}{0:C0}}" Width="90">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Open AR aged more than 90 days past due/invoice date — collection risk"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="5" ResizeBehavior="PreviousAndNext"
                                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="{StaticResource Panel.Border}"/>

                        <!-- Detail: redesigned with stat cards + project list -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Empty state -->
                                <StackPanel Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedClientHasValue}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center" Opacity="0.3"/>
                                    <TextBlock Text="Select a client" Foreground="{StaticResource Text.Secondary}"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="13"/>
                                    <TextBlock Text="View their full project history and AR aging"
                                               Foreground="{StaticResource Text.Secondary}" FontSize="10.5" FontStyle="Italic"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Client header bar -->
                                <Border Grid.Row="0" Padding="14,12" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1"
                                        Visibility="{Binding SelectedClientHasValue, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedClient.ClientName}" FontWeight="Bold" FontSize="15" Foreground="#1E3A8A"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="10.5" Margin="0,2,0,0">
                                            <Run Text="ClientID:"/><Run Text="{Binding SelectedClient.ClientId, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SelectedClient.ProjectCount, Mode=OneWay}"/><Run Text=" total ("/>
                                            <Run Text="{Binding SelectedClient.ActiveProjectCount, Mode=OneWay}"/><Run Text=" active)"/>
                                            <Run Text=" · Tenure: "/>
                                            <Run Text="{Binding SelectedClient.TenureDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Stat tiles for selected client -->
                                <Grid Grid.Row="1" Margin="10,10,10,4"
                                      Visibility="{Binding SelectedClientHasValue, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                                            CornerRadius="4" Padding="10,6" Margin="0,0,3,3">
                                        <StackPanel>
                                            <TextBlock Text="LIFETIME FEE" FontSize="9" FontWeight="SemiBold" Foreground="#166534"/>
                                            <TextBlock Text="{Binding SelectedClient.LifetimeFee, StringFormat={}{0:C0}}" FontSize="16" FontWeight="Bold" Foreground="#16A34A"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                            CornerRadius="4" Padding="10,6" Margin="3,0,0,3">
                                        <StackPanel>
                                            <TextBlock Text="LIFETIME BILLED" FontSize="9" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#2563EB">
                                                <Run Text="{Binding SelectedClient.LifetimeBilledWithUnposted, Mode=OneWay, StringFormat={}{0:C0}}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding SelectedClient.PercentBilledWithUnposted, Mode=OneWay, StringFormat={}{0:P0}}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                                            CornerRadius="4" Padding="10,6" Margin="0,3,3,0">
                                        <StackPanel>
                                            <TextBlock Text="OUTSTANDING" FontSize="9" FontWeight="SemiBold" Foreground="#9A3412"/>
                                            <TextBlock Text="{Binding SelectedClient.Outstanding, StringFormat={}{0:C0}}" FontSize="16" FontWeight="Bold" Foreground="#EA580C"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                            CornerRadius="4" Padding="10,6" Margin="3,3,0,0">
                                        <StackPanel>
                                            <TextBlock Text="90+ AGED AR" FontSize="9" FontWeight="SemiBold" Foreground="#991B1B"/>
                                            <TextBlock Text="{Binding SelectedClient.Outstanding90Plus, StringFormat={}{0:C0}}" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Project list for selected client -->
                                <DataGrid Grid.Row="2"
                                          Margin="10,4,10,10"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          ItemsSource="{Binding SelectedClient.Projects}"
                                          Visibility="{Binding SelectedClientHasValue, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Project #" Binding="{Binding Wbs1}" Width="100"
                                                            ToolTipService.ToolTip="Deltek WBS1. Bold = active project."/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"
                                                            ToolTipService.ToolTip="Project name"/>
                                        <DataGridTextColumn Header="Opened" Binding="{Binding OpenDate, StringFormat=MMM yyyy}" Width="80"
                                                            ToolTipService.ToolTip="Project open date"/>
                                        <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="70"
                                                            ToolTipService.ToolTip="Current project phase"/>
                                        <DataGridTextColumn Header="Total Fee" Binding="{Binding TotalFee, StringFormat={}{0:C0}}" Width="100"
                                                            ToolTipService.ToolTip="Total project fee: fixed contract plus any hourly extras revenue."/>
                                        <DataGridTextColumn Header="Billed" Binding="{Binding FeeBilledWithUnposted, StringFormat={}{0:C0}}" Width="100"
                                                            ToolTipService.ToolTip="Total billed to date (incl. unposted invoices). Italic + amber when unposted billings are folded in.">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource UnpostedBillingCellStyle}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="% Billed" Binding="{Binding PercentBilledWithUnposted, StringFormat={}{0:P0}}" Width="70">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource UnpostedBillingCellStyle}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, StringFormat={}{0:C0}}" Width="100"
                                                            ToolTipService.ToolTip="Open AR balance"/>
                                        <DataGridTextColumn Header="90+" Binding="{Binding Outstanding90Plus, StringFormat={}{0:C0}}" Width="80"
                                                            ToolTipService.ToolTip="AR aged 90+ days past due/invoice"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Revenue Forecast section: outside the outer ScrollViewer for full-height layout -->
                <Grid Grid.Row="1" Visibility="{Binding ForecastVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header card: matches Billing Manager style (white bg, purple title) -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Revenue Forecast" FontWeight="Bold" FontSize="14" Foreground="#7C3AED"/>
                                <TextBlock Text="24 months of historical billings + 12-month forecast"
                                           Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="Baseline pace:"/>
                                <Run Text="{Binding ForecastBaselineDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            </TextBlock>
                            <Border Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                                    Background="#F3E8FF" BorderBrush="#C4B5FD" BorderThickness="1"
                                    Cursor="Help" VerticalAlignment="Center"
                                    ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="60000">
                                <Border.ToolTip>
                                    <StackPanel MaxWidth="500">
                                        <TextBlock Text="Forecast Methodology" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,6">
                                            <Run FontWeight="SemiBold">Inputs:</Run>
                                            <Run Text=" 24 months of actual fee billed from PRSummaryMain (firm-wide), plus current backlog (sum of Fee − Fee Billed across active projects)."/>
                                        </TextBlock>

                                        <TextBlock Text="1. Partial-month detection" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,2" Foreground="#7C3AED"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                            Recent months with revenue &lt; 40% of historical median are flagged as still-being-posted in Deltek (typical 60-90 day billing lag). Shown as amber bars in the chart and EXCLUDED from baseline/trend/seasonal computation so they don't drag the forecast down.
                                        </TextBlock>

                                        <TextBlock Text="2. Per-month forecast formula" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,2" Foreground="#7C3AED"/>
                                        <TextBlock Text="forecast[i] = (baseline + slope × i) × seasonal_index[month]"
                                                   TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" Margin="6,0,0,6"/>

                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                            <Run FontWeight="SemiBold">Baseline:</Run>
                                            <Run Text=" (3 × trailing-6mo median + 1 × trailing-12mo median) / 4 of COMPLETE months only. Median is robust to single-month invoicing spikes — a single big invoice can't dominate the baseline."/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                            <Run FontWeight="SemiBold">Trend slope:</Run>
                                            <Run Text=" Theil-Sen median slope on the trailing 12 complete months — robust regression that captures growth or decline without being skewed by outliers. Clamped to ±15% of baseline so a noisy window can't blow up the projection."/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                            <Run FontWeight="SemiBold">Seasonal index:</Run>
                                            <Run Text=" each calendar month's median ÷ overall median, damped 50% toward 1.0 so a single weird year can't dominate. Requires at least 2 observations of that month, otherwise defaults to 1.0."/>
                                        </TextBlock>

                                        <TextBlock Text="3. Steady-state assumption" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,2" Foreground="#7C3AED"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                            The forecast is NOT capped by current backlog. It assumes the firm continues to win new work at historical pace — the realistic default for a going concern. The "Months of Runway" KPI is the separate "what if we win nothing new" warning.
                                        </TextBlock>

                                        <TextBlock TextWrapping="Wrap" FontSize="11" FontStyle="Italic" Foreground="#6B7280" Margin="0,6,0,0">
                                            What's NOT modeled: large lumpy wins, contract cancellations, fee adjustments mid-project, or step-changes in firm size (hires/layoffs). For those, look at backlog and runway directly.
                                        </TextBlock>
                                    </StackPanel>
                                </Border.ToolTip>
                                <TextBlock Text="?" FontWeight="Bold" FontSize="13" Foreground="#581C87"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KPI tile row — each tile has a rich definition tooltip on the entire card -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="0,0,4,0" Cursor="Help"
                                ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <StackPanel MaxWidth="380">
                                    <TextBlock Text="Trailing 12 Months" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">What:</Run>
                                        <Run Text=" Total firm-wide fee billed across the most recent 12 complete months."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">How:</Run>
                                        <Run Text=" SUM(BilledFee) FROM PRSummaryMain (with legacy Revenue fallback) across the trailing 12 months. Excludes the current in-progress month."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5">
                                        <Run FontWeight="SemiBold">Why:</Run>
                                        <Run Text=" Annual revenue baseline — the most stable measure of firm scale, smoothing out monthly variation."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel>
                                <TextBlock Text="TRAILING 12 MONTHS" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Text="{Binding ForecastTrailing12, StringFormat={}{0:C0}}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0"/>
                                <TextBlock Text="actual fee billed" Foreground="{StaticResource Text.Secondary}" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="4,0,4,0" Cursor="Help"
                                ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <StackPanel MaxWidth="380">
                                    <TextBlock Text="Trailing 3 Months" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">What:</Run>
                                        <Run Text=" Fee billed across the most recent 3 complete months — the firm's current operating pace."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">How:</Run>
                                        <Run Text=" SUM(BilledFee) FROM PRSummaryMain (with legacy Revenue fallback) across the trailing 3 complete months."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5">
                                        <Run FontWeight="SemiBold">Why:</Run>
                                        <Run Text=" Compare to (Trailing 12 ÷ 4) to see if the firm is accelerating or slowing relative to its annual run rate."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel>
                                <TextBlock Text="TRAILING 3 MONTHS" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Text="{Binding ForecastTrailing3, StringFormat={}{0:C0}}" FontSize="20" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0"/>
                                <TextBlock Text="recent pace" Foreground="{StaticResource Text.Secondary}" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="4,0,4,0" Cursor="Help"
                                ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <StackPanel MaxWidth="380">
                                    <TextBlock Text="Current Backlog" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">What:</Run>
                                        <Run Text=" Total unbilled fee across all currently active projects — work the firm has won but not yet invoiced."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">How:</Run>
                                        <Run Text=" SUM(Fee − Fee Billed) across active projects (status A). Negative balances clamped to zero."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5">
                                        <Run FontWeight="SemiBold">Why:</Run>
                                        <Run Text=" The hard ceiling on future revenue from existing contracts. New wins beyond this aren't included in the forecast."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel>
                                <TextBlock Text="CURRENT BACKLOG" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Text="{Binding ForecastBacklog, StringFormat={}{0:C0}}" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,2,0,0"/>
                                <TextBlock Text="unbilled fee" Foreground="{StaticResource Text.Secondary}" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="4,0,4,0" Cursor="Help"
                                ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <StackPanel MaxWidth="380">
                                    <TextBlock Text="Months of Runway" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">What:</Run>
                                        <Run Text=" How many months we can keep billing at current pace before the active project pipeline runs out."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">How:</Run>
                                        <Run Text=" Current Backlog ÷ Baseline pace (the same pace used in the forecast model)."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">Why:</Run>
                                        <Run Text=" The single most important sales-pipeline number: anything &lt; 6 means BD effort needs to ramp; &gt; 12 means we're well-stocked."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" FontStyle="Italic" Foreground="#6B7280">
                                        Assumes no new project wins. Add new sales to extend runway.
                                    </TextBlock>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel>
                                <TextBlock Text="MONTHS OF RUNWAY" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Text="{Binding ForecastMonthsOfBacklog, StringFormat={}{0:N1}}" FontSize="20" FontWeight="Bold" Foreground="#EA580C" Margin="0,2,0,0"/>
                                <TextBlock Text="months at current pace" Foreground="{StaticResource Text.Secondary}" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="4,0,4,0" Cursor="Help"
                                ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <StackPanel MaxWidth="380">
                                    <TextBlock Text="Forecast — Next 3 Months" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">What:</Run>
                                        <Run Text=" Projected fee billed for the next 3 calendar months."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">How:</Run>
                                        <Run Text=" Sum of monthly forecasts using: baseline pace + trend slope, modulated by each calendar month's seasonal index. Assumes the firm continues to win new work at historical pace — not capped by backlog."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5">
                                        <Run FontWeight="SemiBold">Why:</Run>
                                        <Run Text=" Short-horizon cash visibility for billing-cycle planning. The most reliable forecast window."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel>
                                <TextBlock Text="FORECAST NEXT 3 MO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Text="{Binding ForecastNext3, StringFormat={}{0:C0}}" FontSize="20" FontWeight="Bold" Foreground="#0891B2" Margin="0,2,0,0"/>
                                <TextBlock Text="projected" Foreground="{StaticResource Text.Secondary}" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="5" Background="White" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="4,0,0,0" Cursor="Help"
                                ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <StackPanel MaxWidth="380">
                                    <TextBlock Text="Forecast — Next 12 Months" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">What:</Run>
                                        <Run Text=" Projected fee billed across the next 12 calendar months."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">How:</Run>
                                        <Run Text=" Sum of all 12 forecast months. Each month gets the seasonal-adjusted trended baseline. Assumes steady-state new business — not capped by backlog (see &quot;Months of Runway&quot; for the no-new-wins scenario)."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5">
                                        <Run FontWeight="SemiBold">Why:</Run>
                                        <Run Text=" Annual fee-billed projection. If lower than Trailing 12 Months, the existing backlog isn't enough to maintain run rate — BD needs to sell more."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" FontStyle="Italic" Foreground="#6B7280" Margin="0,4,0,0">
                                        Tapers to zero in late months when backlog depletes — assumes no new wins.
                                    </TextBlock>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel>
                                <TextBlock Text="FORECAST NEXT 12 MO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Text="{Binding ForecastNext12, StringFormat={}{0:C0}}" FontSize="20" FontWeight="Bold" Foreground="#0891B2" Margin="0,2,0,0"/>
                                <TextBlock Text="projected" Foreground="{StaticResource Text.Secondary}" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bar chart: 24 months actuals + 12 months forecast -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="MONTHLY FEE BILLED" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"
                                           ToolTip="36-month timeline: 24 historical months from PRSummaryMain followed by 12 forecast months. Bars are scaled relative to the highest single month in the timeline."/>
                                <Border Background="#DBEAFE" CornerRadius="3" Padding="6,2" Margin="14,0,4,0" VerticalAlignment="Center"
                                        ToolTip="Complete actual billings from PRSummaryMain. These months are used to compute the baseline, trend, and seasonality.">
                                    <TextBlock Text="actual" FontSize="9" Foreground="#1E3A8A" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#FEF3C7" CornerRadius="3" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center"
                                        ToolTip="Partial / still-being-posted in Deltek. Detected automatically when a recent month is &lt; 40% of historical median. Excluded from baseline computation so the forecast isn't dragged down by the typical 60-90 day billing lag.">
                                    <TextBlock Text="partial" FontSize="9" Foreground="#92400E" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#E9D5FF" CornerRadius="3" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center"
                                        ToolTip="Forecast fee billed from the seasonal trend model. Each month: (baseline + slope × i) × seasonal_index. Assumes the firm continues to win new work at historical pace — not capped by backlog.">
                                    <TextBlock Text="forecast" FontSize="9" Foreground="#581C87" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="(scaled to highest month — hover bars for exact $)" Foreground="{StaticResource Text.Secondary}"
                                           FontSize="10" FontStyle="Italic" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ForecastTimeline}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="34" Margin="2,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Width="22"
                                                        HorizontalAlignment="Center">
                                                    <Border.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Revenue, StringFormat={}{0:C0}}"/>
                                                            <TextBlock FontSize="10" Foreground="Gray">
                                                                <Run Text="{Binding IsActual, Converter={StaticResource BoolToActualLabel}}"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="10" Foreground="#D97706" FontStyle="Italic"
                                                                       Visibility="{Binding IsPartial, Converter={StaticResource BoolToVis}}"
                                                                       Text="⚠ Still being posted in Deltek — excluded from baseline"/>
                                                        </StackPanel>
                                                    </Border.ToolTip>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- Default: forecast (purple) -->
                                                            <Setter Property="Background" Value="#7C3AED"/>
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                            <Style.Triggers>
                                                                <!-- Complete actual: solid blue -->
                                                                <DataTrigger Binding="{Binding IsActual}" Value="True">
                                                                    <Setter Property="Background" Value="#2563EB"/>
                                                                </DataTrigger>
                                                                <!-- Partial actual: amber + reduced opacity -->
                                                                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                                    <Setter Property="Opacity" Value="0.55"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Height>
                                                        <MultiBinding Converter="{StaticResource BarHeight}">
                                                            <Binding Path="Revenue"/>
                                                            <Binding Path="DataContext.ForecastChartMaxValue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </Border.Height>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="8.5"
                                                           HorizontalAlignment="Center" Margin="0,3,0,0"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Monthly breakdown table -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0">
                        <DataGrid AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="22"
                                  FontSize="11"
                                  VerticalScrollBarVisibility="Auto"
                                  ItemsSource="{Binding ForecastTimeline}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActual}" Value="False">
                                            <Setter Property="Background" Value="#FAF5FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" Binding="{Binding Label}" Width="120"
                                                    ToolTipService.ToolTip="Calendar month — short month name + 2-digit year"/>
                                <DataGridTextColumn Header="Fee Billed" Binding="{Binding Revenue, StringFormat={}{0:C0}}" Width="160"
                                                    ToolTipService.ToolTip="Actual fee billed (historical months) or projected fee billed (forecast months)"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding IsActual, Converter={StaticResource BoolToActualLabel}}" Width="*"
                                                    ToolTipService.ToolTip="Actual = sourced from PRSummaryMain. Forecast = computed by the seasonal trend model. Forecast rows are tinted purple."/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
        </Grid>
        <controls:AiQueryPanel x:Name="AiPanel" Grid.Row="4"/>
    </Grid>
</Window>

