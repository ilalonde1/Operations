<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Compatibility boundary: Outlook VSTO add-in launches this EXE by name. Keep output stable in this pass. -->
    <AssemblyName>Kor.Operations.App</AssemblyName>
    <OutputName>Kor.Transmittals.App</OutputName>
    <!-- Rebrand root namespace without changing EXE output identity. -->
    <RootNamespace>Kor.Operations</RootNamespace>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Work around duplicate assembly attributes being generated during WPF temp assembly generation. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- Playwright's node driver (445 MB, every platform) arrives transitively through
         Kor.Opportunities.Data. The app never launches a browser (scrapers run in the Worker),
         so keep it out of this output and out of everything that references this project. -->
    <PlaywrightPlatform>none</PlaywrightPlatform>
  </PropertyGroup>
