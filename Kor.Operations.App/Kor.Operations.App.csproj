<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Compatibility boundary: Outlook VSTO add-in launches this EXE by name. Keep output stable in this pass. -->
    <AssemblyName>Kor.Operations.App</AssemblyName>
    <OutputName>Kor.Transmittals.App</OutputName>
    <!-- Rebrand root namespace without changing EXE output identity. -->
    <RootNamespace>Kor.Operations</RootNamespace>
    <!-- Explicit Windows minimum to satisfy platform analyzers (CA1416). -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Work around duplicate assembly attributes being generated during WPF temp assembly generation. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <UseSharedCompilation>false</UseSharedCompilation>
    <NoWarn>$(NoWarn);SA0001</NoWarn>
    <StyleCopEnabled>false</StyleCopEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <None Remove="Assets\Fonts\Muli-Bold.ttf" />
    <None Remove="Assets\Fonts\Muli-ExtraLight.ttf" />
    <None Remove="Assets\Fonts\Muli-Light.ttf" />
    <None Remove="Assets\Fonts\Muli-SemiBold.ttf" />
    <None Remove="Assets\Fonts\Muli.ttf" />
    <None Remove="Assets\Fonts\Mulish-Black.ttf" />
    <None Remove="Assets\Fonts\Mulish-BlackItalic.ttf" />
    <None Remove="Assets\Fonts\Mulish-Bold.ttf" />
    <None Remove="Assets\Fonts\Mulish-BoldItalic.ttf" />
    <None Remove="Assets\Fonts\Mulish-ExtraBold.ttf" />
    <None Remove="Assets\Fonts\Mulish-ExtraBoldItalic.ttf" />
    <None Remove="Assets\Fonts\Mulish-ExtraLight.ttf" />
    <None Remove="Assets\Fonts\Mulish-ExtraLightItalic.ttf" />
    <None Remove="Assets\Fonts\Mulish-Italic.ttf" />
    <None Remove="Assets\Fonts\Mulish-Light.ttf" />
    <None Remove="Assets\Fonts\Mulish-LightItalic.ttf" />
    <None Remove="Assets\Fonts\Mulish-Medium.ttf" />
    <None Remove="Assets\Fonts\Mulish-MediumItalic.ttf" />
    <None Remove="Assets\Fonts\Mulish-Regular.ttf" />
    <None Remove="Assets\Fonts\Mulish-SemiBold.ttf" />
    <None Remove="Assets\Fonts\Mulish-SemiBoldItalic.ttf" />
    <None Remove="Assets\logo.ico" />
    <None Remove="Assets\logo.png" />
    <None Remove="Assets\QuickRemarksEditor.html" />
    <None Remove="Assets\SignatureEditor.html" />
    <None Remove="Assets\tinymce\js\tinymce\tinymce.min.js" />
    <None Remove="Assets\tinymce\tinymce.min.js" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Fonts\Muli-Bold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\Muli-ExtraLight.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\Muli-Light.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\Muli-SemiBold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\Muli.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\Mulish-Black.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\Mulish-BlackItalic.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\Mulish-Bold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\Mulish-BoldItalic.ttf">
