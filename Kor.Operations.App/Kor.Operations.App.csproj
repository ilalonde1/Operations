    <!-- SAFE OAPI is invoked via pure reflection + late binding (see
         SafeApiExporter.cs). We deliberately do NOT reference SAFEv1.dll
         at compile time because every compile-time binding turned out to
         pin our code to our bundled DLL's vtable layout, which doesn't
         match SAFE 22's actual COM server → NullReferenceException on
         first method call. Runtime reflection loads whichever SAFEv1.dll
         sits next to the SAFE.exe we discover, guaranteeing version match. -->
  </ItemGroup>
