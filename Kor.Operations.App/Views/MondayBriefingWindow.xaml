<Window x:Class="Kor.Operations.App.Views.MondayBriefingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Monday Briefing"
        Width="1200" Height="900"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SeverityBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#1565C0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding severity}" Value="High">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding severity}" Value="HIGH">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding severity}" Value="Medium">
                    <Setter Property="Background" Value="#EF6C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding severity}" Value="MEDIUM">
                    <Setter Property="Background" Value="#EF6C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding severity}" Value="Low">
                    <Setter Property="Background" Value="#1565C0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding severity}" Value="LOW">
                    <Setter Property="Background" Value="#1565C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LastUpdated}" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorVisibility}"
                               Foreground="#C62828"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="Loading..."
                               Visibility="{Binding BusyVisibility}"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource Button.Secondary}"
                            Padding="14,6"
                            Margin="0,0,8,0"/>
                    <Button Content="Export to Excel"
                            Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource Button.Primary}"
                            Padding="14,6"
                            Margin="0,0,8,0"/>
                    <Button Content="Export to Word"
                            Command="{Binding ExportWordCommand}"
                            Style="{StaticResource Button.Primary}"
                            Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource Panel.Background}"
                        BorderBrush="{StaticResource Panel.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderText}">
                            <Run Text="ACTION ITEMS ("/>
                            <Run Text="{Binding ActionItems.Count, Mode=OneWay}"/>
                            <Run Text=" unacknowledged)"/>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding ActionItemGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Header}"
                                              IsExpanded="True"
                                              Margin="0,0,0,10">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Panel.Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="12"
                                                            Margin="0,8,0,0"
                                                            Background="#FFFFFF">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                    <Border Style="{StaticResource SeverityBadge}" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding severity}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding body}"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{StaticResource Text.Secondary}"
                                                                           LineHeight="18"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="1"
                                                                    Content="Acknowledge"
                                                                    Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource Button.Secondary}"
                                                                    Padding="10,5"
                                                                    Margin="14,0,0,0"
                                                                    VerticalAlignment="Top"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Panel.Background}"
                        BorderBrush="{StaticResource Panel.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="STRATEGIC BRIEF" Style="{StaticResource SectionHeaderText}"/>
                        <ItemsControl ItemsSource="{Binding BriefSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Panel.Border}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,10"
                                            Background="#FFFFFF">
                                        <StackPanel>
                                            <TextBlock Text="{Binding section}"
                                                       Foreground="{StaticResource Brand.Accent.Brush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding headline}"
                                                       FontWeight="SemiBold"
                                                       FontSize="16"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding body}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="19"
                                                       Foreground="{StaticResource Text.Secondary}"/>
                                            <Border BorderBrush="#EF6C00"
                                                    BorderThickness="4,0,0,0"
                                                    Padding="10,8,0,0"
                                                    Margin="0,12,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Recommendation"
                                                               FontWeight="SemiBold"
                                                               Foreground="#EF6C00"
                                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding recommendation}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
