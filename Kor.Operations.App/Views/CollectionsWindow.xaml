<Window x:Class="Kor.Operations.App.Views.CollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Collections"
        Width="1100" Height="800"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Window.Resources>
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#64748B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="Lien">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Foreclosure">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="WriteOff">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Open">
                    <Setter Property="Background" Value="#475569"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Resolved">
                    <Setter Property="Background" Value="#9CA3AF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrapCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Padding" Value="0,3"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LastUpdated}" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorVisibility}"
                               Foreground="#C62828"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="Loading..."
                               Visibility="{Binding BusyVisibility}"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <CheckBox Content="Active only"
                              IsChecked="{Binding ActiveOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource Button.Secondary}"
                            Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <DataGrid ItemsSource="{Binding Cases}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      EnableRowVirtualization="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ClientID" Binding="{Binding clientID}" Width="110"/>
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusBadge}">
                                    <TextBlock Text="{Binding status}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="LegalAmount" Binding="{Binding legalAmount, StringFormat={}{0:C0}}" Width="120"/>
                    <DataGridTextColumn Header="OpenedAt" Binding="{Binding openedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="105"/>
                    <DataGridTextColumn Header="OpenedBy" Binding="{Binding openedBy}" Width="190"/>
                    <DataGridTextColumn Header="LastUpdatedAt" Binding="{Binding lastUpdatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                    <DataGridTextColumn Header="LastUpdatedBy" Binding="{Binding lastUpdatedBy}" Width="190"/>
                    <DataGridTextColumn Header="ResolvedAt" Binding="{Binding resolvedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="105"/>
                    <DataGridTextColumn Header="Notes"
                                        Binding="{Binding notes}"
                                        ElementStyle="{StaticResource WrapCellText}"
                                        Width="*"
                                        MinWidth="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
