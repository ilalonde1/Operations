<Window x:Class="Kor.Operations.App.Views.CollectionsCaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="{Binding WindowTitle}"
        Width="1100" Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Window.Resources>
        <Style x:Key="WrapCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Padding" Value="0,3"/>
        </Style>

        <Style x:Key="DisabledRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Client" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClientDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,8" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Status" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="0" Grid.Column="3"
                          ItemsSource="{Binding AvailableStatuses}"
                          SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,18,8"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="LegalAmount" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="0" Grid.Column="5"
                         Text="{Binding LegalAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:C2}}"
                         Margin="0,0,18,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Notes" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Top" Margin="0,6,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6"
                         Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="60"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Secondary}"
                        Padding="14,6"
                        Margin="0,0,8,0"/>
                <Button Content="Resolve"
                        Command="{Binding ResolveCommand}"
                        Visibility="{Binding ResolveButtonVisibility}"
                        Style="{StaticResource Button.Secondary}"
                        Padding="14,6"
                        Margin="0,0,8,0"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource Button.Primary}"
                        Padding="14,6"/>
            </StackPanel>
        </Border>

        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Select All"
                        Command="{Binding SelectAllCommand}"
                        Style="{StaticResource Button.Secondary}"
                        Padding="12,5"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Content="Select None"
                        Command="{Binding SelectNoneCommand}"
                        Style="{StaticResource Button.Secondary}"
                        Padding="12,5"/>
                <TextBlock Grid.Column="3"
                           Text="Loading..."
                           Visibility="{Binding BusyVisibility}"
                           Foreground="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorVisibility}"
                       Foreground="#C62828"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <Border Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                <TextBlock Text="No open AR for this client. Either nothing is currently invoiced for them, or every open invoice is already covered by another active collections case."
                           Visibility="{Binding EmptyPickerVisibility}"
                           Foreground="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="40"
                           FontSize="13"/>
                <DataGrid ItemsSource="{Binding Invoices}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          EnableRowVirtualization="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          RowStyle="{StaticResource DisabledRowStyle}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header=""
                                                Binding="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="44"
                                                CellStyle="{StaticResource CheckCellStyle}"/>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="110" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Project" Width="*" MinWidth="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,2">
                                        <TextBlock Text="{Binding ProjectName}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding WBS1, StringFormat='WBS {0}'}"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingBalance, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Days" Binding="{Binding DaysOutstanding}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding OtherCaseNote}" Width="140" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
