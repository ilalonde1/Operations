<Window x:Class="Kor.Operations.App.Views.CollectionsCaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="{Binding WindowTitle}"
        Width="1100" Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Window.Resources>
        <Style x:Key="WrapCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Padding" Value="0,3"/>
        </Style>

        <!-- Canonical Collections status palette — kept in lockstep with
             CollectionsWindow.StatusBadge so the same Status looks identical
             on the read-only list and inside the case editor. -->
        <Style x:Key="CaseStatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#475569"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Open">
                    <Setter Property="Background" Value="#475569"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Lien">
                    <Setter Property="Background" Value="#EA580C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Foreclosure">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="WriteOff">
                    <Setter Property="Background" Value="#374151"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Resolved">
                    <Setter Property="Background" Value="#15803D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Footer action button styles. Coloured to signal severity at a glance. -->
        <Style x:Key="ActionLien" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Background" Value="#EA580C"/>
            <Setter Property="BorderBrush" Value="#EA580C"/>
        </Style>
        <Style x:Key="ActionForeclosure" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#C62828"/>
        </Style>
        <Style x:Key="ActionWriteOff" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#374151"/>
        </Style>
        <Style x:Key="ActionResolve" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Background" Value="#15803D"/>
            <Setter Property="BorderBrush" Value="#15803D"/>
        </Style>

        <Style x:Key="DisabledRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top"
                Background="#FFFBEB"
                BorderBrush="#FCD34D"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="#92400E" Margin="0,0,0,4">
                    What does this do?
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="#78350F" FontSize="12" LineHeight="17">
                    <Run Text="Saving this case moves the checked invoices into the"/>
                    <Run Text="collections / legal-recovery track" FontWeight="SemiBold"/>
                    <Run Text=". From that point on:"/>
                    <LineBreak/>
                    <Run Text="• They are"/>
                    <Run Text="excluded from the Monday AR aging alert" FontWeight="SemiBold"/>
                    <Run Text="(no more weekly nag for invoices already in legal hands)."/>
                    <LineBreak/>
                    <Run Text="• They are excluded from the client's regular AR posture in alerts and reports."/>
                    <LineBreak/>
                    <Run Text="• They stay tracked under this case until you change Status to"/>
                    <Run Text="Resolved" FontWeight="SemiBold"/>
                    <Run Text="(at which point they return to normal AR aging if still unpaid)."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Client" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClientDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,8" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Status" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <Border Grid.Row="0" Grid.Column="3"
                        Style="{StaticResource CaseStatusBadge}"
                        Margin="0,0,18,8"
                        ToolTip="Status changes via the action buttons in the footer.">
                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Legal $ (optional)" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,8"
                           ToolTip="Dollar amount under formal legal recovery (lien, lawsuit, judgment). Often equals the sum of selected invoice outstandings — but you may also include interest, legal fees, or exclude items if your legal action covers a different scope. Optional."/>
                <TextBox Grid.Row="0" Grid.Column="5"
                         Text="{Binding LegalAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:C2}}"
                         Margin="0,0,18,8"
                         ToolTip="Dollar amount under formal legal recovery (lien, lawsuit, judgment). Often equals the sum of selected invoice outstandings — but you may also include interest, legal fees, or exclude items if your legal action covers a different scope. Optional."/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Lien expires" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,8"
                           Visibility="{Binding LienExpiryVisibility}"
                           ToolTip="Date the lien expires. Used by the Monday alert to warn you when expiry is approaching (within 30 days)."/>
                <DatePicker Grid.Row="1" Grid.Column="3"
                            SelectedDate="{Binding LienExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding LienExpiryVisibility}"
                            Margin="0,0,18,8"
                            ToolTip="Date the lien expires. Used by the Monday alert to warn you when expiry is approaching (within 30 days)."/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Notes" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Top" Margin="0,6,8,0"/>
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="6">
                    <TextBox x:Name="NotesTextBox"
                             Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="60"
                             VerticalContentAlignment="Top"
                             Padding="6,4"/>
                    <TextBlock IsHitTestVisible="False"
                               Text="Describe the legal action, key contacts, deadlines, status updates…"
                               Foreground="{StaticResource Text.Secondary}"
                               FontStyle="Italic"
                               VerticalAlignment="Top"
                               Margin="8,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NotesTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Secondary}"
                        Padding="14,6"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                <Setter Property="ToolTip" Value="Save with the current status (shown as the badge above). Use the buttons on the right to change status."/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="ToolTip" Value="Select at least one invoice from the list below before saving — a collections case has to cover specific invoices."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Mark Lien"
                            Command="{Binding SaveCommand}"
                            CommandParameter="Lien"
                            Style="{StaticResource ActionLien}"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            ToolTip="Set status to Lien and save. Use when a lien has been filed."/>
                    <Button Content="Mark Foreclosure"
                            Command="{Binding SaveCommand}"
                            CommandParameter="Foreclosure"
                            Style="{StaticResource ActionForeclosure}"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            ToolTip="Set status to Foreclosure and save. Use when foreclosure proceedings are underway."/>
                    <Button Content="Write Off"
                            Command="{Binding SaveCommand}"
                            CommandParameter="WriteOff"
                            Style="{StaticResource ActionWriteOff}"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            ToolTip="Set status to WriteOff and save. Marks as uncollectable; invoices stay locked to this case so they don't reappear in AR aging."/>
                    <Button Content="Resolve"
                            Command="{Binding ResolveCommand}"
                            Visibility="{Binding ResolveButtonVisibility}"
                            Style="{StaticResource ActionResolve}"
                            Padding="14,6"
                            ToolTip="Mark Resolved and save. Use when the case is paid, settled, or otherwise closed — invoices return to the regular AR aging stream if still unpaid."/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Select All"
                        Command="{Binding SelectAllCommand}"
                        Style="{StaticResource Button.Secondary}"
                        Padding="12,5"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Content="Select None"
                        Command="{Binding SelectNoneCommand}"
                        Style="{StaticResource Button.Secondary}"
                        Padding="12,5"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding SelectionSummary}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#1E3A8A"/>
                <TextBlock Grid.Column="3"
                           Text="Loading..."
                           Visibility="{Binding BusyVisibility}"
                           Foreground="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorVisibility}"
                       Foreground="#C62828"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <Border Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                <TextBlock Text="No open AR for this client. Either nothing is currently invoiced for them, or every open invoice is already covered by another active collections case."
                           Visibility="{Binding EmptyPickerVisibility}"
                           Foreground="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="40"
                           FontSize="13"/>
                <DataGrid ItemsSource="{Binding Invoices}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          EnableRowVirtualization="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          RowStyle="{StaticResource DisabledRowStyle}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header=""
                                                Binding="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="44"
                                                CellStyle="{StaticResource CheckCellStyle}"/>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="110" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Project" Width="*" MinWidth="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,2">
                                        <TextBlock Text="{Binding ProjectName}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding WBS1, StringFormat='WBS {0}'}"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Inv Date" Binding="{Binding InvoiceDate, StringFormat={}{0:yyyy-MM-dd}}" Width="92" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="62" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Original" Binding="{Binding OriginalAmount, StringFormat={}{0:N0}}" Width="92" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat={}{0:N0}}" Width="92" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#15803D"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingBalance, StringFormat={}{0:N0}}" Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Days" Binding="{Binding DaysOutstanding}" Width="60" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
