<Window x:Class="Kor.Operations.App.FileSync.FileSyncLogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fs="clr-namespace:Kor.Operations.App.FileSync"
        Title="FileSync Logs"
        Width="1500"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <fs:LogLevelToBrushConverter x:Key="LevelToBrush"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title strip -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="FileSync Logs" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="  -  live tail across hosts and jobs"
                       FontSize="14"
                       Foreground="{StaticResource Text.Secondary}"
                       VerticalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Filter bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Host" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" x:Name="HostCombo"
                          Width="140" Margin="0,0,16,0"
                          ItemsSource="{Binding Hosts}"
                          SelectedItem="{Binding SelectedHost, Mode=TwoWay}"/>

                <TextBlock Grid.Column="2" Text="Date" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker Grid.Column="3" x:Name="DatePick"
                            Width="120" Margin="0,0,16,0"
                            SelectedDate="{Binding SelectedDate, Mode=TwoWay}"/>

                <TextBlock Grid.Column="4" Text="Min level" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="5" x:Name="LevelCombo"
                          Width="80" Margin="0,0,16,0"
                          SelectedValue="{Binding MinLevel, Mode=TwoWay}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="ALL"/>
                    <ComboBoxItem Content="DBG"/>
                    <ComboBoxItem Content="INF" IsSelected="True"/>
                    <ComboBoxItem Content="WRN"/>
                    <ComboBoxItem Content="ERR"/>
                    <ComboBoxItem Content="FTL"/>
                </ComboBox>

                <TextBlock Grid.Column="6" Text="Job" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="7" x:Name="JobCombo"
                          Width="180" Margin="0,0,16,0"
                          ItemsSource="{Binding Jobs}"
                          SelectedItem="{Binding JobFilter, Mode=TwoWay}"/>

                <TextBlock Grid.Column="8" Text="Search" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="9" x:Name="SearchBox"
                         Width="220" Margin="0,0,16,0"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <CheckBox Grid.Column="11" Content="Auto-refresh" Margin="0,0,16,0"
                          IsChecked="{Binding AutoRefresh, Mode=TwoWay}"
                          VerticalAlignment="Center"/>

                <CheckBox Grid.Column="12" Content="Auto-scroll"
                          IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Lines + detail split -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      x:Name="LinesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ItemsSource="{Binding DisplayedLines}"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      FontFamily="Cascadia Mono, Consolas">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy line"            Click="CopyLine_Click"/>
                        <MenuItem Header="Copy with details"    Click="CopyDetails_Click"/>
                        <Separator/>
                        <MenuItem Header="Filter by this source" Click="FilterBySource_Click"/>
                        <MenuItem Header="Clear filters"        Click="ClearFilters_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}"
                                        Width="100"/>
                    <DataGridTemplateColumn Header="Lvl" Width="50" SortMemberPath="Severity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9"
                                        Padding="6,1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{Binding Level, Converter={StaticResource LevelToBrush}}">
                                    <TextBlock Text="{Binding Level}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="10"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Source"
                                        Binding="{Binding ShortSource}"
                                        Width="200"/>
                    <DataGridTextColumn Header="Message"
                                        Binding="{Binding Message}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Panel.Border}"/>

            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="12"
                    Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Detail" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedLine.SourceContext, FallbackValue=''}"
                               Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2"
                               Text="{Binding SelectedLine.Message, FallbackValue=''}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBox Grid.Row="3"
                             Text="{Binding SelectedLine.Details, FallbackValue='', Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             Background="Transparent"
                             BorderThickness="0"
                             TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="0,1,0,0"
                Padding="12,6"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        x:Name="OpenInExplorerBtn"
                        Content="Open log folder"
                        Padding="10,2"
                        Margin="0,0,8,0"
                        Click="OpenInExplorerBtn_Click"/>
                <Button Grid.Column="2"
                        x:Name="RefreshNowBtn"
                        Content="Refresh now"
                        Padding="10,2"
                        Click="RefreshNowBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
