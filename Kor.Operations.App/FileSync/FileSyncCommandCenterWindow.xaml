<Window x:Class="Kor.Operations.App.FileSync.FileSyncCommandCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:fs="clr-namespace:Kor.Operations.App.FileSync"
        Title="FileSync Command Center"
        Width="1400"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <fs:JobStatusToBrushConverter x:Key="StatusToBrush"/>
        <fs:JobStatusToTextConverter x:Key="StatusToText"/>
        <fs:TimeSpanToHumanConverter x:Key="HumanTime"/>
        <fs:BoolToOnOffConverter x:Key="BoolToOnOff"/>
        <fs:CountToVisibilityConverter x:Key="CountToVis"/>
        <fs:HeartbeatHealthToBrushConverter x:Key="HealthToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="FileSync Command Center"
                            SubtitleText="Live status, manual fire, and per-job knobs"
                            AvatarDiameter="64"
                            AvatarBorderThickness="2"/>

        <!-- KPI strip. Three at-a-glance health tiles computed from existing
             collections; no extra SQL. Headline is a big number, subline is
             the metric label, brush comes from the VM and reflects the tier
             (good / warning / bad). -->
        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,4,0" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="{Binding HostsKpiHeadline}" Foreground="{Binding HostsKpiBrush}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding HostsKpiSubline}" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="{Binding JobsKpiHeadline}" Foreground="{Binding JobsKpiBrush}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding JobsKpiSubline}" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0,0,0" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="{Binding FailuresKpiHeadline}" Foreground="{Binding FailuresKpiBrush}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding FailuresKpiSubline}" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Heartbeat panel -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="12,0,12,8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Service heartbeat" FontSize="14" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Content="Auto-refresh"
                              IsChecked="{Binding AutoRefresh}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="Re-poll the control plane every 15 seconds."/>
                    <Button x:Name="LogsBtn" Content="Logs..."
                            Padding="14,4" Margin="0,0,8,0"
                            Click="LogsBtn_Click"/>
                    <Button x:Name="ActivityBtn" Content="Activity..."
                            Padding="14,4" Margin="0,0,8,0"
                            Click="ActivityBtn_Click"/>
                    <Button x:Name="RefreshBtn" Content="Refresh"
                            Padding="14,4" Click="RefreshBtn_Click"/>
                </StackPanel>
                <DataGrid Grid.Row="1" Grid.ColumnSpan="2"
                          x:Name="HeartbeatsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Margin="0,8,0,0"
                          MaxHeight="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Host"            Binding="{Binding HostName}"             Width="130"/>
                        <DataGridTemplateColumn Header="Health" Width="150" SortMemberPath="LastHeartbeatAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding HealthStatus, Converter={StaticResource HealthToBrush}}">
                                        <TextBlock Text="{Binding HealthLabel}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mode"            Binding="{Binding GlobalMode}"           Width="80"/>
                        <DataGridTextColumn Header="Version"         Binding="{Binding ServiceVersion}"       Width="100"/>
                        <DataGridTextColumn Header="Jobs"            Binding="{Binding JobsRegistered}"       Width="60"/>
                        <DataGridTextColumn Header="Started"         Binding="{Binding StartedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                        <DataGridTextColumn Header="Last heartbeat"  Binding="{Binding LastHeartbeatAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 24h run-history ribbon. Each dot is a JobRun positioned by start
             time, coloured by status. Click a dot to drop the Log Viewer
             onto that run's time window. Hidden until the first refresh has
             populated RecentRuns. -->
        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Margin="12,0,12,8"
                Padding="12,10,12,4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Last 24 hours" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Failures only"
                                  IsChecked="{Binding ShowFailuresOnly}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  ToolTip="Hide successful runs from the ribbon."/>
                        <Ellipse Width="8" Height="8" Fill="#228B22" Margin="0,0,4,0"/>
                        <TextBlock Text="Success" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Ellipse Width="8" Height="8" Fill="#C11E1E" Margin="0,0,4,0"/>
                        <TextBlock Text="Failed" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Ellipse Width="8" Height="8" Fill="#E5A800" Margin="0,0,4,0"/>
                        <TextBlock Text="Running" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Ellipse Width="8" Height="8" Fill="#808080" Margin="0,0,4,0"/>
                        <TextBlock Text="Cancelled" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <fs:RunHistoryRibbon x:Name="HistoryRibbon"
                                     Height="44"
                                     Margin="0,6,0,0"
                                     Runs="{Binding RecentRuns}"
                                     SnapsToDevicePixels="True"
                                     UseLayoutRounding="True"/>
            </StackPanel>
        </Border>

        <!-- Pending triggers (collapsed when queue empty) -->
        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Margin="12,0,12,8"
                Padding="12"
                Visibility="{Binding PendingTriggerCount, Converter={StaticResource CountToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding PendingTriggerCount, StringFormat='Pending triggers ({0})'}"
                           FontSize="14" FontWeight="SemiBold"/>
                <DataGrid Grid.Row="1"
                          x:Name="PendingGrid"
                          ItemsSource="{Binding PendingTriggers}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Margin="0,8,0,0"
                          MaxHeight="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"            Binding="{Binding TriggerId}"      Width="60"/>
                        <DataGridTextColumn Header="Job"          Binding="{Binding JobName}"        Width="170"/>
                        <DataGridTextColumn Header="Requested at" Binding="{Binding RequestedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                        <DataGridTextColumn Header="Waiting"      Binding="{Binding WaitingFor, Converter={StaticResource HumanTime}}" Width="100"/>
                        <DataGridTextColumn Header="Requested by" Binding="{Binding RequestedBy}"    Width="220"/>
                        <DataGridTextColumn Header="Args"         Binding="{Binding Args}"           Width="*"/>
                        <DataGridTemplateColumn Header="Cancel" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Cancel" Padding="8,2"
                                            Click="CancelPending_Click"
                                            Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Jobs panel -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="12,0,12,8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Registered jobs" FontSize="14" FontWeight="SemiBold"/>
                <DataGrid Grid.Row="1"
                          x:Name="JobsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Margin="0,8,0,0"
                          MouseDoubleClick="JobsGrid_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <!-- Subtle row tints so the operator's eye finds the
                             active/imminent rows without obscuring the text.
                             Running > Imminent (a job that fires while running
                             is still actively running). -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImminent}" Value="True">
                                    <Setter Property="Background" Value="#33E5A800"/>
                                    <Setter Property="ToolTip" Value="Next fire is within 5 minutes."/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="#33228B22"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="ToolTip" Value="This job is currently running."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job"           Binding="{Binding JobName}"           Width="170"/>
                        <DataGridTextColumn Header="Display name"  Binding="{Binding DisplayName}"       Width="220"/>
                        <DataGridTextColumn Header="Mode"          Binding="{Binding Mode}"              Width="70"/>
                        <DataGridTextColumn Header="Enabled"       Binding="{Binding Enabled, Converter={StaticResource BoolToOnOff}}" Width="60"/>
                        <DataGridTemplateColumn Header="Last run" Width="120" SortMemberPath="LastRunStatus">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{Binding LastRunStatus, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Text="{Binding LastRunStatus, Converter={StaticResource StatusToText}}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Trend (last 10)" Width="120" SortMemberPath="LastRunStartedAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding RecentRunStatuses}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Last 10 runs, oldest first.">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="8" Height="8" Margin="1,0,1,0"
                                                         Fill="{Binding ., Converter={StaticResource StatusToBrush}}"
                                                         ToolTip="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="When"
                                            Binding="{Binding SinceLastRun, Converter={StaticResource HumanTime}}"
                                            Width="100"
                                            SortMemberPath="LastRunStartedAt"/>
                        <DataGridTextColumn Header="Cron"          Binding="{Binding CronExpression}"    Width="120"/>
                        <DataGridTextColumn Header="Next fire"
                                            Binding="{Binding UntilNextFire, Converter={StaticResource HumanTime}, ConverterParameter=future}"
                                            Width="120"
                                            SortMemberPath="NextFireAt"/>
                        <DataGridTemplateColumn Header="Actions" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Toggle mode"
                                                Margin="0,0,6,0" Padding="8,2"
                                                Click="ToggleMode_Click"
                                                Tag="{Binding}"/>
                                        <Button Content="Manual fire"
                                                Padding="8,2"
                                                Click="ManualFire_Click"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Notes"         Binding="{Binding Notes}"             Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status bar with sticky failure bell. Bell is hidden when there
             are no unacknowledged failures; lights red and shows the count
             when there are. Click acknowledges and pivots the ribbon into
             failures-only so the operator sees the offending dots. -->
        <Border Grid.Row="6" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="{Binding StatusMessage}" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        x:Name="FailureBellBtn"
                        Click="FailureBellBtn_Click"
                        Padding="10,2"
                        Background="#C11E1E"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        ToolTip="Acknowledge new failures and pivot the ribbon."
                        Visibility="{Binding HasUnackedFailures, Converter={StaticResource BoolToVis}}">
                    <TextBlock>
                        <Run Text="!  "/>
                        <Run Text="{Binding UnackedFailureCount, Mode=OneWay}"/>
                        <Run Text=" new failure(s) — acknowledge"/>
                    </TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- Floating toast stack. Sits above the Jobs grid in the bottom-right
             corner; each toast is a Border added/removed by the code-behind
             when a run transitions Running -> Success/Failed across an
             auto-refresh tick. -->
        <StackPanel x:Name="ToastStack"
                    Grid.RowSpan="7"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,40"
                    Panel.ZIndex="999"
                    IsHitTestVisible="False"/>
    </Grid>
</Window>
