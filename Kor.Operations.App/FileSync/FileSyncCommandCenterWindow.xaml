<Window x:Class="Kor.Operations.App.FileSync.FileSyncCommandCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:fs="clr-namespace:Kor.Operations.App.FileSync"
        Title="FileSync Command Center"
        Width="1400"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <fs:JobStatusToBrushConverter x:Key="StatusToBrush"/>
        <fs:JobStatusToTextConverter x:Key="StatusToText"/>
        <fs:TimeSpanToHumanConverter x:Key="HumanTime"/>
        <fs:BoolToOnOffConverter x:Key="BoolToOnOff"/>
        <fs:CountToVisibilityConverter x:Key="CountToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="FileSync Command Center"
                            SubtitleText="Live status, manual fire, and per-job knobs"
                            AvatarDiameter="64"
                            AvatarBorderThickness="2"/>

        <!-- Heartbeat panel -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="12,0,12,8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Service heartbeat" FontSize="14" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ActivityBtn" Content="Activity..."
                            Padding="14,4" Margin="0,0,8,0"
                            Click="ActivityBtn_Click"/>
                    <Button x:Name="RefreshBtn" Content="Refresh"
                            Padding="14,4" Click="RefreshBtn_Click"/>
                </StackPanel>
                <DataGrid Grid.Row="1" Grid.ColumnSpan="2"
                          x:Name="HeartbeatsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Margin="0,8,0,0"
                          MaxHeight="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Host"            Binding="{Binding HostName}"             Width="130"/>
                        <DataGridTextColumn Header="Mode"            Binding="{Binding GlobalMode}"           Width="80"/>
                        <DataGridTextColumn Header="Version"         Binding="{Binding ServiceVersion}"       Width="100"/>
                        <DataGridTextColumn Header="Jobs"            Binding="{Binding JobsRegistered}"       Width="60"/>
                        <DataGridTextColumn Header="Started"         Binding="{Binding StartedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                        <DataGridTextColumn Header="Last heartbeat"  Binding="{Binding LastHeartbeatAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                        <DataGridTextColumn Header="Stale?"          Binding="{Binding IsStale}"              Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Pending triggers (collapsed when queue empty) -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Margin="12,0,12,8"
                Padding="12"
                Visibility="{Binding PendingTriggerCount, Converter={StaticResource CountToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding PendingTriggerCount, StringFormat='Pending triggers ({0})'}"
                           FontSize="14" FontWeight="SemiBold"/>
                <DataGrid Grid.Row="1"
                          x:Name="PendingGrid"
                          ItemsSource="{Binding PendingTriggers}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Margin="0,8,0,0"
                          MaxHeight="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"            Binding="{Binding TriggerId}"      Width="60"/>
                        <DataGridTextColumn Header="Job"          Binding="{Binding JobName}"        Width="170"/>
                        <DataGridTextColumn Header="Requested at" Binding="{Binding RequestedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                        <DataGridTextColumn Header="Waiting"      Binding="{Binding WaitingFor, Converter={StaticResource HumanTime}}" Width="100"/>
                        <DataGridTextColumn Header="Requested by" Binding="{Binding RequestedBy}"    Width="220"/>
                        <DataGridTextColumn Header="Args"         Binding="{Binding Args}"           Width="*"/>
                        <DataGridTemplateColumn Header="Cancel" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Cancel" Padding="8,2"
                                            Click="CancelPending_Click"
                                            Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Jobs panel -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="12,0,12,8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Registered jobs" FontSize="14" FontWeight="SemiBold"/>
                <DataGrid Grid.Row="1"
                          x:Name="JobsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Margin="0,8,0,0"
                          MouseDoubleClick="JobsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job"           Binding="{Binding JobName}"           Width="170"/>
                        <DataGridTextColumn Header="Display name"  Binding="{Binding DisplayName}"       Width="220"/>
                        <DataGridTextColumn Header="Mode"          Binding="{Binding Mode}"              Width="70"/>
                        <DataGridTextColumn Header="Enabled"       Binding="{Binding Enabled, Converter={StaticResource BoolToOnOff}}" Width="60"/>
                        <DataGridTemplateColumn Header="Last run" Width="120" SortMemberPath="LastRunStatus">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{Binding LastRunStatus, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Text="{Binding LastRunStatus, Converter={StaticResource StatusToText}}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="When"
                                            Binding="{Binding SinceLastRun, Converter={StaticResource HumanTime}}"
                                            Width="100"
                                            SortMemberPath="LastRunStartedAt"/>
                        <DataGridTextColumn Header="Cron"          Binding="{Binding CronExpression}"    Width="120"/>
                        <DataGridTextColumn Header="Next fire"
                                            Binding="{Binding UntilNextFire, Converter={StaticResource HumanTime}, ConverterParameter=future}"
                                            Width="120"
                                            SortMemberPath="NextFireAt"/>
                        <DataGridTemplateColumn Header="Actions" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Toggle mode"
                                                Margin="0,0,6,0" Padding="8,2"
                                                Click="ToggleMode_Click"
                                                Tag="{Binding}"/>
                                        <Button Content="Manual fire"
                                                Padding="8,2"
                                                Click="ManualFire_Click"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Notes"         Binding="{Binding Notes}"             Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Foreground="{StaticResource Text.Secondary}"/>
        </Border>
    </Grid>
</Window>
