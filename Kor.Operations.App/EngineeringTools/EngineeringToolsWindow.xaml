<Window x:Class="Kor.Operations.EngineeringTools.EngineeringToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="KOR NewerForma™ — Engineering Tools"
        Width="980" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="KOR NewerForma"
                            SubtitleText="Engineering Tools"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="🛠" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="Engineering Tools"
                       FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,6"/>
            <TextBlock Text="Tools will appear here as they are built."
                       Foreground="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
