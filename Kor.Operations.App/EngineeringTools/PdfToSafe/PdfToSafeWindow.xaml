<Window x:Class="Kor.Operations.EngineeringTools.PdfToSafe.PdfToSafeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="KOR NewerForma™ — Structural PDF Import"
        Width="1300" Height="820"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="KOR NewerForma"
                            SubtitleText="Structural PDF Import"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="SaveProjectButton"
                                        DockPanel.Dock="Left"
                                        Content="Save"
                                        Style="{StaticResource Button.Secondary}"
                                        Padding="6,4"
                                        FontSize="11"
                                        Click="SaveProject_Click"/>
                                <Button x:Name="LoadProjectButton"
                                        DockPanel.Dock="Left"
                                        Content="Load"
                                        Style="{StaticResource Button.Secondary}"
                                        Padding="6,4"
                                        FontSize="11"
                                        Margin="6,0,0,0"
                                        Click="LoadProject_Click"/>
                            </DockPanel>

                            <Border Background="{StaticResource Panel.Background}"
                                    BorderBrush="{StaticResource Panel.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Load PDF"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"
                                               Margin="0,0,0,8"/>
                                    <Button x:Name="LoadPdfButton"
                                            Content="Browse PDF..."
                                            Style="{StaticResource Button.Secondary}"
                                            HorizontalAlignment="Stretch"
                                            Click="LoadPdf_Click"/>
                                    <Button x:Name="SafeApiExportButton"
                                            Content="⚡ Export to SAFE"
                                            Style="{StaticResource Button.Primary}"
                                            HorizontalAlignment="Stretch"
                                            FontSize="13" FontWeight="SemiBold"
                                            Height="38"
                                            Margin="0,8,0,0"
                                            Click="SafeApiExport_Click"
                                            ToolTip="AI classifies your markups, then exports slabs, columns, walls, loads and grids directly into a SAFE .fdb via the OAPI. One click."/>
                                    <Button x:Name="EtabsApiExportButton"
                                            Content="⚡ Export to ETABS"
                                            Style="{StaticResource Button.Primary}"
                                            HorizontalAlignment="Stretch"
                                            FontSize="13" FontWeight="SemiBold"
                                            Height="38"
                                            Margin="0,6,0,0"
                                            Click="EtabsApiExport_Click"
                                            ToolTip="AI classifies your markups, then exports slabs, columns, walls, loads and grids directly into an ETABS .edb via the OAPI. One click."/>
                                    <Button x:Name="Sap2000ApiExportButton"
                                            Content="⚡ Export to SAP2000"
                                            Style="{StaticResource Button.Primary}"
                                            HorizontalAlignment="Stretch"
                                            FontSize="13" FontWeight="SemiBold"
                                            Height="38"
                                            Margin="0,6,0,0"
                                            Click="Sap2000ApiExport_Click"
                                            ToolTip="AI classifies your markups, then exports directly into a SAP2000 model via the OAPI. One click."/>
                                    <Button x:Name="FirmDefaultsButton"
                                            Content="⚙ Firm defaults…"
                                            Style="{StaticResource Button.Secondary}"
                                            HorizontalAlignment="Stretch"
                                            FontSize="11"
                                            Margin="0,6,0,0"
                                            Click="FirmDefaults_Click"
                                            ToolTip="Edit the default grade, thickness, loads, and stiffness modifiers applied to every new PDF"/>
                                    <TextBlock x:Name="FileNameText"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                    <StackPanel x:Name="PageSelectorPanel"
                                                Orientation="Horizontal"
                                                Margin="0,8,0,0"
                                                Visibility="Collapsed">
                                        <TextBlock Text="Page:"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ComboBox x:Name="PageSelector"
                                                  Width="100"
                                                  SelectionChanged="PageSelector_SelectionChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ScalePanel"
                                    Background="{StaticResource Panel.Background}"
                                    BorderBrush="{StaticResource Panel.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Scale &amp; Detection"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="1 :"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="ScaleInput"
                                                 Width="70"
                                                 Text="100"
                                                 Margin="4,0,8,0"
                                                 VerticalAlignment="Center"/>
                                        <Button x:Name="ReAnalyseButton"
                                                Content="Re-analyse"
                                                Style="{StaticResource Button.Secondary}"
                                                Padding="6,4"
                                                FontSize="11"
                                                Click="ReAnalyse_Click"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DetectionSummaryPanel"
                                                Orientation="Horizontal"
                                                Margin="0,8,0,0"
                                                Visibility="Collapsed">
                                        <Border CornerRadius="4" Padding="6,3" Background="{StaticResource Surface.Subtle}" Margin="0,0,6,0">
                                            <TextBlock x:Name="SlabCountText" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,3" Background="{StaticResource Surface.Subtle}" Margin="0,0,6,0">
                                            <TextBlock x:Name="ColumnCountText" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,3" Background="{StaticResource Surface.Subtle}" Margin="0,0,6,0">
                                            <TextBlock x:Name="LineCountText" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                                        </Border>
                                    </StackPanel>
                                    <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                                        <DockPanel LastChildFill="True">
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel x:Name="StatusSpinnerRow" Grid.Column="0" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                                                    <Canvas Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Ellipse Width="14" Height="14" Stroke="#CBD5E1" StrokeThickness="2" Fill="Transparent"/>
                                                        <Ellipse Width="14" Height="14" Stroke="{StaticResource Brand.Primary.Brush}" StrokeThickness="2" Fill="Transparent" StrokeDashArray="2 3" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                                            <Ellipse.RenderTransform>
                                                                <RotateTransform x:Name="StatusSpinnerRotation"/>
                                                            </Ellipse.RenderTransform>
                                                            <Ellipse.Triggers>
                                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetName="StatusSpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Ellipse.Triggers>
                                                        </Ellipse>
                                                    </Canvas>
                                                    <TextBlock x:Name="StatusSpinnerLabel" Text="Analysing…" FontSize="11" FontStyle="Italic" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button x:Name="StatusCopyButton" Grid.Column="1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Content="Copy" Click="StatusCopy_Click"
                                                        Style="{StaticResource Button.Secondary}"
                                                        Padding="8,2" FontSize="10" MinWidth="44"
                                                        Visibility="Collapsed"
                                                        ToolTip="Copy the AI analysis text to the clipboard"/>
                                            </Grid>
                                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,4,0"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="PdfInfoPanel" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock x:Name="PageCountText" FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource Text.Secondary}" Margin="4,0,4,0"/>
                                <TextBlock x:Name="PathCountText" FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Color properties grid — per-color engineering properties
                         editable by the engineer without requiring AI. Shows one
                         row per detected markup color; engineer sets type,
                         thickness, loads, grade per color group. -->
                    <Border Grid.Row="1" Background="{StaticResource Panel.Background}"
                            Padding="8,6" BorderBrush="{StaticResource Panel.Border}"
                            BorderThickness="0,1,0,0">
                        <Expander x:Name="ColorPropsExpander"
                                  Header="Color Properties"
                                  FontSize="12" FontWeight="SemiBold"
                                  IsExpanded="True">
                            <DataGrid x:Name="ColorPropsGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      SelectionMode="Single"
                                      FontSize="11"
                                      MaxHeight="200"
                                      Margin="0,6,0,0"
                                      CellEditEnding="ColorPropsGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Color" Binding="{Binding Name}" IsReadOnly="True" Width="110"/>
                                    <DataGridComboBoxColumn Header="Type" Width="70"
                                        SelectedItemBinding="{Binding ElementType, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGridComboBoxColumn.ItemsSource>
                                            <x:Array Type="sys:String"
                                                     xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                                <sys:String>Slab</sys:String>
                                                <sys:String>Beam</sys:String>
                                                <sys:String>Column</sys:String>
                                                <sys:String>Wall</sys:String>
                                                <sys:String>Opening</sys:String>
                                                <sys:String>Ignore</sys:String>
                                            </x:Array>
                                        </DataGridComboBoxColumn.ItemsSource>
                                    </DataGridComboBoxColumn>
                                    <DataGridTextColumn Header="Grade" Binding="{Binding GradeCode}" Width="55"/>
                                    <DataGridTextColumn Header="Thick" Binding="{Binding ThicknessMm, StringFormat=F0}" Width="50"/>
                                    <DataGridTextColumn Header="SDL" Binding="{Binding SdlKPa, StringFormat=F1}" Width="45"/>
                                    <DataGridTextColumn Header="Live" Binding="{Binding LiveKPa, StringFormat=F1}" Width="45"/>
                                    <DataGridCheckBoxColumn Header="Inc" Binding="{Binding Included}" Width="35"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource Panel.Background}" Padding="0,10,0,0">
                        <StackPanel>
                            <Expander Header="Other export formats" FontSize="11"
                                      Foreground="{StaticResource Text.Secondary}"
                                      IsExpanded="False" Margin="0,0,0,4">
                                <StackPanel Margin="0,6,0,0">
                                    <Button x:Name="ExportF2kButton" Content="Export SAFE (.f2k)" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch" Height="30" FontSize="11" Click="ExportF2k_Click" IsEnabled="False"/>
                                    <Button x:Name="ExportE2kButton" Content="Export ETABS (.e2k)" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch" Height="30" FontSize="11" Margin="0,4,0,0" Click="ExportE2k_Click" IsEnabled="False"/>
                                    <Button x:Name="ExportDxfButton" Content="Export DXF" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch" Height="30" FontSize="11" Margin="0,4,0,0" Click="ExportDxf_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Expander>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button x:Name="SaveProjectButton2" Content="Save Project" Style="{StaticResource Button.Secondary}" Padding="6,4" FontSize="10" Click="SaveProject_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1" CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" Background="{StaticResource Surface.Subtle}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center">
                            <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Load a PDF to preview" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Load a vector PDF exported from Revit or AutoCAD.&#x0a;Scale is auto-detected from PDF text.&#x0a;Scroll to zoom · right-drag to pan." FontSize="12" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320"/>
                    </StackPanel>

                    <Grid x:Name="PreviewViewbox" Visibility="Collapsed" MouseWheel="PreviewContainer_MouseWheel" MouseDown="PreviewContainer_MouseDown" MouseMove="PreviewContainer_MouseMove" MouseUp="PreviewContainer_MouseUp" ClipToBounds="True">
                        <Canvas x:Name="PreviewCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image x:Name="PreviewImage" Canvas.Left="0" Canvas.Top="0"/>
                        </Canvas>
                    </Grid>

                    <Border x:Name="PreviewLegend" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Background="{StaticResource Panel.Background}" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="8" Padding="10,8" Panel.ZIndex="10" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="1.5" Opacity="0.18" BlurRadius="7"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel x:Name="LegendSlabRow" Orientation="Horizontal" Margin="0,0,0,5" Cursor="Hand" MouseDown="LegendSlab_Click" ToolTip="Click to show/hide all slab outlines">
                                <Rectangle Width="14" Height="3" Fill="LimeGreen" VerticalAlignment="Center"/>
                                <TextBlock Text="Slab outline" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="LegendLineRow" Orientation="Horizontal" Margin="0,0,0,5" Cursor="Hand" MouseDown="LegendLine_Click" ToolTip="Click to show/hide all linear elements">
                                <Rectangle Width="14" Height="3" Fill="Cyan" VerticalAlignment="Center"/>
                                <TextBlock Text="Linear element" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="LegendColumnRow" Orientation="Horizontal" Cursor="Hand" MouseDown="LegendColumn_Click" ToolTip="Click to show/hide all columns">
                                <Ellipse Width="10" Height="10" Fill="Yellow" Stroke="DarkGoldenrod" StrokeThickness="1" VerticalAlignment="Center"/>
                                <TextBlock Text="Column" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Separator Margin="0,7,0,5"/>
                            <TextBlock Text="Left-click element to exclude / include" FontSize="10" FontStyle="Italic" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ZoomToolbar" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12" Panel.ZIndex="10" Visibility="Collapsed">
                        <Button Content="+" Width="28" Height="28" Click="ZoomIn_Click" Style="{StaticResource Button.Secondary}" FontSize="16" FontWeight="Bold" Padding="0" Margin="0,0,4,0" ToolTip="Zoom in (scroll wheel)"/>
                        <Button Content="-" Width="28" Height="28" Click="ZoomOut_Click" Style="{StaticResource Button.Secondary}" FontSize="16" FontWeight="Bold" Padding="0" Margin="0,0,4,0" ToolTip="Zoom out (scroll wheel)"/>
                        <Button Content="[ ]" Width="36" Height="28" Click="FitView_Click" Style="{StaticResource Button.Secondary}" FontSize="11" Padding="0" Margin="0,0,8,0" ToolTip="Fit to window (double-click)"/>
                        <Button x:Name="PreviewToggleButton" Content="Preview export"
                                Height="28" MinWidth="118" Padding="10,0"
                                Style="{StaticResource Button.Secondary}" FontSize="11"
                                Click="PreviewToggle_Click"
                                ToolTip="Toggle between the PDF source view and a preview of exactly what SAFE will import"/>
                    </StackPanel>
                    <Border x:Name="PreviewBanner"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,12,0,0" Panel.ZIndex="11"
                            Background="#1E40AF" CornerRadius="4" Padding="10,4"
                            Visibility="Collapsed">
                        <TextBlock Text="Export preview — this is what SAFE will import"
                                   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <controls:AiQueryPanel x:Name="AiChatPanel" Grid.Row="2"/>

        <Border x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100" IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource Panel.Background}" Padding="10" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Opacity="0.25" BlurRadius="10"/>
                    </Border.Effect>
                    <Canvas Width="36" Height="36">
                        <Ellipse Width="36" Height="36" Stroke="#E0E0E0" StrokeThickness="4" Fill="Transparent"/>
                        <Ellipse Width="36" Height="36" Stroke="{StaticResource Brand.Primary.Brush}" StrokeThickness="4" Fill="Transparent" StrokeDashArray="2 4" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Canvas>
                </Border>
                <TextBlock x:Name="LoadingText" Text="Loading..." Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
