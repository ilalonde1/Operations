<Window x:Class="Kor.Operations.EngineeringTools.PdfToSafe.PdfToSafeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="KOR NewerForma™ — PDF → SAFE"
        Width="1300" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="KOR NewerForma"
                            SubtitleText="PDF → SAFE"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <!-- Main content: sidebar + preview -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top controls -->
                    <StackPanel Grid.Row="0">
                        <Border Style="{StaticResource Form.SectionLabel}" Margin="0,0,0,6">
                            <TextBlock Text="Source PDF" FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <Button x:Name="LoadPdfButton"
                                Content="Load PDF..."
                                Click="LoadPdf_Click"
                                Style="{StaticResource Button.Primary}"
                                Padding="10,7"
                                HorizontalAlignment="Stretch"/>

                        <Border Background="{StaticResource Surface.Subtle}"
                                BorderBrush="{StaticResource Panel.Border}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="8,6" Margin="0,6,0,0">
                            <TextBlock x:Name="FileNameText"
                                       Text="No file loaded"
                                       Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       FontSize="12"/>
                        </Border>

                        <!-- Status badge -->
                        <Border x:Name="StatusBadge"
                                CornerRadius="6" Padding="8,6"
                                Margin="0,6,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="StatusText"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- PDF info -->
                        <StackPanel x:Name="PdfInfoPanel" Visibility="Collapsed" Margin="0,4,0,0">
                            <TextBlock x:Name="PageCountText"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock x:Name="PathCountText"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Scale input -->
                        <StackPanel x:Name="ScalePanel" Visibility="Collapsed">
                            <Separator Margin="0,10,0,8"/>
                            <Border Style="{StaticResource Form.SectionLabel}" Margin="0,0,0,6">
                                <TextBlock Text="Drawing Scale (1:X)" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBox x:Name="ScaleInput"
                                     Text="100"
                                     FontSize="13"
                                     Padding="8,5"/>
                            <TextBlock Text="e.g. 100 for 1:100, 50 for 1:50"
                                       Style="{StaticResource Form.FieldLabel}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Export results -->
                        <TextBlock x:Name="ExportResultsText"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Export button pinned to bottom -->
                    <Button x:Name="ExportDxfButton"
                            Grid.Row="2"
                            Content="Export DXF for SAFE"
                            Click="ExportDxf_Click"
                            Style="{StaticResource Button.Primary}"
                            IsEnabled="False"
                            Background="{StaticResource Brand.Accent.Brush}"
                            Padding="10,9"
                            HorizontalAlignment="Stretch"
                            />
                </Grid>
            </Border>

            <!-- Preview pane -->
            <Border Grid.Column="2"
                    Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1" CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <StackPanel x:Name="PreviewPlaceholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="64" Height="64"
                                Background="{StaticResource Surface.Subtle}"
                                BorderBrush="{StaticResource Panel.Border}"
                                BorderThickness="1" CornerRadius="12"
                                HorizontalAlignment="Center">
                            <TextBlock Text="📄" FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Load a PDF to preview"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="Vector PDFs exported from Revit or AutoCAD are supported."
                                   FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="240"/>
                    </StackPanel>

                    <Viewbox x:Name="PreviewViewbox"
                             Stretch="Uniform"
                             Visibility="Collapsed">
                        <Canvas x:Name="PreviewCanvas">
                            <Image x:Name="PreviewImage"
                                   Canvas.Left="0" Canvas.Top="0"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
