<Window x:Class="Kor.Operations.EngineeringTools.PdfToSafe.PdfToSafeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="KOR NewerForma™ — PDF → SAFE"
        Width="1300" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="KOR NewerForma"
                            SubtitleText="PDF → SAFE"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <!-- Main content: sidebar + preview -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top controls -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Form.SectionLabel}" Margin="0,0,0,6">
                            <TextBlock Text="Source PDF" FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <Button x:Name="LoadPdfButton"
                                Content="Load PDF..."
                                Click="LoadPdf_Click"
                                Style="{StaticResource Button.Primary}"
                                Padding="10,7"
                                HorizontalAlignment="Stretch"
                                ToolTip="Load a vector PDF exported from Revit or AutoCAD"/>

                        <Border Background="{StaticResource Surface.Subtle}"
                                BorderBrush="{StaticResource Panel.Border}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="8,6" Margin="0,6,0,0">
                            <TextBlock x:Name="FileNameText"
                                       Text="No file loaded"
                                       Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       FontSize="12"/>
                        </Border>

                        <!-- Page selector -->
                        <StackPanel x:Name="PageSelectorPanel"
                                    Visibility="Collapsed"
                                    Margin="0,6,0,0">
                            <TextBlock Text="Page"
                                       Style="{StaticResource Form.FieldLabel}"
                                       Margin="0,0,0,3"/>
                            <ComboBox x:Name="PageSelector"
                                      FontSize="12"
                                      SelectionChanged="PageSelector_SelectionChanged"
                                      ToolTip="Select which page of the PDF to analyse"/>
                        </StackPanel>

                        <!-- Status badge -->
                        <Border x:Name="StatusBadge"
                                CornerRadius="6" Padding="8,6"
                                Margin="0,6,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="StatusText"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- PDF info -->
                        <StackPanel x:Name="PdfInfoPanel" Visibility="Collapsed" Margin="0,4,0,0">
                            <TextBlock x:Name="PageCountText"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock x:Name="PathCountText"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Detection summary -->
                        <StackPanel x:Name="DetectionSummaryPanel"
                                    Visibility="Collapsed"
                                    Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Panel.Border}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="SlabCountText" Text="0"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="slabs" FontSize="10"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Panel.Border}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="ColumnCountText" Text="0"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="cols" FontSize="10"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4"
                                        Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Panel.Border}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="LineCountText" Text="0"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="lines" FontSize="10"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Button x:Name="ClearExclusionsButton"
                                Content="Clear exclusions"
                                Style="{StaticResource Button.Secondary}"
                                Click="ClearExclusions_Click"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                Padding="8,5"
                                FontSize="12"
                                Margin="0,6,0,0"
                                ToolTip="Restore all excluded elements and redraw the overlay"/>

                        <!-- Scale input -->
                        <StackPanel x:Name="ScalePanel" Visibility="Collapsed">
                            <Separator Margin="0,10,0,8"/>
                            <Border Style="{StaticResource Form.SectionLabel}" Margin="0,0,0,6">
                                <TextBlock Text="Drawing Scale (1:X)" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ScaleInput"
                                         Grid.Column="0"
                                         Text="100"
                                         FontSize="13"
                                         Padding="8,5"
                                         ToolTip="Enter the drawing scale denominator. The tool will auto-detect this from the PDF text if possible."/>
                                <Button x:Name="ReAnalyseButton"
                                        Grid.Column="2"
                                        Content="Apply"
                                        Style="{StaticResource Button.Secondary}"
                                        Click="ReAnalyse_Click"
                                        IsEnabled="False"
                                        Padding="10,5"
                                        ToolTip="Re-analyse with current scale and threshold settings. Any exclusions will be cleared."/>
                            </Grid>
                            <TextBlock Text="e.g. 100 for 1:100, 50 for 1:50"
                                       Style="{StaticResource Form.FieldLabel}"
                                       Margin="0,4,0,0"/>

                            <Separator Margin="0,12,0,10"/>

                            <Border Style="{StaticResource Form.SectionLabel}" Margin="0,0,0,8">
                                <TextBlock Text="Detection Thresholds" FontSize="12" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock Text="Slab min diagonal (mm)"
                                       Style="{StaticResource Form.FieldLabel}"
                                       Margin="0,0,0,3"/>
                            <TextBox x:Name="SlabMinInput"
                                     Text="1000"
                                     FontSize="13"
                                     Padding="8,5"
                                     ToolTip="Closed paths smaller than this diagonal (mm) are classified as columns. Increase if small rooms are being detected as slabs."/>

                            <TextBlock Text="Min line length (mm)"
                                       Style="{StaticResource Form.FieldLabel}"
                                       Margin="0,8,0,3"/>
                            <TextBox x:Name="LineMinInput"
                                     Text="200"
                                     FontSize="13"
                                     Padding="8,5"
                                     ToolTip="Open paths shorter than this (mm) are ignored. Decrease to capture shorter beams or walls."/>

                            <CheckBox x:Name="ExcludeGridLinesCheck"
                                      Content="Exclude grid lines"
                                      FontSize="12"
                                      Margin="0,10,0,0"
                                      ToolTip="Filters out long straight lines that span most of the drawing (Revit grid bubbles)"/>
                        </StackPanel>

                        <!-- Export results -->
                        <TextBlock x:Name="ExportResultsText"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Export button pinned to bottom -->
                    <Button x:Name="ExportDxfButton"
                            Grid.Row="2"
                            Content="Export DXF for SAFE"
                            Click="ExportDxf_Click"
                            Style="{StaticResource Button.Primary}"
                            IsEnabled="False"
                            Background="{StaticResource Brand.Accent.Brush}"
                            Padding="10,9"
                            HorizontalAlignment="Stretch"
                            ToolTip="Export geometry as a DXF file ready to import into CSI SAFE. Excluded elements will be omitted."
                            />
                </Grid>
            </Border>

            <!-- Preview pane -->
            <Border Grid.Column="2"
                    Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1" CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <StackPanel x:Name="PreviewPlaceholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="64" Height="64"
                                Background="{StaticResource Surface.Subtle}"
                                BorderBrush="{StaticResource Panel.Border}"
                                BorderThickness="1" CornerRadius="12"
                                HorizontalAlignment="Center">
                            <TextBlock Text="📄" FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Load a PDF to preview"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="Load a vector PDF exported from Revit or AutoCAD. Scale is auto-detected from PDF text. Use scroll to zoom, right-drag to pan."
                                   FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="240"/>
                    </StackPanel>

                    <Grid x:Name="PreviewViewbox"
                          Visibility="Collapsed"
                          MouseWheel="PreviewContainer_MouseWheel"
                          MouseDown="PreviewContainer_MouseDown"
                          MouseMove="PreviewContainer_MouseMove"
                          MouseUp="PreviewContainer_MouseUp"
                          ClipToBounds="True">
                        <Canvas x:Name="PreviewCanvas"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <Image x:Name="PreviewImage"
                                   Canvas.Left="0" Canvas.Top="0"/>
                        </Canvas>
                    </Grid>

                    <!-- Overlay legend -->
                    <Border x:Name="PreviewLegend"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,12,12"
                            Background="{StaticResource Panel.Background}"
                            BorderBrush="{StaticResource Panel.Border}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="10,8"
                            Panel.ZIndex="10"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="1.5" Opacity="0.18" BlurRadius="7"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Rectangle Width="14" Height="3" Fill="LimeGreen"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Slab outline" FontSize="11"
                                           Foreground="{StaticResource Text.Secondary}"
                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Rectangle Width="14" Height="3" Fill="Cyan"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Linear element" FontSize="11"
                                           Foreground="{StaticResource Text.Secondary}"
                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="Yellow"
                                         Stroke="DarkGoldenrod" StrokeThickness="1"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Column" FontSize="11"
                                           Foreground="{StaticResource Text.Secondary}"
                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Separator Margin="0,7,0,5"/>
                            <TextBlock Text="Left-click element to exclude / include"
                                       FontSize="10" FontStyle="Italic"
                                       Foreground="{StaticResource Text.Secondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ZoomToolbar"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="12,0,0,12"
                                Panel.ZIndex="10"
                                Visibility="Collapsed">
                        <Button Content="+" Width="28" Height="28"
                                Click="ZoomIn_Click"
                                Style="{StaticResource Button.Secondary}"
                                FontSize="16" FontWeight="Bold"
                                Padding="0" Margin="0,0,4,0"
                                ToolTip="Zoom in (scroll wheel)"/>
                        <Button Content="-" Width="28" Height="28"
                                Click="ZoomOut_Click"
                                Style="{StaticResource Button.Secondary}"
                                FontSize="16" FontWeight="Bold"
                                Padding="0" Margin="0,0,4,0"
                                ToolTip="Zoom out (scroll wheel)"/>
                        <Button Content="[ ]" Width="36" Height="28"
                                Click="FitView_Click"
                                Style="{StaticResource Button.Secondary}"
                                FontSize="11"
                                Padding="0"
                                ToolTip="Fit to window (double-click)"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
