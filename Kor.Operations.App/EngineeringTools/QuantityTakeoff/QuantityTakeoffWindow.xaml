<Window x:Class="Kor.Operations.EngineeringTools.QuantityTakeoff.QuantityTakeoffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOR — Quantity Takeoff &amp; Issue Delta"
        Width="940" Height="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Quantity Takeoff &amp; Issue Delta" FontSize="18" FontWeight="Bold" Foreground="#1F3864"/>
        <TextBlock Grid.Row="1" Margin="0,2,0,12" Foreground="#595959"
                   Text="Import a concrete schedule (CSV) for each issue, then generate the delta report. Columns: Level, Element, Grade, Change, Category, ConcreteM3, RebarKg."/>

        <!-- Project -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Project #:" VerticalAlignment="Center"/>
            <TextBox x:Name="Wbs1Box" Width="110" Margin="6,0,16,0" Text="31065-01"/>
            <TextBlock Text="Name:" VerticalAlignment="Center"/>
            <TextBox x:Name="ProjectNameBox" Width="240" Margin="6,0,0,0" Text="5380 Heather Street"/>
        </StackPanel>

        <!-- Before -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Import BEFORE CSV…" Padding="10,4" Click="ImportBefore_Click"/>
            <TextBox x:Name="BeforeLabelBox" Width="150" Margin="10,0,0,0" Text="IFT Addendum"/>
            <TextBlock x:Name="BeforeStatus" Text="(none loaded)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#777"/>
        </StackPanel>

        <!-- After -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Import AFTER CSV…" Padding="10,4" Click="ImportAfter_Click"/>
            <TextBox x:Name="AfterLabelBox" Width="150" Margin="10,0,0,0" Text="IFC"/>
            <TextBlock x:Name="AfterStatus" Text="(none loaded)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#777"/>
        </StackPanel>

        <!-- Generate -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="GenerateBtn" Content="Generate Delta Report (.xlsx + .docx)" Padding="16,6" FontWeight="SemiBold" Click="Generate_Click"/>
            <TextBlock x:Name="ResultStatus" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <DataGrid x:Name="PreviewGrid" Grid.Row="6" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70"/>
                <DataGridTextColumn Header="Element" Binding="{Binding ElementType}" Width="80"/>
                <DataGridTextColumn Header="Grade" Binding="{Binding GradeCode}" Width="60"/>
                <DataGridTextColumn Header="Conc. Before m³" Binding="{Binding ConcreteBeforeM3, StringFormat=N1}" Width="110"/>
                <DataGridTextColumn Header="Conc. After m³" Binding="{Binding ConcreteAfterM3, StringFormat=N1}" Width="110"/>
                <DataGridTextColumn Header="Δ Conc m³" Binding="{Binding ConcreteDeltaM3, StringFormat=N1}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
