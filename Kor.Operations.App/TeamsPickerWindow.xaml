<Window x:Class="Kor.Operations.TeamsPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Pick Teams"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Loaded="Window_Loaded">

    <!-- Candy stripe brush for alternating rows -->
    <Window.Resources>
        <!-- Light neutral stripe; tweak color if you want it closer to your theme -->
        <SolidColorBrush x:Key="GridAlternateRowBrush" Color="#FFF5F5F5" />
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="10">

        <!-- Header (identical style to ContactPickerWindow) -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brand.Primary.Brush}"
                CornerRadius="12"
                Padding="0"
                Margin="0,0,0,10">
            <controls:KorHeader x:Name="HeaderBar"
                                HeaderText="Select Teams"
                                SubtitleText="Choose one or more teams; members will be added to To / Cc"
                                AvatarDiameter="96"
                                AvatarBorderThickness="2" />
        </Border>

        <!-- Main card -->
        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel LastChildFill="True">

                <!-- Filters row (mirrors ContactPicker, plus My teams only) -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox"
                             Width="460"
                             Margin="0,0,8,0"
                             ToolTip="Search team names (min 2 chars)"
                             KeyDown="SearchBox_KeyDown" />
                    <Button x:Name="SearchBtn"
                            Content="Search"
                            Width="110"
                            Click="SearchBtn_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="ClearBtn"
                            Content="Clear"
                            Width="100"
                            Style="{StaticResource Button.Secondary}"
                            Click="ClearBtn_Click" />
                    <CheckBox x:Name="MyTeamsOnlyCheckBox"
                              Content="My teams only"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Checked="FilterChanged"
                              Unchecked="FilterChanged" />
                    <TextBlock x:Name="CountTextBlock"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Secondary}" />
                </StackPanel>

                <!-- Bottom: hint + OK/Cancel (no pager needed for teams) -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <TextBlock x:Name="TotalText"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Secondary}" />
                    <Button x:Name="OkBtn"
                            Content="OK"
                            Width="110"
                            Margin="0,0,8,0"
                            Click="OkBtn_Click" />
                    <Button x:Name="CancelBtn"
                            Content="Cancel"
                            Width="110"
                            Style="{StaticResource Button.Secondary}"
                            Click="CancelBtn_Click" />
                </StackPanel>

                <!-- Grid – styled like ContactPicker, but bound to TeamView -->
                <DataGrid x:Name="TeamsGrid"
                          ItemsSource="{Binding Items}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="TeamsGrid_MouseDoubleClick"
                          AlternationCount="2"
                          AlternatingRowBackground="{StaticResource GridAlternateRowBrush}">
                    <DataGrid.Columns>

                        <!-- Team name -->
                        <DataGridTextColumn Header="Team"
                                            Binding="{Binding Name}"
                                            Width="300" />

                        <!-- Team type -->
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding Type}"
                                            Width="220" />

                        <!-- Members count with tooltip -->
                        <DataGridTemplateColumn Header="Mem" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MemberCount}"
                                               HorizontalAlignment="Center">
                                        <TextBlock.ToolTip>
                                            <TextBlock Text="{Binding MembersTooltip}"
                                                       TextWrapping="Wrap" />
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Compact member email chips -->
                        <DataGridTemplateColumn Header="Member emails" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Members}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel IsItemsHost="True" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,4,4"
                                                            Padding="6,2"
                                                            CornerRadius="10"
                                                            Background="{StaticResource App.Background}"
                                                            BorderBrush="{StaticResource Text.Secondary}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>
    </DockPanel>
</Window>
