<Window x:Class="Kor.Operations.Compensation.CompensationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compensation Calculator"
        Width="1400"
        Height="880"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Compensation Calculator" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Trailing 12 complete months, employee contribution pool" Foreground="{StaticResource Text.Secondary}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Width="120"
                    Height="34"
                    Margin="12,0,0,0"
                    Content="Reset Row"
                    Click="ResetSelectedRow_Click"/>
        </DockPanel>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,12"
                Background="{StaticResource Panel.Background}"
                BorderBrush="{StaticResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="12">
            <UniformGrid Columns="6">
                <StackPanel Margin="8,0">
                    <TextBlock Text="Firm Revenue" Foreground="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding Firm.FirmRevenueDisplay}" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="Firm Labor" Foreground="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding Firm.FirmLaborCostDisplay}" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="Gross Profit" Foreground="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding Firm.FirmGrossProfitDisplay}" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="Bonus Pool" Foreground="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding Firm.FirmBonusPoolDisplay}" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="Firm Utilization" Foreground="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding Firm.FirmUtilizationDisplay}" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="Margin / Billable Hr" Foreground="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding Firm.EmployeeMarginPerBillableHourDisplay}" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="8"
                    Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Employees" FontWeight="Bold" Margin="8,6"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding EmployeesView}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee" Binding="{Binding FullName}" Width="180"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="140"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding AnnualizedHoursEffectiveDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Utilization" Binding="{Binding UtilizationEffectiveDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Revenue" Binding="{Binding PersonRevenueDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding PersonCostDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Contribution" Binding="{Binding ContributionScoreDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Bonus" Binding="{Binding BonusDisplay}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="12"
                    Background="{StaticResource Panel.Background}"
                    BorderBrush="{StaticResource Panel.Border}"
                    BorderThickness="1"
                    CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedRow}">
                        <TextBlock Text="{Binding FullName, TargetNullValue=Select an employee}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bonus"/>
                            <TextBlock Grid.Column="1" Text="{Binding BonusDisplay}" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Contribution Score"/>
                            <TextBlock Grid.Column="1" Text="{Binding ContributionScoreDisplay}" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bonus Share"/>
                            <TextBlock Grid.Column="1" Text="{Binding BonusShareDisplay}" FontWeight="Bold"/>
                        </Grid>

                        <Separator Margin="0,6"/>

                        <TextBlock Text="Annualized Hours" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AnnualizedHoursActualDisplay}" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,2"/>
                        <Slider Minimum="0" Maximum="2800" Value="{Binding HoursOverrideValue, Mode=TwoWay}" Margin="0,0,0,10"/>

                        <TextBlock Text="Utilization %" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UtilizationActualDisplay}" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,2"/>
                        <Slider Minimum="0" Maximum="110" Value="{Binding UtilizationOverridePercentValue, Mode=TwoWay}" Margin="0,0,0,10"/>

                        <TextBlock Text="Billing Rate" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BillingRateActualDisplay}" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,2"/>
                        <Slider Minimum="0" Maximum="600" Value="{Binding BillingRateOverrideValue, Mode=TwoWay}" Margin="0,0,0,10"/>

                        <TextBlock Text="Cost Rate" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CostRateActualDisplay}" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,2"/>
                        <Slider Minimum="0" Maximum="400" Value="{Binding CostRateOverrideValue, Mode=TwoWay}" Margin="0,0,0,10"/>

                        <TextBlock Text="Productivity Score" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProductivityScoreActualDisplay}" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,2"/>
                        <Slider Minimum="0" Maximum="100" Value="{Binding ProductivityScoreOverrideValue, Mode=TwoWay}" Margin="0,0,0,10"/>

                        <Separator Margin="0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Revenue"/>
                            <TextBlock Grid.Column="1" Text="{Binding PersonRevenueDisplay}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cost"/>
                            <TextBlock Grid.Column="1" Text="{Binding PersonCostDisplay}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Realized Profit"/>
                            <TextBlock Grid.Column="1" Text="{Binding RealizedProfitDisplay}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Expected Profit"/>
                            <TextBlock Grid.Column="1" Text="{Binding ExpectedProfitDisplay}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Revenue Scale"/>
                            <TextBlock Grid.Column="1" Text="{Binding RevenueScaleFactorDisplay}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cost Scale"/>
                            <TextBlock Grid.Column="1" Text="{Binding CostScaleFactorDisplay}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
