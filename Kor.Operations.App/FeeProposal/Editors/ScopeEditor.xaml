<UserControl x:Class="Kor.Operations.App.FeeProposal.Editors.ScopeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Heading" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Heading, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Narrative" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Narrative, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" Margin="0,4,0,10"/>
            <TextBlock Text="CAD Platform" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <ComboBox SelectedValue="{Binding CadPlatform, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,4,0,10">
                <ComboBoxItem Content="Revit/BIM LOD 300"/>
                <ComboBoxItem Content="AutoCAD"/>
                <ComboBoxItem Content="Revit/BIM LOD 300 or AutoCAD"/>
            </ComboBox>
            <TextBlock Text="Jurisdiction" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Jurisdiction, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Included Services" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <ListBox x:Name="ServicesList" Height="220">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2,0,2">
                            <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add" Width="70" Margin="0,0,8,0" Click="AddService_Click"/>
                <Button Content="Remove" Width="80" Click="RemoveService_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
