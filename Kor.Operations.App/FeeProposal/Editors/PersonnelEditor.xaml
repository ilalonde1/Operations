<UserControl x:Class="Kor.Operations.App.FeeProposal.Editors.PersonnelEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Lead Engineer" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <ComboBox x:Name="LeadCombo"
                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag}"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding LeadStaffId, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,4,0,10"/>
            <TextBlock Text="Lead Bio Override" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding LeadBioOverride, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" Margin="0,4,0,10"/>
            <TextBlock Text="Supporting Partner" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag}"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SupportingStaffId, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,4,0,10"/>
            <TextBlock Text="Supporting Bio Override" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding SupportingBioOverride, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" Margin="0,4,0,10"/>
            <TextBlock Text="Collaboration Note" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding CollaborationNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" Margin="0,4,0,10"/>
            <TextBlock Text="Additional Staff" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <ListBox x:Name="AdditionalStaffList" SelectionMode="Extended" Height="150" DisplayMemberPath="FullName"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <ComboBox x:Name="AvailableStaffCombo"
                          Width="220"
                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag}"
                          DisplayMemberPath="FullName"/>
                <Button Content="Add" Width="70" Margin="8,0,8,0" Click="AddAdditionalStaff_Click"/>
                <Button Content="Remove" Width="80" Click="RemoveAdditionalStaff_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
