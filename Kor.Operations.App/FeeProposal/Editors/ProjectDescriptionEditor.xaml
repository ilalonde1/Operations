<UserControl x:Class="Kor.Operations.App.FeeProposal.Editors.ProjectDescriptionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Heading" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Heading, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Preamble" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Preamble, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" Margin="0,4,0,10"/>
            <TextBlock Text="Assumption Bullets" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <ListBox x:Name="BulletsList" SelectionChanged="BulletsList_SelectionChanged" Height="180" DisplayMemberPath="." ItemsSource="{Binding AssumptionBullets}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <Button Content="Add" Width="70" Margin="0,0,8,0" Click="AddBullet_Click"/>
                <Button Content="Remove" Width="80" Click="RemoveBullet_Click"/>
            </StackPanel>
            <TextBlock Text="Selected Bullet" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox x:Name="SelectedBulletText" TextChanged="SelectedBulletText_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
