<UserControl x:Class="Kor.Operations.App.FeeProposal.Editors.ApprovalToProceedEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Heading" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Heading, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Intro Paragraph" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding IntroParagraph, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="170" Margin="0,4,0,10"/>
            <TextBlock Text="Invoicing Paragraph" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding InvoicingParagraph, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="170" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
