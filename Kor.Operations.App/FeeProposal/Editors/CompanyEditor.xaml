<UserControl x:Class="Kor.Operations.App.FeeProposal.Editors.CompanyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Heading" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Heading, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Sections" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <ListBox x:Name="SectionsList" Height="200" SelectionChanged="SectionsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Body}" Foreground="{StaticResource Text.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <Button Content="Add Section" Width="100" Margin="0,0,8,0" Click="AddSection_Click"/>
                <Button Content="Remove Section" Width="110" Click="RemoveSection_Click"/>
            </StackPanel>
            <TextBlock Text="Section Title" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox x:Name="SectionTitleText" TextChanged="SectionTitleText_TextChanged" Margin="0,4,0,10"/>
            <TextBlock Text="Section Body" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox x:Name="SectionBodyText" TextChanged="SectionBodyText_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" Height="220" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
