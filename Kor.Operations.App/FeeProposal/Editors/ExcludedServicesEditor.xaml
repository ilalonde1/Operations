<UserControl x:Class="Kor.Operations.App.FeeProposal.Editors.ExcludedServicesEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Heading" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Heading, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Preamble" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Preamble, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" Margin="0,4,0,10"/>
            <TextBlock Text="Excluded Items" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <ListBox x:Name="ExcludedList" SelectionChanged="ExcludedList_SelectionChanged" Height="180">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), StringFormat={}{0}. }"/>
                            <Run Text="{Binding}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <Button Content="Add" Width="70" Margin="0,0,8,0" Click="AddExcluded_Click"/>
                <Button Content="Remove" Width="80" Click="RemoveExcluded_Click"/>
            </StackPanel>
            <TextBlock Text="Selected Item" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox x:Name="SelectedExcludedText" TextChanged="SelectedExcludedText_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
