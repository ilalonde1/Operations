<UserControl x:Class="Kor.Operations.App.FeeProposal.Editors.FeeTableEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,16">

            <!-- Overview -->
            <TextBlock Text="Overview" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Heading" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Heading, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Preamble" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding Preamble, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="130" Margin="0,4,0,0"/>

            <!-- Fee Phases -->
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Panel.Border}" Margin="0,16,0,16"/>
            <TextBlock Text="Fee Phases" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox x:Name="PhasesList" Height="180" SelectionChanged="PhasesList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PhaseName}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Fee, StringFormat={}{0:N2}}" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                <Button Content="Add" Width="70" Margin="0,0,8,0" Click="AddPhase_Click"/>
                <Button Content="Remove" Width="80" Click="RemovePhase_Click"/>
            </StackPanel>
            <TextBlock Text="Phase Name" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox x:Name="PhaseNameText" TextChanged="PhaseNameText_TextChanged" Margin="0,4,0,10"/>
            <TextBlock Text="Fee ($)" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox x:Name="PhaseFeeText" TextChanged="PhaseFeeText_TextChanged" Margin="0,4,0,0" ToolTip="Enter a numeric value"/>

            <!-- Additional Details -->
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Panel.Border}" Margin="0,16,0,16"/>
            <TextBlock Text="Additional Details" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Field Review Visits" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding FieldReviewVisits, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Disbursements Allowance" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox Text="{Binding DisbursementsAllowance, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>

            <!-- Notes -->
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Panel.Border}" Margin="0,16,0,16"/>
            <TextBlock Text="Additional Notes" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox x:Name="NotesList" Height="140" SelectionChanged="NotesList_SelectionChanged" DisplayMemberPath="."/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                <Button Content="Add" Width="70" Margin="0,0,8,0" Click="AddNote_Click"/>
                <Button Content="Remove" Width="80" Click="RemoveNote_Click"/>
            </StackPanel>
            <TextBlock Text="Selected Note" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
            <TextBox x:Name="SelectedNoteText" TextChanged="SelectedNoteText_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" Height="90" Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
