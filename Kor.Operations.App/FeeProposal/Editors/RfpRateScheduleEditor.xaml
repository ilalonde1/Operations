<UserControl x:Class="Kor.Operations.App.FeeProposal.Editors.RfpRateScheduleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="RFP rate schedule" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Burden %"/><TextBox Text="{Binding BurdenPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Overhead %"/><TextBox Text="{Binding OverheadPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Profit %"/><TextBox Text="{Binding ProfitPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
                <StackPanel><TextBlock Text="Your statutory load %"/><TextBox Text="{Binding StatutoryLoadPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
            </UniformGrid>
            <TextBlock Text="Quoted hourly is the rate including overhead, before profit. Statutory load is your own comparison figure; it does not change the calculation." TextWrapping="Wrap" Margin="0,12"/>
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="Position" Binding="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Scored" Binding="{Binding Scored, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Base hourly" Binding="{Binding BaseHourly, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100"/>
                    <DataGridTextColumn Header="Quoted hourly (optional)" Binding="{Binding QuotedHourly, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Calculated hourly rates" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <DataGrid ItemsSource="{Binding Calculations}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="130">
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Scored}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Excl. OH" Binding="{Binding ExcludingOverhead, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Incl. OH" Binding="{Binding IncludingOverhead, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Incl. OH &amp; profit" Binding="{Binding IncludingOverheadAndProfit, StringFormat=N2}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
            <ItemsControl ItemsSource="{Binding Flags}" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#AD3D16" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
