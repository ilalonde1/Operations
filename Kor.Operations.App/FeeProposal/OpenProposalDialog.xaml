<Window x:Class="Kor.Operations.App.FeeProposal.OpenProposalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Proposal"
        Width="500"
        Height="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10">
            <ListBox x:Name="ProposalList"
                     ItemsSource="{Binding Proposals}"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Open" Width="84" Height="32" Margin="0,0,8,0" Click="Open_Click"/>
            <Button Content="Cancel" Width="84" Height="32" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
