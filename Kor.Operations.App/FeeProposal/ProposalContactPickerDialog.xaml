<Window x:Class="Kor.Operations.App.FeeProposal.ProposalContactPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find Contact" Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="Mulish, Segoe UI"
        Background="{StaticResource App.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Width="360" Margin="0,0,8,0"
                     MinHeight="28"
                     Padding="6,4" VerticalContentAlignment="Center"
                     KeyDown="SearchBox_KeyDown"
                     ToolTip="Name, email, or company (2+ chars)"/>
            <Button Content="Search" Style="{StaticResource Button.Primary}"
                    Width="90" Click="SearchBtn_Click"/>
        </StackPanel>

        <ListBox x:Name="ResultsList" Grid.Row="1"
                 SelectionMode="Single"
                 Cursor="Hand"
                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                 Background="{StaticResource Panel.Background}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}">
                            <Run Text="{Binding Title}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Company}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Email}" FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Style="{StaticResource Button.Primary}"
                    Width="80" Margin="0,0,8,0" Click="OkBtn_Click"/>
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}"
                    Width="80" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
