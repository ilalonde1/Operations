<Window x:Class="Kor.Operations.App.FeeProposal.FeeProposalBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fee Proposal Builder"
        Width="1680"
        Height="940"
        MinWidth="1400"
        MinHeight="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="New" Width="84" Height="32" Margin="0,0,8,0" Click="NewProposal_Click"/>
                    <Button Content="Open" Width="84" Height="32" Margin="0,0,8,0" Click="OpenProposal_Click"/>
                    <Button Content="Save" Width="84" Height="32" Margin="0,0,8,0" Click="SaveProposal_Click"/>
                    <Button Content="Manage Staff"
                            Width="112"
                            Height="32"
                            Click="ManageStaff_Click"
                            Style="{StaticResource Button.Secondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Generate DOCX"
                            Width="128"
                            Height="32"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanGenerate}"
                            Click="GenerateDocx_Click"/>
                    <Button Content="Generate PDF"
                            Width="128"
                            Height="32"
                            IsEnabled="{Binding CanGenerate}"
                            Click="GeneratePdf_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Block Library" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LibraryCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Category}" IsExpanded="True" Margin="0,0,0,8">
                                        <ListBox ItemsSource="{Binding Templates}" BorderThickness="0" Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding BlockType}" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Width="28"
                                                                Height="28"
                                                                Padding="0"
                                                                Tag="{Binding}"
                                                                Click="InsertTemplate_Click"
                                                                ToolTip="Insert block"
                                                                Style="{StaticResource Button.Secondary}">
                                                            <TextBlock Text="+" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="+ New Blank Block" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding BlockTypeNames}"
                                      SelectedItem="{Binding SelectedBlockTypeName}"
                                      MinHeight="32"
                                      Margin="0,0,0,8"/>
                            <Button Content="Add" Height="32" Click="AddBlankBlock_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Document Composer" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Document Name" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding DocumentName, UpdateSourceTrigger=PropertyChanged}" MinHeight="34"/>
                    </StackPanel>

                    <ListBox x:Name="BlockList"
                             Grid.Row="1"
                             ItemsSource="{Binding Blocks}"
                             SelectedItem="{Binding SelectedBlock}"
                             SelectionChanged="BlockList_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel.Background}"
                                        BorderBrush="{StaticResource Panel.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding TemplateName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding BlockType}" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="↑" Width="30" Height="30" Margin="0,0,6,0" Tag="{Binding}" Click="MoveBlockUp_Click"/>
                                            <Button Content="↓" Width="30" Height="30" Margin="0,0,6,0" Tag="{Binding}" Click="MoveBlockDown_Click"/>
                                            <Button Content="Save as template" Height="30" Margin="0,0,6,0" Padding="10,0" Tag="{Binding}" Click="SaveBlockAsTemplate_Click"/>
                                            <Button Content="Delete" Height="30" Padding="10,0" Tag="{Binding}" Click="DeleteBlock_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12">
                <ContentControl x:Name="BlockEditorHost"/>
            </Border>
        </Grid>
    </Grid>
</Window>
