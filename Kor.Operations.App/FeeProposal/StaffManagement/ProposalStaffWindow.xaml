<Window x:Class="Kor.Operations.App.FeeProposal.StaffManagement.ProposalStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Management"
        Width="700"
        Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Staff}"
                         SelectedItem="{Binding Selected}"
                         DisplayMemberPath="FullName"
                         BorderThickness="0"
                         Background="Transparent"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add"
                            Width="80"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="Add_Click"/>
                    <Button Content="Delete"
                            Width="80"
                            Height="32"
                            Click="Delete_Click"
                            IsEnabled="{Binding HasSelection}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12" IsEnabled="{Binding HasSelection}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Selected}">
                    <TextBlock Text="Full Name" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10"/>

                    <TextBlock Text="Credentials" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Credentials, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10"/>

                    <TextBlock Text="Title" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10"/>

                    <TextBlock Text="Email" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10"/>

                    <TextBlock Text="Phone" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10"/>

                    <TextBlock Text="Bio" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="100"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Signature Image Path" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SignatureImagePath, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Content="Browse"
                                Height="32"
                                Padding="12,0"
                                Click="BrowseSignature_Click"/>
                    </Grid>

                    <TextBlock Text="Photo Path" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PhotoPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,14"/>

                    <Button Content="Save"
                            Width="100"
                            Height="34"
                            HorizontalAlignment="Left"
                            Click="Save_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
