<Window x:Class="Kor.Operations.App.BusinessDevelopment.Reports.BdReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BD Reports"
        Width="1280"
        Height="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:KorHeader Grid.Row="0"
                            x:Name="HeaderBar"
                            Margin="2,0,2,8"
                            HeaderText="BD Reports"
                            SubtitleText="Pursuit dashboard + on-demand sector reports from live honing verdicts"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <Grid Grid.Row="1" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pursuit dashboard: verdict cards per sector -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Sectors" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Refresh"
                            HorizontalAlignment="Right"
                            Padding="14,6"
                            Click="Refresh_Click"
                            IsEnabled="{Binding IsIdle}"/>
                </Grid>

                <ListBox Grid.Row="1"
                         x:Name="SectorList"
                         ItemsSource="{Binding Sectors}"
                         SelectedItem="{Binding SelectedSector, Mode=TwoWay}"
                         SelectionChanged="SectorList_SelectionChanged"
                         HorizontalContentAlignment="Stretch"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="12">
                                            <Run Text="{Binding TotalDisplay, Mode=OneWay}"/>
                                            <Run Text="projects"/>
                                        </TextBlock>
                                    </Grid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Background="#C0392B" CornerRadius="999" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Foreground="White" FontSize="11">
                                                <Run Text="{Binding PursueUrgent, Mode=OneWay}"/>
                                                <Run Text="URGENT"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#1E8449" CornerRadius="999" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Foreground="White" FontSize="11">
                                                <Run Text="{Binding PursueDisplay, Mode=OneWay}"/>
                                                <Run Text="PURSUE"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#B7950B" CornerRadius="999" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Foreground="White" FontSize="11">
                                                <Run Text="{Binding MonitorDisplay, Mode=OneWay}"/>
                                                <Run Text="MONITOR"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#2471A3" CornerRadius="999" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Foreground="White" FontSize="11">
                                                <Run Text="{Binding DiscoverDisplay, Mode=OneWay}"/>
                                                <Run Text="DISCOVER"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#85929E" CornerRadius="999" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Foreground="White" FontSize="11">
                                                <Run Text="{Binding NotHonedDisplay, Mode=OneWay}"/>
                                                <Run Text="NOT HONED"/>
                                            </TextBlock>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A2471A3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- Report preview: WebView2 rendering of the SAME document the DOCX export uses -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Report preview" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Save DOCX…"
                            HorizontalAlignment="Right"
                            Padding="14,6"
                            Click="SaveDocx_Click"
                            IsEnabled="{Binding CanExportDocx}"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="2">
                    <wv2:WebView2 x:Name="Preview"/>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="16,8,16,12"
                   Foreground="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
</Window>
