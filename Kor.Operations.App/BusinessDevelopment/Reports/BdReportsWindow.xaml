<Window x:Class="Kor.Operations.App.BusinessDevelopment.Reports.BdReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BD Reports"
        Width="1280"
        Height="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:KorHeader Grid.Row="0"
                            x:Name="HeaderBar"
                            Margin="2,0,2,8"
                            HeaderText="BD Reports"
                            SubtitleText="Pursuit dashboard + on-demand sector reports from live honing verdicts"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <Grid Grid.Row="1" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pursuit dashboard: verdict cards per sector + analytical reports -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Sectors" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Refresh"
                            HorizontalAlignment="Right"
                            Padding="14,6"
                            Click="Refresh_Click"
                            IsEnabled="{Binding IsIdle}"/>
                </Grid>

                <!-- 2026-06-12 UX pass (ss2): compact one-row sector items so the
                     whole catalog fits without scrolling — freshness dot + title +
                     number-only verdict mini-pills; the full labeled breakdown
                     lives in the row tooltip. -->
                <ListBox Grid.Row="1"
                         x:Name="SectorList"
                         ItemsSource="{Binding Sectors}"
                         SelectedItem="{Binding SelectedSector, Mode=TwoWay}"
                         SelectionChanged="SectorList_SelectionChanged"
                         HorizontalContentAlignment="Stretch"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style x:Key="MiniPillText" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style x:Key="MiniPill" TargetType="Border">
                            <Setter Property="CornerRadius" Value="999"/>
                            <Setter Property="Padding" Value="6,1"/>
                            <Setter Property="Margin" Value="3,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0" ToolTip="{Binding SummaryTooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#1E8449"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAging}" Value="True">
                                                    <Setter Property="Fill" Value="#B7950B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasStale}" Value="True">
                                                    <Setter Property="Fill" Value="#C0392B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Border Style="{StaticResource MiniPill}" Background="#C0392B">
                                        <TextBlock Style="{StaticResource MiniPillText}" Text="{Binding PursueUrgent}"/>
                                    </Border>
                                    <Border Style="{StaticResource MiniPill}" Background="#1E8449">
                                        <TextBlock Style="{StaticResource MiniPillText}" Text="{Binding PursueDisplay}"/>
                                    </Border>
                                    <Border Style="{StaticResource MiniPill}" Background="#B7950B">
                                        <TextBlock Style="{StaticResource MiniPillText}" Text="{Binding MonitorDisplay}"/>
                                    </Border>
                                    <Border Style="{StaticResource MiniPill}" Background="#2471A3">
                                        <TextBlock Style="{StaticResource MiniPillText}" Text="{Binding DiscoverDisplay}"/>
                                    </Border>
                                    <Border Style="{StaticResource MiniPill}" Background="#85929E">
                                        <TextBlock Style="{StaticResource MiniPillText}" Text="{Binding NotHonedDisplay}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding TotalDisplay, Mode=OneWay}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           MinWidth="32"
                                           TextAlignment="Right"
                                           Margin="8,0,2,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0D2471A3"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A2471A3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Grid.Row="2" Text="Analytical reports" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8"/>
                <!-- 2026-06-12 UX pass (ss2): flat menu rows, no cards — the
                     description lives in the tooltip. -->
                <ListBox Grid.Row="3"
                         x:Name="AnalyticalList"
                         ItemsSource="{Binding AnalyticalReports}"
                         SelectedItem="{Binding SelectedAnalytical, Mode=TwoWay}"
                         SelectionChanged="AnalyticalList_SelectionChanged"
                         HorizontalContentAlignment="Stretch"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding Description}"
                                       Margin="2,0"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0D2471A3"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A2471A3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- Report preview: WebView2 rendering of the SAME document the DOCX export uses -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Report preview" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Save DOCX…"
                            HorizontalAlignment="Right"
                            Padding="14,6"
                            Click="SaveDocx_Click"
                            IsEnabled="{Binding CanExportDocx}"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="2">
                    <wv2:WebView2 x:Name="Preview"/>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="16,8,16,12"
                   Foreground="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
</Window>
