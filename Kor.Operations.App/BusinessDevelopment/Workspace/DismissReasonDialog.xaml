<Window x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.DismissReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Not for us"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TargetText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Why is this not for us?" Margin="0,0,0,4"/>
            <ComboBox x:Name="ReasonBox" SelectedIndex="0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Note (optional)" Margin="0,0,0,4"/>
            <TextBox x:Name="NoteBox" Padding="10,0" Height="28" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Remove it" Width="110" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
