<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.AttributionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="View_Loaded"
             Unloaded="View_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brand.Primary.Brush}"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Refresh" Width="100" Click="RefreshButton_Click"/>
        </StackPanel>

        <!-- Stat tiles -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Border Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="{Binding WinsDisplay}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Wins (CRM)" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="{Binding WonFeeDisplay}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Won fee (proposed)" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="{Binding ActiveDisplay}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Active pursuits" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="{Binding SubmittedDisplay}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Submitted" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatTile}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding WinRateDisplay}" Style="{StaticResource StatValue}" FontSize="16"/>
                    <TextBlock Text="Win rate" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Honest maturity note -->
        <Border Grid.Row="2" Margin="0,0,0,8" Padding="10,6"
                Background="#FFF7E6" BorderBrush="#E0C078" BorderThickness="1" CornerRadius="3"
                Visibility="{Binding HasMaturityNote, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding MaturityNote}" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <!-- Breakdowns -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Wins by source feed" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Brand.Primary.Brush}" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" ItemsSource="{Binding BySource}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source"  Binding="{Binding Source}"                 Width="*"/>
                            <DataGridTextColumn Header="Wins"    Binding="{Binding Wins}"                   Width="70"/>
                            <DataGridTextColumn Header="Won fee" Binding="{Binding WonFee, StringFormat={}{0:C0}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Wins by owner" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Brand.Primary.Brush}" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" ItemsSource="{Binding ByOwner}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Owner"   Binding="{Binding Owner}"                  Width="*"/>
                            <DataGridTextColumn Header="Wins"    Binding="{Binding Wins}"                   Width="70"/>
                            <DataGridTextColumn Header="Won fee" Binding="{Binding WonFee, StringFormat={}{0:C0}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Padding="2,8,2,0" Background="Transparent">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
        </Border>
    </Grid>
</UserControl>
