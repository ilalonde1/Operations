<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource App.Background}"
             Loaded="AdminView_Loaded"
             Unloaded="AdminView_Unloaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Sources &amp; Schedules" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          ItemsSource="{Binding Sources}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding SourceType}" Width="130"/>
                        <DataGridTextColumn Header="Delay (s)" Binding="{Binding CrawlDelaySeconds}" Width="90"/>
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="Base URL" Binding="{Binding BaseUrl}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Scheduled Jobs" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          ItemsSource="{Binding ScheduledJobs}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job" Binding="{Binding JobName}" Width="240"/>
                        <DataGridTextColumn Header="Cron" Binding="{Binding CronSchedule}" Width="150"/>
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="Last run" Binding="{Binding LastRun}" Width="130"/>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Recent Ingestion Runs" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              ItemsSource="{Binding RecentRuns}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="190"/>
                            <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Inserted" Binding="{Binding InsertedCount}" Width="75"/>
                            <DataGridTextColumn Header="Dupes" Binding="{Binding DuplicateCount}" Width="65"/>
                            <DataGridTextColumn Header="Skipped" Binding="{Binding SkippedCount}" Width="75"/>
                            <DataGridTextColumn Header="Failed" Binding="{Binding FailedCount}" Width="65"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Data Health" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              ItemsSource="{Binding Health}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
</UserControl>
