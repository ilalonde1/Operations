<Window x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.PursuitBriefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:local="clr-namespace:Kor.Operations.App.BusinessDevelopment.Workspace"
        Title="Pursuit Brief"
        Width="820"
        Height="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:PlaceholderBrushConverter x:Key="PlaceholderBrush"/>
        <local:SeatStatusBrushConverter x:Key="SeatStatusBrush"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Round 52: header standardized to AvatarDiameter=96 (matches Home,
             Engineering Tools, PM Tools, BD hub). Export PDF moved out of the
             header overlay into its own toolbar row below the band so it sits
             on a neutral surface, not jammed against the avatar. -->
        <controls:KorHeader Grid.Row="0"
                            x:Name="HeaderBar"
                            Margin="2,0,2,8"
                            HeaderText="Pursuit Brief"
                            SubtitleText="{Binding ProjectName}"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,18,8">
            <Button Content="Export PDF"
                    Padding="14,7"
                    Click="ExportPdf_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Brief.Project.ProjectName}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Right"
                                        MaxWidth="260">
                                <Border Background="{Binding Brief.Architect.SeatStatus, Converter={StaticResource SeatStatusBrush}}"
                                        CornerRadius="999"
                                        Padding="12,5"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SeatStatusDisplay}"
                                               FontWeight="Bold"
                                               Typography.Capitals="AllSmallCaps"/>
                                </Border>
                                <TextBlock Text="{Binding SeatPriorityDisplay}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding HasSeatPriority, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Owner" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.Project.Owner}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Market" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.Project.Market}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="City" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.Project.City}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Sector" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.Project.Sector}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Stage" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.Project.Stage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Est. cost" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.Project.EstCostDisplay}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Margin="0,18,12,8">
                                <Hyperlink NavigateUri="{Binding Brief.Project.SourceUrl}" RequestNavigate="OnHyperlinkRequestNavigate">Open source</Hyperlink>
                            </TextBlock>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="How it's bought" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="No procurement profile on file for this owner."
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontStyle="Italic"
                                   Visibility="{Binding NoProcurementProfile, Converter={StaticResource BoolToVis}}"/>
                        <UniformGrid Columns="2" Visibility="{Binding HasProcurementProfile, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Procurement method" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.OwnerProcurement.ProcurementMethod}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Roster program" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.OwnerProcurement.RosterProgram}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Evaluation criteria" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.OwnerProcurement.EvaluationCriteria}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Budget cadence" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Brief.OwnerProcurement.BudgetCadence}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Likely prime &amp; structural seat" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <TextBlock Text="{Binding Brief.Architect.ArchitectName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,12,8"/>
                            <Border Background="{Binding Brief.Architect.SeatStatus, Converter={StaticResource SeatStatusBrush}}"
                                    CornerRadius="999"
                                    Padding="10,4"
                                    Margin="0,0,12,8">
                                <TextBlock Text="{Binding SeatStatusDisplay}" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding SeatPriorityDisplay}" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,8"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Brief.Architect.DisplacementRead}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="Architect warmth" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <TextBlock Text="{Binding ArchitectWarmthDisplay}"
                                   Foreground="{Binding ArchitectWarmthIsPlaceholder, Converter={StaticResource PlaceholderBrush}}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,10"/>
                        <TextBlock Text="Recurring structural partners" Foreground="{StaticResource Text.Secondary}" FontSize="11"/>
                        <ItemsControl ItemsSource="{Binding Brief.Architect.RecurringStructuralPartners}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Who to call" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Architect contacts" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Brief.ArchitectContacts}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Role, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Email, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Owner contacts" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Brief.OwnerContacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Role, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Email, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="KOR knows at the owner" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding OwnerContactsDisplay}"
                                   Foreground="{Binding OwnerContactsIsPlaceholder, Converter={StaticResource PlaceholderBrush}}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Competition" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Owner BD record" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding OwnerBdRecordDisplay}"
                                   Foreground="{Binding OwnerBdRecordIsPlaceholder, Converter={StaticResource PlaceholderBrush}}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Brief.CompetitorNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="{Binding Firm, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding CapacityRead, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="KOR's edge" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding KorEdgeDisplay}"
                                   Foreground="{Binding KorEdgeIsPlaceholder, Converter={StaticResource PlaceholderBrush}}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="The play / fit" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding ThePlayDisplay}"
                                   Foreground="{Binding ThePlayIsPlaceholder, Converter={StaticResource PlaceholderBrush}}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <TextBlock Foreground="{Binding FitScoreIsPlaceholder, Converter={StaticResource PlaceholderBrush}}">
                            <Run Text="Fit score: "/>
                            <Run Text="{Binding FitScoreDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Margin="16,8,16,12"
                   Foreground="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
</Window>
