<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fin="clr-namespace:Kor.Operations.Financials"
             Background="{StaticResource App.Background}"
             ToolTipService.InitialShowDelay="200"
             ToolTipService.ShowDuration="20000"
             Loaded="DashboardView_Loaded"
             Unloaded="DashboardView_Unloaded">
    <!-- 2026-10-13 clarity pass ("Clarity is King"). The dashboard answers three
         questions and shows the funnel's three numbers, nothing else:
           what is closing  -> Closing soon (next 30 days, countdown, double-click = the RFP)
           what is new      -> New RFPs (latest 15, double-click = the RFP)
           what should I do -> Priority Actions (collapsed, count in the header)
         Thirteen blocks became four. The pipeline charts and the five stat tiles
         moved to the Pipeline window (one bar template there), the open-seats list
         to Relationships, competitor watch to Competition. The forward-pipeline
         panel went: Future Projects IS that list. -->
    <UserControl.Resources>
        <!-- Every clickable list reads as clickable: Hand cursor + slate hover. -->
        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDEEF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Funnel badge: a coloured, clickable card. Each routes to the Pipeline
             window pre-filtered to the funnel stage its count came from. -->
        <Style x:Key="FunnelBadgeButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small "ⓘ" badge: this number has a definition (hover for it). -->
        <Style x:Key="InfoBadgeOverlay" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: the funnel, three numbers. Click one to open the Pipeline window on that stage. -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource FunnelBadgeButton}"
                    Background="{StaticResource Brand.Accent.Brush}"
                    Padding="16" Margin="0,0,10,0"
                    Click="OpenSeatsTile_Click"
                    ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_OpenSeats}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Reachable Now" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="Act now — structural seat open" Foreground="#FFE4DA" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding OpenSeatCountDisplay}"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource InfoBadgeOverlay}">
                        <TextBlock Text="ⓘ" Foreground="White" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource FunnelBadgeButton}"
                    Background="{StaticResource Brand.Primary.Brush}"
                    Padding="14" Margin="0,0,10,0"
                    Click="InBidWindowTile_Click"
                    ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_InBidWindow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="In Bidding" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Being procured now" Foreground="#C8D2DE" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding BidWindowCountDisplay}"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource InfoBadgeOverlay}">
                        <TextBlock Text="ⓘ" Foreground="White" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource FunnelBadgeButton}"
                    Background="#6B7280"
                    Padding="14"
                    Click="RadarTile_Click"
                    ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_Radar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Watching" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Longer-term — keep an eye on" Foreground="#E0E2E4" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding RadarCountDisplay}"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource InfoBadgeOverlay}">
                        <TextBlock Text="ⓘ" Foreground="White" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <!-- Row 1: what is closing. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8">
                    <Run Text="Closing soon"/>
                    <Run Text="  next 30 days · double-click opens the RFP" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Text.Secondary}"/>
                </TextBlock>
                <ListBox Grid.Row="1"
                         x:Name="DeadlinesList"
                         ItemsSource="{Binding Deadlines}"
                         BorderThickness="0"
                         MaxHeight="340"
                         MouseDoubleClick="DeadlinesList_MouseDoubleClick"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EDEEF1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Text.Secondary}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource Brand.Accent.Brush}" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                        <Run Text="{Binding Countdown, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1"
                           Text="Nothing closes in the next 30 days."
                           Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0,18,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDeadlines}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Row 2: what is new. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"
                ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_LatestRfps}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="Help"
                           ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_LatestRfps}">
                    <Run Text="New RFPs"/>
                    <Run Text="  latest 15 · double-click opens the RFP" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Text.Secondary}"/>
                </TextBlock>
                <DataGrid Grid.Row="1"
                          x:Name="LatestRfpsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          MaxHeight="420"
                          ItemsSource="{Binding LatestRfps}"
                          MouseDoubleClick="LatestRfpsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                        <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="180"/>
                        <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Closes" Binding="{Binding Deadline}" Width="190"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Row 3: what should I do. Collapsed by default; the header carries the count. -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Expander x:Name="PriorityActionsExpander"
                      IsExpanded="False"
                      Expanded="PriorityActionsExpander_Toggled"
                      Collapsed="PriorityActionsExpander_Toggled">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Priority Actions"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Background="{StaticResource Brand.Accent.Brush}"
                                CornerRadius="9" Padding="6,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PriorityActionsCount, StringFormat='({0})'}"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="Suggested next moves — mark done, or start a pursuit"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Province:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Text.Secondary}"/>
                    <ComboBox Grid.Column="1" x:Name="PriorityProvinceCombo" Height="26"
                              ItemsSource="{Binding PriorityProvinceOptions}"
                              SelectedIndex="0"
                              SelectionChanged="PriorityFilter_Changed"/>
                    <TextBlock Grid.Column="3" Text="Type:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Text.Secondary}"/>
                    <ComboBox Grid.Column="4" x:Name="PriorityTypeCombo" Height="26"
                              ItemsSource="{Binding PriorityActionTypeOptions}"
                              SelectedIndex="0"
                              SelectionChanged="PriorityFilter_Changed"/>
                    <TextBlock Grid.Column="6" Text="Min confidence:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Text.Secondary}"/>
                    <ComboBox Grid.Column="7" x:Name="PriorityConfidenceCombo" Height="26"
                              ItemsSource="{Binding PriorityConfidenceOptions}"
                              SelectedIndex="0"
                              SelectionChanged="PriorityFilter_Changed"/>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding PriorityActions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <Button Content="{Binding OrgDisplayName}"
                                                    Click="PriorityAction_OpenOrg_Click"
                                                    Tag="{Binding}"
                                                    FontWeight="SemiBold" FontSize="13"
                                                    Foreground="{StaticResource Brand.Primary.Brush}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                                    ToolTip="Open Org Dossier"/>
                                            <TextBlock Text="{Binding OrgKind}" FontSize="10" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#EDEEF1" CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock FontSize="10" Foreground="{StaticResource Text.Secondary}"
                                                           Text="{Binding Confidence}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2,8,0">
                                            <Run FontWeight="SemiBold" Text="{Binding ActionType, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Recommendation, Mode=OneWay}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                       Text="{Binding TargetPersonName, StringFormat=target: {0}}"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                       Text="{Binding TimingNotes, StringFormat=timing: {0}}"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                       Text="{Binding RefreshedAtUtc, StringFormat=as of {0:yyyy-MM-dd}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✓ Done" Click="PriorityAction_Done_Click" Tag="{Binding}"
                                                Padding="8,4" Margin="0,0,4,0" FontSize="11"
                                                ToolTip="Mark this action as done."/>
                                        <Button Content="✕ Dismiss" Click="PriorityAction_Dismiss_Click" Tag="{Binding}"
                                                Padding="8,4" Margin="0,0,4,0" FontSize="11"
                                                ToolTip="Dismiss this recommendation."/>
                                        <Button Content="→ Dossier" Click="PriorityAction_OpenCrm_Click" Tag="{Binding}"
                                                Padding="8,4" FontSize="11"
                                                ToolTip="Open the org intel dossier (people, signals, KOR track record)."/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="1"
                           Text="No open priority actions match the current filters."
                           Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0,18,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPriorityActions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            </Expander>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Margin="0,0,0,0"
                   Foreground="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
    </ScrollViewer>
</UserControl>
