<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kor.Operations.App.BusinessDevelopment.Workspace"
             Background="{StaticResource App.Background}"
             Loaded="DashboardView_Loaded"
             Unloaded="DashboardView_Unloaded">
    <UserControl.Resources>
        <local:BarHeightConverter x:Key="BarHeight" MaxHeight="120"/>
        <local:MillionsCurrencyConverter x:Key="MillionsCurrency"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalPipelineDisplay}" FontSize="28" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                    <TextBlock Text="Total pipeline" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding OpenRfpsDisplay}" FontSize="28" FontWeight="SemiBold" Foreground="#2563EB"/>
                    <TextBlock Text="Open RFPs" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding UpcomingProjectsDisplay}" FontSize="28" FontWeight="SemiBold" Foreground="#7C3AED"/>
                    <TextBlock Text="Upcoming projects" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding ClosingSoonDisplay}" FontSize="28" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                    <TextBlock Text="Closing within 7 days" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="{Binding PipelineValueDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="#2563EB"/>
                    <TextBlock Text="Pipeline value" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Latest RFPs" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              ItemsSource="{Binding LatestRfps}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="180"/>
                            <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Pipeline by sector" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SectorBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="48" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="#2563EB"
                                                CornerRadius="3,3,0,0"
                                                Width="22"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="By market" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MarketBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="44" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="#7C3AED"
                                                CornerRadius="3,3,0,0"
                                                Width="22"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Deadlines next 30 days" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Deadlines}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11">
                                            <Run Text="{Binding Province, Mode=OneWay}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Deadline, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1E3A8A" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                            <Run Text="{Binding DaysLeft, Mode=OneWay}"/>
                                            <Run Text="d"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="By Stage" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding StageBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="48" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="#2563EB"
                                                CornerRadius="3,3,0,0"
                                                Width="22"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Value by Market ($M)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MarketValueBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="48" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="#7C3AED"
                                                CornerRadius="3,3,0,0"
                                                Width="22"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Converter={StaticResource MillionsCurrency}, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Deadlines - Next 6 Months" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DeadlineMonthBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="48" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="#1E3A8A"
                                                CornerRadius="3,3,0,0"
                                                Width="22"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Open Structural Seats" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              ItemsSource="{Binding OpenStructuralSeats}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Architect" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Market" Binding="{Binding Market}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Read" Binding="{Binding DisplacementRead}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Forward Pipeline" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MouseDoubleClick="ForwardPipelineGrid_MouseDoubleClick"
                              ItemsSource="{Binding ForwardPipeline}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="*"/>
                            <DataGridTextColumn Header="Proponent" Binding="{Binding ProponentName}" Width="140"/>
                            <DataGridTextColumn Header="Prov" Binding="{Binding Province}" Width="55"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding CostDisplay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Competitor Watch" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              ItemsSource="{Binding CompetitorWatch}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Firm" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Capacity Read" Binding="{Binding CapacityRead}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
    </ScrollViewer>
</UserControl>
