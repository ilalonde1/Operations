<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kor.Operations.App.BusinessDevelopment.Workspace"
             xmlns:fin="clr-namespace:Kor.Operations.Financials"
             Background="{StaticResource App.Background}"
             ToolTipService.InitialShowDelay="200"
             ToolTipService.ShowDuration="20000"
             Loaded="DashboardView_Loaded"
             Unloaded="DashboardView_Unloaded">
    <UserControl.Resources>
        <local:BarHeightConverter x:Key="BarHeight" MaxHeight="120"/>
        <local:MillionsCurrencyConverter x:Key="MillionsCurrency"/>

        <!-- Dashboard-scoped DataGridRow: Hand cursor + slate hover so every
             clickable list reads as clickable. Chart cards use ItemsControl,
             not DataGrid, so this only hits the list panels. -->
        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDEEF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stat tile rendered as a clickable button. Mimics the Card visual
             (white bg, panel border, rounded corners) but fires Click + has
             a Hand cursor + slate hover so the big synopsis numbers read as
             drillable buttons. -->
        <Style x:Key="Card.StatButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Panel.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDEEF1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.Primary.Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round 56: funnel badge style — Button that preserves the colored
             card visual via TemplateBinding on Background, gives Cursor=Hand,
             and adds a subtle hover dim. Lets the whole badge be clickable
             so Open Seats / In Bid Window / Radar can navigate to Forward
             Pipeline like the Row 2 stat tiles. -->
        <Style x:Key="FunnelBadgeButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round 56: standard info-circle pattern, mirrored from
             WorkloadMeetingWindow.xaml so every module uses the same hover
             affordance for "this has a definition". The icon is overlaid as
             a small "ⓘ" badge in the corner of clickable tiles (Cursor=Hand
             stays on the parent so hover still feels clickable, not just
             "info"). -->
        <Style x:Key="InfoBadgeOverlay" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Bar inside the bar-chart ItemsControl rendered as a transparent
             button so clicking the bar drills into the relevant screen. -->
        <Style x:Key="Chart.BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- R82 Row 0: Priority Actions queue. Top-25 open IntelAction rows
             ranked High→Low confidence + recency. Per-row Done/Dismiss/CRM
             buttons. Filters at the header. 2026-06-12 UX pass: the list got
             long with live data, so the card collapses by default — the
             header keeps the count visible; expand state persists for the
             app session (static field in code-behind, no settings plumbing). -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Expander x:Name="PriorityActionsExpander"
                      IsExpanded="False"
                      Expanded="PriorityActionsExpander_Toggled"
                      Collapsed="PriorityActionsExpander_Toggled">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Priority Actions"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Background="{StaticResource Brand.Accent.Brush}"
                                CornerRadius="9" Padding="6,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PriorityActionsCount, StringFormat='({0})'}"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="top open recommendations across all orgs — acknowledge or move to CRM"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Province:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Text.Secondary}"/>
                    <ComboBox Grid.Column="1" x:Name="PriorityProvinceCombo" Height="26"
                              ItemsSource="{Binding PriorityProvinceOptions}"
                              SelectedIndex="0"
                              SelectionChanged="PriorityFilter_Changed"/>
                    <TextBlock Grid.Column="3" Text="Type:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Text.Secondary}"/>
                    <ComboBox Grid.Column="4" x:Name="PriorityTypeCombo" Height="26"
                              ItemsSource="{Binding PriorityActionTypeOptions}"
                              SelectedIndex="0"
                              SelectionChanged="PriorityFilter_Changed"/>
                    <TextBlock Grid.Column="6" Text="Min confidence:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Text.Secondary}"/>
                    <ComboBox Grid.Column="7" x:Name="PriorityConfidenceCombo" Height="26"
                              ItemsSource="{Binding PriorityConfidenceOptions}"
                              SelectedIndex="0"
                              SelectionChanged="PriorityFilter_Changed"/>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding PriorityActions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <Button Content="{Binding OrgDisplayName}"
                                                    Click="PriorityAction_OpenOrg_Click"
                                                    Tag="{Binding}"
                                                    FontWeight="SemiBold" FontSize="13"
                                                    Foreground="{StaticResource Brand.Primary.Brush}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                                    ToolTip="Open Org Dossier"/>
                                            <TextBlock Text="{Binding OrgKind}" FontSize="10" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#EDEEF1" CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock FontSize="10" Foreground="{StaticResource Text.Secondary}"
                                                           Text="{Binding Confidence}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2,8,0">
                                            <Run FontWeight="SemiBold" Text="{Binding ActionType, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Recommendation, Mode=OneWay}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                       Text="{Binding TargetPersonName, StringFormat=target: {0}}"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                       Text="{Binding TimingNotes, StringFormat=timing: {0}}"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                       Text="{Binding RefreshedAtUtc, StringFormat=as of {0:yyyy-MM-dd}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✓ Done" Click="PriorityAction_Done_Click" Tag="{Binding}"
                                                Padding="8,4" Margin="0,0,4,0" FontSize="11"
                                                ToolTip="Mark this action as done."/>
                                        <Button Content="✕ Dismiss" Click="PriorityAction_Dismiss_Click" Tag="{Binding}"
                                                Padding="8,4" Margin="0,0,4,0" FontSize="11"
                                                ToolTip="Dismiss this recommendation."/>
                                        <Button Content="→ CRM" Click="PriorityAction_OpenCrm_Click" Tag="{Binding}"
                                                Padding="8,4" FontSize="11"
                                                ToolTip="Open the CRM panel for this org."/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="1"
                           Text="No open priority actions match the current filters."
                           Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0,18,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPriorityActions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            </Expander>
        </Border>

        <!-- Row 1: Pipeline Funnel hero -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Pipeline Funnel" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="1.05*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Round 56: funnel badges promoted from <Border> to
                         clickable <Button>. Each routes to Forward Pipeline
                         (the MPI viewer those counts come from) — same
                         convention as the Row 2 stat tiles below. Tooltip
                         on the Button still resolves to the methodology
                         entry via FinancialMetricTooltip; the small "ⓘ"
                         overlay marks "has a definition" without competing
                         with the badge's primary read. -->
                    <Button Grid.Column="0" Style="{StaticResource FunnelBadgeButton}"
                            Background="{StaticResource Brand.Accent.Brush}"
                            Padding="16" Margin="0,0,10,0"
                            Click="OpenSeatsTile_Click"
                            ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_OpenSeats}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Open Seats" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Act now" Foreground="#FFE4DA" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding OpenSeatCountDisplay}"
                                       Foreground="White"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoBadgeOverlay}">
                                <TextBlock Text="ⓘ" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource FunnelBadgeButton}"
                            Background="{StaticResource Brand.Primary.Brush}"
                            Padding="14" Margin="0,0,10,0"
                            Click="InBidWindowTile_Click"
                            ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_InBidWindow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="In Bid Window" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Procurement / design" Foreground="#C8D2DE" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding BidWindowCountDisplay}"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoBadgeOverlay}">
                                <TextBlock Text="ⓘ" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource FunnelBadgeButton}"
                            Background="#6B7280"
                            Padding="14"
                            Click="RadarTile_Click"
                            ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_Radar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Radar" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Watch" Foreground="#E0E2E4" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RadarCountDisplay}"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource InfoBadgeOverlay}">
                                <TextBlock Text="ⓘ" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 2: 5 stat tiles -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource Card.StatButton}" Margin="0,0,8,0"
                    Click="TotalPipelineTile_Click"
                    ToolTip="Open Forward Pipeline">
                <StackPanel>
                    <TextBlock Text="{Binding TotalPipelineDisplay}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>
                    <TextBlock Text="Total pipeline" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource Card.StatButton}" Margin="0,0,8,0"
                    Click="OpenRfpsTile_Click"
                    ToolTip="Open RFPs screen">
                <StackPanel>
                    <TextBlock Text="{Binding OpenRfpsDisplay}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>
                    <TextBlock Text="Open RFPs" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource Card.StatButton}" Margin="0,0,8,0"
                    Click="UpcomingProjectsTile_Click"
                    ToolTip="Open Forward Pipeline">
                <StackPanel>
                    <TextBlock Text="{Binding UpcomingProjectsDisplay}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>
                    <TextBlock Text="Upcoming projects" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Style="{StaticResource Card.StatButton}" Margin="0,0,8,0"
                    Click="ClosingSoonTile_Click"
                    ToolTip="Open RFPs screen">
                <StackPanel>
                    <TextBlock Text="{Binding ClosingSoonDisplay}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>
                    <TextBlock Text="Closing within 7 days" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource Card.StatButton}"
                    Click="PipelineValueTile_Click"
                    ToolTip="Open Forward Pipeline">
                <StackPanel>
                    <TextBlock Text="{Binding PipelineValueDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}"/>
                    <TextBlock Text="Pipeline value" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 3: Latest RFPs (clickable) + Pipeline by sector chart -->
        <Grid Grid.Row="3" Margin="0,0,0,12" Height="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0"
                    ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_LatestRfps}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="Help"
                               ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_LatestRfps}">
                        <Run Text="Latest RFPs"/>
                        <Run Text="  double-click to open" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Text.Secondary}"/>
                    </TextBlock>
                    <DataGrid Grid.Row="1"
                              x:Name="LatestRfpsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              ItemsSource="{Binding LatestRfps}"
                              MouseDoubleClick="LatestRfpsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="180"/>
                            <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Button Grid.Column="1" Style="{StaticResource Card.StatButton}" Padding="12"
                    Click="SectorChart_Click"
                    ToolTip="Open Forward Pipeline">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Pipeline by sector" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SectorBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="48" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Style="{StaticResource Chart.BarButton}"
                                                Tag="{Binding Label}"
                                                Click="Bar_Click"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                        <Border Background="{StaticResource Brand.Primary.Brush}"
                                                CornerRadius="3,3,0,0"
                                                Width="22">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        </Button>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Button>
        </Grid>

        <!-- Row 4: 3 clickable lists side-by-side — Open Structural Seats /
             Forward Pipeline / Competitor Watch. Competitor capacity-read
             column wraps + uses the muted slate so it's readable at a glance. -->
        <Grid Grid.Row="4" Margin="0,0,0,12" Height="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="Help"
                               ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_OpenStructuralSeats}">
                        <Run Text="Open Structural Seats"/>
                        <Run Text="  double-click to open dossier" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Text.Secondary}"/>
                    </TextBlock>
                    <DataGrid Grid.Row="1"
                              x:Name="OpenStructuralSeatsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              ItemsSource="{Binding OpenStructuralSeats}"
                              MouseDoubleClick="OpenStructuralSeatsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Architect" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Market" Binding="{Binding Market}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTemplateColumn Header="Read" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplacementRead}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="11"
                                                   Padding="4,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="Help"
                               ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_ForwardPipeline}">
                        <Run Text="Forward Pipeline"/>
                        <Run Text="  double-click for brief" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Text.Secondary}"/>
                    </TextBlock>
                    <DataGrid Grid.Row="1"
                              x:Name="ForwardPipelineGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MouseDoubleClick="ForwardPipelineGrid_MouseDoubleClick"
                              ItemsSource="{Binding ForwardPipeline}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="*"/>
                            <DataGridTextColumn Header="Proponent" Binding="{Binding ProponentName}" Width="140"/>
                            <DataGridTextColumn Header="Prov" Binding="{Binding Province}" Width="55"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding CostDisplay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="Help"
                               ToolTip="{fin:FinancialMetricTooltip Key=BdDashboard_CompetitorWatch}">
                        <Run Text="Competitor Watch"/>
                        <Run Text="  double-click to open dossier" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Text.Secondary}"/>
                    </TextBlock>
                    <DataGrid Grid.Row="1"
                              x:Name="CompetitorWatchGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              ItemsSource="{Binding CompetitorWatch}"
                              MouseDoubleClick="CompetitorWatchGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Firm" Binding="{Binding DisplayName}" Width="170"/>
                            <DataGridTemplateColumn Header="Capacity Read" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CapacityRead}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="11"
                                                   Padding="4,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 5: Bar-chart row — By market / By Stage / Value by Market -->
        <Grid Grid.Row="5" Margin="0,0,0,12" Height="220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource Card.StatButton}" Padding="12" Margin="0,0,12,0"
                    Click="MarketChart_Click"
                    ToolTip="Open Forward Pipeline">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="By market" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MarketBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="44" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Style="{StaticResource Chart.BarButton}"
                                                Tag="{Binding Label}"
                                                Click="Bar_Click"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                        <Border Background="{StaticResource Brand.Primary.Brush}"
                                                CornerRadius="3,3,0,0"
                                                Width="22">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        </Button>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource Card.StatButton}" Padding="12" Margin="0,0,12,0"
                    Click="StageChart_Click"
                    ToolTip="Open Forward Pipeline">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="By Stage" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding StageBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="48" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Style="{StaticResource Chart.BarButton}"
                                                Tag="{Binding Label}"
                                                Click="Bar_Click"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                        <Border Background="{StaticResource Brand.Primary.Brush}"
                                                CornerRadius="3,3,0,0"
                                                Width="22">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        </Button>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource Card.StatButton}" Padding="12"
                    Click="MarketValueChart_Click"
                    ToolTip="Open Forward Pipeline">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Value by Market ($M)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MarketValueBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="48" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Style="{StaticResource Chart.BarButton}"
                                                Tag="{Binding Label}"
                                                Click="Bar_Click"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                        <Border Background="{StaticResource Brand.Primary.Brush}"
                                                CornerRadius="3,3,0,0"
                                                Width="22">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Converter={StaticResource MillionsCurrency}, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        </Button>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Button>
        </Grid>

        <!-- Row 5: Deadlines (30-day clickable list + 6-month histogram).
             Moved below the big tables/charts so it doesn't squeeze them.
             ListBox is height-capped so 20+ items scroll inside, not push the
             dashboard. -->
        <Grid Grid.Row="6" Margin="0,0,0,0" Height="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8">
                        <Run Text="Deadlines next 30 days"/>
                        <Run Text="  double-click to open" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Text.Secondary}"/>
                    </TextBlock>
                    <ListBox Grid.Row="1"
                             x:Name="DeadlinesList"
                             ItemsSource="{Binding Deadlines}"
                             BorderThickness="0"
                             MouseDoubleClick="DeadlinesList_MouseDoubleClick"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EDEEF1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11">
                                            <Run Text="{Binding Province, Mode=OneWay}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Deadline, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource Brand.Accent.Brush}" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                            <Run Text="{Binding DaysLeft, Mode=OneWay}"/>
                                            <Run Text="d"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Button Grid.Column="1" Style="{StaticResource Card.StatButton}" Padding="12"
                    Click="DeadlineMonthChart_Click"
                    ToolTip="Open RFPs screen">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Deadlines - Next 6 Months" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DeadlineMonthBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="48" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Style="{StaticResource Chart.BarButton}"
                                                Tag="{Binding Label}"
                                                Click="Bar_Click"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                        <Border Background="{StaticResource Brand.Primary.Brush}"
                                                CornerRadius="3,3,0,0"
                                                Width="22">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BarHeight}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="Max"/>
                                                </MultiBinding>
                                            </Border.Height>
                                        </Border>
                                        </Button>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Button>
        </Grid>

        <TextBlock Grid.Row="6"
                   Text="{Binding StatusMessage}"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
    </ScrollViewer>
</UserControl>
