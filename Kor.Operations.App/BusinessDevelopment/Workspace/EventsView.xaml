<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource App.Background}"
             Loaded="EventsView_Loaded"
             Unloaded="EventsView_Unloaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Where to Show Up" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Upcoming industry events ranked by KOR market fit, relationship hooks, and sector relevance."
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border CornerRadius="999" Padding="8,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource App.Background}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tier}" Value="Tier 1">
                                                        <Setter Property="Background" Value="{StaticResource Brand.Primary.Brush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tier}" Value="Tier 2">
                                                        <Setter Property="Background" Value="{StaticResource CorporateBlue}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tier}" Value="Tier 1">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tier}" Value="Tier 2">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding DateDisplay}" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding EventType}" Foreground="{StaticResource Text.Secondary}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap">
                                        <Run Text="{Binding Organizer, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Location, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding SectorsThemes}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="Who'll be there" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding TargetsPresent}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                    <TextBlock Text="Why" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brand.Primary.Brush}" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding KorRelevance}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding CostNote}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding SourceNote}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,0,0,10"/>
                                    <TextBlock>
                                        <Hyperlink NavigateUri="{Binding RegistrationUrl}" RequestNavigate="OnHyperlinkRequestNavigate">
                                            <Run Text="Register / details"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
</UserControl>
