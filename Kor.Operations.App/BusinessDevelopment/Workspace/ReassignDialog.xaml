<Window x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.ReassignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reassign pursuit"
        Width="440" Height="270"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText"
                   TextWrapping="Wrap" FontWeight="SemiBold"
                   Foreground="{StaticResource Brand.Primary.Brush}"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="Reassign to (from your team directory)" FontSize="12"
                   Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="2" x:Name="OwnerCombo"
                  IsEditable="True" IsTextSearchEnabled="True"
                  DisplayMemberPath="Display" TextSearch.TextPath="Display"
                  Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3" Text="Reason (optional)" FontSize="12"
                   Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="4" x:Name="ReasonBox" Padding="10,0"
                 Margin="0,0,0,12"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Reassign" Width="110" IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    Click="Reassign_Click"/>
        </StackPanel>
    </Grid>
</Window>
