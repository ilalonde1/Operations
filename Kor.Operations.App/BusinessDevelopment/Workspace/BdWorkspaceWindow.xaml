<Window x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.BdWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:appControls="clr-namespace:Kor.Operations.App.Controls"
        xmlns:local="clr-namespace:Kor.Operations.App.BusinessDevelopment.Workspace"
        Title="Business Development Workspace"
        Width="1360"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI"
        Loaded="BdWorkspaceWindow_Loaded">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#EDEEF1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brand.Primary.Brush}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource Brand.Primary.Brush}"/>
        </Style>

        <!-- Round 2026-07-08 (E4 nav polish): labeled rail groups so the
             Bazaar -> Pursuits -> Overwatch lifecycle reads as a flow. -->
        <Style x:Key="NavGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="12,10,0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="Business Development"
                            SubtitleText="Workspace"
                            AvatarDiameter="96"
                            AvatarBorderThickness="2"/>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Find an organization"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,0,0,4"/>
                    <appControls:OrgSearchTypeahead x:Name="GlobalSearch"
                                                    Margin="0,0,0,10"/>

                    <!-- 2026-07-09 IA consolidation: rail regrouped to mirror the
                         workflow (Find -> Pursue -> Know -> Tools); RFPs + Grab
                         merged into one "Opportunities" surface; back-nav added. -->
                    <Button x:Name="BackButton" Content="←  Back" Style="{StaticResource NavButton}"
                            Click="BackButton_Click" IsEnabled="False" Margin="0,0,0,4"
                            ToolTip="Back to the previous screen."/>

                    <TextBlock Text="FIND" Style="{StaticResource NavGroupHeader}" Margin="12,0,0,3"/>
                    <Button x:Name="DashboardButton" Content="Dashboard" Style="{StaticResource ActiveNavButton}" Click="Dashboard_Click"/>
                    <Button x:Name="OpportunitiesButton" Content="Opportunities" Style="{StaticResource NavButton}" Click="Opportunities_Click"
                            ToolTip="Open tenders — 'To grab' (un-claimed, ranked by fit) or 'All tenders' (the full registry)."/>
                    <Button x:Name="UpcomingButton" Content="Future Projects" Style="{StaticResource NavButton}" Click="Upcoming_Click"
                            ToolTip="Major projects on the horizon — earlier than tenders, before an RFP exists."/>

                    <TextBlock Text="PURSUE" Style="{StaticResource NavGroupHeader}"/>
                    <Button x:Name="PursuitsButton" Content="Pursuits" Style="{StaticResource NavButton}" Click="Pursuits_Click"
                            ToolTip="The pursuits you own — calls, contacts, stages, outcomes."/>
                    <Button x:Name="OverwatchButton" Content="Pursuit Monitor" Style="{StaticResource NavButton}" Click="Overwatch_Click"
                            ToolTip="Manager board — every owned active pursuit, coldest first."/>

                    <TextBlock Text="KNOW" Style="{StaticResource NavGroupHeader}"/>
                    <Button x:Name="RelationshipsButton" Content="Relationships" Style="{StaticResource NavButton}" Click="Relationships_Click"/>
                    <Button x:Name="AttributionButton" Content="BD Scorecard" Style="{StaticResource NavButton}" Click="Attribution_Click"
                            ToolTip="Wins, won fee, active pursuits — the honest scorecard."/>
                    <Button x:Name="CompetitionButton" Content="Market History" Style="{StaticResource NavButton}" Click="Competition_Click"
                            ToolTip="Who won what, historically — the competitor record."/>
                    <Button x:Name="EventsButton" Content="Events" Style="{StaticResource NavButton}" Click="Events_Click"/>
                    <Button x:Name="BdTrackingButton" Content="BD Tracking" Style="{StaticResource NavButton}" Click="BdTracking_Click"
                            ToolTip="The KOR Structural BD Tracking 2026 spreadsheet, ingested (read-only)."/>

                    <TextBlock Text="TOOLS" Style="{StaticResource NavGroupHeader}"/>
                    <Button x:Name="BriefsMakerButton" Content="Make a Brief..." Style="{StaticResource NavButton}" Click="BriefsMaker_Click"/>
                    <Button x:Name="ProposalsButton" Content="Proposals" Style="{StaticResource NavButton}" Click="Proposals_Click"
                            ToolTip="Opens the Fee Proposal Builder in a separate window."/>
                    <Button x:Name="BrochuresButton" Content="Brochures" Style="{StaticResource NavButton}" Click="Brochures_Click"
                            ToolTip="Opens the Sales Brochure Builder in a separate window."/>

                    <Button x:Name="AdminButton" Content="Admin" Style="{StaticResource NavButton}" Click="Admin_Click"
                            Margin="0,14,0,2" ToolTip="Sources, ingestion, and settings."/>
                </StackPanel>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
