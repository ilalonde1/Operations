<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.OverwatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="View_Loaded"
             Unloaded="View_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Refresh" Width="100" Click="RefreshButton_Click"/>
            <Button Content="Reassign…" Width="120" Margin="10,0,0,0"
                    Click="ReassignButton_Click"
                    IsEnabled="{Binding CanReassign}"
                    Style="{StaticResource Button.Primary}"
                    ToolTip="Hand the selected pursuit to a different owner (logged)."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Pursuit Overwatch"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Brand.Primary.Brush}"
                           Margin="0,0,0,2"/>
                <TextBlock Grid.Row="1" Text="{Binding Headline}"
                           Foreground="{StaticResource Text.Secondary}" FontSize="12"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasPursuits, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                <DataGrid Grid.Row="2"
                          x:Name="OverwatchGrid"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Pursuits}"
                          SelectedItem="{Binding Selected}"
                          MouseDoubleClick="OverwatchGrid_MouseDoubleClick"
                          ToolTip="Double-click a pursuit to open and manage it in Pursuits.">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Staleness" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StalenessBrush}" CornerRadius="999"
                                            Margin="2" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StalenessDisplay}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Owner"      Binding="{Binding OwnerDisplay}"        Width="110"/>
                        <!-- Plan 2.2a: stage + how long it has sat there ("Drafting 34d"). -->
                        <DataGridTextColumn Header="Stage"      Binding="{Binding StageAgeDisplay}"     Width="110"/>
                        <DataGridTextColumn Header="Project"    Binding="{Binding ProjectName}"         Width="*"/>
                        <DataGridTextColumn Header="Buyer"      Binding="{Binding Buyer}"               Width="170"/>
                        <DataGridTextColumn Header="Region"     Binding="{Binding RegionDisplay}"       Width="90"/>
                        <!-- Plan 3.1: fused touch, source-labelled ("2026-07-01 (email)"). -->
                        <DataGridTextColumn Header="Last touch" Binding="{Binding LastTouchDisplay}"    Width="140"/>
                        <DataGridTextColumn Header="Acts"       Binding="{Binding ActivityCountDisplay}" Width="50"/>
                        <DataGridTextColumn Header="Opened"     Binding="{Binding OpenedDisplay}"       Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="2,8,2,0" Background="Transparent">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
        </Border>
    </Grid>
</UserControl>
