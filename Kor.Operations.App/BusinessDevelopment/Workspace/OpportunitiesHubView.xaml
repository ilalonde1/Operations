<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.OpportunitiesHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SegBtnActive" TargetType="Button" BasedOn="{StaticResource SegBtn}">
            <Setter Property="Background" Value="{StaticResource Brand.Primary.Brush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Border CornerRadius="8" BorderThickness="1"
                    BorderBrush="{StaticResource Panel.Border}"
                    Background="{StaticResource App.Background}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SignalsBtn" Content="Signals" Click="Signals_Click"
                            ToolTip="Applications and rezonings, plus clearly marked other or unclassified leads."/>
                    <Button x:Name="BidsBtn" Content="Bids" Click="Bids_Click"
                            ToolTip="Requests for bids and separately identified awards and bid history."/>
                    <Button x:Name="MineBtn" Content="Mine" Click="Mine_Click"
                            ToolTip="Opportunities you own, of any kind, most recently touched first."/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ModeHint" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,0,10">
            <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="KindFilter" Width="220" SelectionChanged="KindFilter_Changed"/>
            <CheckBox x:Name="ToGrabFilter" Content="To grab" Margin="16,0,0,0" VerticalAlignment="Center"
                      Checked="ToGrab_Changed" Unchecked="ToGrab_Changed"
                      ToolTip="Available, unclaimed opportunities using the existing Bazaar eligibility rules."/>
            <TextBlock x:Name="CountHint" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}"/>
        </StackPanel>
        <WrapPanel Grid.Row="2" x:Name="SmallWorkPanel" Margin="12,0,12,10">
            <TextBlock Text="Work size:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="WorkSizeFilter" Width="205" SelectedIndex="0" SelectionChanged="WorkSize_Changed"
                      ToolTip="Uses the shared application scope classification. Unassessed applications remain visible by default.">
                <ComboBoxItem Content="Smaller work collapsed"/>
                <ComboBoxItem Content="All work"/>
                <ComboBoxItem Content="Smaller work only"/>
            </ComboBox>
            <Button x:Name="SmallWorkReveal" Margin="12,0,0,0" Padding="12,5" Click="SmallWorkReveal_Click"
                    ToolTip="Some multi-unit proposals have ambiguous scope text. Reveal smaller items to review them."/>
            <TextBlock x:Name="SmallWorkCount" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Text.Secondary}"/>
        </WrapPanel>
        <ContentControl Grid.Row="3" x:Name="Host"/>
    </Grid>
</UserControl>
