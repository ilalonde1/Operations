<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.OpportunitiesHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SegBtnActive" TargetType="Button" BasedOn="{StaticResource SegBtn}">
            <Setter Property="Background" Value="{StaticResource Brand.Primary.Brush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Border CornerRadius="8" BorderThickness="1"
                    BorderBrush="{StaticResource Panel.Border}"
                    Background="{StaticResource App.Background}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SignalsBtn" Content="Signals" Click="Signals_Click"
                            ToolTip="Applications and rezonings, plus clearly marked other or unclassified leads."/>
                    <Button x:Name="BidsBtn" Content="Bids" Click="Bids_Click"
                            ToolTip="Requests for bids and separately identified awards and bid history."/>
                    <Button x:Name="MineBtn" Content="Mine" Click="Mine_Click"
                            ToolTip="Opportunities you own, of any kind, most recently touched first."/>
                </StackPanel>
            </Border>
            <!-- 2026-10-20 "cleaner UI": one row. The tabs already say the kind, so the kind picker, the size picker and the
                 count line are kept for the code but not shown; the hidden-items button is the one control that matters. -->
            <CheckBox x:Name="ToGrabFilter" Content="Only ones nobody has grabbed" Margin="18,0,0,0" VerticalAlignment="Center"
                      Checked="ToGrab_Changed" Unchecked="ToGrab_Changed"
                      ToolTip="Available, unclaimed opportunities you can take on."/>
            <WrapPanel x:Name="SmallWorkPanel" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="WorkSizeLabel" Visibility="Collapsed"/>
                <ComboBox x:Name="WorkSizeFilter" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="WorkSize_Changed">
                    <ComboBoxItem Content="Smaller work collapsed"/>
                    <ComboBoxItem Content="All work"/>
                    <ComboBoxItem Content="Smaller work only"/>
                </ComboBox>
                <Button x:Name="SmallWorkReveal" Padding="12,5" Click="SmallWorkReveal_Click"/>
                <TextBlock x:Name="SmallWorkCount" Visibility="Collapsed"/>
            </WrapPanel>
            <TextBlock x:Name="ModeHint" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Visibility="Collapsed">
            <ComboBox x:Name="KindFilter" SelectionChanged="KindFilter_Changed"/>
            <TextBlock x:Name="CountHint"/>
        </StackPanel>
        <ContentControl Grid.Row="3" x:Name="Host"/>
    </Grid>
</UserControl>
