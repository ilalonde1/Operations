<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Workspace.BazaarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource App.Background}"
             FontFamily="Mulish, Segoe UI"
             Loaded="View_Loaded"
             Unloaded="View_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Refresh" Width="100" Click="RefreshButton_Click"/>
            <Button Content="Grab selected" Width="140" Margin="10,0,0,0"
                    Click="GrabButton_Click"
                    IsEnabled="{Binding CanGrab}"
                    Style="{StaticResource Button.Primary}"
                    ToolTip="Claim the selected opportunity — it leaves the Bazaar and becomes a Drafting pursuit you own."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Opportunity Bazaar"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Brand.Primary.Brush}"
                           Margin="0,0,0,2"/>
                <TextBlock Grid.Row="1" Text="{Binding Headline}"
                           Foreground="{StaticResource Text.Secondary}" FontSize="12"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasGrabbable, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                <DataGrid Grid.Row="2"
                          x:Name="BazaarGrid"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Grabbable}"
                          SelectedItem="{Binding Selected}"
                          MouseDoubleClick="BazaarGrid_MouseDoubleClick"
                          ToolTip="Double-click a row to open the buyer's intel dossier before deciding to grab.">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Relevance" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding TierBrush}" CornerRadius="999"
                                            Margin="2" Padding="8,2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TierDisplay}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ScoreDisplay}" Foreground="White" FontSize="11" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Source"   Binding="{Binding SourceDisplay}"          Width="110"/>
                        <DataGridTextColumn Header="Name"     Binding="{Binding Name}"                   Width="*"/>
                        <DataGridTextColumn Header="Buyer"    Binding="{Binding BuyerName}"              Width="190"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding LocationDisplay}"        Width="150"/>
                        <DataGridTextColumn Header="Est. value" Binding="{Binding EstimatedValueDisplay}" Width="120"/>
                        <DataGridTextColumn Header="Deadline" Binding="{Binding DeadlineDisplay}"        Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="2,8,2,0" Background="Transparent">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
        </Border>
    </Grid>
</UserControl>
