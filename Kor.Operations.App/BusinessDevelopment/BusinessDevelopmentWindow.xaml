<Window x:Class="Kor.Operations.App.BusinessDevelopment.BusinessDevelopmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Business Development"
        Width="980"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Card.Hover" Color="#FFF8EAE5"/>
        <Style x:Key="HubCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14" Background="Transparent">
                            <Border x:Name="Card"
                                    Background="{StaticResource Panel.Background}"
                                    BorderBrush="{StaticResource Panel.Border}"
                                    BorderThickness="1"
                                    CornerRadius="14" Padding="22">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1.5" Opacity="0.18" BlurRadius="7"/>
                                </Border.Effect>
                                <ContentPresenter/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Card.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:KorHeader x:Name="HeaderBar"
                            Grid.Row="0"
                            Margin="2,0,2,8"
                            HeaderText="Business Development"
                            SubtitleText="Find opportunities, propose, win, repeat"
                            AvatarDiameter="80"
                            AvatarBorderThickness="2"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <controls:CenteredUniformGrid x:Name="CardsGrid" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Button x:Name="OpportunitiesCard" Style="{StaticResource HubCardButton}" Click="OpenOpportunities_Click">
                    <StackPanel>
                        <Grid>
                            <Ellipse Width="36" Height="36" Fill="#EFEFF1"/>
                            <TextBlock Text="🎯" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Opportunities" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Text="Ingest, score, and triage RFPs from CanadaBuys and other sources."
                                   Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999"
                                Margin="0,12,0,0" Padding="6,3,6,3" HorizontalAlignment="Left">
                            <TextBlock Text="Open" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="CrmCard" Style="{StaticResource HubCardButton}" Click="OpenCrm_Click">
                    <StackPanel>
                        <Grid>
                            <Ellipse Width="36" Height="36" Fill="#EFEFF1"/>
                            <TextBlock Text="🤝" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="CRM" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Text="Track active engagements, contacts, and pursuit activity through win/lose."
                                   Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999"
                                Margin="0,12,0,0" Padding="6,3,6,3" HorizontalAlignment="Left">
                            <TextBlock Text="Open" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="FeeProposalCard" Style="{StaticResource HubCardButton}" Click="OpenFeeProposal_Click">
                    <StackPanel>
                        <Grid>
                            <Ellipse Width="36" Height="36" Fill="#EFEFF1"/>
                            <TextBlock Text="🧾" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Fee Proposal Builder" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Text="Compose proposal blocks, manage templates, and prepare a document shell."
                                   Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999"
                                Margin="0,12,0,0" Padding="6,3,6,3" HorizontalAlignment="Left">
                            <TextBlock Text="Open" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="BrochureCard" Style="{StaticResource HubCardButton}" Click="OpenBrochure_Click">
                    <StackPanel>
                        <Grid>
                            <Ellipse Width="36" Height="36" Fill="#EFEFF1"/>
                            <TextBlock Text="📋" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Brochure Builder" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Text="Generate a formatted multi-page sales brochure from project data."
                                   Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999"
                                Margin="0,12,0,0" Padding="6,3,6,3" HorizontalAlignment="Left">
                            <TextBlock Text="Open" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="CompetitionInfoCard" Style="{StaticResource HubCardButton}" Click="OpenCompetitionInfo_Click">
                    <StackPanel>
                        <Grid>
                            <Ellipse Width="36" Height="36" Fill="#EFEFF1"/>
                            <TextBlock Text="🔎" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Competition Info" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Text="Datamining over the BC Bid historical archive: filter, search, drill into past pursuits."
                                   Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999"
                                Margin="0,12,0,0" Padding="6,3,6,3" HorizontalAlignment="Left">
                            <TextBlock Text="Open" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="MajorProjectsCard" Style="{StaticResource HubCardButton}" Click="OpenMajorProjects_Click">
                    <StackPanel>
                        <Grid>
                            <Ellipse Width="36" Height="36" Fill="#EFEFF1"/>
                            <TextBlock Text="🏗" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Major Projects Inventory" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Text="BC + AB forward pipeline - 3,400+ projects with architect and developer links."
                                   Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Brand.Primary.Brush}" CornerRadius="999"
                                Margin="0,12,0,0" Padding="6,3,6,3" HorizontalAlignment="Left">
                            <TextBlock Text="Open" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Button>
            </controls:CenteredUniformGrid>
        </ScrollViewer>
    </Grid>
</Window>
