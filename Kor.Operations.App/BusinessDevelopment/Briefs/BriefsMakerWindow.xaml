<Window x:Class="Kor.Operations.App.BusinessDevelopment.Briefs.BriefsMakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:appControls="clr-namespace:Kor.Operations.App.Controls"
        Title="Make a Brief"
        Width="640"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        FontFamily="Mulish, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="TypeTabs">
            <TabItem Header="Organization">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Pick an organization"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,0,0,4"/>
                    <appControls:OrgSearchTypeahead x:Name="OrgPicker"
                                                    Margin="0,0,0,12"/>
                    <Border x:Name="OrgPreview"
                            Padding="12"
                            Background="#F9FAFB"
                            BorderBrush="{StaticResource Panel.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="OrgPreviewName"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="OrgPreviewMeta"
                                       FontSize="11"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Region">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Province"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="ProvinceCombo"
                              Height="32"
                              VerticalContentAlignment="Center"
                              SelectionChanged="ProvinceCombo_SelectionChanged"
                              Margin="0,0,0,12">
                        <ComboBoxItem Content="BC"/>
                        <ComboBoxItem Content="AB"/>
                        <ComboBoxItem Content="ON"/>
                        <ComboBoxItem Content="QC"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>
                    <TextBlock Text="City (optional)"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="CityCombo"
                              Height="32"
                              VerticalContentAlignment="Center"
                              IsEnabled="False"
                              SelectionChanged="CityCombo_SelectionChanged"
                              Margin="0,0,0,12"/>
                    <Border x:Name="RegionPreview"
                            Padding="12"
                            Background="#F9FAFB"
                            BorderBrush="{StaticResource Panel.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                        <TextBlock x:Name="RegionPreviewText"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Project">
                <Grid>
                    <TextBlock Text="Coming in R90b"
                               FontSize="14"
                               Foreground="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </TabItem>

            <TabItem Header="Person">
                <Grid>
                    <TextBlock Text="Coming in R90c"
                               FontSize="14"
                               Foreground="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="GeneratePdfButton"
                    Content="Generate PDF"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="GeneratePdf_Click"/>
            <Button x:Name="GenerateDocxButton"
                    Content="Generate Word"
                    Padding="14,6"
                    IsEnabled="False"
                    Click="GenerateDocx_Click"/>
        </StackPanel>
    </Grid>
</Window>
