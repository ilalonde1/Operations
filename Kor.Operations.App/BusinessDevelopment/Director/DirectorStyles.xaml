<!-- BD Director v3 (21 Oct 2026): the KOR palette from Themes/KorTheme.xaml, cards, one action per card. Colour only means
     something: the verdict (orange = your call, green = bid, grey = don't bid) and a deadline close or overdue. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="D.Slate" Color="#3F5364"/>
    <SolidColorBrush x:Key="D.SlateDeep" Color="#344555"/>
    <SolidColorBrush x:Key="D.SlateHover" Color="#4C6175"/>
    <SolidColorBrush x:Key="D.Orange" Color="#FF5B35"/>
    <SolidColorBrush x:Key="D.Page" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="D.CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="D.Line" Color="#E3E6EA"/>
    <SolidColorBrush x:Key="D.Ink" Color="#26323D"/>
    <SolidColorBrush x:Key="D.Ink2" Color="#5F6B77"/>
    <SolidColorBrush x:Key="D.Ink3" Color="#8C96A0"/>
    <SolidColorBrush x:Key="D.RailText" Color="#C9D2DB"/>
    <SolidColorBrush x:Key="D.Select" Color="#2F5496"/>

    <Style x:Key="D.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource D.CardBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource D.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="D.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource D.Ink2}"/>
        <Setter Property="Margin" Value="2,0,0,10"/>
    </Style>

    <Style x:Key="D.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource D.Ink}"/>
    </Style>

    <Style x:Key="D.Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="D.Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Buttons drawn here so they look the same everywhere in the Director: flat, rounded, no OS chrome. -->
    <Style x:Key="D.Button" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource D.Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource D.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#B9C1CA"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="D.Primary" TargetType="Button" BasedOn="{StaticResource D.Button}">
        <Setter Property="Background" Value="{StaticResource D.Slate}"/>
        <Setter Property="BorderBrush" Value="{StaticResource D.Slate}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="D.Ghost" TargetType="Button" BasedOn="{StaticResource D.Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource D.Ink2}"/>
    </Style>

    <!-- The left rail's destinations. -->
    <Style x:Key="D.Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource D.RailText}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="9" Padding="14,10" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource D.SlateHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource D.SlateDeep}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chips (Everyone / Mine). -->
    <Style x:Key="D.Filter" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource D.Ink2}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="16" Padding="14,6" Background="White" BorderBrush="{StaticResource D.Line}" BorderThickness="1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource D.Slate}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource D.Slate}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="D.Avatar" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>
</ResourceDictionary>
