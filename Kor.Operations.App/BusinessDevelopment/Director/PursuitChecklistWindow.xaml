<Window x:Class="Kor.Operations.App.BusinessDevelopment.Director.PursuitChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Kor.Operations.Converters"
        Title="{Binding Title}" Width="1320" Height="900" MinWidth="1050" MinHeight="750"
        WindowStartupLocation="CenterOwner" Background="{StaticResource App.Background}">
    <Window.Resources><converters:BdDayConverter x:Key="BdDay"/></Window.Resources>
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <Grid IsEnabled="{Binding IsReady}">
            <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="NaN">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="35"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTemplateColumn Header="Quoted requirement" Width="3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Requirement}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceRef}" Width="180"/>
                    <DataGridTextColumn Header="Check" Binding="{Binding CheckKind}" Width="100"/>
                    <DataGridTemplateColumn Header="Note" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusNote}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Checked by" Binding="{Binding CheckedBy}" Width="110"/>
                    <DataGridTextColumn Header="Checked" Binding="{Binding CheckedAtUtc, Converter={StaticResource BdDay}}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Margin="0,10">
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Width="150"/>
                <Button DockPanel.Dock="Right" Content="Set status with note" Click="SetStatus_Click" Margin="8,0,0,0" Padding="12,6"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="8,0,0,0" ToolTip="Explain your assessment"/>
            </DockPanel>
            <Expander Grid.Row="2" Header="Add item — quote the RFP and its source" Margin="0,0,0,12">
                <StackPanel Margin="4,10">
                    <TextBlock Text="Quoted requirement (up to 1,000 characters)"/>
                    <TextBox Text="{Binding Requirement, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
                    <TextBlock Text="Source reference" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding SourceRef, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                    <WrapPanel Margin="0,8,0,0">
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding CheckKind}" Width="150"/>
                        <TextBox Text="{Binding CheckParameter, UpdateSourceTrigger=PropertyChanged}" Width="350" MaxLength="400" Margin="8,0" ToolTip="Phrase, positive page limit or file name pattern; {rfp} and * are supported"/>
                        <Button Content="Add item" Click="Add_Click" Padding="12,6"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <DataGrid Grid.Row="3" ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="NaN">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bid attachment" Binding="{Binding File.FileName}" Width="2*"/>
                    <DataGridTextColumn Header="Author" Binding="{Binding Metadata.Author}" Width="*"/>
                    <DataGridTextColumn Header="Last modified by" Binding="{Binding Metadata.LastModifiedBy}" Width="*"/>
                    <DataGridTextColumn Header="Revision" Binding="{Binding Metadata.Revision}" Width="65"/>
                    <DataGridTextColumn Header="Last saved" Binding="{Binding Metadata.LastSaved, Converter={StaticResource BdDay}, ConverterParameter=Time}" Width="140"/>
                    <DataGridTextColumn Header="Read status" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Grid.Row="4" Margin="0,12,0,0">
                <Button Content="Check the draft" Click="Check_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Add the generic checklist" Click="Generic_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Reload" Click="Reload_Click" Padding="12,6"/>
            </WrapPanel>
        </Grid>
    </DockPanel>
</Window>
