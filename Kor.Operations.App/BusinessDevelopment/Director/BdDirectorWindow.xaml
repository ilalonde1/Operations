<Window x:Class="Kor.Operations.App.BusinessDevelopment.Director.BdDirectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Kor.Operations.Converters"
        xmlns:director="clr-namespace:Kor.Operations.App.BusinessDevelopment.Director"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="BD Director" Width="1680" Height="980" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{StaticResource App.Background}">
    <Window.Resources>
        <converters:BdDayConverter x:Key="BdDay"/>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="20,9"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Panel.Border}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Panel.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="27"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Padding="18,6"
                    IsEnabled="{Binding CanRefresh}" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="BD Director" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0">
                    <Run Text="{Binding Live, Mode=OneWay}"/><Run Text=" live pursuits · "/>
                    <Run Text="{Binding PeopleCount, Mode=OneWay}"/><Run Text=" people · as of "/>
                    <Run Text="{Binding AsOf, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <TabControl x:Name="Tabs" Grid.Row="1">
        <TabItem Header="The number">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static director:BdDirectorViewModel.NumberCaption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Set a target…" Click="SetTarget_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Retire" Click="RetireTarget_Click" Padding="12,6"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Height="500">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="What" Binding="{Binding MetricDisplay}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeDisplay}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="Period" Width="245">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock ToolTip="{Binding PeriodNote}">
                                        <Run Text="{Binding Target.PeriodStartUtc, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                                        <Run Text=" – "/><Run Text="{Binding Target.PeriodEndUtc, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                                    </TextBlock>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetDisplay}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Actual" Binding="{Binding ActualDisplay}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Set by" Binding="{Binding Target.SetBy}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding FeeCoverage}" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="People">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12">
            <StackPanel>
                <TextBlock Text="People" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{x:Static director:BdDirectorViewModel.PeopleCaption}" TextWrapping="Wrap"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                          Height="270" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Person" Binding="{Binding DisplayName}" Width="2*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Live pursuits" Binding="{Binding Live}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Overdue next action" Binding="{Binding OverdueNextAction}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="No next action" Binding="{Binding NoNextAction}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Untouched 14 days" Binding="{Binding Untouched14d}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Activity, 30 days" Binding="{Binding Activities30}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Activity, 90 days" Binding="{Binding Activities90}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Buyers emailed, 90 days" Binding="{Binding BuyersMailed90}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Opened the tools, 30 days" Binding="{Binding Opens30}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding SelectedPersonCaption}" FontWeight="SemiBold" Margin="0,10,0,6"/>
                <DataGrid ItemsSource="{Binding SelectedPursuits}" Height="132">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pursuit" Binding="{Binding ProjectName}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="110" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivity}" Width="125" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Opened" Binding="{Binding Opened}" Width="125" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Reassign…" Click="Reassign_Click" Padding="8,2" Margin="2,0"/>
                                        <Button Content="Open" Click="OpenPursuit_Click" Tag="{Binding PursuitId}" Padding="8,2" Margin="2,0"/>
                                        <Button Content="Ask…" Click="AskPursuit_Click" Padding="8,2" Margin="2,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Header="Funnel">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12">
            <StackPanel>
                <TextBlock Text="Funnel" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
                <TextBlock Text="{x:Static director:BdDirectorViewModel.FunnelCaption}" TextWrapping="Wrap"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding Stages}" Height="102">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Pursuits" Binding="{Binding Pursuits}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Days in stage, median" Binding="{Binding MedianDisplay}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding Outcomes}" TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <TextBlock Text="{Binding LostDetails}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Where wins came from" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding Sources}" Height="102">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Wins" Binding="{Binding Wins}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Won fee" Binding="{Binding WonFee, StringFormat={}{0:C0}}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Undecided, past deadline" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DeadlineCaption}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding Undecided}" Height="122">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pursuit" Binding="{Binding ProjectName}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, Converter={StaticResource BdDay}}" Width="125" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Button Content="Open" Click="OpenPursuit_Click" Tag="{Binding PursuitId}" Padding="8,2"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Header="Accounts">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static director:BdDirectorViewModel.AccountsCaption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False" Height="620">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="KOR projects" Binding="{Binding Projects}" Width="110" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Last KOR project" Binding="{Binding LastProject}" Width="125" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Live pursuits" Binding="{Binding LivePursuits}" Width="85" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Last touch" Binding="{Binding LastTouch}" Width="125" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Open asks" Binding="{Binding OpenAsks}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding SelectedAccount.DisplayName}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding AccountMessage}" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasAccountDeltek, Converter={StaticResource BoolVisibility}}">
                                <Run Text="Lifetime fee "/><Run Text="{Binding SelectedAccountDeltek.LifetimeFee, Mode=OneWay, StringFormat={}{0:C0}}"/>
                                <Run Text=" · "/><Run Text="{Binding SelectedAccountDeltek.ProjectCount, Mode=OneWay}"/><Run Text=" projects · latest "/>
                                <Run Text="{Binding SelectedAccountDeltek.LatestProjectName, Mode=OneWay}"/><Run Text=", "/>
                                <Run Text="{Binding SelectedAccountDeltek.LatestProjectStart, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasAccountAr, Converter={StaticResource BoolVisibility}}">
                                <Run Text="AR outstanding "/><Run Text="{Binding SelectedAccountDeltek.Ar.TotalOutstanding, Mode=OneWay, StringFormat={}{0:C0}}"/>
                                <Run Text=", "/><Run Text="{Binding SelectedAccountDeltek.Ar.Outstanding90Plus, Mode=OneWay, StringFormat={}{0:C0}}"/>
                                <Run Text=" over 90 days, "/><Run Text="{Binding SelectedAccountDeltek.Ar.OpenInvoiceCount, Mode=OneWay}"/><Run Text=" open invoices"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasAccountPostedThrough, Converter={StaticResource BoolVisibility}}">
                                <Run Text="Billed figures posted through "/><Run Text="{Binding SelectedAccountDeltek.SummaryPostedThrough, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding AccountDegradedMessage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Open dossier" Click="OpenDossier_Click" Padding="10,6" Margin="0,0,6,6"/>
                                <Button Content="Ask…" Click="AskAccount_Click" Padding="10,6" Margin="0,0,6,6"/>
                                <Button Content="Decide…" Click="DecideAccount_Click" Padding="10,6" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Asks &amp; decisions">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static director:BdDirectorViewModel.AsksCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox ItemsSource="{Binding AskStatuses}" SelectedItem="{Binding AskStatusFilter, Mode=TwoWay}"
                                  controls:Placeholder.Text="Ask status" IsEnabled="{Binding CanRefresh}" Width="150" Margin="0,0,12,0"/>
                        <Button Content="Ask…" Click="Ask_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Withdraw" Click="WithdrawAsk_Click" Padding="12,6" IsEnabled="{Binding SelectedAsk.IsOpen, FallbackValue=False}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Asks}" SelectedItem="{Binding SelectedAsk}" Height="280" RowHeight="58">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="To" Binding="{Binding ToDisplay}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Ask" Binding="{Binding Record.Ask}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="About" Binding="{Binding About}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Minutes" Binding="{Binding Record.Minutes}" Width="75" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding Record.DueUtc, Converter={StaticResource BdDay}}" Width="125" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Record.Status}" Width="95" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Closed note" Binding="{Binding Record.ClosedNote}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{x:Static director:BdDirectorViewModel.DecisionsCaption}" TextWrapping="Wrap" Margin="0,20,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Decide…" Click="Decide_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Right" Tag="Right" Click="ScoreDecision_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="{Binding SelectedDecision.IsPending, FallbackValue=False}"/>
                        <Button Content="Wrong" Tag="Wrong" Click="ScoreDecision_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="{Binding SelectedDecision.IsPending, FallbackValue=False}"/>
                        <Button Content="Unclear" Tag="Unclear" Click="ScoreDecision_Click" Padding="12,6" IsEnabled="{Binding SelectedDecision.IsPending, FallbackValue=False}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Decisions}" SelectedItem="{Binding SelectedDecision}" Height="280" RowHeight="58">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Decided" Binding="{Binding Record.DecidedAtUtc, Converter={StaticResource BdDay}}" Width="125" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Decision" Binding="{Binding Record.Decision}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Rationale" Binding="{Binding Record.Rationale}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Expected" Binding="{Binding Record.ExpectedOutcome}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Review" Binding="{Binding Record.ReviewAtUtc, Converter={StaticResource BdDay}}" Width="125" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Record.Outcome}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Scored" Binding="{Binding Record.OutcomeNote}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource Text.Secondary}"/>
    </Grid>
</Window>
