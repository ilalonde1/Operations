                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Wins" Binding="{Binding Wins}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Won fee" Binding="{Binding WonFee, StringFormat={}{0:C0}}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Undecided, past deadline" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DeadlineCaption}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                        <DataGrid MouseDoubleClick="Row_DoubleClick" ItemsSource="{Binding Undecided}" Height="122">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pursuit" Binding="{Binding ProjectName}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, Converter={StaticResource BdDay}}" Width="125" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Button Content="Open" Click="OpenPursuit_Click" Tag="{Binding PursuitId}" Padding="8,2"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Header="Accounts">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static director:BdDirectorViewModel.AccountsCaption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DataGrid MouseDoubleClick="Row_DoubleClick" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False" Height="620">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="KOR projects" Binding="{Binding Projects}" Width="110" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Last KOR project" Binding="{Binding LastProject}" Width="125" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Live pursuits" Binding="{Binding LivePursuits}" Width="85" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Last touch" Binding="{Binding LastTouch}" Width="125" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Open asks" Binding="{Binding OpenAsks}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding SelectedAccount.DisplayName}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding AccountMessage}" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasAccountDeltek, Converter={StaticResource BoolVisibility}}">
                                <Run Text="Lifetime fee "/><Run Text="{Binding SelectedAccountDeltek.LifetimeFee, Mode=OneWay, StringFormat={}{0:C0}}"/>
                                <Run Text=" · "/><Run Text="{Binding SelectedAccountDeltek.ProjectCount, Mode=OneWay}"/><Run Text=" projects · latest "/>
                                <Run Text="{Binding SelectedAccountDeltek.LatestProjectName, Mode=OneWay}"/><Run Text=", "/>
                                <Run Text="{Binding SelectedAccountDeltek.LatestProjectStart, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasAccountAr, Converter={StaticResource BoolVisibility}}">
                                <Run Text="AR outstanding "/><Run Text="{Binding SelectedAccountDeltek.Ar.TotalOutstanding, Mode=OneWay, StringFormat={}{0:C0}}"/>
                                <Run Text=", "/><Run Text="{Binding SelectedAccountDeltek.Ar.Outstanding90Plus, Mode=OneWay, StringFormat={}{0:C0}}"/>
                                <Run Text=" over 90 days, "/><Run Text="{Binding SelectedAccountDeltek.Ar.OpenInvoiceCount, Mode=OneWay}"/><Run Text=" open invoices"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasAccountPostedThrough, Converter={StaticResource BoolVisibility}}">
                                <Run Text="Billed figures posted through "/><Run Text="{Binding SelectedAccountDeltek.SummaryPostedThrough, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding AccountDegradedMessage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Open dossier" Click="OpenDossier_Click" Padding="10,6" Margin="0,0,6,6"/>
                                <Button Content="Ask…" Click="AskAccount_Click" Padding="10,6" Margin="0,0,6,6"/>
                                <Button Content="Decide…" Click="DecideAccount_Click" Padding="10,6" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Asks &amp; decisions">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static director:BdDirectorViewModel.AsksCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox ItemsSource="{Binding AskStatuses}" SelectedItem="{Binding AskStatusFilter, Mode=TwoWay}"
                                  controls:Placeholder.Text="Ask status" IsEnabled="{Binding CanRefresh}" Width="150" Margin="0,0,12,0"/>
                        <Button Content="Ask…" Click="Ask_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Withdraw" Click="WithdrawAsk_Click" Padding="12,6" IsEnabled="{Binding SelectedAsk.IsOpen, FallbackValue=False}"/>
                    </StackPanel>
                    <DataGrid MouseDoubleClick="Row_DoubleClick" ItemsSource="{Binding Asks}" SelectedItem="{Binding SelectedAsk}" Height="280" RowHeight="58">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="To" Binding="{Binding ToDisplay}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Ask" Binding="{Binding Record.Ask}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="About" Binding="{Binding About}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Minutes" Binding="{Binding Record.Minutes}" Width="75" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding Record.DueUtc, Converter={StaticResource BdDay}}" Width="125" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Record.Status}" Width="95" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Closed note" Binding="{Binding Record.ClosedNote}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{x:Static director:BdDirectorViewModel.DecisionsCaption}" TextWrapping="Wrap" Margin="0,20,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Decide…" Click="Decide_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Right" Tag="Right" Click="ScoreDecision_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="{Binding SelectedDecision.IsPending, FallbackValue=False}"/>
                        <Button Content="Wrong" Tag="Wrong" Click="ScoreDecision_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="{Binding SelectedDecision.IsPending, FallbackValue=False}"/>
                        <Button Content="Unclear" Tag="Unclear" Click="ScoreDecision_Click" Padding="12,6" IsEnabled="{Binding SelectedDecision.IsPending, FallbackValue=False}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BriefTrackRecordSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding BriefTrackRecordBreakdown}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DataGrid MouseDoubleClick="Row_DoubleClick" ItemsSource="{Binding Decisions}" SelectedItem="{Binding SelectedDecision}" Height="280" RowHeight="58">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Decided" Binding="{Binding Record.DecidedAtUtc, Converter={StaticResource BdDay}}" Width="125" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Decision" Binding="{Binding Record.Decision}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Rationale" Binding="{Binding Record.Rationale}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Expected" Binding="{Binding Record.ExpectedOutcome}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Review" Binding="{Binding Record.ReviewAtUtc, Converter={StaticResource BdDay}}" Width="125" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Record.Outcome}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Scored" Binding="{Binding Record.OutcomeNote}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Knowledge">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Static director:BdDirectorViewModel.KnowledgeCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="7*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Books" Style="{StaticResource SectionTitle}"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding KnowledgeBooks}" SelectedItem="{Binding SelectedBook, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Book" Binding="{Binding Source.Title}" Width="2*" MinWidth="100" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Source.Author}" Width="*" MinWidth="80" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Passages" Binding="{Binding Source.Passages}" Width="58"/>
                                <DataGridTextColumn Header="Extracted" Binding="{Binding Extracted}" Width="70"/>
                                <DataGridTextColumn Header="Claims" Binding="{Binding Source.Claims}" Width="55"/>
                                <DataGridTextColumn Header="Reviewed" Binding="{Binding Source.Reviewed}" Width="65"/>
                                <DataGridTextColumn Header="Retired" Binding="{Binding Source.Retired}" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Claims" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel Grid.Row="1" Margin="0,4,0,6">
                            <ComboBox ItemsSource="{Binding ClaimFilters}" SelectedItem="{Binding ClaimFilter, Mode=TwoWay}"
                                      controls:Placeholder.Text="Claim status" Width="125" Margin="0,0,8,6"/>
                            <Button Content="Sample 20" Click="SampleClaims_Click" Padding="10,6" Margin="0,0,8,6"/>
                            <Button Content="Keep" Click="KeepClaim_Click" IsEnabled="{Binding SelectedClaim.CanReview, FallbackValue=False}" Padding="10,6" Margin="0,0,8,6"/>
                            <Button Content="Retire…" Click="RetireClaim_Click" IsEnabled="{Binding SelectedClaim.CanReview, FallbackValue=False}" Padding="10,6" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <DockPanel Grid.Row="2" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="By book" Click="ClaimsByBook_Click" Padding="10,6" Margin="8,0,0,0"/>
                            <TextBlock DockPanel.Dock="Left" Text="By concept" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding KnowledgeConcepts}" SelectedItem="{Binding SelectedConcept, Mode=TwoWay}"
                                      DisplayMemberPath="Display" controls:Placeholder.Text="Choose a concept"/>
                        </DockPanel>
                        <TextBlock Grid.Row="3" Text="{Binding ClaimsCaption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="4" ItemsSource="{Binding KnowledgeClaims}" SelectedItem="{Binding SelectedClaim, Mode=TwoWay}" RowHeight="NaN">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="44"/></Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Claim.Kind}" Width="75" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="Verdict" Width="135">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock Text="{Binding VerdictDisplay}" TextWrapping="Wrap"/>
                                            <TextBlock Text="⚑ Review claim" Foreground="Red" FontWeight="Bold"
                                                       Visibility="{Binding IsFlagged, Converter={StaticResource BoolVisibility}}"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Claim" Binding="{Binding Claim.Statement}" Width="3*" MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="6,6"/>
                                            <Setter Property="TextTrimming" Value="None"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Confidence" Binding="{Binding Claim.Confidence, StringFormat={}{0:0.00}}" Width="85"/>
                                <DataGridTextColumn Header="Concepts" Binding="{Binding Concepts}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Ref" Binding="{Binding Claim.Ref}" Width="80" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="5" Text="{Binding KnowledgeMessage}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </Grid>
                    <ContentControl Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource PassagePane}"/>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Market">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Static director:BdDirectorViewModel.MarketCaption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Text="{Binding MarketFunnel}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Signals, 30 days" Style="{StaticResource SectionTitle}"/>
                        <DataGrid MouseDoubleClick="Row_DoubleClick" ItemsSource="{Binding MarketSignals}" RowHeight="NaN">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Org" Binding="{Binding Org}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenAtUtc, Converter={StaticResource BdDay}}" Width="120"/>
                                <DataGridTextColumn Header="Corroborations" Binding="{Binding Corroborations}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="RFPs closing in 30 days" Style="{StaticResource SectionTitle}"/>
                        <DataGrid MouseDoubleClick="Row_DoubleClick" ItemsSource="{Binding MarketDeadlines}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="RFP" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="84"/>
                                <DataGridTextColumn Header="Closing" Binding="{Binding Deadline}" Width="165"/>
                                <DataGridTextColumn Header="Time left" Binding="{Binding Countdown}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="Forward pipeline" Style="{StaticResource SectionTitle}"/>
                        <DataGrid MouseDoubleClick="Row_DoubleClick" ItemsSource="{Binding ForwardPipeline}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Proponent" Binding="{Binding ProponentName}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="84"/>
                                <DataGridTextColumn Header="Sector" Binding="{Binding Sector}" Width="90"/>
                                <DataGridTextColumn Header="Est. cost" Binding="{Binding EstimatedCostCad, StringFormat={}{0:C0}}" Width="115"/>
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Open structural seats" Style="{StaticResource SectionTitle}"/>
                        <DataGrid MouseDoubleClick="Row_DoubleClick" ItemsSource="{Binding OpenSeats}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Firm" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Market" Binding="{Binding Market}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                                <DataGridTextColumn Header="Opening" Binding="{Binding DisplacementRead}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="This week">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Static director:BdDirectorViewModel.BriefCaption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Text="{Binding BriefMessage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding BriefSections}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,0,0,1" Padding="0,0,12,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Acknowledge" Click="AcknowledgeBrief_Click" IsEnabled="{Binding CanAcknowledge}" Padding="10,4"/>
                                            <TextBlock Text="{Binding Section}" FontSize="18" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Brief.Headline}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6"/>
                                        <TextBlock Text="{Binding Brief.Body}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Brief.Recommendation}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8"/>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasCall, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding CallStatus}"/>
                                            <TextBlock Visibility="{Binding IsCallPending, Converter={StaticResource BoolVisibility}}">
                                                <Run Text=", review "/><Run Text="{Binding Decision.ReviewAtUtc, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Generated, Converter={StaticResource BdDay}}" Foreground="{StaticResource Text.Secondary}"/>
                                        <TextBlock Text="{Binding Acknowledgement}" Foreground="{StaticResource Text.Secondary}"/>
                                        <ItemsControl ItemsSource="{Binding Citations}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Button Click="OpenCitation_Click" HorizontalContentAlignment="Stretch" Margin="0,3" Padding="8,6">
                                                    <StackPanel><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontStyle="Italic"/></StackPanel>
                                                </Button>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource PassagePane}"/>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Pending bids">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static director:BdDirectorViewModel.PendingBidsCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="1" Text="{Binding PendingBidsSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                    <CheckBox Content="Mine" IsChecked="{Binding MineOnly}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="Mark submitted…" Click="MarkSubmitted_Click" IsEnabled="{Binding SelectedPendingBid.CanSubmit, FallbackValue=False}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Build fee proposal…" Click="BuildFeeProposal_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Checklist…" Click="Checklist_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Org chart…" Click="OrgChart_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Build brochure…" Click="BuildBrochure_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Assign…" Click="AssignBid_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Edit opportunity…" Click="EditOpportunity_Click" Padding="12,6"/>
                </WrapPanel>
                <DataGrid MouseDoubleClick="Row_DoubleClick" x:Name="PendingBidsGrid" Grid.Row="3" ItemsSource="{Binding PendingBids}" SelectedItem="{Binding SelectedPendingBid}"
                          CanUserSortColumns="False">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                    <Setter Property="Foreground" Value="Firebrick"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Client" Binding="{Binding Bid.Client}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Project" Binding="{Binding Bid.Project}" Width="2*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="RFP" Binding="{Binding Bid.RfpNumber}" Width="*" MinWidth="145" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Assignee" Binding="{Binding Assignee}" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Due" Binding="{Binding Bid.DueUtc, Converter={StaticResource BdDay}, ConverterParameter=Time}" Width="185" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Time left" Binding="{Binding Countdown}" Width="160" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="90" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedAtUtc, Converter={StaticResource BdDay}, ConverterParameter=Time}" Width="185" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="File" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Grid>
                                    <TextBlock x:Name="FileText" Text="{Binding Bid.SubmittedFileName}" Style="{StaticResource CellText}"/>
                                    <TextBlock x:Name="FileLink" Visibility="Collapsed" Style="{StaticResource CellText}">
                                        <Hyperlink Click="SubmittedFile_Click"><Run Text="{Binding Bid.SubmittedFileName}"/></Hyperlink>
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasSubmittedFile}" Value="True">
                                        <Setter TargetName="FileText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="FileLink" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Link" Width="80">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <TextBlock Style="{StaticResource CellText}" Visibility="{Binding HasFolderLink, Converter={StaticResource BoolVisibility}}">
                                    <Hyperlink Click="FolderLink_Click" ToolTip="{Binding Bid.FolderLink}">Open</Hyperlink>
                                </TextBlock>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="My day">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="{Binding MyDayMessage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MyDay}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{Binding Item.Buyer}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Contact}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Item.Seat}" Foreground="{StaticResource Text.Secondary}"/>
                                        <TextBlock Text="{Binding SecondSeats}" TextWrapping="Wrap"/>
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0">
                                            <Run Text="{Binding WhyPrefix, Mode=OneWay}"/><Run Text="{Binding WhyDate, Mode=OneWay, Converter={StaticResource BdDay}, TargetNullValue=''}"/><Run Text="{Binding WhySuffix, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Visibility="{Binding HasSignal, Converter={StaticResource BoolVisibility}}">
                                            <Run Text="Last signal "/><Run Text="{Binding Item.SignalLastSeenAtUtc, Mode=OneWay, Converter={StaticResource BdDay}}"/><Run Text=": "/><Run Text="{Binding Item.SignalSubject, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Visibility="{Binding HasLastActivity, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Text.Secondary}">
                                            <Run Text="Last logged touch "/><Run Text="{Binding Item.LastActivityUtc, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding HistoryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding KnownBy}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding HistoryWarning}" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Log call" Tag="Call" Click="LogMyDay_Click" IsEnabled="{Binding CanLog}" Padding="10,5" Margin="0,0,6,6"/>
                                            <Button Content="Log email" Tag="EmailOut" Click="LogMyDay_Click" IsEnabled="{Binding CanLog}" Padding="10,5" Margin="0,0,6,6"/>
                                            <Button Content="Log meeting" Tag="Meeting" Click="LogMyDay_Click" IsEnabled="{Binding CanLog}" Padding="10,5" Margin="0,0,6,6"/>
                                        </WrapPanel>
                                        <WrapPanel Visibility="{Binding CanStartTracking, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="Region" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox ItemsSource="{Binding DataContext.MyDayRegions, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                      SelectedItem="{Binding SelectedRegion}" Width="190" ToolTip="Choose a region" Margin="0,0,8,0"/>
                                            <Button Content="Start tracking" Click="StartTracking_Click" Padding="10,5"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding TrackedBy}" TextWrapping="Wrap"/>
                                        <Button Content="Join as second seat" Click="JoinSecondSeat_Click" Padding="10,5" HorizontalAlignment="Left"
                                                Visibility="{Binding CanJoin, Converter={StaticResource BoolVisibility}}"/>
                                        <TextBlock Text="Pull in an engineer as second seat" FontWeight="SemiBold" Margin="0,8,0,0"
                                                   Visibility="{Binding HasCandidates, Converter={StaticResource BoolVisibility}}"/>
                                        <ItemsControl ItemsSource="{Binding Candidates}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Button Click="ChooseEngineer_Click" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                                                </Button>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Copy" Click="CopyMyDay_Click" Padding="12,5"/>
                                            <TextBlock Text="Drafted note" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBox Text="{Binding DraftedNote, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="10"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        </TabControl>
        </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource Text.Secondary}"/>
        <TextBlock Grid.Row="2" x:Name="RhythmStatus" Text="{Binding Status}" Margin="0,8,0,0" HorizontalAlignment="Right"
                   Foreground="{StaticResource Text.Secondary}"/>
    </Grid>
</Window>
