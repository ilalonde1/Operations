<Window x:Class="Kor.Operations.App.BusinessDevelopment.Director.BdDirectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Kor.Operations.Converters"
        xmlns:director="clr-namespace:Kor.Operations.App.BusinessDevelopment.Director"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:opp="clr-namespace:Kor.Operations.App.Opportunities"
        Title="BD Director" Width="1680" Height="980" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{StaticResource App.Background}">
    <Window.Resources>
        <converters:BdDayConverter x:Key="BdDay"/>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <opp:NullOrEmptyStringToVisibilityConverter x:Key="TextVisible"/>
        <opp:InvertBoolConverter x:Key="Not"/>
        <Style x:Key="PlanChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="#E5F3EA"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="off"><Setter Property="Background" Value="#FBE9E7"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="slow"><Setter Property="Background" Value="#FDF2DC"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="blocked"><Setter Property="Background" Value="#E6EDF3"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <DataTemplate x:Key="PassagePane">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Passage" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="{Binding SelectedPassage.SourceTitle}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4"/>
                <TextBlock Grid.Row="2" Text="{Binding SelectedPassage.Ref}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Text="{Binding PassageMessage}" TextWrapping="Wrap"/>
                <TextBox Grid.Row="4" Text="{Binding SelectedPassage.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10"/>
                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectedClaim.Claim.RetiredReason}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CitationStatus}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="20,9"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Panel.Border}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Panel.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="27"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Padding="18,6"
                    IsEnabled="{Binding CanRefresh}" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="BD Director" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0">
                    <Run Text="{Binding Live, Mode=OneWay}"/><Run Text=" live pursuits · "/>
                    <Run Text="{Binding PeopleCount, Mode=OneWay}"/><Run Text=" people · as of "/>
                    <Run Text="{Binding AsOf, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <TabControl x:Name="Tabs" Grid.Row="1">
        <TabItem Header="Today" x:Name="TodayTab">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding HourMessage}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"
                           Visibility="{Binding HourMessage, Converter={StaticResource TextVisible}}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasHour, Converter={StaticResource BoolVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MaxWidth="1100"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MinWidth="360" MaxWidth="600"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Hour.Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Hour.Lede}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding MovesProgressText}" FontWeight="SemiBold" Margin="0,0,22,4"/>
                                <TextBlock Text="{Binding TeamLateText}" Foreground="#B0362C" Margin="0,0,22,4"/>
                                <TextBlock Text="{Binding DueTomorrowText}" Foreground="#8A5A00" Margin="0,0,22,4"/>
                                <TextBlock Text="{Binding ClosedSinceYesterdayText}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,22,4"/>
                            </WrapPanel>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Ask Claude" Click="AskClaudeToday_Click" Padding="14,4" Margin="8,0,0,0"
                                        ToolTip="Opens Claude Code on your PC with today's picture and the doctrine that applies. Its answer comes back under Doctrine."/>
                                <TextBox x:Name="AskTodayBox" MaxLength="2000" controls:Placeholder.Text="Ask Claude about today, the team or what to do next…" Padding="8,4"/>
                            </DockPanel>
                            <Border Background="#FDF2DC" BorderBrush="#8A5A00" BorderThickness="4,0,0,0" Padding="12,8" Margin="0,10,0,4"
                                    Visibility="{Binding Hour.Callout, Converter={StaticResource TextVisible}}">
                                <TextBlock Text="{Binding Hour.Callout}" TextWrapping="Wrap" Foreground="#17212C"/>
                            </Border>

                            <TextBlock Text="Today's moves" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>
                            <ItemsControl x:Name="MovesList" ItemsSource="{Binding Moves}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                            Background="{StaticResource App.Background}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsResolved}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SideText}" Foreground="{StaticResource Text.Secondary}"/>
                                                <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Rank, Mode=OneWay}"/><Run Text=".  "/><Run Text="{Binding Title, Mode=OneWay}"/></TextBlock>
                                            </DockPanel>
                                            <StackPanel Visibility="{Binding IsOpen, Converter={StaticResource BoolVisibility}}">
                                                <ItemsControl ItemsSource="{Binding WhyNow}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,1"><Run Text="•  "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Background="#E6EDF3" BorderBrush="#2E4A62" BorderThickness="3,0,0,0" Padding="10,6" Margin="0,8,0,0"
                                                        Visibility="{Binding Principle.Quote, Converter={StaticResource TextVisible}, FallbackValue=Collapsed}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Principle.Quote}" TextWrapping="Wrap" Foreground="#17212C"/>
                                                        <TextBlock Text="{Binding Principle.Cite}" Foreground="#5A6876" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Drafts}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <Expander Margin="0,3" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" Padding="6,3">
                                                            <Expander.Header>
                                                                <TextBlock TextWrapping="Wrap"><Run Text="Draft: " FontWeight="SemiBold"/><Run Text="{Binding Subject, Mode=OneWay}"/><Run Text="   to " Foreground="#5A6876"/><Run Text="{Binding ToText, Mode=OneWay}" Foreground="#5A6876"/></TextBlock>
                                                            </Expander.Header>
                                                            <StackPanel Margin="0,6,0,4">
                                                                <TextBox Text="{Binding Body, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="10,8" MaxHeight="320"
                                                                         VerticalScrollBarVisibility="Auto"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <Button Content="Copy" Click="CopyDraft_Click" Tag="{Binding Draft}" Padding="12,4" Margin="0,0,8,0"/>
                                                                    <Button Content="Draft in Outlook" Click="DraftInOutlook_Click" Tag="{Binding Draft}" Padding="12,4"
                                                                            ToolTip="Opens a new message in Outlook for you to review and send. Nothing is sent from here."/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,1"><Run Text="→  "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button Content="Done" Click="MoveResult_Click" Tag="Done" Padding="16,5" Margin="0,0,8,6" FontWeight="SemiBold"/>
                                                    <Button Content="Not today" Click="MoveResult_Click" Tag="NotToday" Padding="12,5" Margin="0,0,8,6"/>
                                                    <Button Content="Not doing" Click="MoveResult_Click" Tag="NotDoing" Padding="12,5" Margin="0,0,20,6"/>
                                                    <ItemsControl ItemsSource="{Binding Links}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <Button Content="{Binding Label}" Tag="{Binding Url}" Click="OpenLink_Click" Style="{StaticResource LinkButton}"/>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="#2E7A4C" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                    Visibility="{Binding IsHourFinished, Converter={StaticResource BoolVisibility}}">
                                <TextBlock TextWrapping="Wrap"><Run Text="That is the hour." FontWeight="SemiBold"/><Run Text=" Everything you did is recorded. Tomorrow's starts from where you left off."/></TextBlock>
                            </Border>
                            <TextBlock Text="{Binding Hour.Sources}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding Hour.NotCovered}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Your list" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding MyActions}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox Click="ActionCheck_Click" Tag="{Binding}" VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="Mark done"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Row.Action}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DueText}" Margin="8,0,0,0" FontSize="12">
                                                    <TextBlock.Style><Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#B0362C"/></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding MyActionsText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Decisions waiting on you" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding Hour.Decisions}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="•  "/><Run Text="{Binding Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="Meetings" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding Hour.Meetings}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="•  "/><Run Text="{Binding Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="People" x:Name="PeopleTab">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="What each person owes, how late, and when you next see them. Pick a person; their one-to-one agenda is built from their list."
                           TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" x:Name="PeopleCardsList" ItemsSource="{Binding PeopleCards}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel Width="230" Margin="6,6">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RoleText}" Foreground="{StaticResource Text.Secondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding OpenText}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding LateText}" Margin="0,0,12,0">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Style.Triggers><DataTrigger Binding="{Binding HasLate}" Value="True"><Setter Property="Foreground" Value="#B0362C"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding WeekText}">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Style.Triggers><DataTrigger Binding="{Binding HasThisWeek}" Value="True"><Setter Property="Foreground" Value="#8A5A00"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding NextText}" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
                    <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Add an action…" Click="AddActionForPerson_Click" Padding="12,4"/>
                                <TextBlock Text="{Binding PersonTitle}" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Ask Claude" Click="AskClaudePerson_Click" Padding="14,4" Margin="8,0,0,0"
                                        ToolTip="Opens Claude Code with this person's list, their agenda and the doctrine that applies."/>
                                <TextBox x:Name="AskPersonBox" MaxLength="2000" controls:Placeholder.Text="Ask Claude about this person: how to run the one-to-one, what to push…" Padding="8,4"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PersonActions}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <CheckBox Click="ActionCheck_Click" Tag="{Binding}" VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="Mark done"
                                                      IsEnabled="{Binding Row.IsOpen}" IsChecked="{Binding Row.IsOpen, Mode=OneWay, Converter={StaticResource Not}}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Row.Action}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding From}" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DueText}" Margin="12,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#B0362C"/></DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <Grid>
                            <TextBlock Text="{Binding PersonNote}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding PersonNote, Converter={StaticResource TextVisible}}"/>
                            <DockPanel Visibility="{Binding PersonIsLead, Converter={StaticResource BoolVisibility}}">
                                <TextBlock DockPanel.Dock="Top" Text="Next one-to-one" Style="{StaticResource SectionTitle}"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
                                    <DatePicker x:Name="PersonMeetingDate" Width="140" Margin="0,0,8,0"/>
                                    <Button Content="Plan it" Click="PlanPersonOneToOne_Click" Padding="14,4" FontWeight="SemiBold"
                                            ToolTip="Records the one-to-one with this agenda. Nothing is sent; draft the invite next."/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Copy the agenda" Click="CopyPersonAgenda_Click" Padding="12,4" Margin="0,0,8,0"/>
                                    <Button Content="Draft the invite in Outlook" Click="DraftPersonInvite_Click" Padding="12,4"/>
                                </StackPanel>
                                <TextBox Text="{Binding PersonAgenda, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Padding="10"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Pursuits" x:Name="PursuitsTab">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding PursuitsMessage}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Ask Claude" Click="AskClaudePursuit_Click" Padding="14,4" Margin="8,0,0,0"
                            ToolTip="Opens Claude Code on the selected pursuit, with the doctrine that applies."/>
                    <TextBox x:Name="AskPursuitBox" MaxLength="2000" controls:Placeholder.Text="Pick a pursuit, then ask Claude about it: how to move it, who to call, what is missing…" Padding="8,4"/>
                </DockPanel>
                <ListBox Grid.Row="2" x:Name="PursuitLinesList" ItemsSource="{Binding PursuitLines}" MouseDoubleClick="PursuitLine_DoubleClick"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{StaticResource Panel.Border}">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid Margin="6,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                <TextBlock Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"><Run Text="{Binding Line, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding TouchText, Mode=OneWay}"/></TextBlock>
                                <TextBlock Text="{Binding Gap}" Foreground="#B0362C" TextWrapping="Wrap" Visibility="{Binding Gap, Converter={StaticResource TextVisible}}"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="10" Padding="10,2" Margin="12,0"
                                    VerticalAlignment="Top"><TextBlock Text="{Binding StageText}" FontSize="12" FontWeight="SemiBold"/></Border>
                            <Button Grid.Column="2" Content="Open" Click="OpenPursuitLine_Click" Tag="{Binding}" Padding="12,3" VerticalAlignment="Top"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
        <TabItem Header="Doctrine" x:Name="DoctrineTab">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"
                           Text="What the books and your experience say a BD director does, as cards you accept or reject. Only accepted cards reach Claude's later answers. Claude runs on your PC; nothing is sent from here."/>
                <DockPanel Grid.Row="1" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Synthesize from the books" Click="Synthesize_Click" Padding="14,4" Margin="8,0,0,0" FontWeight="SemiBold"
                            ToolTip="Opens Claude Code to read the books in the knowledge base and propose doctrine cards, building on what you have accepted."/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBox x:Name="SynthesisFocusBox" MaxLength="2000" controls:Placeholder.Text="Optional focus for the synthesis, e.g. pricing and fee proposals" Padding="8,4"/>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="560"/></Grid.ColumnDefinitions>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="Accept all waiting" Click="AcceptAllCards_Click" Padding="14,4" VerticalAlignment="Center"
                                    Visibility="{Binding HasProposed, Converter={StaticResource BoolVisibility}}"
                                    ToolTip="Accepts every card waiting for you. Reject the ones you disagree with first."/>
                            <TextBlock Text="{Binding ProposedHeading}" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="ProposedCardsList" ItemsSource="{Binding Proposed}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Plain}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0"><Run Text="{Binding Title, Mode=OneWay}"/><Run Text="  ·  applies to "/><Run Text="{Binding AppliesTo, Mode=OneWay}"/></TextBlock>
                                                <Expander Header="The card" Margin="0,6,0,0">
                                                    <StackPanel Margin="0,4,0,0">
                                                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="Principle: " FontWeight="SemiBold"/><Run Text="{Binding Principle, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="You are in it when: " FontWeight="SemiBold"/><Run Text="{Binding Recognise, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="The play: " FontWeight="SemiBold"/><Run Text="{Binding Play, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,2" Visibility="{Binding Warning, Converter={StaticResource TextVisible}}"><Run Text="Warning sign: " FontWeight="SemiBold"/><Run Text="{Binding Warning, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,2" Foreground="{StaticResource Text.Secondary}"><Run Text="From: "/><Run Text="{Binding Citations, Mode=OneWay}"/></TextBlock>
                                                    </StackPanel>
                                                </Expander>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="Accept" Click="AcceptCard_Click" Tag="{Binding}" Padding="16,4" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                                    <Button Content="Reject" Click="RejectCard_Click" Tag="{Binding}" Padding="14,4"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander Header="Accepted doctrine" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding Accepted}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="#"/><Run Text="{Binding Id, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding Play, Mode=OneWay}" Foreground="#5A6876"/></TextBlock>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Questions and answers" Style="{StaticResource SectionTitle}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RunsList" ItemsSource="{Binding Runs}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{StaticResource Panel.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#2E4A62" Margin="0,2,0,0"/>
                                            <TextBox Text="{Binding Answer, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                                     Margin="0,4,0,0" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                                     Visibility="{Binding Answer, Converter={StaticResource TextVisible}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Data" x:Name="DataTab">
        <TabControl x:Name="DataTabs" Margin="0,8,0,0">
        <TabItem Header="Actions" x:Name="ActionsTab">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Every commitment, with its owner, date and result. Seeded from the 9 October meeting." TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ActionSummary}" FontWeight="SemiBold" Margin="0,6,0,8"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding ActionFilters}" SelectedItem="{Binding ActionFilter}" Width="120" Margin="0,0,8,6"/>
                    <ComboBox ItemsSource="{Binding Owners}" SelectedItem="{Binding OwnerFilter}" Width="220" Margin="0,0,16,6"/>
                    <Button Content="Mark done…" Click="ActionDone_Click" IsEnabled="{Binding CanCloseAction}" Padding="12,5" Margin="0,0,6,6"/>
                    <Button Content="Declined…" Click="ActionDeclined_Click" IsEnabled="{Binding CanCloseAction}" Padding="12,5" Margin="0,0,6,6"/>
                    <Button Content="Withdraw…" Click="ActionWithdraw_Click" IsEnabled="{Binding CanCloseAction}" Padding="12,5" Margin="0,0,16,6"/>
                    <Button Content="Add an action…" Click="AddAction_Click" Padding="12,5" Margin="0,0,6,6"/>
                </WrapPanel>
                <DataGrid MouseDoubleClick="Row_DoubleClick" Grid.Row="2" x:Name="ActionsGrid" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" RowHeight="NaN">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#B3261E"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                        <DataGridTextColumn Header="Due" Binding="{Binding Row.DueUtc, Converter={StaticResource BdDay}}" Width="105"/>
                        <DataGridTextColumn Header="Owner" Binding="{Binding Row.OwnerName}" Width="170"/>
                        <DataGridTemplateColumn Header="Action" Width="3*">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Margin="6,4">
                                    <TextBlock Text="{Binding Row.Action}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Row.WhyNow}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text.Secondary}"
                                               Visibility="{Binding Row.WhyNow, Converter={StaticResource TextVisible}}"/>
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Region" Binding="{Binding RegionText}" Width="120"/>
                        <DataGridTextColumn Header="From" Binding="{Binding From}" Width="150"/>
                        <DataGridTemplateColumn Header="Result" Width="2*">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding Row.Result}" TextWrapping="Wrap" Margin="6,4"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="Meetings" x:Name="MeetingsTab">
            <Grid Margin="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="460"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="A 20-minute one-to-one with each lead every two weeks, and a 27-minute all-hands each month. Agendas are built from the action register. Nothing is sent from here." TextWrapping="Wrap"/>
                    <WrapPanel Grid.Row="1" Margin="0,8">
                        <ComboBox x:Name="LeadPicker" ItemsSource="{Binding Leads}" DisplayMemberPath="Name" SelectedIndex="0" Width="210" Margin="0,0,8,6"/>
                        <DatePicker x:Name="MeetingDate" Width="130" Margin="0,0,8,6"/>
                        <Button Content="Plan one-to-one" Click="PlanOneToOne_Click" Padding="10,5" Margin="0,0,8,6"/>
                        <Button Content="Plan all-hands" Click="PlanAllHands_Click" Padding="10,5" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Meetings}" SelectedItem="{Binding SelectedMeeting}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding Row.ScheduledForUtc, Converter={StaticResource BdDay}}" Width="105"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" Width="95"/>
                            <DataGridTextColumn Header="Meeting" Binding="{Binding Row.Title}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Row.Status}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding SelectedMeeting.Row.Title}" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel Grid.Row="1" Margin="0,4,0,8">
                        <Button Content="Copy" Click="CopyMeeting_Click" Padding="10,5" Margin="0,0,8,6"/>
                        <Button Content="Draft invite in Outlook" Click="DraftMeetingInvite_Click" Padding="10,5" Margin="0,0,8,6"
                                ToolTip="Opens a new message in Outlook with the agenda. Nothing is sent from here."/>
                        <Button Content="Record as held…" Click="MeetingHeld_Click" Padding="10,5" Margin="0,0,8,6"/>
                        <Button Content="Cancel meeting" Click="MeetingCancelled_Click" Padding="10,5" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <TextBox Grid.Row="2" Text="{Binding SelectedMeeting.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="10"/>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="References" x:Name="ReferencesTab">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Every reference KOR gives out. Phone each one before their name goes on an application, and tell them KOR was BMZ. Rows in red still need work." TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ReferenceSummary}" FontWeight="SemiBold" Margin="0,6,0,8"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button Content="Record a call…" Click="RecordReferenceCall_Click" Padding="12,5" Margin="0,0,8,6"/>
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference}" RowHeight="NaN">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="#B3261E"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Project" Width="2*">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Row.Project}" TextWrapping="Wrap" Margin="6,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Role" Binding="{Binding Row.Role}" Width="140"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding Row.Company}" Width="190"/>
                        <DataGridTextColumn Header="Person" Binding="{Binding Contact}" Width="150"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Row.Phone}" Width="115"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Row.Email}" Width="200"/>
                        <DataGridTextColumn Header="KOR lead" Binding="{Binding Row.KorLeadName}" Width="130"/>
                        <DataGridTextColumn Header="Call" Binding="{Binding OutcomeText}" Width="105"/>
                        <DataGridTextColumn Header="Called" Binding="{Binding Row.LastCalledUtc, Converter={StaticResource BdDay}}" Width="95"/>
                        <DataGridTemplateColumn Header="Notes" Width="2*">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Row.Notes}" TextWrapping="Wrap" Margin="6,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="The number">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static director:BdDirectorViewModel.NumberCaption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Set a target…" Click="SetTarget_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Retire" Click="RetireTarget_Click" Padding="12,6"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Height="500">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="What" Binding="{Binding MetricDisplay}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeDisplay}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="Period" Width="245">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock ToolTip="{Binding PeriodNote}">
                                        <Run Text="{Binding Target.PeriodStartUtc, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                                        <Run Text=" – "/><Run Text="{Binding Target.PeriodEndUtc, Mode=OneWay, Converter={StaticResource BdDay}}"/>
                                    </TextBlock>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetDisplay}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Actual" Binding="{Binding ActualDisplay}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Set by" Binding="{Binding Target.SetBy}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding FeeCoverage}" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="By person">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12">
            <StackPanel>
                <TextBlock Text="People" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{x:Static director:BdDirectorViewModel.PeopleCaption}" TextWrapping="Wrap"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                          Height="270" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Person" Binding="{Binding DisplayName}" Width="2*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Live pursuits" Binding="{Binding Live}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Second seat" Binding="{Binding SecondSeat}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Overdue next action" Binding="{Binding OverdueNextAction}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="No next action" Binding="{Binding NoNextAction}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Untouched 14 days" Binding="{Binding Untouched14d}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Activity, 30 days" Binding="{Binding Activities30}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Activity, 90 days" Binding="{Binding Activities90}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Buyers emailed, 90 days" Binding="{Binding BuyersMailed90}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Opened the tools, 30 days" Binding="{Binding Opens30}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding SelectedPersonCaption}" FontWeight="SemiBold" Margin="0,10,0,6"/>
                <DataGrid MouseDoubleClick="Row_DoubleClick" ItemsSource="{Binding SelectedPursuits}" Height="132">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pursuit" Binding="{Binding ProjectName}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="110" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivity}" Width="125" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Opened" Binding="{Binding Opened}" Width="125" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Reassign…" Click="Reassign_Click" Padding="8,2" Margin="2,0"/>
                                        <Button Content="Open" Click="OpenPursuit_Click" Tag="{Binding PursuitId}" Padding="8,2" Margin="2,0"/>
                                        <Button Content="Ask…" Click="AskPursuit_Click" Padding="8,2" Margin="2,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Header="Funnel">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12">
            <StackPanel>
                <TextBlock Text="Funnel" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
                <TextBlock Text="{x:Static director:BdDirectorViewModel.FunnelCaption}" TextWrapping="Wrap"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding Stages}" Height="102">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Pursuits" Binding="{Binding Pursuits}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Days in stage, median" Binding="{Binding MedianDisplay}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding Outcomes}" TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <TextBlock Text="{Binding LostDetails}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Where wins came from" FontWeight="SemiBold" Margin="0,0,0,6"/>
