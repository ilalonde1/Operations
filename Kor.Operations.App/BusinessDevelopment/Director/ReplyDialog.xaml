<Window x:Class="Kor.Operations.App.BusinessDevelopment.Director.ReplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Record reply" Width="640" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource App.Background}">
    <!-- An owner's answer to a roll-up: one line per number. Nothing is written until Save; the preview names every pursuit. -->
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="ReplyBox" AcceptsReturn="True" TextWrapping="Wrap" Height="150" MaxLength="8000" VerticalScrollBarVisibility="Auto"
                 controls:Placeholder.Text="Paste the reply, e.g.  1. done   2. moved to Fri 30 Oct   3. dropped, went with RJC"
                 TextChanged="ReplyBox_TextChanged" Margin="0,0,0,12"/>
        <TextBlock Text="What saving will do" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="#17212c" Margin="0,0,0,8"/>
        <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Foreground="#b3261e" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="Save_Click" Padding="16,6" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
