<!-- The BD look (21 Oct 2026, Ian: "that same look and function … to the BD interface the users use"). Merged by BD Director and
     the BD Workspace, so every screen inside either one draws its buttons and tables the same way without being edited one by
     one. Implicit styles only: a screen that sets its own style still wins. KOR palette from Themes/KorTheme.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DirectorStyles.xaml"/></ResourceDictionary.MergedDictionaries>

    <!-- Buttons: flat, rounded, no Windows chrome. -->
    <Style TargetType="Button" BasedOn="{StaticResource D.Button}">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <!-- Tabs: words with a slate underline under the selected one, no boxes. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource D.Line}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="0,12,0,0"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource D.Ink2}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="b" Padding="14,8,14,7" Margin="0,0,2,-1" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource D.Ink}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource D.Slate}"/>
                            <Setter Property="Foreground" Value="{StaticResource D.Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggles (Mine, filters): a rounded chip, slate when on. Built-in controls give their inner toggles their own style, so this
         reaches only toggles a screen draws itself. -->
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource D.Ink2}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource D.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource D.Slate}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource D.Slate}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#B9C1CA"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group boxes: a card with a quiet heading. -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource D.Line}"/>
        <Setter Property="Foreground" Value="{StaticResource D.Ink}"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,8" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource D.Ink2}" TextElement.FontSize="12.5"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource D.Ink}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Tables: horizontal rules only, a quiet header, room to read, a soft selection. -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource D.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F2"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="MinRowHeight" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource D.Ink}"/>
        <Setter Property="AlternatingRowBackground" Value="White"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F7F8FA"/>
        <Setter Property="Foreground" Value="{StaticResource D.Ink2}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource D.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="8,5">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#E6ECF6"/>
                <Setter Property="Foreground" Value="{StaticResource D.Ink}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
