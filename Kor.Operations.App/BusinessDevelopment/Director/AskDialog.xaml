<Window x:Class="Kor.Operations.App.BusinessDevelopment.Director.AskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Ask" Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource App.Background}">
    <StackPanel Margin="20">
        <TextBlock Text="To"/><ComboBox x:Name="PersonBox" DisplayMemberPath="Display" controls:Placeholder.Text="Choose a person" Margin="0,4,0,12"/>
        <TextBlock Text="Ask"/><TextBox x:Name="AskBox" MaxLength="500" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
            controls:Placeholder.Text="One bounded thing to do" Margin="0,4,0,12"/>
        <TextBlock Text="Why now (optional)"/><TextBox x:Name="WhyBox" MaxLength="1000" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
            controls:Placeholder.Text="Why this matters now" Margin="0,4,0,12"/>
        <TextBlock Text="Minutes (5–180)"/><TextBox x:Name="MinutesBox" Text="60" controls:Placeholder.Text="Minutes" Margin="0,4,0,12"/>
        <TextBlock Text="Due"/><DatePicker x:Name="DuePicker" Margin="0,4,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Save ask" IsDefault="True" Click="Save_Click" Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</Window>
