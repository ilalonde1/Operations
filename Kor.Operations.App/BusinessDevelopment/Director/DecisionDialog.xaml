<Window x:Class="Kor.Operations.App.BusinessDevelopment.Director.DecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Record a decision" Width="580" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource App.Background}">
    <StackPanel Margin="20">
        <TextBlock Text="Kind"/><ComboBox x:Name="KindBox" DisplayMemberPath="Display" SelectedIndex="0" Margin="0,4,0,12"/>
        <TextBlock Text="Decision"/><TextBox x:Name="DecisionBox" MaxLength="500" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
            controls:Placeholder.Text="What was decided" Margin="0,4,0,12"/>
        <TextBlock Text="Rationale"/><TextBox x:Name="RationaleBox" MaxLength="2000" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
            controls:Placeholder.Text="Why this is the right call" Margin="0,4,0,12"/>
        <TextBlock Text="Expected outcome"/><TextBox x:Name="ExpectedBox" MaxLength="500" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
            controls:Placeholder.Text="What should happen if this works" Margin="0,4,0,12"/>
        <TextBlock Text="Review date"/><DatePicker x:Name="ReviewPicker" Margin="0,4,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Record decision" IsDefault="True" Click="Save_Click" Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</Window>
