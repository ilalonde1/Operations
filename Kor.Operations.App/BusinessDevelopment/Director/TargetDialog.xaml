<Window x:Class="Kor.Operations.App.BusinessDevelopment.Director.TargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Set a target" Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{StaticResource App.Background}">
    <StackPanel Margin="20">
        <TextBlock Text="What"/><ComboBox x:Name="MetricBox" DisplayMemberPath="Display" SelectedValuePath="Key" SelectedIndex="0" Margin="0,4,0,12"/>
        <TextBlock Text="Scope"/><ComboBox x:Name="ScopeBox" SelectedIndex="0" SelectionChanged="Scope_Changed" Margin="0,4,0,12"/>
        <TextBlock Text="Person (for a person target)"/>
        <ComboBox x:Name="PersonBox" DisplayMemberPath="Display" controls:Placeholder.Text="Choose a person"
                  SelectionChanged="Person_Changed" Margin="0,4,0,12"/>
        <TextBlock Text="Region or person's mailbox"/>
        <TextBox x:Name="KeyBox" MaxLength="150" controls:Placeholder.Text="Region name or email address" Margin="0,4,0,12"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Period start"/><DatePicker x:Name="StartPicker" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Period end (exclusive)"/><DatePicker x:Name="EndPicker" Margin="0,4,0,0"/></StackPanel>
        </Grid>
        <TextBlock Text="Live pursuits, pipeline fee and accounts with a live pursuit show today's snapshot; their periods do not filter the actual." TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Target value"/><TextBox x:Name="ValueBox" controls:Placeholder.Text="Number or fee" Margin="0,4,0,12"/>
        <TextBlock Text="Note (optional)"/><TextBox x:Name="NoteBox" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                    controls:Placeholder.Text="Why this target" Margin="0,4,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Set target" IsDefault="True" Click="Save_Click" Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</Window>
