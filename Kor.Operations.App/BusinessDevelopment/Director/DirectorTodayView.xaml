<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Director.DirectorTodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DirectorStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Vis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Two columns: what to decide and what is waiting on the left, the person's own list on the right. Nothing is drawn
         empty: a section with nothing in it is not shown (Ian, 21 Oct: the stranded card and the empty box were "butt ugly"). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,32,40,32" MaxWidth="1560" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="2*" MinWidth="360"/></Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,28">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource D.Title}"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="{StaticResource D.Ink2}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <!-- 0. A tender joined one of the person's forward pursuits on its own: say so plainly, once, and let them accept it or
                     send it back as the grabber's own pursuit (Ian, 21 Oct 2026: "make it obvious it's a join"). -->
                <TextBlock Text="{Binding JoinsHeader}" Style="{StaticResource D.Section}" Visibility="{Binding HasJoins, Converter={StaticResource Vis}}"/>
                <ItemsControl ItemsSource="{Binding Joins}" Margin="0,0,0,12" Visibility="{Binding HasJoins, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource D.Card}" Margin="0,0,0,16" Padding="0" Background="#FFF8F5" BorderBrush="#FFD9CC">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource D.Orange}" CornerRadius="12,0,0,12"/>
                                    <StackPanel Grid.Column="1" Margin="24,18,24,18">
                                        <Border Style="{StaticResource D.Pill}" Background="{StaticResource D.Orange}">
                                            <TextBlock Text="JOINED" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource D.Ink}" Margin="0,10,0,3"/>
                                        <TextBlock Text="{Binding Sub}" FontSize="13" Foreground="{StaticResource D.Ink2}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Explain}" FontSize="13.5" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource D.Ink}" Margin="0,12,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Yes, it's this project" Style="{StaticResource D.Primary}" Click="AcceptJoin_Click"/>
                                            <Button Content="Not this project" Style="{StaticResource D.Button}" Margin="8,0,0,0" Click="RejectJoin_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 1. What needs a call: one card per tender, the questions that decide it, the button that acts on it. -->
                <TextBlock Text="{Binding DecisionsHeader}" Style="{StaticResource D.Section}"/>
                <Border Style="{StaticResource D.Card}" Margin="0,0,0,28" Visibility="{Binding NoDecisions, Converter={StaticResource Vis}}">
                    <TextBlock Text="Nothing waiting on your call. A tender you grab lands here once Claude has read it." FontSize="13.5"
                               Foreground="{StaticResource D.Ink2}" TextWrapping="Wrap"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Decisions}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource D.Card}" Margin="0,0,0,16" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{Binding VerdictBrush}" CornerRadius="12,0,0,12"/>
                                    <StackPanel Grid.Column="1" Margin="24,20,24,20">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource D.Pill}" Background="{Binding VerdictBrush}">
                                                <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictFore}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <Border Style="{StaticResource D.Chip}" Background="{Binding ChipBack}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Chip}" Foreground="{Binding ChipFore}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource D.Ink}" Margin="0,12,0,3"/>
                                        <TextBlock FontSize="13" Foreground="{StaticResource D.Ink2}" TextWrapping="Wrap">
                                            <Run Text="{Binding Buyer, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding OwnerLine, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock Text="{Binding PointsLead}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource D.Ink2}"
                                                   Margin="0,18,0,2" Visibility="{Binding HasPointsLead, Converter={StaticResource Vis}}"/>
                                        <ItemsControl ItemsSource="{Binding Points}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource D.Orange}" Margin="2,8,12,0" VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding}" FontSize="14" TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource D.Ink}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding NextStep}" FontSize="12.5" Foreground="{StaticResource D.Ink2}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,16,0,0" Visibility="{Binding HasNextStep, Converter={StaticResource Vis}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Content="{Binding PrimaryAction}" Style="{StaticResource D.Primary}" Click="Primary_Click"/>
                                            <Button Content="{Binding SecondaryAction}" Style="{StaticResource D.Button}" Margin="8,0,0,0" Click="Review_Click"
                                                    Visibility="{Binding HasSecondary, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2. A lead's own pursuits with no next step or an overdue one: one click to fix. -->
                <TextBlock Text="{Binding FollowUpsHeader}" Style="{StaticResource D.Section}"
                           Visibility="{Binding HasFollowUps, Converter={StaticResource Vis}}"/>
                <Border Style="{StaticResource D.Card}" Padding="20,4" Margin="0,0,0,28" Visibility="{Binding HasFollowUps, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding FollowUps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource D.Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Set next step" Style="{StaticResource D.Button}" Padding="12,5"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="FollowUp_Click"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource D.Ink}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12.5" Foreground="{Binding SubBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 3. The dates that matter in the next three weeks; not drawn when there are none. -->
                <TextBlock Text="COMING UP" Style="{StaticResource D.Section}" Visibility="{Binding HasWeek, Converter={StaticResource Vis}}"/>
                <Border Style="{StaticResource D.Card}" Padding="20,4" Visibility="{Binding HasWeek, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding Week}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource D.Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Day}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource D.Ink}"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{StaticResource D.Ink3}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{StaticResource D.Ink}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource D.Ink2}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource D.Chip}" Background="{Binding TagBack}">
                                            <TextBlock Text="{Binding Tag}" Foreground="{Binding TagFore}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- 4. New grabs (Director only), the person's own list, today's prepared moves, and the one person who most needs a hand. -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <!-- What the team grabbed since the manager last looked: keep it with them, or give it to someone else.
                     Grabbing stays instant; this is managing by exception (Director only). -->
                <TextBlock Text="{Binding NewGrabsHeader}" Style="{StaticResource D.Section}"
                           Visibility="{Binding HasNewGrabs, Converter={StaticResource Vis}}"/>
                <Border Style="{StaticResource D.Card}" Padding="20,4" Margin="0,0,0,28" Visibility="{Binding HasNewGrabs, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding NewGrabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource D.Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource D.Avatar}" Background="{Binding AvatarBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="Keep" Style="{StaticResource D.Button}" Padding="14,5" Click="Keep_Click"
                                                    ToolTip="It stays with them; it leaves this list."/>
                                            <Button Content="Give to…" Style="{StaticResource D.Ghost}" Padding="12,5" Margin="6,0,0,0" Click="Give_Click"
                                                    ToolTip="Open it in Pursuits to choose who should have it. They are emailed automatically."/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource D.Ink}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12.5" Foreground="{StaticResource D.Ink2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <DockPanel Margin="0,0,0,0">
                    <Border DockPanel.Dock="Right" Style="{StaticResource D.Chip}" Background="#FEE2E2" Margin="0,-4,0,6" VerticalAlignment="Top"
                            Visibility="{Binding HasListLate, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding ListLate}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding ListHeader}" Style="{StaticResource D.Section}"/>
                </DockPanel>
                <Border Style="{StaticResource D.Card}" Padding="20,4">
                    <Grid>
                        <TextBlock Text="Nothing on your list." Foreground="{StaticResource D.Ink3}" Margin="0,14"
                                   Visibility="{Binding ListEmpty, Converter={StaticResource Vis}}"/>
                        <ItemsControl ItemsSource="{Binding MyList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource D.Line}" BorderThickness="0,0,0,1" Padding="0,13">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Left" Width="20" Height="20" Margin="0,1,14,0" VerticalAlignment="Top" Click="Done_Click"
                                                    ToolTip="Mark done" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="box" BorderBrush="#C3CAD2" BorderThickness="1.5" CornerRadius="10" Background="White">
                                                            <Path x:Name="tick" Data="M5,10 L8.5,13.5 L15,6.5" Stroke="White" StrokeThickness="2" Visibility="Hidden"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="box" Property="Background" Value="#3F5364"/>
                                                                <Setter TargetName="box" Property="BorderBrush" Value="#3F5364"/>
                                                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource D.Ink}"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{Binding SubBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Style="{StaticResource D.Card}" Margin="0,16,0,0" Visibility="{Binding HasHour, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open the hour" Style="{StaticResource D.Button}" VerticalAlignment="Center" Click="Hour_Click"/>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="TODAY'S MOVES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource D.Ink3}"/>
                            <TextBlock Text="{Binding HourTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource D.Ink}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding HourProgress}" FontSize="12" Foreground="{StaticResource D.Ink2}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource D.Card}" Margin="0,16,0,0" Background="#FFF6F2" BorderBrush="#FFD9CC"
                        Visibility="{Binding HasNudge, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource D.Avatar}" Background="{Binding Nudge.AvatarBrush}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Nudge.Initials}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right" Content="Book 20 min" Style="{StaticResource D.Button}" VerticalAlignment="Center" Click="Nudge_Click"/>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding Nudge.NudgeText}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" Foreground="{StaticResource D.Ink}"/>
                            <TextBlock Text="A short pass together would clear most of them." FontSize="12" Foreground="{StaticResource D.Ink2}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
