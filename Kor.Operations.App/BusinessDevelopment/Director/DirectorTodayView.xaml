<UserControl x:Class="Kor.Operations.App.BusinessDevelopment.Director.DirectorTodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DirectorStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Vis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,30">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource D.Title}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="{StaticResource D.Ink2}" Margin="0,4,0,26"/>

            <!-- 1. What needs Ian's call: one card per decision, the reason that decides it, the button that acts on it. -->
            <TextBlock Text="{Binding DecisionsHeader}" Style="{StaticResource D.Section}" Visibility="{Binding HasDecisions, Converter={StaticResource Vis}}"/>
            <ItemsControl ItemsSource="{Binding Decisions}" Margin="0,0,0,28" Visibility="{Binding HasDecisions, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource D.Card}" Margin="0,0,16,16" Padding="20,18">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Border Style="{StaticResource D.Pill}" Background="{Binding VerdictBrush}">
                                        <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictFore}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Style="{StaticResource D.Chip}" Background="{Binding ChipBack}" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Chip}" Foreground="{Binding ChipFore}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource D.Ink}" Margin="0,12,0,2"/>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Buyer}" FontSize="13" Foreground="{StaticResource D.Ink}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding OwnerLine}" FontSize="12.5" Foreground="{StaticResource D.Ink2}" Margin="0,2,0,0"/>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Deciding}" FontSize="13.5" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{StaticResource D.Ink}" Margin="0,12,0,16" MaxHeight="82" TextTrimming="WordEllipsis"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                    <Button Content="{Binding PrimaryAction}" Style="{StaticResource D.Primary}" Click="Primary_Click"/>
                                    <Button Content="{Binding SecondaryAction}" Style="{StaticResource D.Ghost}" Margin="6,0,0,0" Click="Review_Click"
                                            Visibility="{Binding HasSecondary, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- 2. The dates that matter in the next three weeks. -->
                <StackPanel>
                    <TextBlock Text="COMING UP" Style="{StaticResource D.Section}"/>
                    <Border Style="{StaticResource D.Card}" Padding="20,6">
                        <Grid>
                            <TextBlock Text="Nothing dated in the next three weeks." Foreground="{StaticResource D.Ink3}" Margin="0,12"
                                       Visibility="{Binding WeekEmpty, Converter={StaticResource Vis}}"/>
                            <ItemsControl ItemsSource="{Binding Week}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource D.Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Day}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource D.Ink}"/>
                                                    <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{StaticResource D.Ink3}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{StaticResource D.Ink}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource D.Ink2}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource D.Chip}" Background="{Binding TagBack}">
                                                    <TextBlock Text="{Binding Tag}" Foreground="{Binding TagFore}" FontSize="12" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 3. Ian's own list, today's prepared moves, and the one person who most needs a hand. -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="YOUR LIST" Style="{StaticResource D.Section}"/>
                    <Border Style="{StaticResource D.Card}" Padding="18,4">
                        <Grid>
                            <TextBlock Text="Nothing on your list." Foreground="{StaticResource D.Ink3}" Margin="0,12"
                                       Visibility="{Binding ListEmpty, Converter={StaticResource Vis}}"/>
                            <ItemsControl ItemsSource="{Binding MyList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource D.Line}" BorderThickness="0,0,0,1" Padding="0,11">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Left" Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top" Click="Done_Click"
                                                        ToolTip="Done" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="box" BorderBrush="#B9C1CA" BorderThickness="2" CornerRadius="5" Background="White"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#3F5364"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" Foreground="{StaticResource D.Ink}"/>
                                                    <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{Binding SubBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- A lead's own pursuits with no next step or an overdue one: one click to fix. -->
                    <TextBlock Text="{Binding FollowUpsHeader}" Style="{StaticResource D.Section}" Margin="2,24,0,10"
                               Visibility="{Binding HasFollowUps, Converter={StaticResource Vis}}"/>
                    <Border Style="{StaticResource D.Card}" Padding="18,4" Visibility="{Binding HasFollowUps, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding FollowUps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource D.Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Set next step" Style="{StaticResource D.Button}" Padding="11,5"
                                                    VerticalAlignment="Center" Margin="10,0,0,0" Click="FollowUp_Click"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource D.Ink}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{Binding SubBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Style="{StaticResource D.Card}" Margin="0,16,0,0" Visibility="{Binding HasHour, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open the hour" Style="{StaticResource D.Button}" VerticalAlignment="Center" Click="Hour_Click"/>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="TODAY'S MOVES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource D.Ink3}"/>
                                <TextBlock Text="{Binding HourTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource D.Ink}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding HourProgress}" FontSize="12" Foreground="{StaticResource D.Ink2}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource D.Card}" Margin="0,16,0,0" Background="#FFF6F2" BorderBrush="#FFD9CC"
                            Visibility="{Binding HasNudge, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource D.Avatar}" Background="{Binding Nudge.AvatarBrush}" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Nudge.Initials}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Content="Book 20 min" Style="{StaticResource D.Button}" VerticalAlignment="Center" Click="Nudge_Click"/>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Nudge.NudgeText}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" Foreground="{StaticResource D.Ink}"/>
                                <TextBlock Text="A short pass together would clear most of them." FontSize="12" Foreground="{StaticResource D.Ink2}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
