<Window x:Class="Kor.Operations.ContactPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        Title="Pick Contacts"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Loaded="Window_Loaded">

    <DockPanel LastChildFill="True" Margin="10">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
            Background="{StaticResource Brand.Primary.Brush}"
            CornerRadius="12"
            Padding="0"
            Margin="0,0,0,10">
            <controls:KorHeader x:Name="HeaderBar"
                          HeaderText="Select Contacts"
                          SubtitleText="Search Vantagepoint and pick one or more recipients"                            
                          AvatarDiameter="96"
                          AvatarBorderThickness="2"/>
        </Border>

        <!-- Main card -->
        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel LastChildFill="True">

                <!-- Filters -->
                <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox"
                   Width="460"
                   MinHeight="28"
                   Padding="6,4"
                   VerticalContentAlignment="Center"
                   Margin="0,0,8,0"
                   ToolTip="Search name, email, company, title (min 2 chars)"
                   KeyDown="SearchBox_KeyDown"/>
                    <Button x:Name="SearchBtn"
                  Content="Search"
                  Width="110"
                  Click="SearchBtn_Click"
                  Margin="0,0,8,0"/>
                    <Button x:Name="ClearBtn"
                  Content="Clear"
                  Width="100"
                  Style="{StaticResource Button.Secondary}"
                  Click="ClearBtn_Click"/>
                    <TextBlock x:Name="CountTextBlock"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>

                <!-- Pager + OK/Cancel (bottom) -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <TextBlock Text="Page:" VerticalAlignment="Center"/>
                    <TextBox x:Name="PageBox" Width="54" Text="1" Margin="6,0,8,0" Padding="4,2" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Size:" VerticalAlignment="Center"/>
                    <TextBox x:Name="PageSizeBox" Width="60" Text="200" Margin="6,0,8,0" Padding="4,2" VerticalContentAlignment="Center"/>
                    <Button x:Name="PrevBtn"
                            Content="Prev"
                            Click="OnPrev"
                            Margin="0,0,6,0"
                            Style="{StaticResource Button.Secondary}"/>
                    <Button x:Name="NextBtn"
                            Content="Next"
                            Click="OnNext"
                            Margin="0,0,8,0"/>
                    <TextBlock x:Name="TotalText"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Secondary}"/>

                    <!-- NEW: visible OK / Cancel buttons -->
                    <Button x:Name="OkBtn"
                            Content="OK"
                            Width="110"
                            Margin="0,0,8,0"
                            Click="OkBtn_Click"/>
                    <Button x:Name="CancelBtn"
                            Content="Cancel"
                            Width="110"
                            Style="{StaticResource Button.Secondary}"
                            Click="CancelBtn_Click"/>
                </StackPanel>

                <!-- Grid (fills remaining space) -->
                <DataGrid x:Name="ResultsDataGrid"
                          ItemsSource="{Binding Items}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="ResultsDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"    Binding="{Binding Name}"    Width="240"/>
                        <DataGridTextColumn Header="Email"   Binding="{Binding Email}"   Width="240"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*"/>
                        <DataGridTextColumn Header="Title"   Binding="{Binding Title}"   Width="260"/>
                    </DataGrid.Columns>
                </DataGrid>


            </DockPanel>
        </Border>
    </DockPanel>
</Window>
