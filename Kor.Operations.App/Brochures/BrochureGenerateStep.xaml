<UserControl x:Class="Kor.Operations.Brochures.BrochureGenerateStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Style="{StaticResource Card}"
            Padding="32"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1.5"
                              Opacity="0.12"
                              BlurRadius="7"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Centered content -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="560">

                <!-- Summary stats -->
                <TextBlock FontSize="14"
                           Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,4">
                    <Run Text="{Binding Blocks.Count, Mode=OneWay}"/>
                    <Run Text=" blocks  ·  "/>
                    <Run Text="{Binding TotalProjectCount, Mode=OneWay}"/>
                    <Run Text=" projects  ·  ~"/>
                    <Run Text="{Binding EstimatedPageCount, Mode=OneWay}"/>
                    <Run Text=" pages"/>
                </TextBlock>

                <TextBlock FontSize="12"
                           FontStyle="Italic"
                           Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,8">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}    {1}">
                            <Binding Path="SelectedSkinDisplayName" Mode="OneWay"/>
                            <Binding Path="SelectedLayoutDisplayName" Mode="OneWay"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!-- Warning when no projects -->
                <TextBlock Text="Add at least one section with a project before generating"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,8"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{StaticResource BrandOrange}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalProjectCount, Mode=OneWay}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Rectangle Height="1" Margin="0,0,0,32" Fill="{StaticResource NeutralGray}"/>

                <!-- Paired generate buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="140" Height="52"
                            FontSize="14" FontWeight="SemiBold"
                            Margin="0,0,12,0"
                            Command="{Binding PreviewBrochureCommand}"
                            IsEnabled="{Binding CanProduce, Mode=OneWay}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                <Setter Property="Content" Value="Preview"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                        <Setter Property="Content" Value="Generating…"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="160" Height="52"
                            FontSize="15" FontWeight="SemiBold"
                            Margin="0,0,16,0"
                            Command="{Binding ProduceBrochureCommand}"
                            IsEnabled="{Binding CanProduce, Mode=OneWay}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                <Setter Property="Content" Value="Generate PDF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                        <Setter Property="Content" Value="Generating…"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Export to Word"
                            Width="160" Height="52"
                            FontSize="15" FontWeight="SemiBold"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ExportDocxCommand}"
                            IsEnabled="{Binding CanProduce, Mode=OneWay}"/>
                </StackPanel>

                <TextBlock Text="The file opens automatically when complete."
                           Margin="0,16,0,0"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- Tips & Checklist (collapsed by default) -->
            <Expander Grid.Row="1" Margin="0,16,0,0" IsExpanded="False"
                      Header="Tips &amp; Checklist"
                      FontSize="11" Foreground="{StaticResource Text.Secondary}">
                <Border Margin="0,6,0,0" Padding="12,10"
                        Background="#F0F4F8" BorderBrush="#D6E0EA" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Review your brochure summary and generate the PDF. The document will open automatically when complete."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                        <TextBlock Text="• Check the block and project counts match what you expect" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="• Make sure at least one project exists before generating" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="• The PDF is saved to your documents folder" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
    </Border>
</UserControl>
