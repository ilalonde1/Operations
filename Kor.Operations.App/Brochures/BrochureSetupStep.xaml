<UserControl x:Class="Kor.Operations.Brochures.BrochureSetupStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Style="{StaticResource Card}"
            Padding="16"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1.5"
                              Opacity="0.12"
                              BlurRadius="7"/>
        </Border.Effect>
        <StackPanel>
            <Border Style="{StaticResource Form.SectionLabel}" Margin="0,0,0,10">
                <TextBlock Text="Brochure Setup" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandNavy}"/>
            </Border>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Visual Style" Style="{StaticResource Form.FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding SkinOptions}"
                              SelectedItem="{Binding SelectedSkinDisplayName, Mode=TwoWay}"
                              MinHeight="32"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Layout" Style="{StaticResource Form.FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding LayoutOptions}"
                              SelectedItem="{Binding SelectedLayoutDisplayName, Mode=TwoWay}"
                              MinHeight="32"/>
                </StackPanel>
            </Grid>

            <Button Content=" Analyze an existing brochure..."
                    HorizontalAlignment="Left"
                    Padding="10,6"
                    Margin="0,0,0,10"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding AnalyzeBrochureCommand}"
                    IsEnabled="{Binding CanProduce}"
                    ToolTip="Upload a PDF brochure and let AI suggest matching colors and style"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="12"
                        Background="#F8FAFC"
                        BorderBrush="#D6E0EA"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Visual Style Preview"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}"
                                   Margin="0,0,0,8"/>
                        <Border Height="120"
                                Background="White"
                                BorderBrush="#DCE4EC"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding VisualStylePreviewImage}"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Preview unavailable"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VisualStylePreviewImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="12"
                        Background="#F8FAFC"
                        BorderBrush="#D6E0EA"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Layout Preview"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}"
                                   Margin="0,0,0,8"/>
                        <Border Height="120"
                                Background="White"
                                BorderBrush="#DCE4EC"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding LayoutPreviewImage}"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Preview unavailable"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutPreviewImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Cover title" Style="{StaticResource Form.FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="CoverTitleBox"
                             Text="{Binding Cover.CoverTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"/>
                    <TextBlock Text="e.g. KOR Structural Portfolio 2025"
                               Margin="10,8,0,0"
                               Foreground="{StaticResource Text.Secondary}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CoverTitleBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Cover photo" Style="{StaticResource Form.FieldLabel}"/>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cover.HasCoverPhoto}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Browse..."
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding PickCoverPhotoCommand}"/>
                    <TextBlock Text="(optional)"
                               Margin="10,8,0,0"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cover.HasCoverPhoto}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="80"
                            Height="56"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Background="#F0F0F0">
                        <Image Source="{Binding Cover, Converter={StaticResource ImagePathConverter}}"
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Cover.CoverPhotoPath, Converter={StaticResource FileNameFromPathConverter}}"
                               Margin="10,20,8,0"
                               MaxWidth="150"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="&#x2715;"
                            Width="24"
                            Height="24"
                            Margin="0,16,8,0"
                            Command="{Binding ClearCoverPhotoCommand}"/>
                    <Button Content="Change..."
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,12,0,0"
                            Command="{Binding PickCoverPhotoCommand}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Cover.HasCoverPhoto}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6">
                    <Run Text="Opacity"/>
                    <Run Text="  "/>
                    <Run Text="{Binding Cover.CoverPhotoOpacity, StringFormat={}{0:P0}, Mode=OneWay}"/>
                </TextBlock>
                <Slider Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="False"
                        TickPlacement="BottomRight"
                        SmallChange="0.05"
                        Value="{Binding Cover.CoverPhotoOpacity, Mode=TwoWay}"/>
            </StackPanel>

            <Grid Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Header logo" Style="{StaticResource Form.FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Browse..."
                                Padding="8,5"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding PickLogoCommand}"/>
                        <Button Content="Cover logo (white)..."
                                 Padding="8,5"
                                 Margin="6,0,0,0"
                                 Style="{StaticResource Button.Secondary}"
                                 Command="{Binding PickCoverLogoCommand}"/>
                        <Button Content="Reset to default"
                                 Padding="8,5"
                                 Margin="6,0,0,0"
                                 Style="{StaticResource Button.Secondary}"
                                 Command="{Binding ClearLogoCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ContactConfig.LogoPath}"
                               FontSize="10"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Brand colors" Style="{StaticResource Form.FieldLabel}"/>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Primary"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <Button Command="{Binding PickPrimaryColorCommand}"
                                Width="32"
                                Height="24"
                                Padding="0"
                                ToolTip="{Binding Cover.PrimaryColorOverride}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource NeutralGray}"
                                Cursor="Hand"
                                Margin="0,0,12,0">
                            <Button.Background>
                                <SolidColorBrush Color="{Binding Cover.PrimaryColorOverride, Converter={StaticResource HexToColorConverter}, ConverterParameter=#435363}"/>
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="Accent"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <Button Command="{Binding PickAccentColorCommand}"
                                Width="32"
                                Height="24"
                                Padding="0"
                                ToolTip="{Binding Cover.AccentColorOverride}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource NeutralGray}"
                                Cursor="Hand">
                            <Button.Background>
                                <SolidColorBrush Color="{Binding Cover.AccentColorOverride, Converter={StaticResource HexToColorConverter}, ConverterParameter=#FF5C36}"/>
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Expander Margin="0,10,0,0" IsExpanded="False"
                      Header="Tips &amp; Checklist"
                      FontSize="11" Foreground="{StaticResource Text.Secondary}">
                <Border Margin="0,6,0,0" Padding="12,10"
                        Background="#F0F4F8" BorderBrush="#D6E0EA" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Set up your brochure template and cover. The cover title and photo will appear on the first page of your document."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                        <TextBlock Text="• Visual Style — colors, fonts, and header treatment" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="• Layout — page structure, project display, and personnel format" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="• Cover title — leave blank to use the template name" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="• Cover photo — optional; use a high-resolution landscape image" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>


