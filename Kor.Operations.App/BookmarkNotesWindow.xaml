<Window x:Class="Kor.Operations.BookmarkNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kor.Operations.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Bookmark notes"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Background}"
        Height="600"
        Width="1500"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Light orange used for the first row of each file -->
        <SolidColorBrush x:Key="BookmarkHeaderBrush" Color="#FFFBE2D2" />

        <!-- Keep your base row styling; add header highlight when not selected -->
        <Style x:Key="BookmarkRowStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <!-- Comfortable minimum; rows can grow when notes wrap -->
            <Setter Property="MinHeight" Value="26" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsHeaderRow}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource BookmarkHeaderBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10" LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brand.Primary.Brush}"
                CornerRadius="12"
                Padding="0"
                Margin="0,0,0,10">
            <controls:KorHeader x:Name="HeaderBar"
                                HeaderText="Bookmark Notes"
                                SubtitleText="Add notes beside each bookmark; they will appear on the cover sheet."
                                AvatarDiameter="96"
                                AvatarBorderThickness="2" />
        </Border>

        <!-- Main card -->
        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel LastChildFill="True">

                <!-- Info + buttons -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <TextBlock Text="Notes are optional; leave blank to use the bookmark text only."
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Foreground="{StaticResource Text.Secondary}" />
                    <Button x:Name="OkBtn"
                            Content="OK"
                            Width="110"
                            Margin="0,0,8,0"
                            Click="OkBtn_Click" />
                    <Button x:Name="CancelBtn"
                            Content="Cancel"
                            Width="110"
                            Style="{StaticResource Button.Secondary}"
                            Click="CancelBtn_Click" />
                </StackPanel>

                <!-- Grid -->
                <DataGrid x:Name="BookmarksGrid"
                          ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          Margin="0,0,0,8"
                          RowStyle="{StaticResource BookmarkRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File"
                                            Binding="{Binding FileName}"
                                            IsReadOnly="True"
                                            Width="320" />
                        <DataGridTextColumn Header="Bookmark"
                                            Binding="{Binding Bookmark}"
                                            IsReadOnly="True"
                                            Width="320" />

                        <!-- NOTE column: wrap + top align (view & edit) -->
                        <DataGridTextColumn Header="Note" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="AcceptsReturn" Value="True"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="2"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Note"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="PropertyChanged" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>
    </DockPanel>
</Window>
