<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- The NetworkOps service on APP01: the same listener the Command Center uses. Not secrets. -->
    <add key="ServerUrl" value="https://KOR-APP01.int.korstructural.com:8445" />
    <!-- SHA-256 of that listener's certificate (self-signed, to 2031). The agent talks to nothing else:
         every script it runs comes from this server, so the pin is what makes that safe. -->
    <add key="ServerCertSha256" value="EBAE9FE81D92623E1EED3C1F9C8F4ED7D5750A8BAE27522CE9F2CE1A3738EA6F" />
  </appSettings>
</configuration>
