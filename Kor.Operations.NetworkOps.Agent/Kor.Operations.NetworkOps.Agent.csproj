<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The NetworkOps endpoint agent (docs/KOR-NetworkOps-Design-2026-09-28.md, section 4.2). .NET Framework 4.7.2,
    not 4.8: every Windows 10 and 11 PC has 4.8, but an older server may not. KOR-BK01 (the Veeam backup box)
    runs 4.7.2, and a net48 agent would not even start there (CLR exit 0x80131700, "requires .NETFramework v4.8").
    4.7.2 (2018) is on every current Windows client and server, and 4.8 added almost no API over it, so this is
    the real "already on every box" floor; a 4.8 machine runs a 4.7.2 exe unchanged. The agent is a few files,
    not a 70 MB runtime pushed over the VPN to 38 machines. No package references, on purpose: JSON, HTTP and the
    service host are all in the framework, so nothing but these files ever needs to be on a PC.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kor.Operations.NetworkOps.Agent</RootNamespace>
    <AssemblyName>Kor.Operations.NetworkOps.Agent</AssemblyName>
    <!-- Reported on every call to APP01, and shown in the Command Center: an upgrade is confirmed from there.
         1.2.2: retargeted net48 -> net472 so it runs on older servers (BK01).
         1.2.3: net472's ValidateSecurityProtocol rejects the TLS 1.3 enum (4.8+), which killed 1.2.2's loop on start;
                it now requires TLS 1.2 and adds 1.3 only where supported. Safe to roll out to the whole fleet. -->
    <Version>1.2.3</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
</Project>
