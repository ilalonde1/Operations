<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<!-- FIRST: KorTransmittals (used by SqlFavoritesRepository for dbo.UserFavorites) -->
		<add name="KorTransmittals" connectionString="Server=KOR-APP01\SQLEXPRESS;Database=KorTransmittals;User Id=transmittals_app;Password=ChangeThisStrongPassword!2025;Encrypt=True;TrustServerCertificate=True;" />
		<!-- Existing: KorEmailIndex (used by the email indexer pieces) -->
		<add name="KorEmailIndex" connectionString="Server=KOR-APP01\SQLEXPRESS;Database=KorEmailIndex;User Id=transmittals_app;Password=ChangeThisStrongPassword!2025;Encrypt=True;TrustServerCertificate=True;" />
	</connectionStrings>
	<appSettings>
		<!-- Keep your production path here -->
		<add key="KorTransmittalsAppPath" value="C:\Newerforma\Kor.Operations.App.exe" />
	</appSettings>
</configuration>